ges.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/bltde15c95e1819160b/61aa4d361dbfc323d33b0acf/new-zealand_1.png","alt":""}},{"uid":"blt9d5daeded813ea89","title":"Peru","abbreviation":"PER","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/bltcc7330cc49845163/6291285cd0f3ca0f53e07c0c/Image_2022-05-27_at_12.35.37_PM.png"}},{"uid":"blt81e1aa4cef5e5e14","title":"South Africa","abbreviation":"SAF","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt8e12ea98946f37eb/61aa4de8f4f01a1e53e2c686/south-africa.png","alt":""}},{"uid":"blt7f7d5d2e3f0b2809","title":"United Arab Emirates","abbreviation":"ARE","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt143bcf923cbd448a/61aa4f1092da7e58659cfc10/united-arab-emirates.png","alt":""}},{"uid":"blt440e3ce320965a9b","title":"United Kingdom / England","abbreviation":"GBR","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt02676e7705186e63/61aa4e462e86841fa22388f0/united-kingdom.png","alt":""}},{"uid":"blt1af49e3a6a89373f","title":"USA","abbreviation":"USA","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt9de45bbdff160673/60d219911e0505677a882fa1/USAFlag.png"}},{"uid":"blt919360340f6a541a","title":"Uruguay","abbreviation":"URU","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt818e1e1f270f02c4/6861abd00090ec257972af13/uruguayan-flag-small.gif"}},{"uid":"blt23f61b88ebea7f55","title":"Venezuela","abbreviation":"VEN","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/bltde1a6103313dd4b0/61aa4f506b14b6709abf44fa/venezuela.png","alt":""}}]}},"sponsor":null}},{"heroBanner":{"backgroundImage":{"xlDesktop":null,"useDesktopSmartCrop":false,"desktop":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt23f8ea1ef3534afa/69069740f63213ff6ab2009f/Classic_-_Homepage_Desktop_1440x500_V1.jpg"},"tablet":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/bltc0cd5543a36bc96b/69069740114ad78ada64f0b1/Classic_-_Homepage_Tablet_768x500_V1.jpg"},"mobile":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt24f851f3b050c45f/69069740d1430d476689c22e/Classic_-_Homepage_Mobile_360x500_V1.jpg"}},"leftHeroConfigFields":{"raceDetails":[{"uid":"blta1ab9142edf4ebcd","raceName":"Breeders' Cup Classic","raceDetails":{"type":"World Championships","bcType":"Classic","sponsor":[],"sponsorLogo":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/bltb2341aaa147a6de7/62963af60d6f4a0fbcbefc6b/Longines5.31.svg","alt":""},"date":"2025-11-01T22:25:00.000Z","priorYearChampionPhoto":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt7e2c69f5f6a26562/6737a9a319d0a891a4f23d98/24-BC-199_Video-Thumbnail_Day2-600x450_v1-SierraLeone.jpg"},"displayPostTime":true,"isCompleted":true,"isLive":true,"purse":"$7,000,000","distance":"1 1/4 miles","grade":1,"ageV2":"3+","division":"Longines Classic","exacta":"","trifecta":"","superfecta":"","superHighFive":"","dailyDouble":"","pick3":"","pick4":"","pick5":"","pick6":"","region":""},"isTvScheduled":true,"broadcast":{"partners":[{"logo":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/bltf79bd4e964d5f80e/68d41e0fc07c892e73863c80/NBC_Logo_2025.svg"},"time":"3:30-7 P.M. ET"},{"logo":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blta5b3a045ace774e7/62bf0ac39a55544ea3af8314/22-BC-162_New-BCcom_Network-Logo-SVGs_146x60-v1-05-Peacock.svg","alt":""},"time":""}]},"trackDetails":[{"uid":"blt491ef0de361a8666","details":{"name":"Del Mar","logo":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/bltd22cd20f3175c3f4/61e830b7b401003502572b15/delmartrack.png"},"image":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/bltd5b96de0f5d0398d/613ab7badadef826b2db456a/DelMarTrackImage.jpeg"},"locationBcbc":"Del Mar","timeZone":-7}}],"raceDescription":"\u003ch1\u003eForever Young (JPN) Wins a Classic Breeders’ Cup Classic\u0026nbsp;\u003c/h1\u003e\u003cp\u003eSusumu Fujita’s Forever Young (JPN) ($9), third in last \u0026nbsp;year’s race behind Sierra Leone and Fierceness, turned the tables Saturday afternoon at Del Mar \u0026nbsp;to win the 42nd running of the $7 million Longines Breeders’ Cup Classic (G1) for 3-year-olds \u0026nbsp;and up by a half-length over Sierra Leone.\u0026nbsp;\u003c/p\u003e\u003cp\u003eTrained by Yoshito Yahagi and ridden by Ryusei Sakai, Forever Young covered the mile and a \u0026nbsp;quarter over a fast track in 2:00.19. The victory is the third for Yahagi in the World \u0026nbsp;Championships and first in the Classic. It is Sakai’s first Breeders’ Cup win.\u0026nbsp;\u003c/p\u003e\u003cp\u003eMore forwardly placed than last year, Forever Young tracked in third behind Contrary Thinking \u0026nbsp;and Fierceness through opening fractions of :23.04, :45.97 and 1:10.48.\u0026nbsp;\u003c/p\u003e\u003cp\u003eApproaching the far turn, Sakai gave Forever Young his cue and he swept to the front with \u0026nbsp;Mindframe and Journalism also on the move and Fierceness saving ground on the inside. Forever \u0026nbsp;Young maintained a safe margin over Fierceness and then was able to hold the late charge from \u0026nbsp;Sierra Leone.\u0026nbsp;\u003c/p\u003e\u003cp\u003eSierra Leone finished a length in front of Fierceness who was 2 ¼ lengths in front of Journalism \u0026nbsp;with Mindframe, Baeza, Nevada Beach, Antiquarian and Contrary Thinking following in order.\u0026nbsp;\u003c/p\u003e\u003cp\u003eForever Young is a 4-year-old son of Real Steel (JPN) out of the Congrats mare Forever Darling. \u0026nbsp;The victory was worth $3,640,000 and increased his earnings to $19,358,590 with a record of \u0026nbsp;13-10-0-3 that includes three Grade or Group 1 wins.\u0026nbsp;\u003c/p\u003e","surface":"","bettingCtaOverride":{"cta":[]}}],"background":null,"ctaButtons":[{"buttonText":"Results Chart","url":"https://assets.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt7af912c85f2c0fc6/6a2c596dc5524b8a199b4f57/2025_Classic_Results_Chart.pdf","attributes":{"style":"Purple","openInNewTab":true,"behavior":"default"}}],"description":"","largeTitle":"","smallTitle":"","sponsorImage":null},"title":"2025 Classic Hero Banner","sticky":true,"condensedHero":false,"links":[{"title":"2026","url":"/races/2026-classic"},{"title":"2025","url":"/races/2025-classic"},{"title":"2024","url":"/races/2024-classic"},{"title":"2023","url":"/races/2023-classic"},{"title":"2022","url":"/races/bcwc/2022/classic"},{"title":"2021","url":"/races/2021-longines-classic"},{"title":"2020","url":"/races/bcwc/2020/classic"},{"title":"2019","url":"/races/bcwc/2019/classic"},{"title":"2018","url":"/races/bcwc/2018/classic"},{"title":"2017","url":"/races/bcwc/2017/classic"},{"title":"2016","url":"/races/bcwc/2016/classic"},{"title":"2015","url":"/races/bcwc/2015/classic"},{"title":"2014","url":"/races/bcwc/2014/classic"},{"title":"2013","url":"/races/bcwc/2013/classic"},{"title":"2012","url":"/races/bcwc/2012/classic"},{"title":"2011","url":"/races/bcwc/2011/classic"},{"title":"2010","url":"/races/bcwc/2010/classic"},{"title":"2009","url":"/races/bcwc/2009/classic"},{"title":"2008","url":"/races/bcwc/2008/classic"},{"title":"2007","url":"/races/bcwc/2007/classic"},{"title":"2006","url":"/races/bcwc/2006/classic"},{"title":"2005","url":"/races/bcwc/2005/classic"},{"title":"2004","url":"/races/bcwc/2004/classic"},{"title":"2003","url":"/races/bcwc/2003/classic"},{"title":"2002","url":"/races/bcwc/2002/classic"},{"title":"2001","url":"/races/bcwc/2001/classic"},{"title":"2000","url":"/races/bcwc/2000/classic"},{"title":"1999","url":"/races/bcwc/1999/classic"},{"title":"1998","url":"/races/bcwc/1998/classic"},{"title":"1997","url":"/races/bcwc/1997/classic"},{"title":"1996","url":"/races/bcwc/1996/classic"},{"title":"1995","url":"/races/bcwc/1995/classic"},{"title":"1994","url":"/races/bcwc/1994/classic"},{"title":"1993","url":"/races/bcwc/1993/classic"},{"title":"1992","url":"/races/bcwc/1992/classic"},{"title":"1991","url":"/races/bcwc/1991/classic"},{"title":"1990","url":"/races/bcwc/1990/classic"},{"title":"1989","url":"/races/bcwc/1989/classic"},{"title":"1988","url":"/races/bcwc/1988/classic"},{"title":"1987","url":"/races/bcwc/1987/classic"},{"title":"1986","url":"/races/bcwc/1986/classic"},{"title":"1985","url":"/races/bcwc/1985/classic"},{"title":"1984","url":"/races/bcwc/1984/classic"}],"replayVideo":{"uid":"blt6d03fd983baedfc3","title":"20251101 R09 Breeders' Cup Classic (G1) Won By Forever Young (JPN)","videoId":"XiwckiPw","length":"2:15","thumbnails":{"default":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt011592d027f3f22e/69068fab1a428e0c3248689b/XiwckiPw.jpg"},"largeCard":null,"smallVerticalCard":null,"horizontalCard":null,"mobileHorizontalCard":null},"preRollAd":[],"publishDate":"2025-11-01T22:47:01.000Z","ogTags":[],"cardType":"Video"}}},{"tabs":{"tabs":[{"title":"Overview","content":[{"detailBanner":{"ContentTypeUid":"block_detail_banner","uid":"bltb6d1555cec25c86b","title":"2025 Classic Detail Banner","manualEntryConfig":[{"title":"DATE","value":"NOV 1, 2025","Metadata":{"uid":"csee49e5c3562fbe48"}},{"title":"DISTANCE","value":"1 1/4 MILES (DIRT)","Metadata":{"uid":"cs6c7b586a2f97a240"}},{"title":"PURSE","value":"$7,000,000","Metadata":{"uid":"cs478d5534b0f378e6"}},{"title":"GRADE","value":"1","Metadata":{"uid":"cscd3f60ef0ce82aba"}},{"title":"AGE","value":"3+","Metadata":{"uid":"cs69d618d69cd60b31"}}],"logo":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blte1ab13c18f3b59b4/672d5a48ee4d41da02396f2e/BreedersCup_DelMar_2025_RGB_DBG.png"},"backgroundTextureImage":null,"tags":[],"locale":"en-us","createdBy":"blt608d82c0d7af6f7e","updatedBy":"blt608d82c0d7af6f7e","createdAt":"2024-11-11T17:14:15.467Z","updatedAt":"2024-11-11T17:39:05.311Z","ACL":{},"Version":2,"InProgress":false,"publishDetails":{"time":"2025-01-06T18:02:25.090Z","user":"blta46375476b4f83a9","environment":"bltbe5baf815e13df4d","locale":"en-us"}}},{"overview":{"content":"\u003ch1\u003eForever Young (JPN) Wins a Classic Breeders’ Cup Classic\u0026nbsp;\u003c/h1\u003e\u003cp\u003eSusumu Fujita’s Forever Young (JPN) ($9), third in last \u0026nbsp;year’s race behind Sierra Leone and Fierceness, turned the tables Saturday afternoon at Del Mar \u0026nbsp;to win the 42nd running of the $7 million Longines Breeders’ Cup Classic (G1) for 3-year-olds \u0026nbsp;and up by a half-length over Sierra Leone.\u0026nbsp;\u003c/p\u003e\u003cp\u003eTrained by Yoshito Yahagi and ridden by Ryusei Sakai, Forever Young covered the mile and a \u0026nbsp;quarter over a fast track in 2:00.19. The victory is the third for Yahagi in the World \u0026nbsp;Championships and first in the Classic. It is Sakai’s first Breeders’ Cup win.\u0026nbsp;\u003c/p\u003e\u003cp\u003eMore forwardly placed than last year, Forever Young tracked in third behind Contrary Thinking \u0026nbsp;and Fierceness through opening fractions of :23.04, :45.97 and 1:10.48.\u0026nbsp;\u003c/p\u003e\u003cp\u003eApproaching the far turn, Sakai gave Forever Young his cue and he swept to the front with \u0026nbsp;Mindframe and Journalism also on the move and Fierceness saving ground on the inside. Forever \u0026nbsp;Young maintained a safe margin over Fierceness and then was able to hold the late charge from \u0026nbsp;Sierra Leone.\u0026nbsp;\u003c/p\u003e\u003cp\u003eSierra Leone finished a length in front of Fierceness who was 2 ¼ lengths in front of Journalism \u0026nbsp;with Mindframe, Baeza, Nevada Beach, Antiquarian and Contrary Thinking following in order.\u0026nbsp;\u003c/p\u003e\u003cp\u003eForever Young is a 4-year-old son of Real Steel (JPN) out of the Congrats mare Forever Darling. \u0026nbsp;The victory was worth $3,640,000 and increased his earnings to $19,358,590 with a record of \u0026nbsp;13-10-0-3 that includes three Grade or Group 1 wins.\u0026nbsp;\u003c/p\u003e"