  <div class="mx-auto pt-64 lg:pt-80">
    <section class="news-header max-w-1440 mx-auto px-0 lg:px-desktop">
  <div class="px-mobile md:px-tablet lg:px-0 py-8">
    <a href="/en/news" class="back-button flex py-12 items-center gap-8">
