			<div class="contentsTitle">
				<div class="contentsTitleIn">
					<h1 class="headTitle2"><span class="headText"><span class="headTextSub"></span>TENNO SHO (Autumn) (G1)</span></h1>
				</div>
				<!--/contentsTitle-->
			</div>
			
		<!-- InstanceEndEditable -->
			<div class="contentsWrap"><!-- InstanceBeginEditable name="mainContents" -->
				<div id="main">
					<p class="textBold textRed alR">TO CLOSE ON Tue, 8 September 2026</p>
					<p class="textBold alR">TOKYO /left handed</p>
					<div class="columnBox column2 equalHeight">
						<div class="column">
							<div class="photo"><img src="img/1101tenno-autumn.jpg" alt=""> </div>
							<div class="imgCap">2025 Winner : Masquerade Ball</div>
						</div>
						<div class="column">
							<div class="photo modal"><a class="modalPartsimg" href="../../../../go_racing/jra_racecourses/course_details/img/tokyo_im01.gif"><img src="../../../../go_racing/jra_racecourses/course_details/img/tokyo_im01.gif" alt=""></a></div>
						</div>
					</div>
					<p class="textBold textRed alR">Sunday, 1 November 2026</p>

					<div class="table clBoth">
						<table class="tableStyle01">
							<colgroup>
							<col class="w34per">
							<col class="w33per">
							<col class="w33per">
							</colgroup>
							<tr>
								<th class="lv01">Distance</th>
								<td>2000m, Turf</td>
								<td>/about 10 furlongs</td>
							</tr>
							<tr>
								<th class="lv01">Total Value</th>
								<td class="textBold">&yen;<span id="total">651,000,000</span></td>
								<td>/about US$<span id="total_us">000</span></td>
							</tr>
							<tr>
								<th class="lv01">Prize Money for the Winner</th>
								<td class="textBold">&yen;<span id="winner">300,000,000 </span></td>
								<td>/about US$<span id="winner_us">000</span></td>
							</tr>
							<tr>
								<th class="lv01">Qualification to Run</th>
								<td colspan="2">3yo&amp;up</td>
							</tr>
							<tr>
								<th class="lv01">Maximum number of Starters</th>
								<td colspan="2">18</td>
							</tr>
						</table>
					</div>

					<div class="table">
						<table class="tableStyle01">
							<colgroup>
							<col class="w34per">
							<col class="w33per">
							<col class="w33per">
							</colgroup>
							<tr>
								<th class="lv01">Nomination</th>
								<td>Tue, 8 September 2026</td>
								<td>free of charge</td>
							</tr>
							<tr>
								<th class="lv01">Declaration</th>
								<td colspan="2">Thu, 29 Oct. '26</td>
							</tr>
							<tr>
								<th class="lv01">Entry to Japan</th>
								<td colspan="2">to Thu, 22 Oct. '26</td>
							</tr>
							<tr>
								<th class="lv01">*Payment</th>
								<td>Fri, 23 Oct. '26</td>
								<td>&yen;<span id="payment">300,000</span> /about US$<span id="payment_us">000</span></td>
							</tr>
						</table>
					</div>
					
					<p><span class="textBold">Weight:</span><br>
					<span class="textBold">3yo 56 kg 4yo+ 58 kg</span></p>
					<p><span class="textBold">Allowance:</span><br>
					<span class="textBold">Fillies &amp; Mares：2 kg</span><br>
					<span class="textBold">Southern Hemisphere Bred born in 2023：2 kg</span></p>

					
					<p class="btnStyle01"><a href="../2026.html"><span>List of JRA Graded Races</span></a></p>



					
<script type="text/javascript" src="./exchanging.js"></script>
