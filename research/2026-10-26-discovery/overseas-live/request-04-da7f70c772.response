ileHorizontalCard":null},"type":"News","author":"","adCards":[{"ContentTypeUid":"collection_advertisement","type":"DFP Ad","dfpAdCard":{"adHeight":250,"code":"\u003ca href=\"https://www.breederscup.com/watch\" target=\"_blank\"\u003e\n\u003cimg src=\"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt01673775b31df10d/6ac3eabb66fa96ff0be8b062/2026_BCWC_Tune-In_Bet_Messaging_Pop_Up_300x250.jpg\" width=\"300\" height=\"250\"\u003e\n\u003c/a\u003e"}}],"ogTags":[],"tags":["news","golden tempo","longines breeders' cup classic","bcwc 26","kentucky derby","keeneland race course"],"cardType":"Article","sponsor":null}],"layout":"1-3-horizontal","cta":{"buttonText":"View More","url":"/news","attributes":{"style":"Purple","openInNewTab":false,"behavior":"default"}},"sponsorBannerImage":null,"nextPageToken":"-/4/-/-","sponsor":null,"title":"LATEST NEWS","description":"","trackingName":"LATEST NEWS"}},{"promoBanner":{"ContentTypeUid":"block_promo_banner","uid":"blt41307ccbf8afd44e","Version":6,"locale":"en-us","ACL":{},"InProgress":false,"backgroundImage":{"xlDesktop":null,"desktop":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/bltff3e9d1c9c70df05/6ace54a704e85206947d0151/_Promo-banner_1280x340.jpg"},"useDesktopSmartCrop":false,"tablet":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/bltd0f69da7889c2f97/6ace54a7f0773376f0f8885f/_Hamburger-banner_688x600.jpg"},"mobile":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt9b3971e79e198b52/6ace54a7f077330318f88863/_Promo-banner_320x600.jpg"}},"clickableBannerUrl":"https://racing.fanduel.com/promos/B10G50RACQST0626?onelink_id=V8wF\u0026pid=breeders-cup\u0026af_xp=custom\u0026af_click_lookback=7d\u0026af_adset=bet-10-get-50\u0026source_caller=ui\u0026c=bet-10-get-50\u0026shortlink=i19emlqm","createdAt":"2024-10-22T13:09:27.245Z","createdBy":"blta46375476b4f83a9","ctaButtons":[],"description":"","largeTitle":"","largeTitleMiddlePlacement":false,"tags":[],"title":"FanDuel Ad 1280x340","updatedAt":"2026-10-17T13:58:52.557Z","updatedBy":"blta46375476b4f83a9","publishDetails":{"time":"2026-10-17T13:59:00.242Z","user":"blta46375476b4f83a9","environment":"bltbe5baf815e13df4d","locale":"en-us"}}},{"contentSwimlane":{"cards":[{"publishDate":"2026-10-23T15:00:12Z","id":"itXNrSawt8I","title":"Foal Friday: National Treasure x Beholder Colt","description":"Only fitting to close out the 2026 Foal Friday season with the scion of a 3-time Breeders’ Cup champion: first ballot Hall of Famer BEHOLDER! \n\nWhen we met Beholder’s Gun Runner colt last year at Spendthrift Farm, Broodmare Manager Aimee Compton told us about her date with champion National Treasure. Of course, we had to meet that baby, too — and he was worth the wait!","thumbnail":"https://i.ytimg.com/vi/itXNrSawt8I/sddefault.jpg","duration":"07:28","type":"youtube"},{"publishDate":"2026-10-22T17:03:15Z","id":"9WmJgEl1vgY","title":"Tiffany (IRE) Breeders' Cup Preparations","description":"Spend the morning with Tiffany (IRE) ahead of the Longines Breeders' Cup Turf. \n\nHear from trainer Sir Mark Prescott, assistant trainer William Butler, and Ryan Bliss of Elite Racing, as they speak on her journey to Graded Stakes success. \n\n📹 JSC Communications","thumbnail":"https://i.ytimg.com/vi/9WmJgEl1vgY/sddefault.jpg","duration":"05:42","type":"youtube"},{"publishDate":"2026-10-22T17:00:13Z","id":"2L-eLqeX_bo","title":"Breeders' Cup Connections: Fully Subscribed","description":"With back-to-back Grade I victories, Fully Subscribed is bringing Payson Stud back to the Breeders’ Cup, carrying the hopes of a breeding operation whose future was changed by one special mare. When Christian Erickson saw Rutherienne, the beloved champion of the late Virginia Kraft Payson, he abandoned plans to wind down the operation and instead committed to growing its legacy. \n\nNow, Rutherienne’s granddaughter is poised to chase Breeders’ Cup Distaff glory, bringing Payson Stud’s story full circle. On this Breeders' Cup Connections, watch how one champion helped shape the future of a family’s breeding legacy.","thumbnail":"https://i.ytimg.com/vi/2L-eLqeX_bo/sddefault.jpg","duration":"02:43","type":"youtube"},{"publishDate":"2026-10-21T19:49:55Z","id":"UyZ8KRbVu3c","title":"Francis-Henri Graffard","description":"Globe-trotting trainer, Francis-Henri Graffard, won his first Breeders' Cup race last year with Gezora at Del Mar.\n\n🔈 Hear who from his barn is pointing to #BC26 at Keeneland. \n\n📹 JSC Communications","thumbnail":"https://i.ytimg.com/vi/UyZ8KRbVu3c/sddefault.jpg","duration":"03:03","type":"youtube"},{"publishDate":"2026-10-21T14:00:07Z","id":"PmXcmS_vUVI","title":"2026 Rein It In: Episode 8","description":"The final episode of Rein It In before Nick Luck and Britney Eurton meet in Lexington for BC26!\n\nRein It In gives Nick and Britney two minutes to provide as much information about a topic as possible.\n\nThe 15-minute-long episodes will focus on topics pertaining to the Breeders’ Cup Challenge Series and international happenings leading to the 2026 Breeders' Cup World Championships at Keeneland, in Lexington, Kentucky.","thumbnail":"https://i.ytimg.com/vi/PmXcmS_vUVI/sddefault.jpg","duration":"19:28","type":"youtube"},{"publishDate":"2026-10-15T19:10:16Z","id":"6pX9kNQi95w","title":"Hands on History: Flightline and Lane's End","description":"From a million-dollar yearling to an undefeated Breeders’ Cup Classic champion, Flightline has defined careers and created lifelong memories for the people who know him best. \n\nOn this Hands On History, learn about Flightline's first foals that have begun to make their mark, as his legacy at Lane’s End continues to grow.\n\nProduced with The TDN","thumbnail":"https://i.ytimg.com/vi/6pX9kNQi95w/sddefault.jpg","duration":"04:07","type":"youtube"},{"publishDate":"2026-10-08T15:21:09Z","id":"D5Yzpnq51UA","title":"Breeders' Cup Connections: Thought Process","description":"Homebred. Grade I winner. Breeders’ Cup contender. ❤️ \n\nAfter the Jones family chose to keep Thought Process as a yearling, she’s gone on to become one of the West Coast’s top turf fillies. On this Breeders' Cup Connections, learn about the special homecoming for Thought Process on her connections’ home track.\n\nProduced with The TDN","thumbnail":"https://i.ytimg.com/vi/D5Yzpnq51UA/sddefault.jpg","duration":"02:56","type":"youtube"},{"publishDate":"2026-10-07T14:54:36Z","id":"xwiH2vEVQaA","title":"Breeders' Cup Interview with Josh Christian on Arc Day","description":"Hear from Breeders' Cup's Vice President of Racing and Nominations Josh Christian on the special relationship Breeders' Cup has with ParisLongchamp and Arc Day!","thumbnail":"https://i.ytimg.com/vi/xwiH2vEVQaA/sddefault.jpg","duration":"01:21","type":"youtube"}],"sponsor":null,"title":"Latest Video","description":"From action on the track to conversations with our sport's biggest stars, check out our most recent videos.","viewMoreCta":{"buttonText":"View More","url":"/video","attributes":{"style":"Purple","openInNewTab":false,"behavior":"default"}},"layout":"sequence","openInModal":true,"playlistId":"latest-video-2026"}},{"contentSwimlane":{"cards":[{"publishDate":"2026-10-17T19:13:58Z","id":"zXo0ka_6PRM","title":"2026 Champions Stakes: Ombudsman","description":"Did you catch that?! The last ticket of the 2026 #WinAndYoureIn season went to Ombudsman. \n\nCongratulations to the Champion Stakes winner and all connections! 🇬🇧","thumbnail":"https://i.ytimg.com/vi/zXo0ka_6PRM/sddefault.jpg","duration":"02:16","type":"youtube"},{"publishDate":"2026-10-04T23:19:02Z","id":"vDyj3HpuaPg","title":"2026 Bourbon Stakes - Agate","description":"Agate wins the Bourbon Stakes and is IN the Brown Advisory #BreedersCup Juvenile Turf! Congrats to the connections!\n\nJockey: Tyler Gaffalione\nTrainer: Kelsey Danner\nOwner/Breeder: Dede McGehee","thumbnail":"https://i.ytimg.com/vi/vDyj3HpuaPg/sddefault.jpg","duration":"01:50","type":"youtube"},{"publishDate":"2026-10-04T22:58:15Z","id":"cJMy2JEu3Ak","title":"2026 Spinster: Fully Subscribed","description":"Fully Subscribed will be back here on October 31st. 📍\n\nCongrats to the #WinAndYoureIn Juddmonte Spinster winner!","thumbnail":"https://i.ytimg.com/vi/cJMy2JEu3Ak/sddefault.jpg","duration":"01:57","type":"youtube"},{"publishDate":"2026-10-04T15:46:08Z","id":"_fEm6DT6W2M","title":"2026 Qatar Prix de la Foret - True Love","description":"True Love wraps up #WinAndYoureIn action from Paris with a win in the Qatar Prix de la Foret!\n\nJockey: Ryan Moore\nTrainer: Aidan P. O'Brien\nOwner: Michael Tabor \u0026 Derrick Smith \u0026 Mrs John Magnier\nBreeder: Coolmore","thumbnail":"https://i.ytimg.com/vi/_fEm6DT6W2M/sddefault.jpg","duration":"01:26","type":"youtube"},{"publishDate":"2026-10-04T15:24:59Z","id":"Jepy11OR6GQ","title":"2026 Prix de l'Opera Longines -  Miss Scott","description":"Joie de vivre! Miss Scott is Keeneland bound for #BC26 after victory in the #WinAndYoureIN Prix de l'Opera Longines. Congrats to the connections! 🌟\n\nJockey: Christophe Soumillon\nTrainer: John \u0026 Thady Gosden\nOwner: The Thoroughbred Racing Corporation Ltd\nBreeder: Ballylinch Stud \u0026 Ecurie Des Charmes","thumbnail":"https://i.ytimg.com/vi/Jepy11OR6GQ/sddefault.jpg","duration":"02:05","type":"youtube"},{"publishDate":"2026-10-04T14:27:00Z","id":"JSmC-0bTaGI","title":"2026 Qatar Prix de l'Arc de Triomphe - Daryz","description":"Daryz earns a spot in the Longines #BreedersCup Turf after triumph in the Qatar Prix de l'Arc de Triomphe.\n\nJockey: Mickael Barzalona\nTrainer: Francis-Henri Graffard/Frankreich\nOwner: Aga Khan Studs Sc\nBreeder: His Highness The Aga Khan's Stud SC","thumbnail":"https://i.ytimg.com/vi/JSmC-0bTaGI/sddefault.jpg","duration":"02:34","type":"youtube"},{"publishDate":"2026-10-04T14:01:30Z","id":"XRLvxj_WmYo","title":"2026 - Prix de l'Abbaye de Longchamp Longines - Miss Yechance","description":"Wow, what a performance from Miss Yechance! We'll see you at #BC26!\n\nCongrats to the connections.\n\nJ: Jack Nicholls\nT: Karl Richard Burke\nO: AL LEITH RACING CLUB\nB: Tally-Ho Stud","thumbnail":"https://i.ytimg.com/vi/XRLvxj_WmYo/sddefault.jpg","duration":"01:02","type":"youtube"},{"publishDate":"2026-10-04T13:45:09Z","id":"npUzESWhN0k","title":"2026 Qatar Prix Jean-Luc Lagardere - Amusingly","description":"Très magnifique! Amusingly storms to victory in the Qatar Prix Jean-Luc Lagardere and now sets sights on #BC26! 🏇\n\nJ: Colin Keane\nT: F-H Graffard\nO: Juddmonte\nB: Juddmonte Farms Ireland Ltd","thumbnail":"https://i.ytimg.com/vi/npUzESWhN0k/sddefault.jpg","duration":"01:22","type":"youtube"}],"sponsor":null,"title":"Breeders' Cup Challenge Series","description":"Watch all the race replays from the 2026 Breeders' Cup Challenge Series.","viewMoreCta":{"buttonText":"View More","url":"/video/breeders-cup-challenge-series-replays","attributes":{"style":"Purple","openInNewTab":true,"behavior":"default"}},"layout":"sequence","openInModal":true,"playlistId":"2026-challenge-series-replays"}},{"promoCards":{"ContentTypeUid":"block_promo_cards","uid":"blt49a1b8af71a4fb49","title":"Promo Cards: Experience \u0026 Future Host Sites","layout":"Content Overlay Cards","promoCards":[{"ContentTypeUid":"collection_promo_card","uid":"bltcb3ca989e5b54172","Version":5,"locale":"en-us","ACL":{},"InProgress":false,"backgroundImages":{"xlDesktop":null,"desktop":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt595992dade610f86/68080e9283ae052119e04af2/BRE_Website_PromoCard.jpg"},"useDesktopSmartCrop":false,"tablet":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt976c7362c029b15e/6808f33d3ed10769b3d040b6/BRE_Website_PromoCard_Stands_Tablet.jpg"},"mobile":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt9a74649e2f02571d/6809539a096d98af4de5de07/BRE_Website_PromoCard_Mobile_UPDATED.jpg"}},"clickableCardConfig":{"url":"","openInNewTab":false},"createdAt":"2024-10-28T21:46:15.270Z","createdBy"