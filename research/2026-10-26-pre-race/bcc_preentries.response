de":" ","raceDate":"March, 24 2023 00:00:00","purseUsa":20000,"positionAtFinish":5},{"trackName":"GOLDEN GATE FIELDS","raceName":" ","grade":" ","raceDate":"February, 11 2023 00:00:00","purseUsa":31000,"positionAtFinish":6},{"trackName":"GOLDEN GATE FIELDS","raceName":" ","grade":" ","raceDate":"January, 16 2023 00:00:00","purseUsa":31000,"positionAtFinish":4},{"trackName":"GOLDEN GATE FIELDS","raceName":" ","grade":" ","raceDate":"December, 11 2022 00:00:00","purseUsa":31000,"positionAtFinish":4},{"trackName":"GOLDEN GATE FIELDS","raceName":"Golden Gate Debutante S.","grade":" ","raceDate":"November, 25 2022 00:00:00","purseUsa":50000,"positionAtFinish":4},{"trackName":"GOLDEN GATE FIELDS","raceName":" ","grade":" ","raceDate":"September, 23 2022 00:00:00","purseUsa":31000,"positionAtFinish":1},{"trackName":"SACRAMENTO","raceName":" ","grade":" ","raceDate":"July, 29 2022 00:00:00","purseUsa":26000,"positionAtFinish":1},{"trackName":"PLEASANTON","raceName":" ","grade":" ","raceDate":"July, 10 2022 00:00:00","purseUsa":26000,"positionAtFinish":2},{"trackName":"GOLDEN GATE FIELDS","raceName":" ","grade":" ","raceDate":"June, 11 2022 00:00:00","purseUsa":30000,"positionAtFinish":2}],"record":{"previousYear":{"starts":11,"earnings":492775,"show":1,"win":3,"place":3,"showP":"9","winP":"27","placeP":"27"},"breedersCup":{"starts":1,"earnings":20000,"show":0,"win":0,"place":0,"showP":"0","winP":"0","placeP":"0"},"currentYear":{"starts":6,"earnings":516750,"show":2,"win":2,"place":1,"showP":"33","winP":"33","placeP":"17"},"lifetime":{"starts":39,"earnings":1153309,"show":6,"win":9,"place":12,"showP":"15","winP":"23","placeP":"31"}},"yearlySummary":[{"showsP":"33","winsP":"33","placesP":"17","starts":6,"earnings":516750,"racingYear":2026,"shows":2,"wins":2,"places":1},{"showsP":"9","winsP":"27","placesP":"27","starts":11,"earnings":492775,"racingYear":2025,"shows":1,"wins":3,"places":3}],"morningLineOdds":[],"bio":"\u003cp\u003eFormer claimer Majestic Oops, who collected her first taste of black-type success in 2025, stepped up her game in 2026, winning her first race at the graded stakes level.\r\u003c/p\u003e\u003cp\u003eVictorious in last year’s Monmouth Park’s Lady’s Secret Stakes (Listed) and Oaklawn Park’s Dig A Diamond Stakes in the first half of her 5-year-old season, the filly subsequently finished runner-up in Monmouth’s Molly Pitcher Stakes (G3) and third in Saratoga’s 7-furlong Ballerina Stakes (G1) \r\u003c/p\u003e\u003cp\u003eRegrouping after a distant ninth in the Breeders’ Cup Distaff (G1) at Del Mar last November, the California-bred kicked off her 6-year-old campaign with a win in Oaklawn’s 6-furlong American Beauty Stakes (Listed) in February. Stretching out in a sloppy renewal of the Azeri Stakes (G2) in March, the daughter of Majestic Harbor came home a three-quarters of a length winner at odds of 9-1 over Regaled in the 1 1/16-mile test with champion Nitrogen third.\r\u003c/p\u003e\u003cp\u003eThird — beaten 8 ¼ lengths — by Claret Baret in the 8 ½-furlong Apple Blossom Handicap (G1) on April 11, she filled the same position, this time behind Splendora, in the May 30 Shawnee Stakes (G2) at Churchill Downs. Given a 3-1 chance next time, the bay came home 1 1/-2 lengths short in fourth in the Clement L. Hirsch Stakes (G1) at Del Mar on Aug. 1.\r\u003c/p\u003e\u003cp\u003eSent off at 7-2 in the “Win and You’re In” qualifier for the Longines Breeders’ Cup Distaff (G1), the Zenyatta Stakes (G2), Majestic Oops found only reigning champion Super Corredora too tough, finishing second behind the 2025 NetJets Breeders’ Cup Juvenile Fillies (G1) winner by 2 ¾ lengths.\r\u003c/p\u003e\u003cp\u003eBred by William and Sandy Dory and Gary and Janet Kropp, Majestic Oops is by the late Grade 1 winner Majestic Harbor and out of Miss Oops (by Olmodavor).\r\u003c/p\u003e","gradedStakesPoints":16,"regionWinnerBadges":[],"breederName":"William Dory, Sandy Dory, Gary Kropp \u0026 Janet Kropp","uid":"bltffe37d5e6d880e78","hasAutogeneratedPage":true,"url":"/redirect/horse/bltffe37d5e6d880e78?ht=pre-entries","pageTitle":"Majestic Oops","jockeyName":"","ownerName":"Medallion Racing (Phillip Shelton), Evan Trommer, Agave Racing Stable (Mark Martinez), Sublime Stables (Bill Dory) \u0026 Sheila Regan","trainer":"Philip D'Amato","country":{"uid":"blt1af49e3a6a89373f","title":"USA","abbreviation":"USA","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt9de45bbdff160673/60d219911e0505677a882fa1/USAFlag.png"}},"horseName":"Majestic Oops","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt29014924ee5e88f0/6ab3cf8f5a97bef6b349774c/Contender_Photo_Majestic_Oops.jpg"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt29014924ee5e88f0/6ab3cf8f5a97bef6b349774c/Contender_Photo_Majestic_Oops.jpg"},"cta":null,"races":[{"uid":"bltf0689a11ba6900ce","ContentTypeUid":"collection_race","challengeSeriesWinner":false,"isEligible":false,"eligibleRank":null,"finishPosition":null,"classicRanking":null,"postPosition":"","scratched":false,"win":"","place":"","show":"","deadHeat":false,"silks":null}],"isChallengeSeriesWinner":false,"silks":null,"isHoC":false,"year":2026,"isHistoricalEntry":false,"relatedArticles":[],"win":"","show":"","place":""},{"sireName":"Win Win Win","damName":"Unanimity","sex":"Filly","color":"Bay","foalingDate":"March, 09 2022 00:00:00","age":4,"pastPerformances":[{"trackName":"CHURCHILL DOWNS","raceName":" ","grade":" ","raceDate":"September, 13 2026 00:00:00","purseUsa":141000,"positionAtFinish":1},{"trackName":"ELLIS PARK","raceName":" ","grade":" ","raceDate":"August, 02 2026 00:00:00","purseUsa":104000,"positionAtFinish":1},{"trackName":"LOS ALAMITOS RACE COURSE","raceName":"Great Lady M S.","grade":"2","raceDate":"July, 04 2026 00:00:00","purseUsa":200000,"positionAtFinish":3},{"trackName":"LOS ALAMITOS RACE COURSE","raceName":"Starlet S.","grade":"2","raceDate":"December, 07 2024 00:00:00","purseUsa":200000,"positionAtFinish":5},{"trackName":"DEL MAR","raceName":"NetJets Breeders' Cup Juvenile Fillies","grade":"1","raceDate":"November, 01 2024 00:00:00","purseUsa":2000000,"positionAtFinish":6},{"trackName":"SANTA ANITA PARK","raceName":"Oak Leaf S. presented by Oak Tree","grade":"2","raceDate":"October, 05 2024 00:00:00","purseUsa":200000,"positionAtFinish":2},{"trackName":"DEL MAR","raceName":"FanDuel Racing Del Mar Debutante S.","grade":"1","raceDate":"September, 07 2024 00:00:00","purseUsa":300000,"positionAtFinish":5},{"trackName":"DEL MAR","raceName":"Sorrento S.","grade":"3","raceDate":"August, 10 2024 00:00:00","purseUsa":150000,"positionAtFinish":1},{"trackName":"SANTA ANITA PARK","raceName":" ","grade":" ","raceDate":"June, 13 2024 00:00:00","purseUsa":54000,"positionAtFinish":1}],"record":{"previousYear":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"breedersCup":{"starts":1,"earnings":40000,"show":0,"win":0,"place":0,"showP":"0","winP":"0","placeP":"0"},"currentYear":{"starts":3,"earnings":106924,"show":1,"win":2,"place":0,"showP":"33","winP":"67","placeP":"0"},"lifetime":{"starts":9,"earnings":319324,"show":1,"win":4,"place":1,"showP":"11","winP":"44","placeP":"11"}},"yearlySummary":[{"showsP":"33","winsP":"67","placesP":"0","starts":3,"earnings":106924,"racingYear":2026,"shows":1,"wins":2,"places":0},{"showsP":"NA","winsP":"NA","placesP":"NA","starts":0,"earnings":0,"racingYear":2025,"shows":0,"wins":0,"places":0}],"morningLineOdds":[],"bio":"\u003cp\u003eTo say that there were lofty expectations for Nooni’s career before she set foot on the racetrack is an understatement of epic proportions.\u0026nbsp;\u0026nbsp;\u003c/p\u003e\u003cp\u003eThe daughter of Florida-based sire Win Win Win dazzled in the lead-up to the 2024 OBS March Sale of 2-year-olds in Training and ultimately sold to Zedan Racing Stables for a sale-topping $1.8 million.\u0026nbsp;\u003c/p\u003e\u003cp\u003eA front-running 9 ½-length debut winner going 5 furlongs at Santa Anita in June 2024, the Florida-bred made it two straight when favored to repeat in Del Mar’s 6-furlong Sorrento Stakes (G3) that summer.\u0026nbsp;\u0026nbsp;\u003c/p\u003e\u003cp\u003eA lackluster fifth in the 7-furlong Del Mar Debutante (G1), the Bob Baffert-trained filly ran second in Santa Anita’s 1 1/16-mile Oak Leaf Stakes (G2) before coming home sixth in the NetJets Breeders’ Cup Juvenile Fillies (G1) at Del Mar. She was a distant fifth behind stablemate Tenma in her juvenile finale in the Starlet Stakes (G2) over 1 1/16 miles in December.\u0026nbsp;\u003c/p\u003e\u003cp\u003eCutting back to 6 ½ furlongs for her delayed reappearance in the July 4, 2026 Great Lady M\u0026nbsp; Stakes (G2) at Los Alamitos in which she finished third, the bay triumphed as the even-money choice in a 6-furlong allowance optional claimer at Ellis Park in August and made it two straight with a 4 ¾-length victory when favored in the 7-furlong optional claimer at Churchill Downs in September.\u003c/p\u003e","gradedStakesPoints":2,"regionWinnerBadges":[],"breederName":"Ocala Stud, Joseph M. O'Farrell III, David O'Farrell, et al.","uid":"blt6ea388834ca9c159","hasAutogeneratedPage":true,"url":"/redirect/horse/blt6ea388834ca9c159?ht=pre-entries","pageTitle":"Nooni","jockeyName":"","ownerName":"Zedan Racing Stables, Inc. (Amr F. Zedan)","trainer":"Bob Baffert","country":{"uid":"blt1af49e3a6a89373f","title":"USA","abbreviation":"USA","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt9de45bbdff160673/60d219911e0505677a882fa1/USAFlag.png"}},"horseName":"Nooni","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blte3592290bb82c000/66bd0d61f8d31f0614b654c6/Nooni_(1).png"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blte3592290bb82c000/66bd0d61f8d31f0614b654c6/Nooni_(1).png"},"cta":null,"races":[{"uid":"bltf0689a11ba6900ce","ContentTypeUid":"collection_race","challengeSe