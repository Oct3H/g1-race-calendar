 08 2024 00:00:00","purseUsa":1000000,"positionAtFinish":12},{"trackName":"GULFSTREAM PARK","raceName":" ","grade":" ","raceDate":"August, 11 2024 00:00:00","purseUsa":65000,"positionAtFinish":1},{"trackName":"GULFSTREAM PARK","raceName":" ","grade":" ","raceDate":"July, 13 2024 00:00:00","purseUsa":65000,"positionAtFinish":2}],"record":{"previousYear":{"starts":9,"earnings":134045,"show":2,"win":1,"place":2,"showP":"22","winP":"11","placeP":"22"},"breedersCup":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"currentYear":{"starts":8,"earnings":442035,"show":1,"win":4,"place":0,"showP":"13","winP":"50","placeP":"0"},"lifetime":{"starts":21,"earnings":616630,"show":3,"win":6,"place":3,"showP":"14","winP":"29","placeP":"14"}},"yearlySummary":[{"showsP":"13","winsP":"50","placesP":"0","starts":8,"earnings":442035,"racingYear":2026,"shows":1,"wins":4,"places":0},{"showsP":"22","winsP":"11","placesP":"22","starts":9,"earnings":134045,"racingYear":2025,"shows":2,"wins":1,"places":2}],"morningLineOdds":[],"bio":"\u003cp\u003eForged Steel has been unbreakable this year at Santa Anita, winning both of his races there in the Hollywood Gold Cup (G2) and Goodwood Stakes (G2), and not in photo finishes, either. \r\u003c/p\u003e\u003cp\u003eHe ran away to a 9 1/2-length score in the May 25 Hollywood Gold Cup and then four months later defeated stablemate Caldera by 1 1/4 lengths in the Goodwood. The latter victory earned him a paid, automatic berth in the Oct. 31 Longines Breeders' Cup Classic (G1) at Keeneland via the Breeders' Cup Challenge Series: Win and You're In. \r\u003c/p\u003e\u003cp\u003eHis Goodwood success came despite Forged Steel being outrun to the early lead, his preferred running position. So, the Vekoma colt settled in second early before taking command on the turn and asserting his superiority. He ran 1 1/8 miles in 1:48.48. \r\u003c/p\u003e\u003cp\u003eThough other stakes outings this year in the Suburban Stakes (G2) at Saratoga and the Pacific Classic (G1) at Del Mar resulted in off-the-board finishes, Forged Steel also has shown the ability to win outside of Santa Anita. Earlier victories in his career came at Oaklawn Park, Tampa Bay Downs and Gulfstream Park. \r\u003c/p\u003e\u003cp\u003eSaffie Joseph Jr. trains him for owners C2 Racing Stable, Mathis Stables and TCC Stables. \r\r\u003c/p\u003e","gradedStakesPoints":16,"regionWinnerBadges":[],"breederName":"Richard E. Wilson","uid":"blt9cf36ecc9bebf2e3","hasAutogeneratedPage":true,"url":"/redirect/horse/blt9cf36ecc9bebf2e3?ht=pre-entries","pageTitle":"Forged Steel","jockeyName":"","ownerName":"C2 Racing Stable, LLC (Clint Cornett \u0026 Mark Cornett), Mathis Stables, LLC (Bill \u0026 Terry Mathis) \u0026 TCC Stables, LLC (Michael Iavarone)","trainer":"Saffie Joseph Jr.","country":{"uid":"blt1af49e3a6a89373f","title":"USA","abbreviation":"USA","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt9de45bbdff160673/60d219911e0505677a882fa1/USAFlag.png"}},"horseName":"Forged Steel","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blte47b05bd63637864/6abbfaa3646488da43ec88ff/Contender_Photo_Forged_Steel_.jpg"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blte47b05bd63637864/6abbfaa3646488da43ec88ff/Contender_Photo_Forged_Steel_.jpg"},"cta":null,"races":[{"uid":"blte4254e02f2a052b4","ContentTypeUid":"collection_race","challengeSeriesWinner":false,"isEligible":false,"eligibleRank":null,"finishPosition":null,"classicRanking":9,"postPosition":"","scratched":false,"win":"","place":"","show":"","deadHeat":false,"silks":null}],"isChallengeSeriesWinner":true,"silks":null,"isHoC":false,"year":2026,"isHistoricalEntry":false,"relatedArticles":[],"win":"","show":"","place":""},{"sireName":"Gun Runner","damName":"Sky Dreamer","sex":"Colt","color":"Chestnut","foalingDate":"March, 15 2023 00:00:00","age":3,"pastPerformances":[{"trackName":"PARX RACING","raceName":"Pennsylvania Derby","grade":"1","raceDate":"September, 19 2026 00:00:00","purseUsa":1000000,"positionAtFinish":2},{"trackName":"MONMOUTH PARK","raceName":"NYRA Bets Haskell S.","grade":"1","raceDate":"July, 18 2026 00:00:00","purseUsa":1005000,"positionAtFinish":5},{"trackName":"CHURCHILL DOWNS","raceName":"Matt Winn S.","grade":"3","raceDate":"June, 07 2026 00:00:00","purseUsa":500000,"positionAtFinish":1},{"trackName":"CHURCHILL DOWNS","raceName":"Kentucky Derby presented by Woodford Reserve","grade":"1","raceDate":"May, 02 2026 00:00:00","purseUsa":5000000,"positionAtFinish":11},{"trackName":"KEENELAND","raceName":"Toyota Blue Grass S.","grade":"1","raceDate":"April, 04 2026 00:00:00","purseUsa":1250000,"positionAtFinish":1},{"trackName":"TAMPA BAY DOWNS","raceName":"ESMARK Tampa Bay Derby","grade":"3","raceDate":"March, 07 2026 00:00:00","purseUsa":400000,"positionAtFinish":2},{"trackName":"CHURCHILL DOWNS","raceName":"Kentucky Jockey Club S.","grade":"2","raceDate":"November, 29 2025 00:00:00","purseUsa":400000,"positionAtFinish":1},{"trackName":"KEENELAND","raceName":" ","grade":" ","raceDate":"October, 10 2025 00:00:00","purseUsa":110000,"positionAtFinish":1},{"trackName":"SARATOGA","raceName":" ","grade":" ","raceDate":"August, 30 2025 00:00:00","purseUsa":100000,"positionAtFinish":3},{"trackName":"SARATOGA","raceName":" ","grade":" ","raceDate":"July, 26 2025 00:00:00","purseUsa":100000,"positionAtFinish":5}],"record":{"previousYear":{"starts":4,"earnings":320703,"show":1,"win":2,"place":0,"showP":"25","winP":"50","placeP":"0"},"breedersCup":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"currentYear":{"starts":6,"earnings":1341255,"show":0,"win":2,"place":2,"showP":"0","winP":"33","placeP":"33"},"lifetime":{"starts":10,"earnings":1661958,"show":1,"win":4,"place":2,"showP":"10","winP":"40","placeP":"20"}},"yearlySummary":[{"showsP":"0","winsP":"33","placesP":"33","starts":6,"earnings":1341255,"racingYear":2026,"shows":0,"wins":2,"places":2},{"showsP":"25","winsP":"50","placesP":"0","starts":4,"earnings":320703,"racingYear":2025,"shows":1,"wins":2,"places":0}],"morningLineOdds":[],"bio":"\u003cp\u003eSpendthrift Farm's Further Ado has shown talent through two years of racing, winning the 2025 Kentucky Jockey Cup (G2) and the 2026 Matt Winn Stakes (G3) at Churchill Downs, and delivering other noteworthy performances. But the Gun Runner colt has performed best on the main track at Keeneland, where he broke his maiden by 20 lengths last fall and Blue Grass Stakes (G1) by 11 lengths this spring. \u0026nbsp; \r\u003c/p\u003e\u003cp\u003eHis affinity for the course makes the 3-year-old a contender for the $7 million Longines Breeders' Cup Classic (G1) Oct. 31 at Keeneland. \u0026nbsp;\r\u003c/p\u003e\u003cp\u003eThe Classic would mark just his second start at 1 1/4 miles after this year's Kentucky Derby (G1) at Churchill Downs, where he weakened to 11th after threatening on the second turn as the favorite. \r\u003c/p\u003e\u003cp\u003eMost recently, the Brad Cox trainee finished second in the Sept. 19 Pennsylvania Derby (G1) over 1 1/8 miles at Parx, rallying to finish a half-length behind The Puma after being stuck in traffic on the second turn of the race. That was his second runner-up finish to The Puma in graded company this year after a defeat in Tampa Bay Derby (G3) in the spring. \u0026nbsp;\r\u003c/p\u003e\u003cp\u003eFurther Ado begins stud duty next year at Spendthrift Farm.\u003c/p\u003e","gradedStakesPoints":22,"regionWinnerBadges":[],"breederName":"John C. Oxley","uid":"blt1db286c8a9e1335f","hasAutogeneratedPage":true,"url":"/redirect/horse/blt1db286c8a9e1335f?ht=pre-entries","pageTitle":"Further Ado","jockeyName":"","ownerName":"Spendthrift Farm, LLC (Tammy \u0026 Eric P. Gustavson)","trainer":"Brad Cox","country":{"uid":"blt1af49e3a6a89373f","title":"USA","abbreviation":"USA","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt9de45bbdff160673/60d219911e0505677a882fa1/USAFlag.png"}},"horseName":"Further Ado","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt03dee280c4a6a674/6ad68af064f7e7a932e961fe/Contender_Photo_Further_Ado_2_.jpg"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt03dee280c4a6a674/6ad68af064f7e7a932e961fe/Contender_Photo_Further_Ado_2_.jpg"},"cta":null,"races":[{"uid":"blte4254e02f2a052b4","ContentTypeUid":"collection_race","challengeSeriesWinner":false,"isEligible":false,"eligibleRank":null,"finishPosition":null,"classicRanking":8,"postPosition":"","scratched":false,"win":"","place":"","show":"","deadHeat":false,"silks":null}],"isChallengeSeriesWinner":false,"silks":null,"isHoC":false,"year":2026,"isHistoricalEntry":false,"relatedArticles":[],"win":"","show":"","place":""},{"sireName":"Curlin","damName":"Carrumba","sex":"Colt","color":"Bay","foalingDate":"February, 07 2023 00:00:00","age":3,"pastPerformances":[{"trackName":"SARATOGA","raceName":"DraftKings Travers S.","grade":"1","raceDate":"August, 29 2026 00:00:00","purseUsa":1250000,"positionAtFinish":3},{"trackName":"SARATOGA","raceName":"Belmont S. Presented by NYRA Bets","grade":"1","raceDate":"June, 06 2026 00:00:00","purseUsa":2000000,"positionAtFinish":1},{"trackName":"CHURCHILL DOWNS","raceName":"Kentucky Derby presented by Woodford Reserve","grade":"1","raceDate":"May, 02 2026 00:00:00","purseUsa":5000000,"positionAtFinish":1},{"trackName":"FAIR GROUNDS","raceName":"Twinspires.com Louisiana Derby","grade":"2","raceDate":"March, 21 2026 00:00:00","purseUsa":1000000,"positionAtFinish":3},{"trackName":"FAIR GROUNDS","raceName":"Fasig-Tipton Risen Star S.","grade":"2","raceDate":"February, 14 2026 00:00:00","purseUsa":500000,"positionAtFinish":3},{"trackName":"FAIR GROUNDS","raceName":"Lecomte S.","grade":"3","raceDate":"January, 17 2026 00:00:00","purseUsa":250000,"positionAtFinish":1},{"trackName":"FAIR GROUNDS","raceName":" ","grade":" ","raceDate":"December, 20 2025 00:00:00","purseUsa":55000,"positionAtFinish":1}],"record":{"previousYear":{"starts":1,"earnings":33000,"show":0,"win":1,"place":0,"showP":"0","winP":"100","placeP":"0"},"breedersCup":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"currentYear":{"starts":6,"earnings":4750000,"show":3,"win":3,"place":0,"showP":"50","winP":"50","placeP":"0"},"lifetime":{"starts":7,"earnings":4783000,"show":3,"win":4,"place":0,"showP":"43","winP":"57","placeP":"0"}},"yearlySummary":[{"showsP":"50","winsP":"50","placesP":"0","starts":6,"earnings":4750000,"racingYear":2026,"shows":3,"wins":3,"places":0},{"showsP":"0","winsP":"100","placesP":"0","starts":1,"earnings":33000,"racingYear":2025,"shows":0,"wins":1,"places":0}],"morningLineOdds":[],"bio":"\u003cp\u003eVictories in the Kentucky Derby (G1) and Belmont Stakes (G1)\u0026nbsp;established\u0026nbsp;Golden Tempo as one of the nation's premier 3-year-olds. This fall, the Oct. 31 Longines Breeders' Cup Classic (G1) at Keeneland could\u0026nbsp;determine\u0026nbsp;where he stands against older competition.\u0026nbsp;\u003c/p\u003e\u003cp\u003eBy two-time Horse of the Year Curlin, Golden Tempo already has proven his affinity for the Classic's 1 1/4-mile distance, having captured both the Derby and Belmont over that trip.\u0026nbsp;\u003c/p\u003e\u003cp\u003eSwift early splits in the Derby played his late-running strength, but he proved in the Belmont he is not pace dependent. Despite moderate fractions that\u0026nbsp;seemingly favored\u0026nbsp;frontrunners, Golden Tempo still unleashed his trademark late charge under Jose Ortiz to prevail. The victory sparked an emotional celebration as trainer Cherie\u0026nbsp;DeVaux, already the first woman to win the Kentucky Derby, added another triumph in the final leg of the Triple Crown.\u0026nbsp;\u003c/p\u003e\u003cp\u003eGolden Tempo also captured the Lecomte Stakes (G3) this winter before finishing third in both the Risen Star Stakes (G2) and Louisiana Derby (G2) ahead of the Derby for her owners and breeders, Phipps Stable and St. Elias Stable.\u0026nbsp;\u003c/p\u003e\u003cp\u003eWith a post-Belmont illness behind him and back on the work tab at Keeneland July 17 before heading to Saratoga, Golden Tempo appears poised to make an impact over the second half of the 2026 season.\u0026nbsp;\u003c/p\u003e","gradedStakesPoints":32,"regionWinnerBadges":[],"breederName":"Phipps Stable \u0026 St. Elias Stables, LLC","uid":"bltec6dadd8c37e5a6f","hasAutogeneratedPage":true,"url":"/redirect/horse/bltec6dadd8c37e5a6f?ht=pre-entries","pageTitle":"Golden Tempo","jockeyName":"","ownerName":"Phipps Stable (Daisy Phipps Pulito) and St. Elias Stables (Vincent Viola)","trainer":"Cherie DeVaux","country":{"uid":"blt1af49e3a6a89373f","title":"USA","abbreviation":"USA","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt9de45bbdff160673/60d219911e0505677a882fa1/USAFlag.png"}},"horseName":"Golden Tempo","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt5c5d49feeeae7731/6a73660e89eb5c210bab2707/Contender_Photo_Golden_Tempo.jpg"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt5c5d49feeeae7731/6a73660e89eb5c210bab2707/Contender_Photo_Golden_Tempo.jpg"},"cta":null,"races":[{"uid":"blte4254e02f2a052b4","ContentTypeUid":"collection_race","challengeSeriesWinner":false,"isEligible":false,"eligibleRank":null,"finishPosition":null,"classicRanking":5,"postPosition":"","scratched":false,"win":"","place":"","show":"","deadHeat":false,"silks":null}],"isChallengeSeriesWinner":false,"silks":null,"isHoC":false,"year":2026,"isHistoricalEntry":false,"relatedArticles":[],"win":"","show":"","place":""},{"sireName":"Nyquist","damName":"Tyburn Brook","sex":"Horse","color":"Dark Bay or Brown","foalingDate":"May, 09 2021 00:00:00","age":5,"pastPerformances":[{"trackName":"DEL MAR","raceName":"Pacific Classic S.","grade":"1","raceDate":"August, 22 2026 00:00:00","purseUsa":1000000,"positionAtFinish":1},{"trackName":"MONMOUTH PARK","raceName":"Monmouth Cup S.","grade":"3","raceDate":"July, 18 2026 00:00:00","purseUsa":350000,"positionAtFinish":1},{"trackName":"SARATOGA","raceName":"Hill 'N' Dale Metropolitan H.","grade":"1","raceDate":"June, 06 2026 00:00:00","purseUsa":1000000,"positionAtFinish":2},{"trackName":"CHURCHILL DOWNS","raceName":"Churchill Downs S. presented by Ford","grade":"1","raceDate":"May, 02 2026 00:00:00","purseUsa":1000000,"positionAtFinish":6},{"trackName":"GULFSTREAM PARK","raceName":"Gulfstream Park Mile S. presented by Fierceness","grade":"3","raceDate":"February, 28 2026 00:00:00","purseUsa":225000,"positionAtFinish":1},{"trackName":"GULFSTREAM PARK","raceName":"Fred W. Hooper S. presented by Visit Lauderdale","grade":"3","raceDate":"January, 24 2026 00:00:00","purseUsa":175000,"positionAtFinish":1},{"trackName":"GULFSTREAM PARK","raceName":"Mr. Prospector S.","grade":"3","raceDate":"December, 27 2025 00:00:00","purseUsa":150000,"positionAtFinish":1},{"trackName":"AQUEDUCT","raceName":" ","grade":" ","raceDate":"November, 22 2025 00:00:00","purseUsa":90000,"positionAtFinish":1},{"trackName":"GULFSTREAM PARK","raceName":" ","grade":" ","raceDate":"February, 15 2025 00:00:00","purseUsa":97000,"positionAtFinish":2},{"trackName":"KEENELAND","raceName":"Perryville S.","grade":"3","raceDate":"October, 19 2024 00:00:00","purseUsa":300000,"positionAtFinish":3},{"trackName":"GULFSTREAM PARK","raceName":" ","grade":" ","raceDate":"March, 28 2024 00:00:00","purseUsa":91000,"positionAtFinish":1},{"trackName":"CHURCHILL DOWNS","raceName":" ","grade":" ","raceDate":"November, 04 2023 00:00:00","purseUsa":120000,"positionAtFinish":1}],"record":{"previousYear":{"starts":3,"earnings":155970,"show":0,"win":2,"place":1,"showP":"0","winP":"67","placeP":"33"},"breedersCup":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"currentYear":{"starts":6,"earnings":1233610,"show":0,"win":4,"place":1,"showP":"0","winP":"67","placeP":"17"},"lifetime":{"starts":12,"earnings":1523155,"show":1,"win":8,"place":2,"showP":"8","winP":"67","placeP":"17"}},"yearlySummary":[{"showsP":"0","winsP":"67","placesP":"17","starts":6,"earnings":1233610,"racingYear":2026,"shows":0,"wins":4,"places":1},{"showsP":"0","winsP":"67","placesP":"33","starts":3,"earnings":155970,"racingYear":2025,"shows":0,"wins":2,"places":1}],"morningLineOdds":[],"bio":"\u003cp\u003eBy recording three consecutive stakes victories in middle-distance races this winter at Gulfstream Park, Godolphin’s Knightsbridge looked like a candidate for a Breeders’ Cup race this fall at Keeneland – but seemingly for the $1 million Breeders’ Cup Dirt Mile (G1) than the longer 1 1/4-mile Longines Breeders’ Cup Classic (G1). \r\u003c/p\u003e\u003cp\u003eBut an eye-opening two-turn performance in the July 18 Monmouth Cup (G3) at Monmouth Park – his first race at 1 1/8 miles – has opened additional opportunities for the 5-year-old Nyquist horse. He was brilliant in the Monmouth Cup, spurting to the lead and increasing his advantage at every call on his way to a 10 ¼-length triumph. His time was sparkling, too, clocked in 1:47.51 after initial fractions of :23.38, :46.57, and 1:10.63. \r\u003c/p\u003e\u003cp\u003e\"He passed the two-turn test today, indeed,\" Godolphin USA director of bloodstock Michael Banahan said. \u0026nbsp; \r\u003c/p\u003e\u003cp\u003eHe passed an even bigger test in his next start, the 1 ¼-mile Pacific Classic (G1) at Del Mar on Aug. 22. Breaking from post 11, he dueled 2024 Big Ass Fans Breeders’ Cup Dirt Mile (G1) winner Full Serrano (ARG) into submission before drawing off for a 6 1/4-length victory. \r\u003c/p\u003e\u003cp\u003eGodolphin and Hall of Fame trainer Bill Mott also have Sovereignty aimed at the Classic. \r\u003c/p\u003e\u003cp\u003eA homebred out of the Bernardini mare Tyburn Brook, Knightsbridge is a half-brother to another Godolphin homebred in Grade 1 winner and freshman sire Speaker's Corner.\u0026nbsp;\u003c/p\u003e","gradedStakesPoints":28,"regionWinnerBadges":[],"breederName":"Godolphin","uid":"blt8348ffd7e66b2061","hasAutogeneratedPage":true,"url":"/redirect/horse/blt8348ffd7e66b2061?ht=pre-entries","pageTitle":"Knightsbridge","jockeyName":"","ownerName":"Godolphin, LLC (Mohammed al Maktoum, et al.)","trainer":"William I. Mott","country":{"uid":"blt1af49e3a6a89373f","title":"USA","abbreviation":"USA","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt9de45bbdff160673/60d219911e0505677a882fa1/USAFlag.png"}},"horseName":"Knightsbridge","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt9bdb69658bb54c2e/6a7b3c9dbe337891cddad9ad/Contender_Photo_Knightsbridge.jpg"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt9bdb69658bb54c2e/6a7b3c9dbe337891cddad9ad/Contender_Photo_Knightsbridge.jpg"},"cta":null,"races":[{"uid":"blte4254e02f2a052b4","ContentTypeUid":"collection_race","challengeSeriesWinner":false,"isEligible":false,"eligibleRank":null,"finishPosition":null,"classicRanking":3,"postPosition":"","scratched":false,"win":"","place":"","show":"","deadHeat":false,"silks":null}],"isChallengeSeriesWinner":true,"silks":null,"isHoC":false,"year":2026,"isHistoricalEntry":false,"relatedArticles":[],"win":"","show":"","place":""},{"sireName":"Not This Time","damName":"Rockadelic","sex":"Colt","color":"Bay","foalingDate":"March, 12 2022 00:00:00","age":4,"pastPerformances":[{"trackName":"SARATOGA","raceName":"Whitney S.","grade":"1","raceDate":"August, 08 2026 00:00:00","purseUsa":1000000,"positionAtFinish":6},{"trackName":"CHURCHILL DOWNS","raceName":"Stephen Foster S.","grade":"1","raceDate":"June, 27 2026 00:00:00","purseUsa":2000000,"positionAtFinish":1},{"trackName":"MEYDAN RACECOURSE","raceName":"Dubai World Cup Sponsored By Emirates Airline","grade":"1","raceDate":"March, 28 2026 00:00:00","purseUsa":12000000,"positionAtFinish":1},{"trackName":"OAKLAWN PARK","raceName":"Razorback H.","grade":"3","raceDate":"February, 28 2026 00:00:00","purseUsa":500000,"positionAtFinish":1},{"trackName":"CHURCHILL DOWNS","raceName":"Clark S. presented by Norton Healthcare","grade":"2","raceDate":"November, 28 2025 00:00:00","purseUsa":600000,"positionAtFinish":1},{"trackName":"PARX RACING","raceName":"Pennsylvania Derby","grade":"1","raceDate":"September, 20 2025 00:00:00","purseUsa":1000000,"positionAtFinish":2},{"trackName":"SARATOGA","raceName":"DraftKings Travers S.","grade":"1","raceDate":"August, 23 2025 00:00:00","purseUsa":1250000,"positionAtFinish":3},{"trackName":"PRAIRIE MEADOWS","raceName":"Iowa Derby","grade":" ","raceDate":"July, 05 2025 00:00:00","purseUsa":250000,"positionAtFinish":1},{"trackName":"FAIR GROUNDS","raceName":"Fasig-Tipton Risen Star S.","grade":"2","raceDate":"February, 15 2025 00:00:00","purseUsa":500000,"positionAtFinish":1},{"trackName":"FAIR GROUNDS","raceName":"Lecomte S.","grade":"3","raceDate":"January, 18 2025 00:00:00","purseUsa":250000,"positionAtFinish":6},{"trackName":"FAIR GROUNDS","raceName":"Gun Runner S.","grade":" ","raceDate":"December, 21 2024 00:00:00","purseUsa":100000,"positionAtFinish":2},{"trackName":"CHURCHILL DOWNS","raceName":" ","grade":" ","raceDate":"November, 17 2024 00:00:00","purseUsa":127000,"positionAtFinish":1},{"trackName":"CHURCHILL DOWNS","raceName":"Iroquois S.","grade":"3","raceDate":"September, 14 2024 00:00:00","purseUsa":300000,"positionAtFinish":7},{"trackName":"ELLIS PARK","raceName":" ","grade":" ","raceDate":"July, 20 2024 00:00:00","purseUsa":71000,"positionAtFinish":1},{"trackName":"CHURCHILL DOWNS","raceName":" ","grade":" ","raceDate":"June, 06 2024 00:00:00","purseUsa":120000,"positionAtFinish":4}],"record":{"previousYear":{"starts":6,"earnings":1148200,"show":1,"win":3,"place":1,"showP":"17","winP":"50","placeP":"17"},"breedersCup":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"currentYear":{"starts":4,"earnings":8334500,"show":0,"win":3,"place":0,"showP":"0","winP":"75","placeP":"0"},"lifetime":{"starts":15,"earnings":9626365,"show":1,"win":8,"place":2,"showP":"7","winP":"53","placeP":"13"}},"yearlySummary":[{"showsP":"0","winsP":"75","placesP":"0","starts":4,"earnings":8334500,"racingYear":2026,"shows":0,"wins":3,"places":0},{"showsP":"17","winsP":"50","placesP":"17","starts":6,"earnings":1148200,"racingYear":2025,"shows":1,"wins":3,"places":1}],"morningLineOdds":[],"bio":"\u003cp\u003eNearly a decade after Gun Runner parlayed a Stephen Foster Stakes (G1) victory into a Longines Breeders’ Cup Classic (G1) triumph and the honor of North America’s Horse of the Year in 2017, Magnitude seeks to forge a similar 4-year-old campaign for Hall of Fame trainer Steve Asmussen and owner Winchell Thoroughbreds. The 4-year-old captured the Stephen Foster at Churchill Downs just as Gun Runner did, and he even accomplished something Gun Runner did not by capturing the $12 million Dubai World Cup (G1) during the winter in the Middle East. Gun Runner was second in the 2017 renewal.\u0026nbsp;\u003c/p\u003e\u003cp\u003eIn his Dubai victory, Magnitude upset reigning Breeders' Cup Classic (G1) winner Forever Young (JPN) in late March after a victory a month earlier in the Razorback Handicap (G3) at Oaklawn Park in the kickoff to his 2026 campaign. Magnitude then returned to North America to deliver an emphatic score in the June 27 Stephen Foster Stakes (G1) at Churchill Downs, a race that drew top-level performers such as Baeza, Sovereignty and White Abarrio. That victory earned him a paid, automatic berth into the Classic via the Breeders’ Cup Challenge Series: Win and You’re In.\u0026nbsp;\u003c/p\u003e\u003cp\u003eMagnitude\u0026nbsp;had his winning streak snapped in the 1 1/8-mike Whitney (G1) at Saratoga on Aug. 8. Outfooted for the early lead by Nitrogen,\u0026nbsp;Magnitude\u0026nbsp;pressed the pace rather than engaging in a speed duel before beginning to retreat and finishing sixth in a field of seven beaten 15 1/4 lengths by the victorious Sovereignty.\u003c/p\u003e","gradedStakesPoints":14,"regionWinnerBadges":[],"breederName":"Ron Stolich","uid":"blt4a9fcb781b5ecbe4","hasAutogeneratedPage":true,"url":"/redirect/horse/blt4a9fcb781b5ecbe4?ht=pre-entries","pageTitle":"Magnitude","jockeyName":"","ownerName":"Winchell Thoroughbreds LLC (Ron Winchell)","trainer":"Steven M. Asmussen","country":{"uid":"blt1af49e3a6a89373f","title":"USA","abbreviation":"USA","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt9de45bbdff160673/60d219911e0505677a882fa1/USAFlag.png"}},"horseName":"Magnitude","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt63d85e15e72e5ec0/6a7367948bcd807fb52607a9/Contender_Photo_Magnitude_.jpg"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt63d85e15e72e5ec0/6a7367948bcd807fb52607a9/Contender_Photo_Magnitude_.jpg"},"cta":null,"races":[{"uid":"blte4254e02f2a052b4","ContentTypeUid":"collection_race","challengeSeriesWinner":true,"isEligible":false,"eligibleRank":null,"finishPosition":null,"classicRanking":4,"postPosition":"","scratched":false,"win":"","place":"","show":"","deadHeat":false,"silks":null}],"isChallengeSeriesWinner":true,"silks":null,"isHoC":false,"year":2026,"isHistoricalEntry":false,"relatedArticles":[],"win":"","show":"","place":""},{"sireName":"Liam's Map","damName":"Atomic Blonde","sex":"Colt","color":"Gray or Roan","foalingDate":"February, 17 2023 00:00:00","age":3,"pastPerformances":[{"trackName":"SARATOGA","raceName":"DraftKings Travers S.","grade":"1","raceDate":"August, 29 2026 00:00:00","purseUsa":1250000,"positionAtFinish":2},{"trackName":"MONMOUTH PARK","raceName":"NYRA Bets Haskell S.","grade":"1","raceDate":"July, 18 2026 00:00:00","purseUsa":1005000,"positionAtFinish":2},{"trackName":"LAUREL PARK","raceName":"Preakness S.","grade":"1","raceDate":"May, 16 2026 00:00:00","purseUsa":2000000,"positionAtFinish":1},{"trackName":"AQUEDUCT","raceName":"Wood Memorial S. Presented by Resorts World Casino","grade":"2","raceDate":"April, 04 2026 00:00:00","purseUsa":750000,"positionAtFinish":5},{"trackName":"GULFSTREAM PARK","raceName":"Coolmore Fountain of Youth S.","grade":"2","raceDate":"February, 28 2026 00:00:00","purseUsa":425000,"positionAtFinish":5},{"trackName":"BELMONT AT THE BIG A","raceName":"Champagne S.","grade":"1","raceDate":"October, 04 2025 00:00:00","purseUsa":500000,"positionAtFinish":1},{"trackName":"SARATOGA","raceName":" ","grade":" ","raceDate":"August, 08 2025 00:00:00","purseUsa":80000,"positionAtFinish":1}],"record":{"previousYear":{"starts":2,"earnings":319000,"show":0,"win":2,"place":0,"showP":"0","winP":"100","placeP":"0"},"breedersCup":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"currentYear":{"starts":5,"earnings":1691520,"show":0,"win":1,"place":2,"showP":"0","winP":"20","placeP":"40"},"lifetime":{"starts":7,"earnings":2010520,"show":0,"win":3,"place":2,"showP":"0","winP":"43","placeP":"29"}},"yearlySummary":[{"showsP":"0","winsP":"20","placesP":"40","starts":5,"earnings":1691520,"racingYear":2026,"shows":0,"wins":1,"places":2},{"showsP":"0","winsP":"100","placesP":"0","starts":2,"earnings":319000,"racingYear":2025,"shows":0,"wins":2,"places":0}],"morningLineOdds":[],"bio":"\u003cp\u003eNapoleon Solo flaunted his speed and class as a juvenile in 2025, winning both of his starts, including the 1-mile Champagne Stakes (G1) in 1:34.57. \r\u003c/p\u003e\u003cp\u003eNow as a 3-year-old, he has continued to succeed in longer, two-turn routes, winning one of America's spring classics, the May 16 Preakness Stakes (G1). That defining performance in the 1 3/16-mile second leg of the Triple Crown came after a couple of fifth-place finishes to begin the year. \r\u003c/p\u003e\u003cp\u003eSold thereafter by owner Al Gold to Espoir USA but kept in the Chad Summers stable, Napoleon Solo was given a short freshening from that race, returning in the Haskell Stakes (G1) at Monmouth Park and running second, beaten just a half-length by Baby Vino after setting the pace in the 1 1/8-mile race. He then returned in the Travers (G1) at Saratoga, racing 1 ¼ miles for the first time, and again showed his staying power with a gritty runner-up finish to Leading Change. \r\u003c/p\u003e\u003cp\u003eA flashy gray and/or roan son of Liam's Map out of the stakes-winning Scat Daddy mare Atomic Blonde, Napoleon Solo is one of the country's leading 3-year-olds.\u0026nbsp;\u003c/p\u003e","gradedStakesPoints":22,"regionWinnerBadges":[],"breederName":"John D. Gunther \u0026 Eurowest Bloodstock","uid":"blt626b6b8da6a994f5","hasAutogeneratedPage":true,"url":"/redirect/horse/blt626b6b8da6a994f5?ht=pre-entries","pageTitle":"Napoleon Solo","jockeyName":"","ownerName":"Espoir USA, Inc. (Rifang Zhang)","trainer":"Chad Summers","country":{"uid":"blt1af49e3a6a89373f","title":"USA","abbreviation":"USA","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt9de45bbdff160673/60d219911e0505677a882fa1/USAFlag.png"}},"horseName":"Napoleon Solo","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blte912621050e17c57/68e7e602f0b3bd7984593826/Contender_Photo_Napoleon_Solo.jpg"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blte912621050e17c57/68e7e602f0b3bd7984593826/Contender_Photo_Napoleon_Solo.jpg"},"cta":null,"races":[{"uid":"blte4254e02f2a052b4","ContentTypeUid":"collection_race","challengeSeriesWinner":false,"isEligible":false,"eligibleRank":null,"finishPosition":null,"classicRanking":6,"postPosition":"","scratched":false,"win":"","place":"","show":"","deadHeat":false,"silks":null}],"isChallengeSeriesWinner":false,"silks":null,"isHoC":false,"year":2026,"isHistoricalEntry":false,"relatedArticles":[],"win":"","show":"","place":""},{"sireName":"Into Mischief","damName":"Crowned","sex":"Colt","color":"Bay","foalingDate":"February, 22 2022 00:00:00","age":4,"pastPerformances":[{"trackName":"SARATOGA","raceName":"Whitney S.","grade":"1","raceDate":"August, 08 2026 00:00:00","purseUsa":1000000,"positionAtFinish":1},{"trackName":"CHURCHILL DOWNS","raceName":"Stephen Foster S.","grade":"1","raceDate":"June, 27 2026 00:00:00","purseUsa":2000000,"positionAtFinish":3},{"trackName":"OAKLAWN PARK","raceName":"Oaklawn H.","grade":"2","raceDate":"April, 18 2026 00:00:00","purseUsa":1250000,"positionAtFinish":2},{"trackName":"SARATOGA","raceName":"DraftKings Travers S.","grade":"1","raceDate":"August, 23 2025 00:00:00","purseUsa":1250000,"positionAtFinish":1},{"trackName":"SARATOGA","raceName":"Jim Dandy S. Presented by Mohegan Sun","grade":"2","raceDate":"July, 26 2025 00:00:00","purseUsa":500000,"positionAtFinish":1},{"trackName":"SARATOGA","raceName":"Belmont S. Presented by NYRA Bets","grade":"1","raceDate":"June, 07 2025 00:00:00","purseUsa":2000000,"positionAtFinish":1},{"trackName":"CHURCHILL DOWNS","raceName":"Kentucky Derby presented by Woodford Reserve","grade":"1","raceDate":"May, 03 2025 00:00:00","purseUsa":5000000,"positionAtFinish":1},{"trackName":"GULFSTREAM PARK","raceName":"Curlin Florida Derby presented by Hill 'n' Dale Farms at Xalapa","grade":"1","raceDate":"March, 29 2025 00:00:00","purseUsa":1000000,"positionAtFinish":2},{"trackName":"GULFSTREAM PARK","raceName":"Coolmore Fountain of Youth S.","grade":"2","raceDate":"March, 01 2025 00:00:00","purseUsa":415000,"positionAtFinish":1},{"trackName":"CHURCHILL DOWNS","raceName":"Street Sense S.","grade":"3","raceDate":"October, 27 2024 00:00:00","purseUsa":200000,"positionAtFinish":1},{"trackName":"BELMONT AT THE BIG A","raceName":" ","grade":" ","raceDate":"September, 27 2024 00:00:00","purseUsa":90000,"positionAtFinish":2},{"trackName":"SARATOGA","raceName":" ","grade":" ","raceDate":"August, 24 2024 00:00:00","purseUsa":100000,"positionAtFinish":4}],"record":{"previousYear":{"starts":6,"earnings":5692020,"show":0,"win":5,"place":1,"showP":"0","winP":"83","placeP":"17"},"breedersCup":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"currentYear":{"starts":3,"earnings":1041250,"show":1,"win":1,"place":1,"showP":"33","winP":"33","placeP":"33"},"lifetime":{"starts":12,"earnings":6876550,"show":1,"win":7,"place":3,"showP":"8","winP":"58","placeP":"25"}},"yearlySummary":[{"showsP":"33","winsP":"33","placesP":"33","starts":3,"earnings":1041250,"racingYear":2026,"shows":1,"wins":1,"places":1},{"showsP":"0","winsP":"83","placesP":"17","starts":6,"earnings":5692020,"racingYear":2025,"shows":0,"wins":5,"places":1}],"morningLineOdds":[],"bio":"\u003cp\u003eA season after illness knocked Sovereignty out of last fall's Longines Breeders' Cup Classic (G1) at Del Mar, the reigning Horse of the Year and champion 3-year-old male of 2025 aims to try again when the $7 million race is staged Oct. 31 at Keeneland.\u0026nbsp;\u003c/p\u003e\u003cp\u003eThe Godolphin homebred 4-year-old son of Into Mischief stamped himself as the leader of his generation in 2025, capturing the Kentucky Derby (G1), Belmont Stakes (G1)\u0026nbsp;and Travers Stakes (G1) during an unforgettable campaign. His 10-length Travers victory left little doubt of his superiority over his 3-year-old peers in 2025.\u0026nbsp;\u003c/p\u003e\u003cp\u003eAway from racing eight months after the Travers, The Bill Mott trainee returned as a 4-year-old in the Oaklawn Handicap (G2) this spring at Oaklawn Park and ran well to be second to White\u0026nbsp;Abarrio, the 2023 Breeders' Cup Classic winner. Then he returned June 27 in the $2 million Stephen Foster Stakes (G1) at Churchill Downs, finishing third behind Magnitude and Baeza after flattening out following a menacing bid on the second turn.\u0026nbsp;\u003c/p\u003e\u003cp\u003eIn his next start, in the 1 1/8-mile Whitney (G1) at Saratoga on Aug. 8, Sovereignty returned to top form by surging past Nitrogen at\u0026nbsp;midstretch\u0026nbsp;and drawing off for a 4 3/4-length\u0026nbsp; victory.\u0026nbsp;\u003c/p\u003e\u003cp\u003eThe 1 1/4-mile distance of the Classic suits Sovereignty's stamina and running style. His signature wins as a 3-year-old in the\u0026nbsp;Derby,\u0026nbsp;Belmont Stakes and Travers Stakes all came over that trip.\u003c/p\u003e","gradedStakesPoints":18,"regionWinnerBadges":[],"breederName":"Godolphin","uid":"blt1fe6974b805403e8","hasAutogeneratedPage":true,"url":"/redirect/horse/blt1fe6974b805403e8?ht=pre-entries","pageTitle":"Sovereignty","jockeyName":"","ownerName":"Godolphin, LLC (Mohammed al Maktoum, et al.)","trainer":"William I. Mott","country":{"uid":"blt1af49e3a6a89373f","title":"USA","abbreviation":"USA","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt9de45bbdff160673/60d219911e0505677a882fa1/USAFlag.png"}},"horseName":"Sovereignty","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt57279f6fc112ed86/68921da0a387228d956fabc2/Contender_Photo_Sovereignty_Updated_.jpg","alt":""},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt57279f6fc112ed86/68921da0a387228d956fabc2/Contender_Photo_Sovereignty_Updated_.jpg","alt":""},"cta":null,"races":[{"uid":"blte4254e02f2a052b4","ContentTypeUid":"collection_race","challengeSeriesWinner":true,"isEligible":false,"eligibleRank":null,"finishPosition":null,"replayVideo":{"uid":"blt73bfc4660c90f3f7","title":"2026 Whitney - Sovereignty","videoId":"wGfQPWc6","length":"2:05","thumbnails":{"default":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt17cb79627ef9817b/6a77d368cb6fc53bc6f4298b/wGfQPWc6.jpg"},"largeCard":null,"smallVerticalCard":null,"horizontalCard":null,"mobileHorizontalCard":null},"preRollAd":[],"publishDate":"2026-08-09T01:05:22.000Z","ogTags":[],"cardType":"Video"},"classicRanking":2,"postPosition":"","scratched":false,"win":"","place":"","show":"","deadHeat":false,"silks":null}],"isChallengeSeriesWinner":true,"silks":null,"isHoC":false,"year":2026,"isHistoricalEntry":true,"relatedArticles":[],"win":"","show":"","place":""},{"sireName":"Copano Rickey (JPN)","damName":"T O Rachel (JPN)","sex":"Horse","color":"Bay","foalingDate":"May, 20 2021 00:00:00","age":5,"pastPerformances":[{"trackName":"SAPPORO","raceName":"Elm S.","grade":"3","raceDate":"August, 08 2026 00:00:00","purseUsa":456274,"positionAtFinish":3},{"trackName":"TOKYO","raceName":"Akhalteke S.","grade":" ","raceDate":"May, 30 2026 00:00:00","purseUsa":262446,"positionAtFinish":1},{"trackName":"TOKYO","raceName":"Oasis S.","grade":" ","raceDate":"April, 26 2026 00:00:00","purseUsa":286126,"positionAtFinish":2},{"trackName":"KYOTO","raceName":"Procyon S.","grade":"2","raceDate":"January, 25 2026 00:00:00","purseUsa":672197,"positionAtFinish":10},{"trackName":"NAKAYAMA","raceName":"Shiwasu S.","grade":" ","raceDate":"December, 14 2025 00:00:00","purseUsa":292676,"positionAtFinish":6},{"trackName":"HANSHIN","raceName":"Sirius S.","grade":"3","raceDate":"September, 27 2025 00:00:00","purseUsa":481571,"positionAtFinish":7},{"trackName":"CHUKYO","raceName":"Nagoyajo S.","grade":" ","raceDate":"August, 30 2025 00:00:00","purseUsa":284261,"positionAtFinish":1},{"trackName":"CHUKYO","raceName":"Seto S.","grade":" ","raceDate":"January, 25 2025 00:00:00","purseUsa":224633,"positionAtFinish":1},{"trackName":"NAKAYAMA","raceName":"Shofuku S.","grade":" ","raceDate":"January, 05 2025 00:00:00","purseUsa":222818,"positionAtFinish":5},{"trackName":"CHURCHILL DOWNS","raceName":"Kentucky Derby presented by Woodford Reserve","grade":"1","raceDate":"May, 04 2024 00:00:00","purseUsa":5000000,"positionAtFinish":5},{"trackName":"NAKAYAMA","raceName":"Fukuryu S.","grade":" ","raceDate":"March, 23 2024 00:00:00","purseUsa":225826,"positionAtFinish":1},{"trackName":"KYOTO","raceName":" ","grade":" ","raceDate":"January, 06 2024 00:00:00","purseUsa":81928,"positionAtFinish":1}],"record":{"previousYear":{"starts":5,"earnings":283533,"show":0,"win":2,"place":0,"showP":"0","winP":"40","placeP":"0"},"breedersCup":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"currentYear":{"starts":4,"earnings":261755,"show":1,"win":1,"place":1,"showP":"25","winP":"25","placeP":"25"},"lifetime":{"starts":12,"earnings":858627,"show":1,"win":5,"place":1,"showP":"8","winP":"42","placeP":"8"}},"yearlySummary":[{"showsP":"25","winsP":"25","placesP":"25","starts":4,"earnings":261755,"racingYear":2026,"shows":1,"wins":1,"places":1},{"showsP":"0","winsP":"40","placesP":"0","starts":5,"earnings":283533,"racingYear":2025,"shows":0,"wins":2,"places":0}],"morningLineOdds":[],"bio":"\u003cp\u003eT O Password will be making his second start in the U.S. after making the trip in 2024 for the Kentucky Derby (G1). His owner accepted the Derby invitation after T O Password banked qualifying points in his native Japan’s Fukuryu Stakes six weeks prior. \u0026nbsp;\r\u003c/p\u003e\u003cp\u003eAs a 48-1 longshot, T O Password rallied from far back in the 20-horse Kentucky Derby field and rallied through the stretch to be beaten just 6 ½ lengths. He then returned to his homeland and went to the sidelines until making his return to the races in early 2025. Racing sparingly, he won three more stakes and was third in the Elm Stakes (G3) on Aug. 8 in his most recent effort. \r\u003c/p\u003e\u003cp\u003eThe first part of his name reflects owner Tomoya Ozasa’s initials. Per Japan Racing Association rules, owners can register a name or sound that is used on all of their horses. \r\u003c/p\u003e\u003cp\u003eT O Password joins a growing list of Japan-based horses that have made their presence felt in the marquee races in the U.S. The trend is inspired in part by the overwhelming success of 2025 Champion Older Dirt Male and Longines Breeders’ Cup Classic (G1) winner Forever Young (JPN), who was third in the 2024 Kentucky Derby (G1). Two other racers from Japan have won Breeders’ Cup World Championship races-– Marche Lorraine (JPN) (Longines Distaff-G1) and Loves Only You (JPN) (Maker’s Mark Filly and Mare Turf-G1) in 2021.\u003c/p\u003e","gradedStakesPoints":0,"regionWinnerBadges":[],"breederName":"Yanagawa Bokujo","uid":"blt545095ee1cb4c2e4","hasAutogeneratedPage":true,"url":"/redirect/horse/blt545095ee1cb4c2e4?ht=pre-entries","pageTitle":"T O Password (JPN)","jockeyName":"","ownerName":"Tomoya Ozasa","trainer":"Daisuke Takayanagi","country":{"uid":"bltddddd2aba803f27e","title":"Japan","abbreviation":"JPN","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blta6f52e264bde8855/61aa4c7d55cf14733fc5bc35/japan.png","alt":""}},"horseName":"T O Password","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt558db5b956007989/6aabebdfd1556f7ef67283de/Contender_Photo_T_O_Password.jpg"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt558db5b956007989/6aabebdfd1556f7ef67283de/Contender_Photo_T_O_Password.jpg"},"cta":null,"races":[{"uid":"blte4254e02f2a052b4","ContentTypeUid":"collection_race","challengeSeriesWinner":false,"isEligible":false,"eligibleRank":null,"finishPosition":null,"classicRanking":null,"postPosition":"","scratched":false,"win":"","place":"","show":"","deadHeat":false,"silks":null}],"isChallengeSeriesWinner":false,"silks":null,"isHoC":false,"year":2026,"isHistoricalEntry":false,"relatedArticles":[],"win":"","show":"","place":""},{"sireName":"Essential Quality","damName":"Eve of War","sex":"Colt","color":"Chestnut","foalingDate":"February, 07 2023 00:00:00","age":3,"pastPerformances":[{"trackName":"PARX RACING","raceName":"Pennsylvania Derby","grade":"1","raceDate":"September, 19 2026 00:00:00","purseUsa":1000000,"positionAtFinish":1},{"trackName":"SARATOGA","raceName":"DraftKings Travers S.","grade":"1","raceDate":"August, 29 2026 00:00:00","purseUsa":1250000,"positionAtFinish":4},{"trackName":"MONMOUTH PARK","raceName":"NYRA Bets Haskell S.","grade":"1","raceDate":"July, 18 2026 00:00:00","purseUsa":1005000,"positionAtFinish":4},{"trackName":"GULFSTREAM PARK","raceName":"Curlin Florida Derby presented by Hill 'n' Dale Farms at Xalapa","grade":"1","raceDate":"March, 28 2026 00:00:00","purseUsa":1000000,"positionAtFinish":2},{"trackName":"TAMPA BAY DOWNS","raceName":"ESMARK Tampa Bay Derby","grade":"3","raceDate":"March, 07 2026 00:00:00","purseUsa":400000,"positionAtFinish":1},{"trackName":"TAMPA BAY DOWNS","raceName":"Sam F. Davis S.","grade":" ","raceDate":"February, 07 2026 00:00:00","purseUsa":250000,"positionAtFinish":3},{"trackName":"GULFSTREAM PARK","raceName":" ","grade":" ","raceDate":"January, 10 2026 00:00:00","purseUsa":84000,"positionAtFinish":2}],"record":{"previousYear":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"breedersCup":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"currentYear":{"starts":7,"earnings":1122280,"show":1,"win":2,"place":2,"showP":"14","winP":"29","placeP":"29"},"lifetime":{"starts":7,"earnings":1122280,"show":1,"win":2,"place":2,"showP":"14","winP":"29","placeP":"29"}},"yearlySummary":[{"showsP":"14","winsP":"29","placesP":"29","starts":7,"earnings":1122280,"racingYear":2026,"shows":1,"wins":2,"places":2},{"showsP":"NA","winsP":"NA","placesP":"NA","starts":0,"earnings":0,"racingYear":2025,"shows":0,"wins":0,"places":0}],"morningLineOdds":[],"bio":"\u003cp\u003eEquipped with blinkers for the first time in the Sept. 19 Pennsylvania Derby (G1) at Parx, The Puma ran to the potential expected from him by notching his first Grade 1 victory. \r\u003c/p\u003e\u003cp\u003eSweeping past rivals on the second turn of the 1 1/8-mile race with a decisive bid under Hall of Fame jockey Javier Castellano, he got the jump on favored Further Ado and outlasted that rival's sustained stretch rally to prevail by a half-length. The strength of that race propelled him into Longines Breeders' Cup Classic (G1) consideration. \r\u003c/p\u003e\u003cp\u003eThe victory was the second graded stakes win of 2026 for The Puma, who this spring captured the Tampa Bay Derby (G3) in just his third start. The latter race preceded a near- miss second in the Florida Derby (G1) at Gulfstream Park. \r\u003c/p\u003e\u003cp\u003eHe returned to racing action this summer, finishing fourth in the Haskell Stakes (G1) and Travers Stakes (G1) ahead of the Pennsylvania Derby. \r\u003c/p\u003e\u003cp\u003eThe Puma, an Essential Quality chestnut colt owned by OGMA Investments, High Step Racing, TCC Stables, YNG Stables LLC and JR Ranch, is named after his trainer, Gustavo Delgado. His trainer was given that nickname due to his flair and striking resemblance to the iconic Venezuelan entertainer known as \"El Puma.\"\u0026nbsp;\u003c/p\u003e","gradedStakesPoints":20,"regionWinnerBadges":[],"breederName":"Hidden Brook Farm \u0026 Brian Kahn","uid":"blte9a5624318231969","hasAutogeneratedPage":true,"url":"/redirect/horse/blte9a5624318231969?ht=pre-entries","pageTitle":"The Puma","jockeyName":"","ownerName":"OGMA Investments, LLC (Gustavo Delgado), Saleh Al Otaibi, High Step Racing, LLC (Randy Guy), TCC Stables, LLC (Michael Iavarone), YNG Stables LLC (Bruce Zoldan) \u0026 JR Ranch (Jose Aguirre)","trainer":"Gustavo Delgado","country":{"uid":"blt1af49e3a6a89373f","title":"USA","abbreviation":"USA","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt9de45bbdff160673/60d219911e0505677a882fa1/USAFlag.png"}},"horseName":"The Puma","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt86e019aea52691da/6ab2dab77a485140fcf975af/Contender_Photo_The_Puma_.jpg"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt86e019aea52691da/6ab2dab77a485140fcf975af/Contender_Photo_The_Puma_.jpg"},"cta":null,"races":[{"uid":"blte4254e02f2a052b4","ContentTypeUid":"collection_race","challengeSeriesWinner":false,"isEligible":false,"eligibleRank":null,"finishPosition":null,"classicRanking":7,"postPosition":"","scratched":false,"win":"","place":"","show":"","deadHeat":false,"silks":null}],"isChallengeSeriesWinner":false,"silks":null,"isHoC":false,"year":2026,"isHistoricalEntry":false,"relatedArticles":[],"win":"","show":"","place":""}]},{"uid":"blt21de548e7ed632cc","raceName":"Breeders' Cup Turf","raceDetails":{"type":"World Championships","bcType":"Turf","sponsor":[{"title":"Longines","redirectUrl":"https://www.breederscup.com/races/2026-classic","label":"Presented By","logos":{"color":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt0e47340b4d496606/66f20005dec4865314332d64/Longines_Logo_Color_For-Race-Pages-01.svg"},"white":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/bltf33c9614ab2b50b5/66e30fb0bc8b1c7ddb3aa315/Logo_Longines_white_RGB(2).png"},"black":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt0e47340b4d496606/66f20005dec4865314332d64/Longines_Logo_Color_For-Race-Pages-01.svg"}},"sponsoredUrls":[],"sponsoredSection":""}],"sponsorLogo":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/bltb2341aaa147a6de7/62963af60d6f4a0fbcbefc6b/Longines5.31.svg","alt":""},"date":"2026-10-31T21:36:00.000Z","priorYearChampionPhoto":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/bltf23db7b936f3d81e/69247cd2c5f92063aa7c8f71/Turf_-_ethical_diamoind.jpg"},"displayPostTime":true,"isCompleted":false,"isLive":false,"purse":"$5,000,000","distance":"1 1/2 miles","grade":1,"ageV2":"3+","division":"Longines Turf","exacta":"","trifecta":"","superfecta":"","superHighFive":"","dailyDouble":"","pick3":"","pick4":"","pick5":"","pick6":"","region":""},"isTvScheduled":true,"broadcast":{"partners":[{"logo":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/bltf79bd4e964d5f80e/68d41e0fc07c892e73863c80/NBC_Logo_2025.svg"},"time":""},{"logo":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt29c35e9a30ccbba3/68d1ca298c48984dc7622c30/22-BC-162_New-BCcom_Network-Logo-SVGs_146x60-v1-05-Peacock.svg"},"time":""}]},"trackDetails":[{"uid":"bltc1d1c6b40525bf04","details":{"name":"Keeneland","logo":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt276fb8147db83742/629e62383d4e745ed3ae5859/keeneland.png"},"image":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/bltb0b7768e84d44449/614ce97164c8007a9bdec19c/Keeneland_Track_Image.jpeg"},"locationBcbc":"Keeneland","timeZone":-4}}],"raceDescription":"\u003ch1\u003eThe\u0026nbsp;ultimate\u0026nbsp;test\u0026nbsp;of\u0026nbsp;class\u0026nbsp;and\u0026nbsp;stamina.\u003cbr /\u003e\u003c/h1\u003eThe Longines Breeders' Cup Turf is run at 1\u0026nbsp;½ miles on the turf course, for male and female three-year-old and older. The longest race of the world championships, the Turf annually attracts the top grass talent from Europe and North America to compete for a $5 million purse in a demanding test of both speed and strength. The Breeders' Cup Turf is limited to 14 starters. Irish trainer Aidan O'Brien has won the Longines Breeders' Cup Turf a record six times.\u003cp\u003e\u0026nbsp;\u003c/p\u003e","surface":"","bettingCtaOverride":{"cta":[]},"horseType":"pre-entries","horses":[{"sireName":"New Bay (GB)","damName":"Bloomfield (IRE)","sex":"Colt","color":"Bay","foalingDate":"February, 06 2022 00:00:00","age":4,"pastPerformances":[{"trackName":"ASCOT","raceName":"Qatar Racing Champion Stakes (Class 1) (Group 1)","grade":"1","raceDate":"October, 17 2026 00:00:00","purseUsa":1732861,"positionAtFinish":3},{"trackName":"LONGCHAMP","raceName":"Qatar Prix de l'Arc de Triomphe","grade":"1","raceDate":"October, 04 2026 00:00:00","purseUsa":5627478,"positionAtFinish":2},{"trackName":"LONGCHAMP","raceName":"Qatar Prix Foy","grade":"2","raceDate":"September, 06 2026 00:00:00","purseUsa":138223,"positionAtFinish":2},{"trackName":"EPSOM","raceName":"Coolmore Coronation Cup","grade":"1","raceDate":"June, 06 2026 00:00:00","purseUsa":1334052,"positionAtFinish":1},{"trackName":"CURRAGH","raceName":"Tattersalls Gold Cup","grade":"1","raceDate":"May, 24 2026 00:00:00","purseUsa":580120,"positionAtFinish":2},{"trackName":"CHESTER","raceName":"Deepbridge Huxley S.","grade":"2","raceDate":"May, 08 2026 00:00:00","purseUsa":230365,"positionAtFinish":2},{"trackName":"MUNCHEN","raceName":"Grosser Allianz Preis von Bayern V4/4","grade":"1","raceDate":"November, 08 2025 00:00:00","purseUsa":179263,"positionAtFinish":1},{"trackName":"LONGCHAMP","raceName":"Prix du Conseil de Paris","grade":"2","raceDate":"October, 19 2025 00:00:00","purseUsa":138798,"positionAtFinish":4},{"trackName":"LONGCHAMP","raceName":"Qatar Prix Dollar","grade":"2","raceDate":"October, 04 2025 00:00:00","purseUsa":214885,"positionAtFinish":2},{"trackName":"LONGCHAMP","raceName":"Qatar Prix Niel","grade":"2","raceDate":"September, 07 2025 00:00:00","purseUsa":139459,"positionAtFinish":2},{"trackName":"YORK","raceName":"Sky Bet York S.","grade":"2","raceDate":"July, 26 2025 00:00:00","purseUsa":201569,"positionAtFinish":6},{"trackName":"SAINT CLOUD","raceName":"Prix Eugene Adam","grade":"2","raceDate":"June, 29 2025 00:00:00","purseUsa":152338,"positionAtFinish":2},{"trackName":"SANDOWN PARK","raceName":"Star Sports Heron S.","grade":" ","raceDate":"May, 29 2025 00:00:00","purseUsa":60618,"positionAtFinish":2},{"trackName":"DONCASTER","raceName":"Betfred Champagne S.","grade":"2","raceDate":"September, 14 2024 00:00:00","purseUsa":192098,"positionAtFinish":1},{"trackName":"CHELMSFORD CITY","raceName":"Ire-incentive, It Pays To Buy Irish Novice Stakes (Class 4) (Gbb Race)","grade":" ","raceDate":"August, 29 2024 00:00:00","purseUsa":12807,"positionAtFinish":1},{"trackName":"SANDOWN PARK","raceName":"Trustatrader.com Ebf Novice Stakes (Class 4) (Gbb Race)","grade":" ","raceDate":"July, 31 2024 00:00:00","purseUsa":12807,"positionAtFinish":1}],"record":{"previousYear":{"starts":7,"earnings":252594,"show":0,"win":1,"place":4,"showP":"0","winP":"14","placeP":"57"},"breedersCup":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"currentYear":{"starts":6,"earnings":2409814,"show":1,"win":1,"place":4,"showP":"17","winP":"17","placeP":"67"},"lifetime":{"starts":16,"earnings":2789749,"show":1,"win":5,"place":8,"showP":"6","winP":"31","placeP":"50"}},"yearlySummary":[{"showsP":"17","winsP":"17","placesP":"67","starts":6,"earnings":2409814,"racingYear":2026,"shows":1,"wins":1,"places":4},{"showsP":"0","winsP":"14","placesP":"57","starts":7,"earnings":252594,"racingYear":2025,"shows":0,"wins":1,"places":4}],"morningLineOdds":[],"bio":"\u003cp\u003eBay City Roller (IRE) dominated the June 6 Coronation Cup (G1) at Epsom. He won the 1 ½-mile contest, which was held on good to soft ground, by 10 lengths. In doing so, he defeated the likes of Jan Brueghel (IRE), Lambourn (IRE) and Calandagan (IRE).\r\u003c/p\u003e\u003cp\u003eOff three months after that victory, Bay City Roller returned in the 1 1/2-mile Prix Foy (G2) at Parislongchamp. He set the pace in the field of four but yielded late to odds-on favorite Daryz (FR) to finish second beaten 1 3/4 lengths.\r\u003c/p\u003e\u003cp\u003eBay City Roller lined up against Daryz again on Oct. 4 at Parislongchamp in the 1 1/2-mile Prix de L’Arc de Triomphe (G1) that drew a field of 16 and the result was the same with Bay City Roller yielding late to trail Daryz by 1 1/4 lengths at the wire.\r\u003c/p\u003e\u003cp\u003eEarlier this year, Bay City Roller finished second by a neck to Lambourn in the May 8 Huxley Stakes (G2) at Chester. He then finished second in the May 24 Tattersalls Gold Cup (G1) at the Curragh when he was 2 lengths behind Almaqam (GB). \r\u003c/p\u003e\u003cp\u003eBay City Roller closed out the 2025 season with a win in the Grosser Preis von Bayern (G1) in Germany. He won by 7 lengths on soft ground that day. He also had a number of second-place finishes last year, including the Prix Dollar (G2), Prix Niel (G2) and Prix Eugene Adam (G2). \r\u003c/p\u003e\u003cp\u003eAs a juvenile, Bay City Roller was undefeated in three starts, finishing the year with a win in the Champagne Stakes (G2) at Doncaster.\r\u003c/p\u003e\u003cp\u003eGeorge Scott trains Bay City Roller for Victorious Forever. \u0026nbsp;Bred by John Connaughton, the 4-year-old colt is by New Bay (GB) and out of the Teofilo (IRE) mare Bloomfield (IRE).\r\u003c/p\u003e","gradedStakesPoints":0,"regionWinnerBadges":[],"breederName":"John Connaughton","uid":"blt9627e52f7f9a8f53","hasAutogeneratedPage":true,"url":"/redirect/horse/blt9627e52f7f9a8f53?ht=pre-entries","pageTitle":"Bay City Roller (IRE)","jockeyName":"","ownerName":"Victorious Forever (HH Sheikh Nasser Bin Hamad Al Khalifa and Khalid Bin Hamad Al Khalifa)","trainer":"George Scott","country":{"uid":"blt440e3ce320965a9b","title":"United Kingdom / England","abbreviation":"GBR","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt02676e7705186e63/61aa4e462e86841fa22388f0/united-kingdom.png","alt":""}},"horseName":"Bay City Roller","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt2ad4c0d54f348403/6ad62a8975da6144283d550e/Contender_Photo_Bay_City_Roller_.jpg"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt2ad4c0d54f348403/6ad62a8975da6144283d550e/Contender_Photo_Bay_City_Roller_.jpg"},"cta":null,"races":[{"uid":"blt21de548e7ed632cc","ContentTypeUid":"collection_race","challengeSeriesWinner":false,"isEligible":false,"eligibleRank":null,"finishPosition":null,"classicRanking":null,"postPosition":"","scratched":false,"win":"","place":"","show":"","deadHeat":false,"silks":null}],"isChallengeSeriesWinner":false,"silks":null,"isHoC":false,"year":2026,"isHistoricalEntry":false,"relatedArticles":[],"win":"","show":"","place":""},{"sireName":"Frankel (GB)","damName":"Newspaperofrecord (IRE)","sex":"Colt","color":"Chestnut","foalingDate":"April, 17 2023 00:00:00","age":3,"pastPerformances":[{"trackName":"LONGCHAMP","raceName":"Qatar Prix de l'Arc de Triomphe","grade":"1","raceDate":"October, 04 2026 00:00:00","purseUsa":5627478,"positionAtFinish":9},{"trackName":"LONGCHAMP","raceName":"Qatar Prix Niel","grade":"2","raceDate":"September, 06 2026 00:00:00","purseUsa":138223,"positionAtFinish":5},{"trackName":"ASCOT","raceName":"King George VI And Queen Elizabeth S.","grade":"1","raceDate":"July, 25 2026 00:00:00","purseUsa":2664975,"positionAtFinish":3},{"trackName":"CURRAGH","raceName":"Dubai Duty Free Irish Derby","grade":"1","raceDate":"June, 28 2026 00:00:00","purseUsa":1423618,"positionAtFinish":1},{"trackName":"CHESTER","raceName":"Boodles Chester Vase S.","grade":"3","raceDate":"May, 06 2026 00:00:00","purseUsa":196308,"positionAtFinish":1},{"trackName":"DONCASTER","raceName":"William Hill Futurity Trophy S.","grade":"1","raceDate":"October, 25 2025 00:00:00","purseUsa":266246,"positionAtFinish":3},{"trackName":"LEOPARDSTOWN","raceName":"KPMG Champions Juvenile Golden Fleece S.","grade":"2","raceDate":"September, 13 2025 00:00:00","purseUsa":176033,"positionAtFinish":1},{"trackName":"KILLARNEY","raceName":"Irish Stallion Farms E.B.F.","grade":" ","raceDate":"July, 14 2025 00:00:00","purseUsa":21012,"positionAtFinish":1},{"trackName":"CURRAGH","raceName":"Barronstown Stud Irish E.B.F.","grade":" ","raceDate":"June, 28 2025 00:00:00","purseUsa":23438,"positionAtFinish":2}],"record":{"previousYear":{"starts":4,"earnings":149358,"show":1,"win":2,"place":1,"showP":"25","winP":"50","placeP":"25"},"breedersCup":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"currentYear":{"starts":5,"earnings":1214378,"show":1,"win":2,"place":0,"showP":"20","winP":"40","placeP":"0"},"lifetime":{"starts":9,"earnings":1363736,"show":2,"win":4,"place":1,"showP":"22","winP":"44","placeP":"11"}},"yearlySummary":[{"showsP":"20","winsP":"40","placesP":"0","starts":5,"earnings":1214378,"racingYear":2026,"shows":1,"wins":2,"places":0},{"showsP":"25","winsP":"50","placesP":"25","starts":4,"earnings":149358,"racingYear":2025,"shows":1,"wins":2,"places":1}],"morningLineOdds":[],"bio":"\u003cp\u003eBenvenuto Cellini (IRE), who is named after the Italian sculptor, has had his share of headlines. He became a top-level winner when he took the June 28 Irish Derby (G1) at the Curragh by defeating Christmas Day (G1) by 1 ¾ lengths. Christmas Day had won the June 6 Derby (G1) at Epsom in his prior start, while Benvenuto Cellini was declared a non-runner after his left hind leg was caught in the starting stall. Benvenuto Cellini came into the Derby having won the May 6 Chester Vase Stakes (G3). \u0026nbsp;\r\u003c/p\u003e\u003cp\u003eFollowing the Irish Derby, he finished third in the July 25 King George VI and Queen Elizabeth Stakes (G1) behind his older counterparts Kalpana (GB) and Calandagan (IRE). Then on Sept. 6 at Parislongchamp, he tired late after being prominent early and finished a nonthreatening fifth of seven beaten 4 1/2 lengths in the 1 1/2-mile Prix Niel (G2). \r\u003c/p\u003e\u003cp\u003eAs a 2-year-old, Benvenuto Cellini broke his maiden at second asking. He went on to win the Champions Juvenile Stakes (G2) at Leopardstown and finished third in the Futurity Trophy Stakes (G1) at Doncaster. \r\u003c/p\u003e\u003cp\u003eAidan O’Brien trains homebred Benvenuto Cellini for Coolmore, Peter Brant and Westerberg. By Frankel (GB), Benvenuto Cellini is out of the Lope De Vega (IRE) mare Newspaperofrecord (IRE), who won 2018 Breeders’ Cup Juvenile Fillies Turf (G1). Campaigned by Klaravich Stables, Newspaperofrecord was sold privately at the end of her racing career.\u0026nbsp;\u003c/p\u003e","gradedStakesPoints":0,"regionWinnerBadges":[],"breederName":"Coolmore \u0026 White Birch Farm Sc","uid":"blta525e115534c51be","hasAutogeneratedPage":true,"url":"/redirect/horse/blta525e115534c51be?ht=pre-entries","pageTitle":"Benvenuto Cellini (IRE)","jockeyName":"","ownerName":"Mrs. John Magnier, Michael Tabor, Derrick Smith, Peter M. Brant \u0026 Westerberg (Lucia Walder)","trainer":"Aidan P. O'Brien","country":{"uid":"blta32e5b692b12a246","title":"Ireland","abbreviation":"IRE","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt613f9a736c40223a/61aa4c2b2f8b9e70946988d3/ireland.png","alt":""}},"horseName":"Benvenuto Cellini","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/bltf22c960240de2c44/6a74b49e5751aa5d187e0d14/Contender_Photo_Benvenuto_Cellini_.jpg"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/bltf22c960240de2c44/6a74b49e5751aa5d187e0d14/Contender_Photo_Benvenuto_Cellini_.jpg"},"cta":null,"races":[{"uid":"blt21de548e7ed632cc","ContentTypeUid":"collection_race","challengeSeriesWinner":false,"isEligible":false,"eligibleRank":null,"finishPosition":null,"classicRanking":null,"postPosition":"","scratched":false,"win":"","place":"","show":"","deadHeat":false,"silks":null}],"isChallengeSeriesWinner":false,"silks":null,"isHoC":false,"year":2026,"isHistoricalEntry":false,"relatedArticles":[],"win":"","show":"","place":""},{"sireName":"Liam's Map","damName":"Linda","sex":"Gelding","color":"Bay","foalingDate":"April, 09 2022 00:00:00","age":4,"pastPerformances":[{"trackName":"KENTUCKY DOWNS","raceName":"AGS Kentucky Turf Cup Invitational S.","grade":"2","raceDate":"September, 05 2026 00:00:00","purseUsa":2000000,"positionAtFinish":7},{"trackName":"COLONIAL DOWNS","raceName":"Arlington Million S.","grade":"1","raceDate":"August, 01 2026 00:00:00","purseUsa":1000000,"positionAtFinish":1},{"trackName":"CHURCHILL DOWNS","raceName":"Chorleywood S.","grade":" ","raceDate":"June, 13 2026 00:00:00","purseUsa":225000,"positionAtFinish":1},{"trackName":"CHURCHILL DOWNS","raceName":"Louisville S.","grade":"3","raceDate":"May, 16 2026 00:00:00","purseUsa":250000,"positionAtFinish":1},{"trackName":"KEENELAND","raceName":"VisitLEX Elkhorn S.","grade":"2","raceDate":"April, 18 2026 00:00:00","purseUsa":400000,"positionAtFinish":1},{"trackName":"GULFSTREAM PARK","raceName":" ","grade":" ","raceDate":"February, 28 2026 00:00:00","purseUsa":87000,"positionAtFinish":2},{"trackName":"KENTUCKY DOWNS","raceName":"DK Horse Nashville Derby Invitational S.","grade":"3","raceDate":"August, 30 2025 00:00:00","purseUsa":3500000,"positionAtFinish":2},{"trackName":"MONMOUTH PARK","raceName":"NYRA Bets Haskell S.","grade":"1","raceDate":"July, 19 2025 00:00:00","purseUsa":1017500,"positionAtFinish":5},{"trackName":"CHURCHILL DOWNS","raceName":"Matt Winn S.","grade":"3","raceDate":"June, 08 2025 00:00:00","purseUsa":400000,"positionAtFinish":2},{"trackName":"CHURCHILL DOWNS","raceName":"Kentucky Derby presented by Woodford Reserve","grade":"1","raceDate":"May, 03 2025 00:00:00","purseUsa":5000000,"positionAtFinish":6},{"trackName":"KEENELAND","raceName":"Toyota Blue Grass S.","grade":"1","raceDate":"April, 08 2025 00:00:00","purseUsa":1250000,"positionAtFinish":1},{"trackName":"GULFSTREAM PARK","raceName":"Coolmore Fountain of Youth S.","grade":"2","raceDate":"March, 01 2025 00:00:00","purseUsa":415000,"positionAtFinish":4},{"trackName":"GULFSTREAM PARK","raceName":"Holy Bull S.","grade":"3","raceDate":"February, 01 2025 00:00:00","purseUsa":265000,"positionAtFinish":1},{"trackName":"GULFSTREAM PARK","raceName":" ","grade":" ","raceDate":"December, 28 2024 00:00:00","purseUsa":65000,"positionAtFinish":1},{"trackName":"CHURCHILL DOWNS","raceName":" ","grade":" ","raceDate":"November, 30 2024 00:00:00","purseUsa":120000,"positionAtFinish":3},{"trackName":"KEENELAND","raceName":" ","grade":" ","raceDate":"October, 26 2024 00:00:00","purseUsa":78000,"positionAtFinish":2}],"record":{"previousYear":{"starts":7,"earnings":1695325,"show":0,"win":2,"place":2,"showP":"0","winP":"29","placeP":"29"},"breedersCup":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"currentYear":{"starts":6,"earnings":1158489,"show":0,"win":4,"place":1,"showP":"0","winP":"67","placeP":"17"},"lifetime":{"starts":16,"earnings":2904244,"show":1,"win":7,"place":4,"showP":"6","winP":"44","placeP":"25"}},"yearlySummary":[{"showsP":"0","winsP":"67","placesP":"17","starts":6,"earnings":1158489,"racingYear":2026,"shows":0,"wins":4,"places":1},{"showsP":"0","winsP":"29","placesP":"29","starts":7,"earnings":1695325,"racingYear":2025,"shows":0,"wins":2,"places":2}],"morningLineOdds":[],"bio":"\u003cp\u003eAn alum of the 2025 Kentucky Derby (G1), Burnham Square switched from dirt to turf last summer and has shown great affinity for the grass. \u0026nbsp;\r\u003c/p\u003e\u003cp\u003eBurnham Square has won four stakes on turf this season. On April 18, he took the 1 ½-mile Elkhorn Stakes (G2) at Keeneland by 9 ¾ lengths. At Churchill Downs, he won the 1 ½-mile Louisville Stakes (G3) on May 16 by 4 ¾ lengths, and he followed that effort with a neck victory in the June 13 Chorleywood Stakes (Listed) over 1 3/8 miles. On Aug. 1, Burnham Square took his show on the road to Colonial Downs and delivered as the favorite in the 1 1/4-mile Arlington Million (G1). The 4-year-old gelding also finished second in a 1 1/16-mile allowance race at Gulfstream Park in February to kick off his season. \r\u003c/p\u003e\u003cp\u003eBurnham Square’s bid for a fifth grass score in 2026 resulted in his poorest turf outing to date as he finished seventh as the favorite beaten 9 3/4 lengths in the Kentucky Turf Cup Invitational (G2) at Kentucky Downs on Sept. 5 going 1 1/2 miles. \r\u003c/p\u003e\u003cp\u003eLast year, Burnham Square notched his biggest victory to date in the Blue Grass Stakes (G1) before finishing a troubled sixth in the Derby. After a lackluster performance in the Haskell Stakes (G1), his connections moved him to turf. In his first attempt on grass, Burnham Square finished second by a head in the Nashville Derby Invitational Stakes (G3) at Kentucky Downs. \r\u003c/p\u003e\u003cp\u003eBurnham Square is trained by Ian Wilkes, who conditions the Whitham Thoroughbreds’ homebred who is a son of the Grade 2-winning mare Linda. Linda also is a Whitham homebred and was trained by Wilkes.\u0026nbsp;\u003c/p\u003e","gradedStakesPoints":20,"regionWinnerBadges":[],"breederName":"Whitham Thoroughbreds, LLC","uid":"bltccc65625a5558845","hasAutogeneratedPage":true,"url":"/redirect/horse/bltccc65625a5558845?ht=pre-entries","pageTitle":"Burnham Square","jockeyName":"","ownerName":"Whitham Thoroughbreds LLC (Janis R. Whitham)","trainer":"Ian R. Wilkes","country":{"uid":"blt1af49e3a6a89373f","title":"USA","abbreviation":"USA","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt9de45bbdff160673/60d219911e0505677a882fa1/USAFlag.png"}},"horseName":"Burnham Square","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blte478a00cef2de0d2/6a736d54c8b7ac3c0751fc4b/Contender_Photo_Burnham_Square.jpg"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blte478a00cef2de0d2/6a736d54c8b7ac3c0751fc4b/Contender_Photo_Burnham_Square.jpg"},"cta":null,"races":[{"uid":"blt21de548e7ed632cc","ContentTypeUid":"collection_race","challengeSeriesWinner":false,"isEligible":false,"eligibleRank":null,"finishPosition":null,"classicRanking":null,"postPosition":"","scratched":false,"win":"","place":"","show":"","deadHeat":false,"silks":null}],"isChallengeSeriesWinner":false,"silks":null,"isHoC":false,"year":2026,"isHistoricalEntry":false,"relatedArticles":[],"win":"","show":"","place":""},{"sireName":"Deep Impact (JPN)","damName":"Sisterly Love","sex":"Horse","color":"Dark Bay or Brown","foalingDate":"March, 05 2018 00:00:00","age":8,"pastPerformances":[{"trackName":"KYOTO","raceName":"Kyoto Daishoten","grade":"2","raceDate":"October, 04 2026 00:00:00","purseUsa":808916,"positionAtFinish":4},{"trackName":"SHA TIN","raceName":"Standard Chartered Champions \u0026 Chater Cup","grade":"1","raceDate":"May, 24 