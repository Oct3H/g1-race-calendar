arch, 30 2025 00:00:00","purseUsa":65100,"positionAtFinish":2},{"trackName":"LEOPARDSTOWN","raceName":"Killavullan S.","grade":"3","raceDate":"October, 19 2024 00:00:00","purseUsa":54122,"positionAtFinish":4},{"trackName":"DUNDALK","raceName":"Irish Stallion Farms E.B.F. Star Appeal S.","grade":" ","raceDate":"October, 04 2024 00:00:00","purseUsa":51416,"positionAtFinish":2},{"trackName":"CORK","raceName":"Coolmore Stud Gleneagles Irish Ebf (C \u0026 G) Maiden","grade":" ","raceDate":"September, 11 2024 00:00:00","purseUsa":19484,"positionAtFinish":1},{"trackName":"CURRAGH","raceName":"Revamp Conservation And Restoration Irish E.B.F.","grade":" ","raceDate":"August, 10 2024 00:00:00","purseUsa":21649,"positionAtFinish":4}],"record":{"previousYear":{"starts":5,"earnings":78355,"show":2,"win":1,"place":1,"showP":"40","winP":"20","placeP":"20"},"breedersCup":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"currentYear":{"starts":7,"earnings":1377298,"show":2,"win":3,"place":0,"showP":"29","winP":"43","placeP":"0"},"lifetime":{"starts":16,"earnings":1479949,"show":4,"win":5,"place":2,"showP":"25","winP":"31","placeP":"13"}},"yearlySummary":[{"showsP":"29","winsP":"43","placesP":"0","starts":7,"earnings":1377298,"racingYear":2026,"shows":2,"wins":3,"places":0},{"showsP":"40","winsP":"20","placesP":"20","starts":5,"earnings":78355,"racingYear":2025,"shows":2,"wins":1,"places":1}],"morningLineOdds":[],"bio":"\u003cp\u003eComanche Brave (IRE) has traveled the world to do battle with a roster of the world's top turf sprinters, changed owners along the way and, at age 4, achieved Group 1 success back home in the British Isles. \r\u003c/p\u003e\u003cp\u003eThe Donnacha O'Brien trainee, a Wootton Bassett colt, started his career with the Irish Coolmore \"lads\" and operated at mid levels of the class ladder in 2024 and 2025. \r\u003c/p\u003e\u003cp\u003eO'Brien shook things up in 2026, starting Comanche Brave's season with a third-place finish in the Abu Dhabi Gold Cup. Sold privately to Saudi businessman Muhaideb Abdullah Almuhaideb, the colt stayed with O'Brien and stepped right up to finish third in the 1351 Turf Sprint (G2) in Riyadh. \r\u003c/p\u003e\u003cp\u003eSent to Hong Kong, he finished fifth behind the world's top turf sprinter, Ka Ying Rising (NZ) in the Chairman's Sprint Prize (G1) in April. Continuing his odyssey, he won the Greenlands Stakes (G2) back in Ireland and finished seventh in the Queen Elizabeth II Jubilee Stakes (G1) at Royal Ascot in June. \r\u003c/p\u003e\u003cp\u003eObviously immune to jet lag, he then stepped up to win the July Cup (G1) July 11 at Newmarket. After that victory, Comanche Brave added another Group 1 score as he posted a 1 1/4-length victory in the 5-furlong Flying Five at the Curragh on Sept. 13.\u003c/p\u003e","gradedStakesPoints":10,"regionWinnerBadges":[],"breederName":"Whisperview Trading Ltd","uid":"blt0037f67f537a5a52","hasAutogeneratedPage":true,"url":"/redirect/horse/blt0037f67f537a5a52?ht=pre-entries","pageTitle":"Comanche Brave (IRE)","jockeyName":"","ownerName":"Muhaideb A Al Muhaideb","trainer":"Donnacha O'Brien","country":{"uid":"blta32e5b692b12a246","title":"Ireland","abbreviation":"IRE","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt613f9a736c40223a/61aa4c2b2f8b9e70946988d3/ireland.png","alt":""}},"horseName":"Comanche Brave","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt3b9043c282e09273/6ac3bcd78b3d25e64309627d/Contender_Photo_Comanche_Brave.png"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt3b9043c282e09273/6ac3bcd78b3d25e64309627d/Contender_Photo_Comanche_Brave.png"},"cta":null,"races":[{"uid":"bltc81c6f52eeba2605","ContentTypeUid":"collection_race","challengeSeriesWinner":false,"isEligible":false,"eligibleRank":null,"finishPosition":null,"classicRanking":null,"postPosition":"","scratched":false,"win":"","place":"","show":"","deadHeat":false,"silks":null}],"isChallengeSeriesWinner":true,"silks":null,"isHoC":false,"year":2026,"isHistoricalEntry":false,"relatedArticles":[],"win":"","show":"","place":""},{"sireName":"Not This Time","damName":"Remarqued","sex":"Filly","color":"Bay","foalingDate":"March, 04 2023 00:00:00","age":3,"pastPerformances":[{"trackName":"KENTUCKY DOWNS","raceName":"Ainsworth Music City S.","grade":"2","raceDate":"September, 05 2026 00:00:00","purseUsa":1500000,"positionAtFinish":6},{"trackName":"SARATOGA","raceName":"Coronation Cup S.","grade":"3","raceDate":"July, 18 2026 00:00:00","purseUsa":225000,"positionAtFinish":1},{"trackName":"CHURCHILL DOWNS","raceName":"Mamzelle S. presented by Kentucky Proud","grade":"3","raceDate":"April, 30 2026 00:00:00","purseUsa":300000,"positionAtFinish":1},{"trackName":"KEENELAND","raceName":"FanDuel Limestone S.","grade":"3","raceDate":"April, 10 2026 00:00:00","purseUsa":350000,"positionAtFinish":3},{"trackName":"DEL MAR","raceName":"Breeders' Cup Juvenile Turf Sprint","grade":"1","raceDate":"October, 31 2025 00:00:00","purseUsa":1000000,"positionAtFinish":1},{"trackName":"WOODBINE","raceName":"bet365 Algonquin S.","grade":" ","raceDate":"October, 05 2025 00:00:00","purseUsa":175000,"positionAtFinish":1},{"trackName":"SARATOGA","raceName":"Bolton Landing S.","grade":" ","raceDate":"August, 17 2025 00:00:00","purseUsa":150000,"positionAtFinish":2},{"trackName":"SARATOGA","raceName":" ","grade":" ","raceDate":"July, 10 2025 00:00:00","purseUsa":100000,"positionAtFinish":1}],"record":{"previousYear":{"starts":4,"earnings":680205,"show":0,"win":3,"place":1,"showP":"0","winP":"75","placeP":"25"},"breedersCup":{"starts":1,"earnings":520000,"show":0,"win":1,"place":0,"showP":"0","winP":"100","placeP":"0"},"currentYear":{"starts":4,"earnings":349225,"show":1,"win":2,"place":0,"showP":"25","winP":"50","placeP":"0"},"lifetime":{"starts":8,"earnings":1029430,"show":1,"win":5,"place":1,"showP":"13","winP":"63","placeP":"13"}},"yearlySummary":[{"showsP":"25","winsP":"50","placesP":"0","starts":4,"earnings":349225,"racingYear":2026,"shows":1,"wins":2,"places":0},{"showsP":"0","winsP":"75","placesP":"25","starts":4,"earnings":680205,"racingYear":2025,"shows":0,"wins":3,"places":1}],"morningLineOdds":[],"bio":"\u003cp\u003eCy Fair wasted no time announcing her potential as the Not This Time filly kicked away to a 3 1/4-length victory in her career debut July 20, 2025, on the Saratoga turf. From that auspicious start, trainer George Weaver sent Cy Fair directly to the listed Bolton Landing Stakes a month later and, after taking a brief lead, she fell just a neck short of holding on for the win. \r\u003c/p\u003e\u003cp\u003eA strong rebound in the listed Algonquin Stakes on the Woodbine turf -- another 3 1/4-length win -- propelled Cy Fair directly to the Breeders' Cup Juvenile Turf Sprint (G1) at Del Mar. There, she lined up against some of the most promising colts, some from across the Atlantic, and beat them all, winning by 1 length. \r\u003c/p\u003e\u003cp\u003eShe returned from a five-month layoff to finish third in the Limestone Stakes (G3) at Keeneland's spring meeting. She bounced right back, winning the Mamzelle Stakes (G3) at Churchill Downs just three weeks later and, after another brief respite, took the Coronation Cup (G3) at Saratoga by 2 1/2 lengths on July 18. \r\u003c/p\u003e\u003cp\u003eCy Fair made her first visit to Kentucky Downs on Sept. 5 for the 6 1/2-furlong Music City Stakes (G2). Racing midpack early on while on the inside, Cy Fair found herself trapped behind horses in the stretch run with no racing room and wound up sixth beaten 2 lengths as the odds-on favorite. \r\u003c/p\u003e\u003cp\u003eCy Fair, out of the Arch mare Remarqued, was bred in Kentucky by Marc Keller.\u003c/p\u003e","gradedStakesPoints":9,"regionWinnerBadges":[],"breederName":"Marc Keller","uid":"blt72a6d999168b856b","hasAutogeneratedPage":true,"url":"/redirect/horse/blt72a6d999168b856b?ht=pre-entries","pageTitle":"Cy Fair","jockeyName":"","ownerName":"Medallion Racing (Phillip Shelton), Swinbank Stables, LLC (Reagan Swinbank), Joey Platts and Mark Stanton","trainer":"George Weaver","country":{"uid":"blt1af49e3a6a89373f","title":"USA","abbreviation":"USA","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt9de45bbdff160673/60d219911e0505677a882fa1/USAFlag.png"}},"horseName":"Cy Fair","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt0bba890c011ed768/6a736d68ded0cf629ef49cba/Contender_Photo_Cy_Fair.jpg"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt0bba890c011ed768/6a736d68ded0cf629ef49cba/Contender_Photo_Cy_Fair.jpg"},"cta":null,"races":[{"uid":"bltc81c6f52eeba2605","ContentTypeUid":"collection_race","challengeSeriesWinner":false,"isEligible":false,"eligibleRank":null,"finishPosition":null,"classicRanking":null,"postPosition":"","scratched":false,"win":"","place":"","show":"","deadHeat":false,"silks":null}],"isChallengeSeriesWinner":false,"silks":null,"isHoC":false,"year":2026,"isHistoricalEntry":true,"relatedArticles":[],"win":"","show":"","place":""},{"sireName":"Not This Time","damName":"Laura's Pleasure","sex":"Mare","color":"Dark Bay or Brown","foalingDate":"May, 16 2021 00:00:00","age":5,"pastPerformances":[{"trackName":"KENTUCKY DOWNS","raceName":"Never Say Die Kentucky Downs Ladies Turf Sprint S.","grade":"1","raceDate":"August, 29 2026 00:00:00","purseUsa":1750000,"positionAtFinish":1},{"trackName":"SARATOGA","raceName":"Caress S.","grade":"2","raceDate":"July, 11 2026 00:00:00","purseUsa":250000,"positionAtFinish":3},{"trackName":"SARATOGA","raceName":"Intercontinental S.","grade":"2","raceDate":"June, 04 2026 00:00:00","purseUsa":250000,"positionAtFinish":5},{"trackName":"KEENELAND","raceName":"Giant's Causeway S. Presented by Keeneland Select","grade":"2","raceDate":"April, 12 2026 00:00:00","purseUsa":400000,"positionAtFinish":1},{"trackName":"GULFSTREAM PARK","