,"purseUsa":300000,"positionAtFinish":2},{"trackName":"SANTA ANITA PARK","raceName":"Zuma Beach S.","grade":"3","raceDate":"October, 06 2024 00:00:00","purseUsa":100000,"positionAtFinish":2},{"trackName":"DEL MAR","raceName":" ","grade":" ","raceDate":"September, 07 2024 00:00:00","purseUsa":75000,"positionAtFinish":1},{"trackName":"DEL MAR","raceName":" ","grade":" ","raceDate":"September, 01 2025 00:00:00","purseUsa":82000,"positionAtFinish":1},{"trackName":"DEL MAR","raceName":" ","grade":" ","raceDate":"August, 02 2024 00:00:00","purseUsa":75000,"positionAtFinish":4},{"trackName":"DEL MAR","raceName":"Big Ass Fans Breeders' Cup Dirt Mile","grade":"1","raceDate":"November, 02 2024 00:00:00","purseUsa":1000000,"positionAtFinish":1},{"trackName":"DEL MAR","raceName":"FanDuel Racing Pacific Classic S.","grade":"1","raceDate":"August, 31 2024 00:00:00","purseUsa":1000000,"positionAtFinish":2},{"trackName":"DEL MAR","raceName":" ","grade":" ","raceDate":"August, 03 2024 00:00:00","purseUsa":76000,"positionAtFinish":1},{"trackName":"SAN ISIDRO","raceName":"Miguel Alfredo Martinez de Hoz","grade":"1","raceDate":"February, 03 2024 00:00:00","purseUsa":36262,"positionAtFinish":7},{"trackName":"SAN ISIDRO","raceName":"Botafogo","grade":"3","raceDate":"January, 13 2024 00:00:00","purseUsa":7457,"positionAtFinish":2},{"trackName":"SAN ISIDRO","raceName":"Tresiete","grade":" ","raceDate":"December, 20 2023 00:00:00","purseUsa":7471,"positionAtFinish":1},{"trackName":"SAN ISIDRO","raceName":"Embrujo","grade":" ","raceDate":"November, 17 2023 00:00:00","purseUsa":15843,"positionAtFinish":3}],"record":{"previousYear":{"starts":2,"earnings":29230,"show":0,"win":0,"place":1,"showP":"0","winP":"0","placeP":"50"},"breedersCup":{"starts":1,"earnings":170000,"show":0,"win":0,"place":1,"showP":"0","winP":"0","placeP":"100"},"currentYear":{"starts":5,"earnings":234395,"show":1,"win":2,"place":0,"showP":"20","winP":"40","placeP":"0"},"lifetime":{"starts":11,"earnings":543125,"show":1,"win":4,"place":2,"showP":"9","winP":"36","placeP":"18"}},"yearlySummary":[{"showsP":"20","winsP":"40","placesP":"0","starts":5,"earnings":234395,"racingYear":2026,"shows":1,"wins":2,"places":0},{"showsP":"0","winsP":"0","placesP":"50","starts":2,"earnings":29230,"racingYear":2025,"shows":0,"wins":0,"places":1}],"morningLineOdds":[],"bio":"\u003cp\u003eIron Man Cal returns to racing’s grandest stage in a different form than his previous appearance. In the 2024 Breeders’ Cup World Championships at Del Mar, he was a 2-year-old colt who was narrowly defeated as a longshot in the Juvenile Turf (G1). He returns as a 4-year-old gelding in the Dirt Mile (G1) at Keeneland after winning the “Win and You’re In” Pat O’Brien Stakes (G2) at Del Mar on Aug. 29. \r\u003c/p\u003e\u003cp\u003e“I think his style of running fits the dirt better,” trainer D’Amato said. “He has steady speed and he doesn’t have to quicken as much on the dirt. When you’re on the grass, you have to show more of a turn of foot.” \u0026nbsp;\r\u003c/p\u003e\u003cp\u003eSuccessful on grass with three victories including Santa Anita’s Zuma Beach (G3) in 2024, Iron Man Cal was third in the San Diego Handicap (G2) at Del Mar on July 18 in his only dirt appearance besides the Pat O’Brien. He was gelded this past spring and scored his first victory with that designation on June 7 in a Santa Anita allowance race. \r\u003c/p\u003e\u003cp\u003eIron Man Cal was acquired by current owner Little Red Feather Racing for $130,000 at the 2023 Keeneland September Yearling Sale. \u0026nbsp;\u003c/p\u003e","gradedStakesPoints":18,"regionWinnerBadges":[],"breederName":"Brereton C. Jones","uid":"blteff9029a3b094cbd","hasAutogeneratedPage":true,"url":"/redirect/horse/blteff9029a3b094cbd?ht=pre-entries","pageTitle":"Iron Man Cal","jockeyName":"","ownerName":"Little Red Feather Racing (William Koch) \u0026 Madaket Stables, LLC (Sol Kumin)","trainer":"Philip D'Amato","country":{"uid":"blt1af49e3a6a89373f","title":"USA","abbreviation":"USA","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt9de45bbdff160673/60d219911e0505677a882fa1/USAFlag.png"}},"horseName":"Iron Man Cal","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/bltde3a7952737438fe/6a972ac9a163363683372230/Contender_Photo_Iron_Man_Cal_.jpg"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/bltde3a7952737438fe/6a972ac9a163363683372230/Contender_Photo_Iron_Man_Cal_.jpg"},"cta":null,"races":[{"uid":"blt830ffcd3734ad389","ContentTypeUid":"collection_race","challengeSeriesWinner":true,"isEligible":false,"eligibleRank":null,"finishPosition":null,"classicRanking":null,"postPosition":"","scratched":false,"win":"","place":"","show":"","deadHeat":false,"silks":null}],"isChallengeSeriesWinner":true,"silks":null,"isHoC":false,"year":2026,"isHistoricalEntry":false,"relatedArticles":[],"win":"","show":"","place":""},{"sireName":"Nyquist","damName":"Tyburn Brook","sex":"Horse","color":"Dark Bay or Brown","foalingDate":"May, 09 2021 00:00:00","age":5,"pastPerformances":[{"trackName":"DEL MAR","raceName":"Pacific Classic S.","grade":"1","raceDate":"August, 22 2026 00:00:00","purseUsa":1000000,"positionAtFinish":1},{"trackName":"MONMOUTH PARK","raceName":"Monmouth Cup S.","grade":"3","raceDate":"July, 18 2026 00:00:00","purseUsa":350000,"positionAtFinish":1},{"trackName":"SARATOGA","raceName":"Hill 'N' Dale Metropolitan H.","grade":"1","raceDate":"June, 06 2026 00:00:00","purseUsa":1000000,"positionAtFinish":2},{"trackName":"CHURCHILL DOWNS","raceName":"Churchill Downs S. presented by Ford","grade":"1","raceDate":"May, 02 2026 00:00:00","purseUsa":1000000,"positionAtFinish":6},{"trackName":"GULFSTREAM PARK","raceName":"Gulfstream Park Mile S. presented by Fierceness","grade":"3","raceDate":"February, 28 2026 00:00:00","purseUsa":225000,"positionAtFinish":1},{"trackName":"GULFSTREAM PARK","raceName":"Fred W. Hooper S. presented by Visit Lauderdale","grade":"3","raceDate":"January, 24 2026 00:00:00","purseUsa":175000,"positionAtFinish":1},{"trackName":"GULFSTREAM PARK","raceName":"Mr. Prospector S.","grade":"3","raceDate":"December, 27 2025 00:00:00","purseUsa":150000,"positionAtFinish":1},{"trackName":"AQUEDUCT","raceName":" ","grade":" ","raceDate":"November, 22 2025 00:00:00","purseUsa":90000,"positionAtFinish":1},{"trackName":"GULFSTREAM PARK","raceName":" ","grade":" ","raceDate":"February, 15 2025 00:00:00","purseUsa":97000,"positionAtFinish":2},{"trackName":"KEENELAND","raceName":"Perryville S.","grade":"3","raceDate":"October, 19 2024 00:00:00","purseUsa":300000,"positionAtFinish":3},{"trackName":"GULFSTREAM PARK","raceName":" ","grade":" ","raceDate":"March, 28 2024 00:00:00","purseUsa":91000,"positionAtFinish":1},{"trackName":"CHURCHILL DOWNS","raceName":" ","grade":" ","raceDate":"November, 04 2023 00:00:00","purseUsa":120000,"positionAtFinish":1}],"record":{"previousYear":{"starts":3,"earnings":155970,"show":0,"win":2,"place":1,"showP":"0","winP":"67","placeP":"33"},"breedersCup":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"currentYear":{"starts":6,"earnings":1233610,"show":0,"win":4,"place":1,"showP":"0","winP":"67","placeP":"17"},"lifetime":{"starts":12,"earnings":1523155,"show":1,"win":8,"place":2,"showP":"8","winP":"67","placeP":"17"}},"yearlySummary":[{"showsP":"0","winsP":"67","placesP":"17","starts":6,"earnings":1233610,"racingYear":2026,"shows":0,"wins":4,"places":1},{"showsP":"0","winsP":"67","placesP":"33","starts":3,"earnings":155970,"racingYear":2025,"shows":0,"wins":2,"places":1}],"morningLineOdds":[],"bio":"\u003cp\u003eBy recording three consecutive stakes victories in middle-distance races this winter at Gulfstream Park, Godolphin’s Knightsbridge looked like a candidate for a Breeders’ Cup race this fall at Keeneland – but seemingly for the $1 million Breeders’ Cup Dirt Mile (G1) than the longer 1 1/4-mile Longines Breeders’ Cup Classic (G1). \r\u003c/p\u003e\u003cp\u003eBut an eye-opening two-turn performance in the July 18 Monmouth Cup (G3) at Monmouth Park – his first race at 1 1/8 miles – has opened additional opportunities for the 5-year-old Nyquist horse. He was brilliant in the Monmouth Cup, spurting to the lead and increasing his advantage at every call on his way to a 10 ¼-length triumph. His time was sparkling, too, clocked in 1:47.51 after initial fractions of :23.38, :46.57, and 1:10.63. \r\u003c/p\u003e\u003cp\u003e\"He passed the two-turn test today, indeed,\" Godolphin USA director of bloodstock Michael Banahan said. \u0026nbsp; \r\u003c/p\u003e\u003cp\u003eHe passed an even bigger test in his next start, the 1 ¼-mile Pacific Classic (G1) at Del Mar on Aug. 22. Breaking from post 11, he dueled 2024 Big Ass Fans Breeders’ Cup Dirt Mile (G1) winner Full Serrano (ARG) into submission before drawing off for a 6 1/4-length victory. \r\u003c/p\u003e\u003cp\u003eGodolphin and Hall of Fame trainer Bill Mott also have Sovereignty aimed at the Classic. \r\u003c/p\u003e\u003cp\u003eA homebred out of the Bernardini mare Tyburn Brook, Knightsbridge is a half-brother to another Godolphin homebred in Grade 1 winner and freshman sire Speaker's Corner.\u0026nbsp;\u003c/p\u003e","gradedStakesPoints":28,"regionWinnerBadges":[],"breederName":"Godolphin","uid":"blt8348ffd7e66b2061","hasAutogeneratedPage":true,"url":"/redirect/horse/blt8348ffd7e66b2061?ht=pre-entries","pageTitle":"Knightsbridge","jockeyName":"","ownerName":"Godolphin, LLC (Mohammed al Maktoum, et al.)","trainer":"William I. Mott","country":{"uid":"blt1af49e3a6a89373f","title":"USA","abbreviation":"USA","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt9de45bbdff160673/60d219911e0505677a882fa1/USAFlag.png"}},"horseName":"Knightsbridge","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt9bdb69658bb54c2e/6a7b3c9dbe337891cddad9ad/Contender_Photo_Knightsbridge.jpg"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt9bdb69658bb54c2e/6a7b3c9dbe337891cddad9ad/Contender_Photo_Knightsbridge.jpg"},"cta":null,"races":[{"uid":"blt830ffcd3734ad389","ContentTypeUid":"collection_race","challengeSeriesWinner":true,"isEligible":false,"eligibleRank":null,"finishPosition":null,"classicRanking":null,"postPosition":"","scratched":false,"win":"","place":"","show":"","deadHeat":false,"silks":null}],"isChallengeSeriesWinner":true,"silks":null,"isHoC":false,"year":2026,"isHistoricalEntry":false,"relatedArticles":[],"win":"","show":"","place":""},{"sireName":"Lord Kanaloa (JPN)","damName":"Eau Super (JPN)","sex":"Horse","color":"Bay","foalingDate":"April, 27 2020 00:00:00","age":6,"pastPerformances":[{"trackName":"URAWA","raceName":"Sakitama Hai","grade":" ","raceDate":"June, 24 2026 00:00:00","purseUsa":841689,"positionAtFinish":1},{"trackName":"FUNABASHI","raceName":"Kashiwa Kinen","grade":" ","raceDate":"May, 05 2026 00:00:00","purseUsa":864840,"positionAtFinish":3},{"trackName":"KOCHI","raceName":"Kurofune Sho","grade":" ","raceDate":"March, 24 2026 00:00:00","purseUsa":340842,"positionAtFinish":4},{"trackName":"TOKYO","raceName":"Negishi S.","grade":"3","raceDate":"February, 01 2026 00:00:00","purseUsa":491281,"positionAtFinish":1},{"trackName":"TOKYO","raceName":"Musashino S.","grade":"3","raceDate":"November, 15 2025 00:00:00","purseUsa":491775,"positionAtFinish":5},{"trackName":"TOKYO","raceName":"Green Channel Cup","grade":" ","raceDate":"October, 04 2025 00:00:00","purseUsa":309184,"positionAtFinish":4},{"trackName":"FUNABASHI","raceName":"Kashiwa Kinen","grade":" ","raceDate":"May, 05 2025 00:00:00","purseUsa":939851,"positionAtFinish":4},{"trackName":"NAGOYA","raceName":"Kakitsubata Kinen","grade":" ","raceDate":"February, 24 2025 00:00:00","purseUsa":361761,"positionAtFinish":1},{"trackName":"TOKYO","raceName":"Negishi S.","grade":"3","raceDate":"February, 02 2025 00:00:00","purseUsa":489758,"positionAtFinish":2},{"trackName":"TOKYO","raceName":"Shimotsuki S.","grade":" ","raceDate":"November, 17 2024 00:00:00","purseUsa":270810,"positionAtFinish":1},{"trackName":"TOKYO","raceName":"TV Shizuoka Sho","grade":" ","raceDate":"October, 13 2024 00:00:00","purseUsa":217857,"positionAtFinish":1},{"trackName":"TOKYO","raceName":"BS Eleven Sho","grade":" ","raceDate":"May, 12 2024 00:00:00","purseUsa":224962,"positionAtFinish":6},{"trackName":"TOKYO","raceName":"Kamakura S.","grade":" ","raceDate":"April, 21 2024 00:00:00","purseUsa":226613,"positionAtFinish":2},{"trackName":"CHUKYO","raceName":"Suzuka Tokubetsu","grade":" ","raceDate":"March, 24 2024 00:00:00","purseUsa":194475,"positionAtFinish":1},{"trackName":"TOKYO","raceName":" ","grade":" ","raceDate":"January, 28 2024 00:00:00","purseUsa":146708,"positionAtFinish":3},{"trackName":"CHUKYO","raceName":"Narumi Tokubetsu","grade":" ","raceDate":"December, 03 2023 00:00:00","purseUsa":200620,"positionAtFinish":3},{"trackName":"CHUKYO","raceName":"India Trophy","grade":" ","raceDate":"July, 08 2023 00:00:00","purseUsa":207211,"positionAtFinish":7},{"trackName":"TOKYO","raceName":" ","grade":" ","raceDate":"April, 23 2023 00:00:00","purseUsa":110939,"positionAtFinish":1},{"trackName":"CHUKYO","raceName":" ","grade":" ","raceDate":"January, 21 2023 00:00:00","purseUsa":114843,"positionAtFinish":3},{"trackName":"CHUKYO","raceName":"Kantsubaki Sho","grade":" ","raceDate":"December, 18 2022 00:00:00","purseUsa":142829,"positionAtFinish":2},{"trackName":"CHUKYO","raceName":" ","grade":" ","raceDate":"September, 24 2022 00:00:00","purseUsa":69055,"positionAtFinish":1},{"trackName":"CHUKYO","raceName":" ","grade":" ","raceDate":"September, 10 2022 00:00:00","purseUsa":93987,"positionAtFinish":8}],"record":{"previousYear":{"starts":5,"earnings":410693,"show":0,"win":1,"place":1,"showP":"0","winP":"20","placeP":"20"},"breedersCup":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"currentYear":{"starts":4,"earnings":887539,"show":1,"win":2,"place":0,"showP":"25","winP":"50","placeP":"0"},"lifetime":{"starts":22,"earnings":1894625,"show":4,"win":8,"place":3,"showP":"18","winP":"36","placeP":"14"}},"yearlySummary":[{"showsP":"25","winsP":"50","placesP":"0","starts":4,"earnings":887539,"racingYear":2026,"shows":1,"wins":2,"places":0},{"showsP":"0","winsP":"20","placesP":"20","starts":5,"earnings":410693,"racingYear":2025,"shows":0,"wins":1,"places":1}],"morningLineOdds":[],"bio":"\u003cp\u003eLord Fons (JPN) joins an expanding roster of Japan-based horses that venture to the premiere races in the U.S. The trend is inspired in part by the overwhelming success of 2025 Longines Breeders’ Cup Classic (G1) winner Forever Young (JPN), who was third in the 2024 Kentucky Derby (G1). Two other competitors from Japan won Breeders’ Cup World Championship races in 2021– Marche Lorraine (JPN) (Longines Distaff) and Loves Only You (JPN) (Maker’s Mark Filly and Mare Turf).\u0026nbsp;\u0026nbsp;\u003c/p\u003e\u003cp\u003eRacing exclusively in his homeland, Lord Fons proved his ability in top-shelf competition when he won the 7-furlong Negishi Stakes (G3) in February. He was a\u0026nbsp;game second\u0026nbsp;in the race last year while racing on the outside and being impeded by a riderless runner. At the same distance, he held off the late challengers to capture the\u0026nbsp;Sakitama\u0026nbsp;Hai on June 24.\u0026nbsp;\u003c/p\u003e\u003cp\u003eAlthough winless at the Dirt Mile distance, Lord Fons showed his aptitude for it with a gallant third-place effort in the Kashiwa Kinen in May.\u0026nbsp;\u003c/p\u003e\u003cp\u003eTrainer Shogo Yasuda was the assistant trainer and exercise rider for Lord Fons’ sire Lord Kanaloa (JPN). He told global horse racing news network Idol Horse that Lord Fons is better suited for the Dirt Mile rather than a sprint because it is a two-turn race.\u0026nbsp;\u0026nbsp;\u003c/p\u003e","gradedStakesPoints":0,"regionWinnerBadges":[],"breederName":"K.I. Farm","uid":"blt9eecfb66bd7d0b3b","hasAutogeneratedPage":true,"url":"/redirect/horse/blt9eecfb66bd7d0b3b?ht=pre-entries","pageTitle":"Lord Fons (JPN)","jockeyName":"","ownerName":"Lord Horse Club Co. Ltd. (Tomoyuki Nakamura)","trainer":"Shogo Yasuda","country":{"uid":"bltddddd2aba803f27e","title":"Japan","abbreviation":"JPN","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blta6f52e264bde8855/61aa4c7d55cf14733fc5bc35/japan.png","alt":""}},"horseName":"Lord Fons","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt43920d8e01ab5222/6a7c734fafd7db1f5652a6e4/Contender_Photo_Lord_Fons.jpg"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt43920d8e01ab5222/6a7c734fafd7db1f5652a6e4/Contender_Photo_Lord_Fons.jpg"},"cta":null,"races":[{"uid":"blt830ffcd3734ad389","ContentTypeUid":"collection_race","challengeSeriesWinner":false,"isEligible":false,"eligibleRank":null,"finishPosition":null,"classicRanking":null,"postPosition":"","scratched":false,"win":"","place":"","show":"","deadHeat":false,"silks":null}],"isChallengeSeriesWinner":false,"silks":null,"isHoC":false,"year":2026,"isHistoricalEntry":false,"relatedArticles":[],"win":"","show":"","place":""},{"sireName":"Liam's Map","damName":"Atomic Blonde","sex":"Colt","color":"Gray or Roan","foalingDate":"February, 17 2023 00:00:00","age":3,"pastPerformances":[{"trackName":"SARATOGA","raceName":"DraftKings Travers S.","grade":"1","raceDate":"August, 29 2026 00:00:00","purseUsa":1250000,"positionAtFinish":2},{"trackName":"MONMOUTH PARK","raceName":"NYRA Bets Haskell S.","grade":"1","raceDate":"July, 18 2026 00:00:00","purseUsa":1005000,"positionAtFinish":2},{"trackName":"LAUREL PARK","raceName":"Preakness S.","grade":"1","raceDate":"May, 16 2026 00:00:00","purseUsa":2000000,"positionAtFinish":1},{"trackName":"AQUEDUCT","raceName":"Wood Memorial S. Presented by Resorts World Casino","grade":"2","raceDate":"April, 04 2026 00:00:00","purseUsa":750000,"positionAtFinish":5},{"trackName":"GULFSTREAM PARK","raceName":"Coolmore Fountain of Youth S.","grade":"2","raceDate":"February, 28 2026 00:00:00","purseUsa":425000,"positionAtFinish":5},{"trackName":"BELMONT AT THE BIG A","raceName":"Champagne S.","grade":"1","raceDate":"October, 04 2025 00:00:00","purseUsa":500000,"positionAtFinish":1},{"trackName":"SARATOGA","raceName":" ","grade":" ","raceDate":"August, 08 2025 00:00:00","purseUsa":80000,"positionAtFinish":1}],"record":{"previousYear":{"starts":2,"earnings":319000,"show":0,"win":2,"place":0,"showP":"0","winP":"100","placeP":"0"},"breedersCup":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"currentYear":{"starts":5,"earnings":1691520,"show":0,"win":1,"place":2,"showP":"0","winP":"20","placeP":"40"},"lifetime":{"starts":7,"earnings":2010520,"show":0,"win":3,"place":2,"showP":"0","winP":"43","placeP":"29"}},"yearlySummary":[{"showsP":"0","winsP":"20","placesP":"40","starts":5,"earnings":1691520,"racingYear":2026,"shows":0,"wins":1,"places":2},{"showsP":"0","winsP":"100","placesP":"0","starts":2,"earnings":319000,"racingYear":2025,"shows":0,"wins":2,"places":0}],"morningLineOdds":[],"bio":"\u003cp\u003eNapoleon Solo flaunted his speed and class as a juvenile in 2025, winning both of his starts, including the 1-mile Champagne Stakes (G1) in 1:34.57. \r\u003c/p\u003e\u003cp\u003eNow as a 3-year-old, he has continued to succeed in longer, two-turn routes, winning one of America's spring classics, the May 16 Preakness Stakes (G1). That defining performance in the 1 3/16-mile second leg of the Triple Crown came after a couple of fifth-place finishes to begin the year. \r\u003c/p\u003e\u003cp\u003eSold thereafter by owner Al Gold to Espoir USA but kept in the Chad Summers stable, Napoleon Solo was given a short freshening from that race, returning in the Haskell Stakes (G1) at Monmouth Park and running second, beaten just a half-length by Baby Vino after setting the pace in the 1 1/8-mile race. He then returned in the Travers (G1) at Saratoga, racing 1 ¼ miles for the first time, and again showed his staying power with a gritty runner-up finish to Leading Change. \r\u003c/p\u003e\u003cp\u003eA flashy gray and/or roan son of Liam's Map out of the stakes-winning Scat Daddy mare Atomic Blonde, Napoleon Solo is one of the country's leading 3-year-olds.\u0026nbsp;\u003c/p\u003e","gradedStakesPoints":22,"regionWinnerBadges":[],"breederName":"John D. Gunther \u0026 Eurowest Bloodstock","uid":"blt626b6b8da6a994f5","hasAutogeneratedPage":true,"url":"/redirect/horse/blt626b6b8da6a994f5?ht=pre-entries","pageTitle":"Napoleon Solo","jockeyName":"","ownerName":"Espoir USA, Inc. (Rifang Zhang)","trainer":"Chad Summers","country":{"uid":"blt1af49e3a6a89373f","title":"USA","abbreviation":"USA","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt9de45bbdff160673/60d219911e0505677a882fa1/USAFlag.png"}},"horseName":"Napoleon Solo","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blte912621050e17c57/68e7e602f0b3bd7984593826/Contender_Photo_Napoleon_Solo.jpg"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blte912621050e17c57/68e7e602f0b3bd7984593826/Contender_Photo_Napoleon_Solo.jpg"},"cta":null,"races":[{"uid":"blt830ffcd3734ad389","ContentTypeUid":"collection_race","challengeSeriesWinner":false,"isEligible":false,"eligibleRank":null,"finishPosition":null,"classicRanking":null,"postPosition":"","scratched":false,"win":"","place":"","show":"","deadHeat":false,"silks":null}],"isChallengeSeriesWinner":false,"silks":null,"isHoC":false,"year":2026,"isHistoricalEntry":false,"relatedArticles":[],"win":"","show":"","place":""},{"sireName":"Connect","damName":"Margarita Friday","sex":"Colt","color":"Bay","foalingDate":"January, 30 2022 00:00:00","age":4,"pastPerformances":[{"trackName":"BELMONT PARK","raceName":"Vosburgh S.","grade":"3","raceDate":"October, 01 2026 00:00:00","purseUsa":250000,"positionAtFinish":1},{"trackName":"SARATOGA","raceName":"Forego S.","grade":"1","raceDate":"August, 29 2026 00:00:00","purseUsa":500000,"positionAtFinish":2},{"trackName":"SARATOGA","raceName":"Alfred G. Vanderbilt S.","grade":"2","raceDate":"July, 25 2026 00:00:00","purseUsa":400000,"positionAtFinish":4},{"trackName":"BELMONT AT THE BIG A","raceName":" ","grade":" ","raceDate":"June, 28 2026 00:00:00","purseUsa":92000,"positionAtFinish":5},{"trackName":"BELMONT AT THE BIG A","raceName":" ","grade":" ","raceDate":"May, 22 2026 00:00:00","purseUsa":92000,"positionAtFinish":1},{"trackName":"CHURCHILL DOWNS","raceName":" ","grade":" ","raceDate":"April, 26 2026 00:00:00","purseUsa":141000,"positionAtFinish":4},{"trackName":"SARATOGA","raceName":"Amsterdam S. Presented by Albany Med Health System","grade":"2","raceDate":"July, 25 2025 00:00:00","purseUsa":200000,"positionAtFinish":5},{"trackName":"SARATOGA","raceName":"Woody Stephens S. Presented by Mohegan Sun","grade":"1","raceDate":"June, 07 2025 00:00:00","purseUsa":500000,"positionAtFinish":5},{"trackName":"AQUEDUCT","raceName":"Jimmy Winkfield S.","grade":" ","raceDate":"March, 15 2025 00:00:00","purseUsa":125000,"positionAtFinish":1},{"trackName":"AQUEDUCT","raceName":" ","grade":" ","raceDate":"February, 14 2025 00:00:00","purseUsa":82000,"positionAtFinish":1},{"trackName":"AQUEDUCT","raceName":" ","grade":" ","raceDate":"January, 11 2025 00:00:00","purseUsa":80000,"positionAtFinish":1},{"trackName":"CHURCHILL DOWNS","raceName":" ","grade":" ","raceDate":"November, 16 2024 00:00:00","purseUsa":120000,"positionAtFinish":9},{"trackName":"KEENELAND","raceName":" ","grade":" ","raceDate":"October, 11 2024 00:00:00","purseUsa":100000,"positionAtFinish":6},{"trackName":"SARATOGA","raceName":" ","grade":" ","raceDate":"August, 29 2024 00:00:00","purseUsa":100000,"positionAtFinish":4},{"trackName":"SARATOGA","raceName":" ","grade":" ","raceDate":"July, 27 2024 00:00:00","purseUsa":100000,"positionAtFinish":2},{"trackName":"BELMONT AT THE BIG A","raceName":" ","grade":" ","raceDate":"June, 15 2024 00:00:00","purseUsa":90000,"positionAtFinish":6}],"record":{"previousYear":{"starts":5,"earnings":185850,"show":0,"win":3,"place":0,"showP":"0","winP":"60","placeP":"0"},"breedersCup":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"currentYear":{"starts":6,"earnings":302830,"show":0,"win":2,"place":1,"showP":"0","winP":"33","placeP":"17"},"lifetime":{"starts":16,"earnings":518554,"show":0,"win":5,"place":2,"showP":"0","winP":"31","placeP":"13"}},"yearlySummary":[{"showsP":"0","winsP":"33","placesP":"17","starts":6,"earnings":302830,"racingYear":2026,"shows":0,"wins":2,"places":1},{"showsP":"0","winsP":"60","placesP":"0","starts":5,"earnings":185850,"racingYear":2025,"shows":0,"wins":3,"places":0}],"morningLineOdds":[],"bio":"\u003cp\u003eT Kraft solidified his place in the Cygames Breeders’ Cup Sprint (G1) when he held off a late challenge to take the “Win and You’re In” Vosburgh Stakes (G3) by a nose at Belmont Park on Oct. 1. The victory was his first at the graded level and followed his runner-up spot in the “Win and You’re In” Forego Stakes (G1) at Saratoga in August. \u0026nbsp;\r\u003c/p\u003e\u003cp\u003eThe Vosburgh was T Kraft’s best performance by various metrics including his career best 100 Beyer Figure. The 4-year-old colt went winless in five starts at two but improved to triumph in three consecutive Aqueduct races including a stakes race as a newly minted sophomore last year. He then went unplaced in Saratoga graded company. Scaling back to the Aqueduct allowance ranks, he gained the fourth of his five career wins on May 22. \u0026nbsp;\r\u003c/p\u003e\u003cp\u003eT Kraft was purchased for $110,000 at the 2023 Keeneland September Yearling Sale. His dam, Margarita Friday, also produced 2024 Sprint winner and champion sprinter Straight No Chaser. His sire Connect was exported for stallion duty in Turkey this year. \u0026nbsp;\r\u003c/p\u003e","gradedStakesPoints":0,"regionWinnerBadges":[],"breederName":"Dr. John Eaton \u0026 Dr. Steve Laymon","uid":"bltb9ce870c4e2aa830","hasAutogeneratedPage":true,"url":"/redirect/horse/bltb9ce870c4e2aa830?ht=pre-entries","pageTitle":"T Kraft","jockeyName":"","ownerName":"LRE Racing, LLC (Lee Einsidler)","trainer":"William I. Mott","country":{"uid":"blt1af49e3a6a89373f","title":"USA","abbreviation":"USA","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt9de45bbdff160673/60d219911e0505677a882fa1/USAFlag.png"}},"horseName":"T Kraft","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt8703fa7030fbe748/6abed03c646488bb79ec9a97/T_Kraft_-_Contender_-_2026.jpg"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt8703fa7030fbe748/6abed03c646488bb79ec9a97/T_Kraft_-_Contender_-_2026.jpg"},"cta":null,"races":[{"uid":"blt830ffcd3734ad389","ContentTypeUid":"collection_race","challengeSeriesWinner":false,"isEligible":false,"eligibleRank":null,"finishPosition":null,"classicRanking":null,"postPosition":"","scratched":false,"win":"","place":"","show":"","deadHeat":false,"silks":null}],"isChallengeSeriesWinner":true,"silks":null,"isHoC":false,"year":2026,"isHistoricalEntry":false,"relatedArticles":[],"win":"","show":"","place":""},{"sireName":"Copano Rickey (JPN)","damName":"T O Rachel (JPN)","sex":"Horse","color":"Bay","foalingDate":"May, 20 2021 00:00:00","age":5,"pastPerformances":[{"trackName":"SAPPORO","raceName":"Elm S.","grade":"3","raceDate":"August, 08 2026 00:00:00","purseUsa":456274,"positionAtFinish":3},{"trackName":"TOKYO","raceName":"Akhalteke S.","grade":" ","raceDate":"May, 30 2026 00:00:00","purseUsa":262446,"positionAtFinish":1},{"trackName":"TOKYO","raceName":"Oasis S.","grade":" ","raceDate":"April, 26 2026 00:00:00","purseUsa":286126,"positionAtFinish":2},{"trackName":"KYOTO","raceName":"Procyon S.","grade":"2","raceDate":"January, 25 2026 00:00:00","purseUsa":672197,"positionAtFinish":10},{"trackName":"NAKAYAMA","raceName":"Shiwasu S.","grade":" ","raceDate":"December, 14 2025 00:00:00","purseUsa":292676,"positionAtFinish":6},{"trackName":"HANSHIN","raceName":"Sirius S.","grade":"3","raceDate":"September, 27 2025 00:00:00","purseUsa":481571,"positionAtFinish":7},{"trackName":"CHUKYO","raceName":"Nagoyajo S.","grade":" ","raceDate":"August, 30 2025 00:00:00","purseUsa":284261,"positionAtFinish":1},{"trackName":"CHUKYO","raceName":"Seto S.","grade":" ","raceDate":"January, 25 2025 00:00:00","purseUsa":224633,"positionAtFinish":1},{"trackName":"NAKAYAMA","raceName":"Shofuku S.","grade":" ","raceDate":"January, 05 2025 00:00:00","purseUsa":222818,"positionAtFinish":5},{"trackName":"CHURCHILL DOWNS","raceName":"Kentucky Derby presented by Woodford Reserve","grade":"1","raceDate":"May, 04 2024 00:00:00","purseUsa":5000000,"positionAtFinish":5},{"trackName":"NAKAYAMA","raceName":"Fukuryu S.","grade":" ","raceDate":"March, 23 2024 00:00:00","purseUsa":225826,"positionAtFinish":1},{"trackName":"KYOTO","raceName":" ","grade":" ","raceDate":"January, 06 2024 00:00:00","purseUsa":81928,"positionAtFinish":1}],"record":{"previousYear":{"starts":5,"earnings":283533,"show":0,"win":2,"place":0,"showP":"0","winP":"40","placeP":"0"},"breedersCup":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"currentYear":{"starts":4,"earnings":261755,"show":1,"win":1,"place":1,"showP":"25","winP":"25","placeP":"25"},"lifetime":{"starts":12,"earnings":858627,"show":1,"win":5,"place":1,"showP":"8","winP":"42","placeP":"8"}},"yearlySummary":[{"showsP":"25","winsP":"25","placesP":"25","starts":4,"earnings":261755,"racingYear":2026,"shows":1,"wins":1,"places":1},{"showsP":"0","winsP":"40","placesP":"0","starts":5,"earnings":283533,"racingYear":2025,"shows":0,"wins":2,"places":0}],"morningLineOdds":[],"bio":"\u003cp\u003eT O Password will be making his second start in the U.S. after making the trip in 2024 for the Kentucky Derby (G1). His owner accepted the Derby invitation after T O Password banked qualifying points in his native Japan’s Fukuryu Stakes six weeks prior. \u0026nbsp;\r\u003c/p\u003e\u003cp\u003eAs a 48-1 longshot, T O Password rallied from far back in the 20-horse Kentucky Derby field and rallied through the stretch to be beaten just 6 ½ lengths. He then returned to his homeland and went to the sidelines until making his return to the races in early 2025. Racing sparingly, he won three more stakes and was third in the Elm Stakes (G3) on Aug. 8 in his most recent effort. \r\u003c/p\u003e\u003cp\u003eThe first part of his name reflects owner Tomoya Ozasa’s initials. Per Japan Racing Association rules, owners can register a name or sound that is used on all of their horses. \r\u003c/p\u003e\u003cp\u003eT O Password joins a growing list of Japan-based horses that have made their presence felt in the marquee races in the U.S. The trend is inspired in part by the overwhelming success of 2025 Champion Older Dirt Male and Longines Breeders’ Cup Classic (G1) winner Forever Young (JPN), who was third in the 2024 Kentucky Derby (G1). Two other racers from Japan have won Breeders’ Cup World Championship races-– Marche Lorraine (JPN) (Longines Distaff-G1) and Loves Only You (JPN) (Maker’s Mark Filly and Mare Turf-G1) in 2021.\u003c/p\u003e","gradedStakesPoints":0,"regionWinnerBadges":[],"breederName":"Yanagawa Bokujo","uid":"blt545095ee1cb4c2e4","hasAutogeneratedPage":true,"url":"/redirect/horse/blt545095ee1cb4c2e4?ht=pre-entries","pageTitle":"T O Password (JPN)","jockeyName":"","ownerName":"Tomoya Ozasa","trainer":"Daisuke Takayanagi","country":{"uid":"bltddddd2aba803f27e","title":"Japan","abbreviation":"JPN","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blta6f52e264bde8855/61aa4c7d55cf14733fc5bc35/japan.png","alt":""}},"horseName":"T O Password","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt558db5b956007989/6aabebdfd1556f7ef67283de/Contender_Photo_T_O_Password.jpg"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt558db5b956007989/6aabebdfd1556f7ef67283de/Contender_Photo_T_O_Password.jpg"},"cta":null,"races":[{"uid":"blt830ffcd3734ad389","ContentTypeUid":"collection_race","challengeSeriesWinner":false,"isEligible":false,"eligibleRank":null,"finishPosition":null,"classicRanking":null,"postPosition":"","scratched":false,"win":"","place":"","show":"","deadHeat":false,"silks":null}],"isChallengeSeriesWinner":false,"silks":null,"isHoC":false,"year":2026,"isHistoricalEntry":false,"relatedArticles":[],"win":"","show":"","place":""},{"sireName":"Vekoma","damName":"Spring Dance","sex":"Colt","color":"Bay","foalingDate":"May, 22 2022 00:00:00","age":4,"pastPerformances":[{"trackName":"PARX RACING","raceName":"Parx Dirt Mile S.","grade":" ","raceDate":"September, 19 2026 00:00:00","purseUsa":300000,"positionAtFinish":2},{"trackName":"MOUNTAINEER CASINO RACETRACK \u0026 RESORT","raceName":"West Virginia Governor's S.","grade":" ","raceDate":"August, 09 2026 00:00:00","purseUsa":200000,"positionAtFinish":1},{"trackName":"KEENELAND","raceName":"Hagyard Fayette S.","grade":"3","raceDate":"October, 25 2025 00:00:00","purseUsa":350000,"positionAtFinish":4},{"trackName":"REMINGTON PARK","raceName":"Oklahoma Derby","grade":"3","raceDate":"September, 28 2025 00:00:00","purseUsa":400000,"positionAtFinish":1},{"trackName":"SARATOGA","raceName":"DraftKings Travers S.","grade":"1","raceDate":"August, 23 2025 00:00:00","purseUsa":1250000,"positionAtFinish":2},{"trackName":"MONMOUTH PARK","raceName":"NYRA Bets Haskell S.","grade":"1","raceDate":"July, 19 2025 00:00:00","purseUsa":1017500,"positionAtFinish":4},{"trackName":"MONMOUTH PARK","raceName":"NYRA Bets Pegasus S.","grade":" ","raceDate":"June, 14 2025 00:00:00","purseUsa":150000,"positionAtFinish":1},{"trackName":"CHURCHILL DOWNS","raceName":" ","grade":" ","raceDate":"May, 03 2025 00:00:00","purseUsa":127000,"positionAtFinish":7},{"trackName":"KEENELAND","raceName":"Stonestreet Lexington S.","grade":"3","raceDate":"April, 12 2025 00:00:00","purseUsa":400000,"positionAtFinish":2},{"trackName":"CHURCHILL DOWNS","raceName":"Street Sense S.","grade":"3","raceDate":"October, 27 2024 00:00:00","purseUsa":200000,"positionAtFinish":5},{"trackName":"KEENELAND","raceName":" ","grade":" ","raceDate":"October, 09 2024 00:00:00","purseUsa":100000,"positionAtFinish":1},{"trackName":"CHURCHILL DOWNS","raceName":" ","grade":" ","raceDate":"September, 12 2024 00:00:00","purseUsa":120000,"positionAtFinish":7},{"trackName":"HORSESHOE INDIANAPOLIS","raceName":" ","grade":" ","raceDate":"August, 07 2024 00:00:00","purseUsa":32000,"positionAtFinish":3}],"record":{"previousYear":{"starts":7,"earnings":725633,"show":0,"win":2,"place":2,"showP":"0","winP":"29","placeP":"29"},"breedersCup":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"currentYear":{"starts":2,"earnings":177200,"show":0,"win":1,"place":1,"showP":"0","winP":"50","placeP":"50"},"lifetime":{"starts":13,"earnings":969706,"show":1,"win":4,"place":3,"showP":"8","winP":"31","placeP":"23"}},"yearlySummary":[{"showsP":"0","winsP":"50","placesP":"50","starts":2,"earnings":177200,"racingYear":2026,"shows":0,"wins":1,"places":1},{"showsP":"0","winsP":"29","placesP":"29","starts":7,"earnings":725633,"racingYear":2025,"shows":0,"wins":2,"places":2}],"morningLineOdds":[],"bio":"\u003cp\u003eA consistent performer regardless of the venue, Bracket Buster has raced at eight tracks in seven states while doing some of his best work at his Keeneland home base.\u0026nbsp;\u003c/p\u003e\u003cp\u003eAt the 2024 October meet, he scored his initial career triumph as a longshot in his third start. The following spring, he set the pace in the Lexington Stakes (G3) before being passed late to be the runner-up. At last year’s fall meeting, Bracket Buster was a close fourth in the Fayette Stakes (G3).\u0026nbsp; He then went to the sidelines and returned with a 15-length romp in the West Virginia Governor’s Stakes (Listed) at Mountaineer on Aug. 9. In what is likely his final tune-up for the Breeders’ Cup, Bracket Buster was runner-up in the Parx Dirt Mile Stakes (Listed) on Sept. 19.\u0026nbsp;\u003c/p\u003e\u003cp\u003eBracket Buster’s best performance was arguably in defeat when he matched strides with eventual Horse of the Year Sovereignty through the upper stretch of the 2025 Travers Stakes (G1) at Saratoga to ultimately finish second. The next month he captured his lone graded victory in the Oklahoma Derby (G3) at Remington Park. \u0026nbsp;\u003c/p\u003e\u003cp\u003eBracket Buster was sourced by current co-owner BBN Racing for $125,000 from the 2023 Keeneland September Yearling Sale. He then was sold for $425,000 at the Keeneland Championship Sale at Del Mar held in conjunction with Breeders’ Cup week. BBN bought back in as a partner.\u0026nbsp;\u003c/p\u003e","gradedStakesPoints":0,"regionWinnerBadges":[],"breederName":"David Baxter","uid":"blt47b28d28e7e98ae2","hasAutogeneratedPage":true,"url":"/redirect/horse/blt47b28d28e7e98ae2?ht=pre-entries","pageTitle":"Bracket Buster","jockeyName":"","ownerName":"BBN Racing, LLC (Ann Braxton Lynch) \u0026 Bowen Thoroughbred Racing LLC (Brandon Bowen)","trainer":"Vicki Oliver","country":{"uid":"blt1af49e3a6a89373f","title":"USA","abbreviation":"USA","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt9de45bbdff160673/60d219911e0505677a882fa1/USAFlag.png"}},"horseName":"Bracket Buster","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt6d8cfc065cc1668c/68ed5eb7875fdef5718e7f5e/Contender_Photo_Bracket_Buster.jpg"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt6d8cfc065cc1668c/68ed5eb7875fdef5718e7f5e/Contender_Photo_Bracket_Buster.jpg"},"cta":null,"races":[{"uid":"blt830ffcd3734ad389","ContentTypeUid":"collection_race","challengeSeriesWinner":false,"isEligible":true,"eligibleRank":13,"finishPosition":null,"classicRanking":null,"postPosition":"13","scratched":false,"win":"","place":"","show":"","deadHeat":false,"silks":null}],"isChallengeSeriesWinner":false,"silks":null,"isHoC":false,"year":2026,"isHistoricalEntry":false,"relatedArticles":[],"win":"","show":"","place":""},{"sireName":"Coal Front","damName":"Wolfblade","sex":"Colt","color":"Dark Bay or Brown","foalingDate":"April, 06 2022 00:00:00","age":4,"pastPerformances":[{"trackName":"CHURCHILL DOWNS","raceName":"Ack Ack S.","grade":"3","raceDate":"September, 26 2026 00:00:00","purseUsa":400000,"positionAtFinish":2},{"trackName":"ELLIS PARK","raceName":"R.A. \"Cowboy\" Jones S. Presented by Coady Media","grade":" ","raceDate":"August, 09 2026 00:00:00","purseUsa":200000,"positionAtFinish":3},{"trackName":"CHURCHILL DOWNS","raceName":"Hanshin S. Presented by JRA","grade":"3","raceDate":"June, 28 2026 00:00:00","purseUsa":300000,"positionAtFinish":4},{"trackName":"CHURCHILL DOWNS","raceName":"Arlington S.","grade":"3","raceDate":"May, 30 2026 00:00:00","purseUsa":275000,"positionAtFinish":6},{"trackName":"OAKLAWN PARK","raceName":"Lake Ouachita S.","grade":" ","raceDate":"May, 02 2026 00:00:00","purseUsa":200000,"positionAtFinish":2},{"trackName":"HORSESHOE INDIANAPOLIS","raceName":"Indiana Derby","grade":"3","raceDate":"July, 05 2025 00:00:00","purseUsa":300000,"positionAtFinish":2},{"trackName":"CHURCHILL DOWNS","raceName":"Matt Winn S.","grade":"3","raceDate":"June, 08 2025 00:00:00","purseUsa":400000,"positionAtFinish":3},{"trackName":"CHURCHILL DOWNS","raceName":"Kentucky Derby presented by Woodford Reserve","grade":"1","raceDate":"May, 03 2025 00:00:00","purseUsa":5000000,"positionAtFinish":11},{"trackName":"OAKLAWN PARK","raceName":"Arkansas Derby","grade":"1","raceDate":"March, 29 2025 00:00:00","purseUsa":1500000,"positionAtFinish":3},{"trackName":"OAKLAWN PARK","raceName":"Rebel S.","grade":"2","raceDate":"February, 23 2025 00:00:00","purseUsa":1250000,"positionAtFinish":1},{"trackName":"OAKLAWN PARK","raceName":"Smarty Jones S.","grade":" ","raceDate":"January, 04 2025 00:00:00","purseUsa":250000,"positionAtFinish":1},{"trackName":"REMINGTON PARK","raceName":"Remington Springboard Mile S.","grade":" ","raceDate":"December, 13 2024 00:00:00","purseUsa":300000,"positionAtFinish":1},{"trackName":"DELTA DOWNS","raceName":"Jean Lafitte S.","grade":" ","raceDate":"November, 08 2024 00:00:00","purseUsa":100000,"positionAtFinish":1},{"trackName":"KEENELAND","raceName":" ","grade":" ","raceDate":"October, 12 2024 00:00:00","purseUsa":110000,"positionAtFinish":7},{"trackName":"KENTUCKY DOWNS","raceName":"Kentucky Downs Juvenile Mile S.","grade":" ","raceDate":"September, 08 2024 00:00:00","purseUsa":1000000,"positionAtFinish":4},{"trackName":"EVANGELINE DOWNS","raceName":" ","grade":" ","raceDate":"July, 25 2024 00:00:00","purseUsa":30000,"positionAtFinish":1}],"record":{"previousYear":{"starts":6,"earnings":980050,"show":2,"win":2,"place":1,"showP":"33","winP":"33","placeP":"17"},"breedersCup":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"currentYear":{"starts":5,"earnings":154475,"show":1,"win":0,"place":2,"showP":"20","winP":"0","placeP":"40"},"lifetime":{"starts":16,"earnings":1442150,"show":3,"win":5,"place":3,"showP":"19","winP":"31","placeP":"19"}},"yearlySummary":[{"showsP":"20","winsP":"0","placesP":"40","starts":5,"earnings":154475,"racingYear":2026,"shows":1,"wins":0,"places":2},{"showsP":"33","winsP":"33","placesP":"17","starts":6,"earnings":980050,"racingYear":2025,"shows":2,"wins":2,"places":1}],"morningLineOdds":[],"bio":"\u003cp\u003eCoal Battle, who has crisscrossed much of the U.S. while gaining millionaire status, is being pointed to his Breeders’ Cup debut in the $1 million Dirt Mile (G1). In his 15 starts, Coal Battle has raced at nine tracks in Louisiana, Oklahoma, Arkansas, Indiana and Kentucky. \r\u003c/p\u003e\u003cp\u003eFoaled in Kentucky, he went to the 2023 Texas Thoroughbred Association yearling sale and was sold for $70,000. About a year later, he debuted as a winner at Louisiana’s Evangeline Downs. After two subsequent grass starts, he capped a four-race winning streak on dirt in the Rebel Stakes (G2) at Oaklawn Park. A third in the Arkansas Derby (G1) secured his spot in the Kentucky Derby (G1) in which he was unplaced. He closed his 3-year-old campaign with two placings in graded stakes at Churchill Downs and Horseshoe Indianapolis. \u0026nbsp;\r\u003c/p\u003e\u003cp\u003eAfter a series of minor setbacks, Coal Battle returned to serious training in February at Oaklawn Park. After 10 months out of action, he was runner-up in the track’s Lake Ouachita Stakes in May. Coal Battle made his next two starts at Churchill Downs finishing sixth in the Arlington (G3) on turf and fourth in the Hanshin (G3) in a return to dirt. \r\u003c/p\u003e\u003cp\u003eSix weeks after the Hanshin on Aug. 9, Coal Battle made his Ellis Park debut and finished third beaten 1 1/2 lengths in the R.A. ”Cowboy” Jones going a mile on the dirt. \r\u003c/p\u003e\u003cp\u003eReturning to Churchill Downs for the 1-mile Ack Ack (G3) on Sept. 26, Coal Battle mounted a late charge that came up a head short of catching the victorious Bishops Bay. \r\u003c/p\u003e\u003cp\u003eCoal Battle’s sire is Coal Front, a graded stakes winner at the 1-mile distance and a starter in the 2019 Big Ass Fans Dirt Mile (G1) at Santa Anita. \u0026nbsp;\u003c/p\u003e","gradedStakesPoints":0,"regionWinnerBadges":[],"breederName":"Hume Wornall \u0026 Jay Adcock","uid":"bltb8b76853bf9b4936","hasAutogeneratedPage":true,"url":"/redirect/horse/bltb8b76853bf9b4936?ht=pre-entries","pageTitle":"Coal Battle","jockeyName":"","ownerName":"Norman Stables LLC (Robert Norman)","trainer":"Lonnie Briley","country":{"uid":"blt1af49e3a6a89373f","title":"USA","abbreviation":"USA","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt9de45bbdff160673/60d219911e0505677a882fa1/USAFlag.png"}},"horseName":"Coal Battle","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt9ac12dc97b6f05a3/6a70c25c89eb5c699aab1950/Contender_Photo_Coal_Battle.jpg"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt9ac12dc97b6f05a3/6a70c25c89eb5c699aab1950/Contender_Photo_Coal_Battle.jpg"},"cta":null,"races":[{"uid":"blt830ffcd3734ad389","ContentTypeUid":"collection_race","challengeSeriesWinner":false,"isEligible":true,"eligibleRank":14,"finishPosition":null,"classicRanking":null,"postPosition":"14","scratched":false,"win":"","place":"","show":"","deadHeat":false,"silks":null}],"isChallengeSeriesWinner":false,"silks":null,"isHoC":false,"year":2026,"isHistoricalEntry":false,"relatedArticles":[],"win":"","show":"","place":""},{"sireName":"Speightstown","damName":"Tempers Rising","sex":"Colt","color":"Bay","foalingDate":"March, 05 2022 00:00:00","age":4,"pastPerformances":[{"trackName":"CHURCHILL DOWNS","raceName":"Ack Ack S.","grade":"3","raceDate":"September, 26 2026 00:00:00","purseUsa":400000,"positionAtFinish":3},{"trackName":"ELLIS PARK","raceName":"R.A. \"Cowboy\" Jones S. Presented by Coady Media","grade":" ","raceDate":"August, 09 2026 00:00:00","purseUsa":200000,"positionAtFinish":1},{"trackName":"CHURCHILL DOWNS","raceName":"Hanshin S. Presented by JRA","grade":"3","raceDate":"June, 28 2026 00:00:00","purseUsa":300000,"positionAtFinish":2},{"trackName":"CHURCHILL DOWNS","raceName":" ","grade":" ","raceDate":"April, 28 2026 00:00:00","purseUsa":141000,"positionAtFinish":2},{"trackName":"GULFSTREAM PARK","raceName":"Army Mule S.","grade":" ","raceDate":"March, 28 2026 00:00:00","purseUsa":175000,"positionAtFinish":7},{"trackName":"KEENELAND","raceName":"Perryville S.","grade":"3","raceDate":"October, 18 2025 00:00:00","purseUsa":350000,"positionAtFinish":3},{"trackName":"HOLLYWOOD CASINO AT CHARLES TOWN RACES","raceName":"Robert Hilton Memorial S.","grade":" ","raceDate":"August, 22 2025 00:00:00","purseUsa":500000,"positionAtFinish":8},{"trackName":"CHURCHILL DOWNS","raceName":"Kentucky Derby presented by Woodford Reserve","grade":"1","raceDate":"May, 03 2025 00:00:00","purseUsa":5000000,"positionAtFinish":5},{"trackName":"KEENELAND","raceName":"Toyota Blue Grass S.","grade":"1","raceDate":"April, 08 2025 00:00:00","purseUsa":1250000,"positionAtFinish":6},{"trackName":"TAMPA BAY DOWNS","raceName":"Lambholm South Tampa Bay Derby","grade":"3","raceDate":"March, 08 2025 00:00:00","purseUsa":400000,"positionAtFinish":1},{"trackName":"TAMPA BAY DOWNS","raceName":"Sam F. Davis S.","grade":" ","raceDate":"February, 08 2025 00:00:00","purseUsa":250000,"positionAtFinish":2},{"trackName":"TAMPA BAY DOWNS","raceName":"Pasco S.","grade":" ","raceDate":"January, 11 2025 00:00:00","purseUsa":150000,"positionAtFinish":1},{"trackName":"CHURCHILL DOWNS","raceName":"Iroquois S.","grade":"3","raceDate":"September, 14 2024 00:00:00","purseUsa":300000,"positionAtFinish":2},{"trackName":"ELLIS PARK","raceName":"Ellis Park Juvenile S.","grade":" ","raceDate":"August, 11 2024 00:00:00","purseUsa":175000,"positionAtFinish":1},{"trackName":"CHURCHILL DOWNS","raceName":" ","grade":" ","raceDate":"June, 20 2024 00:00:00","purseUsa":120000,"positionAtFinish":1}],"record":{"previousYear":{"starts":7,"earnings":462875,"show":1,"win":1,"place":1,"showP":"14","winP":"14","placeP":"14"},"breedersCup":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"currentYear":{"starts":5,"earnings":247360,"show":1,"win":1,"place":2,"showP":"20","winP":"20","placeP":"40"},"lifetime":{"starts":15,"earnings":942295,"show":2,"win":4,"place":4,"showP":"13","winP":"27","placeP":"27"}},"yearlySummary":[{"showsP":"20","winsP":"20","placesP":"40","starts":5,"earnings":247360,"racingYear":2026,"shows":1,"wins":1,"places":2},{"showsP":"14","winsP":"14","placesP":"14","starts":7,"earnings":462875,"racingYear":2025,"shows":1,"wins":1,"places":1}],"morningLineOdds":[],"bio":"\u003cp\u003eOwen Almighty flashed his brilliance early. The son of champion and Breeders’ Cup Sprint (G1) winner Speightstown zipped to a 3 ½-length victory in his career debut in a 5 ½-furlong Churchill Downs race on June 20, 2024. Then his talent at longer distances, including his Tampa Bay Derby (G3) triumph in March, inspired dreams of the Kentucky Derby (G1). \u0026nbsp;A month after that score, the colt tried Keeneland’s Toyota Blue Grass Stakes (G1) in which he settled behind the front-runner before fading late and finishing last. The Derby dream was nearly derailed but because the colt had plenty of qualifying points, his connections opted to enter. \u0026nbsp;\r\u003c/p\u003e\u003cp\u003eAs a 40-1 longshot in the Derby field of 19, Owen Almighty pressed the pace and grabbed a brief advantage at the 1-mile mark before settling for fifth. He capitalized on his miler speed as the runner-up in the Hanshin Stakes (G3) at Churchill Downs in June and as the victor in the R.A. “Cowboy” Jones at Ellis Park in August. \r\u003c/p\u003e\u003cp\u003eOwen Almighty was back in action Sept. 26 at Churchill Downs in the 1-mile Ack Ack (G3). Getting a ground-saving trip, Owen Almighty rallied late to finish third of seven beaten a length by Bishops Bay. \r\u003c/p\u003e\u003cp\u003eOwen Almighty was purchased for $350,000 at Fasig-Tipton’s Saratoga Select Yearling Sale by current owner Travis Boersma’s Flying Dutchman Breeding and Racing under their Boardshorts Stables banner. The colt is named for one of Boersma’s five sons. \u0026nbsp;\u003c/p\u003e","gradedStakesPoints":3,"regionWinnerBadges":[],"breederName":"Mark Stanley","uid":"blt9203f0f1d9e9d60c","hasAutogeneratedPage":true,"url":"/redirect/horse/blt9203f0f1d9e9d60c?ht=pre-entries","pageTitle":"Owen Almighty","jockeyName":"","ownerName":"Flying Dutchmen (Travis Boersma)","trainer":"Brian A. Lynch","country":{"uid":"blt1af49e3a6a89373f","title":"USA","abbreviati