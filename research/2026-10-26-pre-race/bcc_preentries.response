ositionAtFinish":9},{"trackName":"OAKLAWN PARK","raceName":"Bathhouse Row S.","grade":" ","raceDate":"April, 19 2025 00:00:00","purseUsa":200000,"positionAtFinish":4},{"trackName":"WOODBINE","raceName":" ","grade":" ","raceDate":"September, 17 2023 00:00:00","purseUsa":111600,"positionAtFinish":1},{"trackName":"OAKLAWN PARK","raceName":" ","grade":" ","raceDate":"March, 14 2025 00:00:00","purseUsa":130000,"positionAtFinish":2},{"trackName":"OAKLAWN PARK","raceName":" ","grade":" ","raceDate":"February, 08 2025 00:00:00","purseUsa":110000,"positionAtFinish":1}],"record":{"previousYear":{"starts":8,"earnings":139747,"show":0,"win":1,"place":2,"showP":"0","winP":"13","placeP":"25"},"breedersCup":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"currentYear":{"starts":7,"earnings":623892,"show":0,"win":4,"place":1,"showP":"0","winP":"57","placeP":"14"},"lifetime":{"starts":15,"earnings":763639,"show":0,"win":5,"place":3,"showP":"0","winP":"33","placeP":"20"}},"yearlySummary":[{"showsP":"0","winsP":"57","placesP":"14","starts":7,"earnings":623892,"racingYear":2026,"shows":0,"wins":4,"places":1},{"showsP":"0","winsP":"13","placesP":"25","starts":8,"earnings":139747,"racingYear":2025,"shows":0,"wins":1,"places":2}],"morningLineOdds":[],"bio":"\u003cp\u003eCue the puns and praise Hymn for his victory in the Forego Stakes (G1) at Saratoga on Aug. 29. As a “Win and You’re In” race, Hymn has fees-paid entry into the Breeders’ Cup Dirt Mile (G1). However, trainer Ron Moquett could opt for the Cygames Breeders’ Cup Sprint (G1), especially if Hymn takes Keeneland’s 6-furlong Phoenix Stakes (G2) on Oct. 2, a Breeders’ Cup Challenge Race for the Sprint. \u0026nbsp;\r\u003c/p\u003e\u003cp\u003eMoquett won the Sprint at Keeneland in 2020 with eventual champion Whitmore, who prepped for the race in the Phoenix four consecutive years. \u0026nbsp; \r\u003c/p\u003e\u003cp\u003eHymn won at first asking in early 2025 at Oaklawn Park but had nine straight losses before winning again on April 10 at the same track. In quick succession he captured a Churchill Downs allowance race, took Laurel Park’s Frank J. De Francis Memorial Dash Stakes (Listed) by 5 ½ lengths, was runner-up in the Alfred G. Vanderbilt Stakes (G2) at Saratoga and then won the Forego. After the race when interviewed in the winner’s circle, Moquett credited the reversal of form to having Hymn gelded a few races before the Forego. \r\u003c/p\u003e\u003cp\u003eHymn was offered at the 2023 Keeneland September Yearling Sale but was listed as unsold on a final bid of $140,000.\u0026nbsp;\u003c/p\u003e","gradedStakesPoints":14,"regionWinnerBadges":[],"breederName":"Fleur de Lis Stables","uid":"blt08648a9ea93fa7bc","hasAutogeneratedPage":true,"url":"/redirect/horse/blt08648a9ea93fa7bc?ht=pre-entries","pageTitle":"Hymn","jockeyName":"","ownerName":"Fleur De Lis Stables (Naveed Chowhan), William S. Sparks\u0026 Bret Jones","trainer":"Ron Moquett","country":{"uid":"blt1af49e3a6a89373f","title":"USA","abbreviation":"USA","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt9de45bbdff160673/60d219911e0505677a882fa1/USAFlag.png"}},"horseName":"Hymn","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/bltdb9db9356e5be1ad/6a972a48de239504fee840b5/Contender_Photo_Hymn.jpg"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/bltdb9db9356e5be1ad/6a972a48de239504fee840b5/Contender_Photo_Hymn.jpg"},"cta":null,"races":[{"uid":"bltf6749e738cff0ef2","ContentTypeUid":"collection_race","challengeSeriesWinner":false,"isEligible":false,"eligibleRank":null,"finishPosition":null,"classicRanking":null,"postPosition":"","scratched":false,"win":"","place":"","show":"","deadHeat":false,"silks":null}],"isChallengeSeriesWinner":true,"silks":null,"isHoC":false,"year":2026,"isHistoricalEntry":false,"relatedArticles":[],"win":"","show":"","place":""},{"sireName":"Collected","damName":"Joyful Dreams","sex":"Gelding","color":"Bay","foalingDate":"April, 08 2022 00:00:00","age":4,"pastPerformances":[{"trackName":"DEL MAR","raceName":"Pacific Classic S.","grade":"1","raceDate":"August, 22 2026 00:00:00","purseUsa":1000000,"positionAtFinish":3},{"trackName":"DEL MAR","raceName":"Pat O'Brien S.","grade":"2","raceDate":"August, 29 2026 00:00:00","purseUsa":250000,"positionAtFinish":1},{"trackName":"OAKLAWN PARK","raceName":"Oaklawn Mile S.","grade":"3","raceDate":"March, 28 2026 00:00:00","purseUsa":500000,"positionAtFinish":4},{"trackName":"DEL MAR","raceName":"San Diego H.","grade":"2","raceDate":"July, 18 2026 00:00:00","purseUsa":300000,"positionAtFinish":3},{"trackName":"GULFSTREAM PARK","raceName":"Pegasus World Cup Invitational S.","grade":"1","raceDate":"January, 24 2026 00:00:00","purseUsa":3000000,"positionAtFinish":3},{"trackName":"SANTA ANITA PARK","raceName":" ","grade":" ","raceDate":"June, 07 2026 00:00:00","purseUsa":68000,"positionAtFinish":1},{"trackName":"DEL MAR","raceName":"Breeders' Cup Dirt Mile","grade":"1","raceDate":"November, 01 2025 00:00:00","purseUsa":1000000,"positionAtFinish":5},{"trackName":"KEENELAND","raceName":" ","grade":" ","raceDate":"April, 12 2026 00:00:00","purseUsa":130000,"positionAtFinish":4},{"trackName":"SANTA ANITA PARK","raceName":" ","grade":" ","raceDate":"March, 14 2026 00:00:00","purseUsa":71000,"positionAtFinish":6},{"trackName":"DEL MAR","raceName":"Caesars Sportsbook Oceanside S.","grade":" ","raceDate":"July, 18 2025 00:00:00","purseUsa":100000,"positionAtFinish":2},{"trackName":"CHURCHILL DOWNS","raceName":"American Turf S. presented by Ford","grade":"1","raceDate":"May, 03 2025 00:00:00","purseUsa":1000000,"positionAtFinish":6},{"trackName":"DEL MAR","raceName":"Breeders' Cup Juvenile Turf","grade":"1","raceDate":"November, 01 2024 00:00:00","purseUsa":1000000,"positionAtFinish":2},{"trackName":"SANTA ANITA PARK","raceName":"Goodwood S.","grade":"1","raceDate":"September, 27 2025 00:00:00","purseUsa":300000,"positionAtFinish":2},{"trackName":"SANTA ANITA PARK","raceName":"Zuma Beach S.","grade":"3","raceDate":"October, 06 2024 00:00:00","purseUsa":100000,"positionAtFinish":2},{"trackName":"DEL MAR","raceName":" ","grade":" ","raceDate":"September, 07 2024 00:00:00","purseUsa":75000,"positionAtFinish":1},{"trackName":"DEL MAR","raceName":" ","grade":" ","raceDate":"September, 01 2025 00:00:00","purseUsa":82000,"positionAtFinish":1},{"trackName":"DEL MAR","raceName":" ","grade":" ","raceDate":"August, 02 2024 00:00:00","purseUsa":75000,"positionAtFinish":4},{"trackName":"DEL MAR","raceName":"Big Ass Fans Breeders' Cup Dirt Mile","grade":"1","raceDate":"November, 02 2024 00:00:00","purseUsa":1000000,"positionAtFinish":1},{"trackName":"DEL MAR","raceName":"FanDuel Racing Pacific Classic S.","grade":"1","raceDate":"August, 31 2024 00:00:00","purseUsa":1000000,"positionAtFinish":2},{"trackName":"DEL MAR","raceName":" ","grade":" ","raceDate":"August, 03 2024 00:00:00","purseUsa":76000,"positionAtFinish":1},{"trackName":"SAN ISIDRO","raceName":"Miguel Alfredo Martinez de Hoz","grade":"1","raceDate":"February, 03 2024 00:00:00","purseUsa":36262,"positionAtFinish":7},{"trackName":"SAN ISIDRO","raceName":"Botafogo","grade":"3","raceDate":"January, 13 2024 00:00:00","purseUsa":7457,"positionAtFinish":2},{"trackName":"SAN ISIDRO","raceName":"Tresiete","grade":" ","raceDate":"December, 20 2023 00:00:00","purseUsa":7471,"positionAtFinish":1},{"trackName":"SAN ISIDRO","raceName":"Embrujo","grade":" ","raceDate":"November, 17 2023 00:00:00","purseUsa":15843,"positionAtFinish":3}],"record":{"previousYear":{"starts":2,"earnings":29230,"show":0,"win":0,"place":1,"showP":"0","winP":"0","placeP":"50"},"breedersCup":{"starts":1,"earnings":170000,"show":0,"win":0,"place":1,"showP":"0","winP":"0","placeP":"100"},"currentYear":{"starts":5,"earnings":234395,"show":1,"win":2,"place":0,"showP":"20","winP":"40","placeP":"0"},"lifetime":{"starts":11,"earnings":543125,"show":1,"win":4,"place":2,"showP":"9","winP":"36","placeP":"18"}},"yearlySummary":[{"showsP":"20","winsP":"40","placesP":"0","starts":5,"earnings":234395,"racingYear":2026,"shows":1,"wins":2,"places":0},{"showsP":"0","winsP":"0","placesP":"50","starts":2,"earnings":29230,"racingYear":2025,"shows":0,"wins":0,"places":1}],"morningLineOdds":[],"bio":"\u003cp\u003eIron Man Cal returns to racing’s grandest stage in a different form than his previous appearance. In the 2024 Breeders’ Cup World Championships at Del Mar, he was a 2-year-old colt who was narrowly defeated as a longshot in the Juvenile Turf (G1). He returns as a 4-year-old gelding in the Dirt Mile (G1) at Keeneland after winning the “Win and You’re In” Pat O’Brien Stakes (G2) at Del Mar on Aug. 29. \r\u003c/p\u003e\u003cp\u003e“I think his style of running fits the dirt better,” trainer D’Amato said. “He has steady speed and he doesn’t have to quicken as much on the dirt. When you’re on the grass, you have to show more of a turn of foot.” \u0026nbsp;\r\u003c/p\u003e\u003cp\u003eSuccessful on grass with three victories including Santa Anita’s Zuma Beach (G3) in 2024, Iron Man Cal was third in the San Diego Handicap (G2) at Del Mar on July 18 in his only dirt appearance besides the Pat O’Brien. He was gelded this past spring and scored his first victory with that designation on June 7 in a Santa Anita allowance race. \r\u003c/p\u003e\u003cp\u003eIron Man Cal was acquired by current owner Little Red Feather Racing for $130,000 at the 2023 Keeneland September Yearling Sale. \u0026nbsp;\u003c/p\u003e","gradedStakesPoints":18,"regionWinnerBadges":[],"breederName":"Brereton C. Jones","uid":"blteff9029a3b094cbd","hasAutogeneratedPage":true,"url":"/redirect/horse/blteff9029a3b094cbd?ht=pre-entries","pageTitle":"Iron Man Cal","jockeyName":"","ownerName":"Little Red Feather Racing (William Koch) \u0026 Madaket Stables, LLC (Sol Kumin)","trainer":"Philip D'Amato","country":{"uid":"blt1af49e3a6a89373f","title":"USA","abbreviation":"USA","flag":{"src":"