itionAtFinish":3},{"trackName":"TURFWAY PARK","raceName":"Jeff Ruby Steaks","grade":"3","raceDate":"April, 02 2022 00:00:00","purseUsa":600000,"positionAtFinish":6},{"trackName":"SANTA ANITA PARK","raceName":"San Felipe S.","grade":"2","raceDate":"March, 05 2022 00:00:00","purseUsa":400000,"positionAtFinish":5},{"trackName":"SANTA ANITA PARK","raceName":"Robert B. Lewis S.","grade":"3","raceDate":"February, 06 2022 00:00:00","purseUsa":200000,"positionAtFinish":2},{"trackName":"SANTA ANITA PARK","raceName":"Eddie Logan S.","grade":" ","raceDate":"January, 02 2022 00:00:00","purseUsa":100000,"positionAtFinish":1},{"trackName":"DEL MAR","raceName":"Cecil B. DeMille S.","grade":"3","raceDate":"November, 28 2021 00:00:00","purseUsa":100000,"positionAtFinish":3},{"trackName":"DEL MAR","raceName":" ","grade":" ","raceDate":"November, 07 2021 00:00:00","purseUsa":70000,"positionAtFinish":1},{"trackName":"SANTA ANITA PARK","raceName":" ","grade":" ","raceDate":"October, 24 2021 00:00:00","purseUsa":61000,"positionAtFinish":2},{"trackName":"SANTA ANITA PARK","raceName":" ","grade":" ","raceDate":"October, 15 2021 00:00:00","purseUsa":61000,"positionAtFinish":5},{"trackName":"DEL MAR","raceName":" ","grade":" ","raceDate":"August, 28 2021 00:00:00","purseUsa":70000,"positionAtFinish":3},{"trackName":"DEL MAR","raceName":" ","grade":" ","raceDate":"August, 01 2021 00:00:00","purseUsa":70000,"positionAtFinish":5}],"record":{"previousYear":{"starts":9,"earnings":320500,"show":3,"win":2,"place":2,"showP":"33","winP":"22","placeP":"22"},"breedersCup":{"starts":1,"earnings":0,"show":0,"win":0,"place":0,"showP":"0","winP":"0","placeP":"0"},"currentYear":{"starts":6,"earnings":212020,"show":1,"win":1,"place":1,"showP":"17","winP":"17","placeP":"17"},"lifetime":{"starts":45,"earnings":1568856,"show":10,"win":8,"place":6,"showP":"22","winP":"18","placeP":"13"}},"yearlySummary":[{"showsP":"17","winsP":"17","placesP":"17","starts":6,"earnings":212020,"racingYear":2026,"shows":1,"wins":1,"places":1},{"showsP":"33","winsP":"22","placesP":"22","starts":9,"earnings":320500,"racingYear":2025,"shows":3,"wins":2,"places":2}],"morningLineOdds":[],"bio":"\u003cp\u003eNo one can call Cabo Spirit a slacker. The 7-year-old Pioneerof the Nile gelding has answered the call to the post regularly and often during six seasons of racing, recording 45 starts through September 2026 with more than $1.5 million in earnings. He finished third or better in 24 of his starts but with only eight wins.\r\u003c/p\u003e\u003cp\u003eIt took trainer George Papaprodromu five tries to get Cabo Spirit to the winner's circle beginning in August 2021. He then finished third in the Cecil B. DeMille Stakes (G3) at Del Mar in November, having crammed six races into four months.\r\u003c/p\u003e\u003cp\u003eThe pattern of consistently good, reliable efforts and few wins ran throughout the next five seasons. The few big wins included the 2022 Twilight Derby (G2) and the 2024 John Henry Turf Championship (G2), both at Santa Anita.\r\u003c/p\u003e\u003cp\u003eHe arguably saved his best for his most recent start. First from the gate in the 2026 City of Hope Mile (G2) at Santa Anita on Sept. 26, Cabo Spirit led all the way to win by a head, earning a \"Win and You're In\" ticket to the FanDuel Breeders' Cup Mile (G1).\r\u003c/p\u003e","gradedStakesPoints":0,"regionWinnerBadges":[],"breederName":"WinStar Farm, LLC","uid":"blte4d42449f17a3d8c","hasAutogeneratedPage":true,"url":"/redirect/horse/blte4d42449f17a3d8c?ht=pre-entries","pageTitle":"Cabo Spirit","jockeyName":"","ownerName":"Kretz Racing, LLC (Rustin Kretz)","trainer":"George Papaprodromou","country":{"uid":"blt1af49e3a6a89373f","title":"USA","abbreviation":"USA","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt9de45bbdff160673/60d219911e0505677a882fa1/USAFlag.png"}},"horseName":"Cabo Spirit","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt1e22fcea49d8ea41/68e404e61ec73e1b1ecf