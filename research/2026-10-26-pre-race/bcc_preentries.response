de":" ","raceDate":"September, 17 2023 00:00:00","purseUsa":26658,"positionAtFinish":1},{"trackName":"ROYAL WINDSOR","raceName":"William Hill Epic Boost Racing League Race 21 Handicap Stakes (Class 2) (For Horses Trained By Trainers Registered T","grade":" ","raceDate":"August, 17 2023 00:00:00","purseUsa":127316,"positionAtFinish":2},{"trackName":"NEWCASTLE","raceName":"Aveika Apprentice Handicap Stakes (Class 4)","grade":" ","raceDate":"July, 29 2023 00:00:00","purseUsa":12593,"positionAtFinish":1},{"trackName":"ROYAL WINDSOR","raceName":"Racing League On Sky Sports Racing Handicap Stakes (Class 5)","grade":" ","raceDate":"July, 17 2023 00:00:00","purseUsa":11002,"positionAtFinish":1},{"trackName":"WOLVERHAMPTON","raceName":"Free Tips Daily On Attheraces.com Novice Stakes (Class 5) (Div I) (Gbb Race)","grade":" ","raceDate":"June, 26 2023 00:00:00","purseUsa":9658,"positionAtFinish":1},{"trackName":"WOLVERHAMPTON","raceName":"At The Races App Form Study Maiden Fillies Stakes (Class 5) (Gbb Race)","grade":" ","raceDate":"June, 05 2023 00:00:00","purseUsa":9467,"positionAtFinish":7},{"trackName":"SOUTHWELL","raceName":"Talksport Powered By Fans Fillies Novice Stakes (Class 5) (Gbb Race)","grade":" ","raceDate":"December, 20 2022 00:00:00","purseUsa":8259,"positionAtFinish":8}],"record":{"previousYear":{"starts":2,"earnings":69789,"show":0,"win":0,"place":2,"showP":"0","winP":"0","placeP":"100"},"breedersCup":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"currentYear":{"starts":4,"earnings":756763,"show":0,"win":2,"place":2,"showP":"0","winP":"50","placeP":"50"},"lifetime":{"starts":19,"earnings":1132861,"show":1,"win":9,"place":7,"showP":"5","winP":"47","placeP":"37"}},"yearlySummary":[{"showsP":"0","winsP":"50","placesP":"50","starts":4,"earnings":756763,"racingYear":2026,"shows":0,"wins":2,"places":2},{"showsP":"0","winsP":"0","placesP":"100","starts":2,"earnings":69789,"racingYear":2025,"shows":0,"wins":0,"places":2}],"morningLineOdds":[],"bio":"\u003cp\u003eTiffany (IRE) made her first start in the United States a memorable one by winning the Sept. 5 Kentucky Turf Cup Invitational Stakes (G2) at Kentucky Downs by 1 ¾ lengths over Ethical Diamond (IRE). The race is part of the Breeders’ Cup Challenge “Win and You’re In” Series, guaranteeing Tiffany a spot in the starting gate of the Longines Breeders’ Cup Turf (G1). Last year’s Turf was won by Ethical Diamond. \u0026nbsp;\r\u003c/p\u003e\u003cp\u003eOne start prior, Tiffany won the Aug. 9 Grosser Preis von Berlin (G1) by a neck over Bright Light (FR) at Hoppegarten in Germany. \u0026nbsp;The 6-year-old mare began her 2026 campaign in France in the June 14 Prix Pawneese Longines (Listed) at Chantilly in which she finished second. She finished second again in the July 4 Lancashire Oaks (G2) at Newmarket in England. \r\u003c/p\u003e\u003cp\u003eOther high level wins during Tiffany’s career include the T.von Zastrow Stutenpreis (G2) and Hoppings Fillies' Stakes (G3) in 2024. A remarkably consistent runner, she has not been worse than third in 16-of-18 lifetime starts, and her two off-the-board finishes came in her first two races. \r\u003c/p\u003e\u003cp\u003eSir Mark Prescott trains Tiffany for Elite Racing OO4. The homebred is by Farhh (GB) and out of the Sadler’s Wells mare Affinity (GB). \r\u003c/p\u003e","gradedStakesPoints":6,"regionWinnerBadges":[],"breederName":"Elite Racing Club","uid":"bltc83436d5b698a58d","hasAutogeneratedPage":true,"url":"/redirect/horse/bltc83436d5b698a58d?ht=pre-entries","pageTitle":"Tiffany (IRE)","jockeyName":"","ownerName":"Elite Racing 004 (Anthony Hill)","trainer":"Sir Mark Prescott","country":{"uid":"blta32e5b692b12a246","title":"Ireland","abbreviation":"IRE","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt613f9a736c40223a/61aa4c2b2f8b9e70946988d3/ireland.png","alt":""}},"horseName":"Tiffany","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/bltcb7844b5730f56fd/6aa1a5b0025f5fe7342c7355/Contender_Photo_Tiffany_(IRE).jpg"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/bltcb7844b5730f56fd/6aa1a5b0025f5fe7342c7355/Contender_Photo_Tiffany_(IRE).jpg"},"cta":null,"races":[{"uid":"blt21de548e7ed632cc","ContentTypeUid":"collection_race","challengeSeriesWinner":false,"isEligible":false,"eligibleRank":null,"finishPosition":null,"classicRanking":null,"postPosition":"","scratched":false,"win":"","place":"","show":"","deadHeat":false,"silks":null}],"isChallengeSeriesWinner":true,"silks":null,"isHoC":false,"year":2026,"isHistoricalEntry":false,"relatedArticles":[],"win":"","show":"","place":""},{"sireName":"Sea The Stars (IRE)","damName":"Miss Aiglonne (GB)","sex":"Filly","color":"Bay","foalingDate":"April, 12 2023 00:00:00","age":3,"pastPerformances":[{"trackName":"YORK","raceName":"Legends Global Yorkshire Oaks","grade":"1","raceDate":"August, 20 2026 00:00:00","purseUsa":816386,"positionAtFinish":6},{"trackName":"CURRAGH","raceName":"Juddmonte Irish Oaks","grade":"1","raceDate":"July, 18 2026 00:00:00","purseUsa":571906,"positionAtFinish":1},{"trackName":"ASCOT","raceName":"Ribblesdale S.","grade":"2","raceDate":"June, 18 2026 00:00:00","purseUsa":332361,"positionAtFinish":2},{"trackName":"LEOPARDSTOWN","raceName":"Its Family Day At Leopardstown","grade":" ","raceDate":"May, 10 2026 00:00:00","purseUsa":17680,"positionAtFinish":1},{"trackName":"GOWRAN PARK","raceName":"Irish Injured Jockeys","grade":" ","raceDate":"April, 09 2026 00:00:00","purseUsa":19826,"positionAtFinish":3},{"trackName":"THURLES","raceName":"Irish Stallion Farms E.B.F. Fillies","grade":" ","raceDate":"October, 09 2025 00:00:00","purseUsa":20933,"positionAtFinish":3}],"record":{"previousYear":{"starts":1,"earnings":1884,"show":1,"win":0,"place":0,"showP":"100","winP":"0","placeP":"0"},"breedersCup":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"currentYear":{"starts":5,"earnings":420645,"show":1,"win":2,"place":1,"showP":"20","winP":"40","placeP":"20"},"lifetime":{"starts":6,"earnings":422529,"show":2,"win":2,"place":1,"showP":"33","winP":"33","placeP":"17"}},"yearlySummary":[{"showsP":"20","winsP":"40","placesP":"20","starts":5,"earnings":420645,"racingYear":2026,"shows":1,"wins":2,"places":1},{"showsP":"100","winsP":"0","placesP":"0","starts":1,"earnings":1884,"racingYear":2025,"shows":1,"wins":0,"places":0}],"morningLineOdds":[],"bio":"\u003cp\u003eJohanna Walsh (IRE) became a Classic winner when she took the July 18 Irish Oaks (G1) at the Curragh. A dominant winner, she defeated Inis Mor (FR) by 4 lengths in the 1 ½-mile race. \u0026nbsp;\r\u003c/p\u003e\u003cp\u003eThe 3-year-old filly had begun her season April 9 with a third-place effort in a maiden race at Gowran Park. She then broke her maiden on May 10 at Leopardstown when she defeated Believed (IRE) by 3 ¼ lengths. \u0026nbsp;\r\u003c/p\u003e\u003cp\u003eOff that victory, Johanna Walsh headed to Royal Ascot for the June 18 Ribblesdale Stakes (G2) in which she put in a good, but green, performance. She was caught by Earth Shot (IRE) in the final strides and finished second by a head. \r\u003c/p\u003e\u003cp\u003eFollowing her victory in the Irish Oaks, Johanna Walsh ran in the Aug. 20 Yorkshire Oaks (G1) and finished sixth of nine going a mile and a half. \r\u003c/p\u003e\u003cp\u003eJoseph O’Brien trains Johanna Walsh for American lawyer Wells Watson, who purchased the bay filly for $497,924 as a yearling. Johanna Walsh is scheduled to be offered at the Tattersalls December Mares Sale at the end of the year. \r\u003c/p\u003e\u003cp\u003eSunderland Holding Inc. bred Johanna Walsh, who is by Sea The Stars (IRE) and out of the Dawn Approach (IRE) mare Miss Aiglonne (GB).\u0026nbsp;\u003c/p\u003e","gradedStakesPoints":0,"regionWinnerBadges":[],"breederName":"Sunderland Holding Inc.","uid":"blt3c724b6564f4f4f0","hasAutogeneratedPage":true,"url":"/redirect/horse/blt3c724b6564f4f4f0?ht=pre-entries","pageTitle":"Johanna Walsh (IRE)","jockeyName":"","ownerName":"Wells T. Watson","trainer":"Joseph Patrick O'Brien","country":{"uid":"blta32e5b692b12a246","title":"Ireland","abbreviation":"IRE","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt613f9a736c40223a/61aa4c2b2f8b9e70946988d3/ireland.png","alt":""}},"horseName":"Johanna Walsh","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blte66e7c3f33facf3b/6334cddf4df1082a16b60e31/Fallback_Horse_Image.png"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blte66e7c3f33facf3b/6334cddf4df1082a16b60e31/Fallback_Horse_Image.png"},"cta":null,"races":[{"uid":"blt21de548e7ed632cc","ContentTypeUid":"collection_race","challengeSeriesWinner":false,"isEligible":true,"eligibleRank":15,"finishPosition":null,"classicRanking":null,"postPosition":"15","scratched":false,"win":"","place":"","show":"","deadHeat":false,"silks":null}],"isChallengeSeriesWinner":false,"silks":null,"isHoC":false,"year":2026,"isHistoricalEntry":false,"relatedArticles":[],"win":"","show":"","place":""},{"sireName":"English Channel","damName":"Fitpitcher","sex":"Horse","color":"Bay","foalingDate":"March, 07 2020 00:00:00","age":6,"pastPerformances":[{"trackName":"BELMONT PARK","raceName":"Joe Hirsch Turf Classic S.","grade":"1","raceDate":"October, 01 2026 00:00:00","purseUsa":500000,"positionAtFinish":2},{"trackName":"GULFSTREAM PARK","raceName":"Pan American S. presented by Rood \u0026 Riddle","grade":"3","raceDate":"March, 28 2026 00:00:00","purseUsa":225000,"positionAtFinish":1},{"trackName":"BELMONT AT THE BIG A","raceName":"Joe Hirsch Turf Classic S.","grade":"1","raceDate":"September, 27 2025 00:00:00","purseUsa":500000,"positionAtFinish":4},{"trackName":"SARATOGA","raceName":"Resorts World Casino Sword Dancer S.","grade":"1","raceDate":"August, 09 2025 00:00:00","purseUsa":750000,"positionAtFinish":6},{"trackName":"SARATOGA","race