0:00:00","purseUsa":82000,"positionAtFinish":1},{"trackName":"AQUEDUCT","raceName":" ","grade":" ","raceDate":"January, 11 2025 00:00:00","purseUsa":80000,"positionAtFinish":1},{"trackName":"CHURCHILL DOWNS","raceName":" ","grade":" ","raceDate":"November, 16 2024 00:00:00","purseUsa":120000,"positionAtFinish":9},{"trackName":"KEENELAND","raceName":" ","grade":" ","raceDate":"October, 11 2024 00:00:00","purseUsa":100000,"positionAtFinish":6},{"trackName":"SARATOGA","raceName":" ","grade":" ","raceDate":"August, 29 2024 00:00:00","purseUsa":100000,"positionAtFinish":4},{"trackName":"SARATOGA","raceName":" ","grade":" ","raceDate":"July, 27 2024 00:00:00","purseUsa":100000,"positionAtFinish":2},{"trackName":"BELMONT AT THE BIG A","raceName":" ","grade":" ","raceDate":"June, 15 2024 00:00:00","purseUsa":90000,"positionAtFinish":6}],"record":{"previousYear":{"starts":5,"earnings":185850,"show":0,"win":3,"place":0,"showP":"0","winP":"60","placeP":"0"},"breedersCup":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"currentYear":{"starts":6,"earnings":302830,"show":0,"win":2,"place":1,"showP":"0","winP":"33","placeP":"17"},"lifetime":{"starts":16,"earnings":518554,"show":0,"win":5,"place":2,"showP":"0","winP":"31","placeP":"13"}},"yearlySummary":[{"showsP":"0","winsP":"33","placesP":"17","starts":6,"earnings":302830,"racingYear":2026,"shows":0,"wins":2,"places":1},{"showsP":"0","winsP":"60","placesP":"0","starts":5,"earnings":185850,"racingYear":2025,"shows":0,"wins":3,"places":0}],"morningLineOdds":[],"bio":"\u003cp\u003eT Kraft solidified his place in the Cygames Breeders’ Cup Sprint (G1) when he held off a late challenge to take the “Win and You’re In” Vosburgh Stakes (G3) by a nose at Belmont Park on Oct. 1. The victory was his first at the graded level and followed his runner-up spot in the “Win and You’re In” Forego Stakes (G1) at Saratoga in August. \u0026nbsp;\r\u003c/p\u003e\u003cp\u003eThe Vosburgh was T Kraft’s best performance by various metrics including his career best 100 Beyer Figure. The 4-year-old colt went winless in five starts at two but improved to triumph in three consecutive Aqueduct races including a stakes race as a newly minted sophomore last year. He then went unplaced in Saratoga graded company. Scaling back to the Aqueduct allowance ranks, he gained the fourth of his five career wins on May 22. \u0026nbsp;\r\u003c/p\u003e\u003cp\u003eT Kraft was purchased for $110,000 at the 2023 Keeneland September Yearling Sale. His dam, Margarita Friday, also produced 2024 Sprint winner and champion sprinter Straight No Chaser. His sire Connect was exported for stallion duty in Turkey this year. \u0026nbsp;\r\u003c/p\u003e","gradedStakesPoints":0,"regionWinnerBadges":[],"breederName":"Dr. John Eaton \u0026 Dr. Steve Laymon","uid":"bltb9ce870c4e2aa830","hasAutogeneratedPage":true,"url":"/redirect/horse/bltb9ce870c4e2aa830?ht=pre-entries","pageTitle":"T Kraft","jockeyName":"","ownerName":"LRE Racing, LLC (Lee Einsidler)","trainer":"William I. Mott","country":{"uid":"blt1af49e3a6a89373f","title":"USA","abbreviation":"USA","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt9de45bbdff160673/60d219911e0505677a882fa1/USAFlag.png"}},"horseName":"T Kraft","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt8703fa7030fbe748/6abed03c646488bb79ec9a97/T_Kraft_-_Contender_-_2026.jpg"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt8703fa7030fbe748/6abed03c646488bb79ec9a97/T_Kraft_-_Contender_-_2026.jpg"},"cta":null,"races":[{"uid":"bltf6749e738cff0ef2","ContentTypeUid":"collection_race","challengeSeriesWinner":true,"isEligible":false,"eligibleRank":null,"finishPosition":null,"classicRanking":null,"postPosition":"","scratched":false,"win":"","place":"","show":"","deadHeat":false,"silks":null}],"isChallengeSeriesWinner":true,"silks":null,"isHoC":false,"year":2026,"isHistoricalEntry":false,"relate