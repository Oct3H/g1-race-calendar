ch year.\u003c/p\u003e\u003cp\u003e\u0026nbsp;\u003c/p\u003e","surface":"","bettingCtaOverride":{"cta":[]},"horseType":"pre-entries","horses":[{"sireName":"Munnings","damName":"Lovely Carina","sex":"Filly","color":"Bay","foalingDate":"March, 31 2022 00:00:00","age":4,"pastPerformances":[{"trackName":"KEENELAND","raceName":"Thoroughbred Club of America S.","grade":"2","raceDate":"October, 03 2026 00:00:00","purseUsa":400000,"positionAtFinish":1},{"trackName":"ELLIS PARK","raceName":"Twin Bridges S.","grade":" ","raceDate":"July, 19 2026 00:00:00","purseUsa":175000,"positionAtFinish":3},{"trackName":"CHURCHILL DOWNS","raceName":"Chicago S.","grade":"2","raceDate":"June, 20 2026 00:00:00","purseUsa":300000,"positionAtFinish":3},{"trackName":"KEENELAND","raceName":" ","grade":" ","raceDate":"April, 22 2026 00:00:00","purseUsa":140000,"positionAtFinish":1},{"trackName":"OAKLAWN PARK","raceName":"Matron S.","grade":" ","raceDate":"March, 27 2026 00:00:00","purseUsa":250000,"positionAtFinish":3},{"trackName":"FAIR GROUNDS","raceName":" ","grade":" ","raceDate":"February, 05 2026 00:00:00","purseUsa":56000,"positionAtFinish":1},{"trackName":"CHURCHILL DOWNS","raceName":"Leslie's Lady Overnight S.","grade":" ","raceDate":"June, 08 2025 00:00:00","purseUsa":175000,"positionAtFinish":3},{"trackName":"CHURCHILL DOWNS","raceName":"Eight Belles S. presented by Sysco","grade":"2","raceDate":"May, 02 2025 00:00:00","purseUsa":600000,"positionAtFinish":3},{"trackName":"KEENELAND","raceName":" ","grade":" ","raceDate":"April, 07 2025 00:00:00","purseUsa":120000,"positionAtFinish":1},{"trackName":"FAIR GROUNDS","raceName":" ","grade":" ","raceDate":"February, 17 2025 00:00:00","purseUsa":53000,"positionAtFinish":3},{"trackName":"CHURCHILL DOWNS","raceName":" ","grade":" ","raceDate":"September, 13 2024 00:00:00","purseUsa":120000,"positionAtFinish":1},{"trackName":"ELLIS PARK","raceName":" ","grade":" ","raceDate":"August, 03 2024 00:00:00","purseUsa":71000,"positionAtFinish":2}],"rec