:"SANTA ANITA PARK","raceName":"John Henry Turf Championship S.","grade":"2","raceDate":"October, 01 2022 00:00:00","purseUsa":200000,"positionAtFinish":3},{"trackName":"DEL MAR","raceName":"Del Mar H. Presented by The Japan Racing Association","grade":"2","raceDate":"September, 03 2022 00:00:00","purseUsa":300000,"positionAtFinish":1},{"trackName":"DEL MAR","raceName":" ","grade":" ","raceDate":"July, 24 2022 00:00:00","purseUsa":84000,"positionAtFinish":3},{"trackName":"SANTA ANITA PARK","raceName":" ","grade":" ","raceDate":"June, 18 2022 00:00:00","purseUsa":72000,"positionAtFinish":2},{"trackName":"SANTA ANITA PARK","raceName":"Charles Whittingham S.","grade":"2","raceDate":"April, 30 2022 00:00:00","purseUsa":225000,"positionAtFinish":3},{"trackName":"SANTA ANITA PARK","raceName":" ","grade":" ","raceDate":"April, 02 2022 00:00:00","purseUsa":69000,"positionAtFinish":1},{"trackName":"SANTA ANITA PARK","raceName":" ","grade":" ","raceDate":"March, 05 2022 00:00:00","purseUsa":69000,"positionAtFinish":2},{"trackName":"SANTA ANITA PARK","raceName":" ","grade":" ","raceDate":"January, 17 2022 00:00:00","purseUsa":69000,"positionAtFinish":2},{"trackName":"DUNDALK","raceName":"Irish Stallion Farms E.B.F. Median Auction Maiden (Plus 10) (Div 2)","grade":" ","raceDate":"February, 26 2021 00:00:00","purseUsa":18266,"positionAtFinish":1}],"record":{"previousYear":{"starts":6,"earnings":514830,"show":2,"win":2,"place":0,"showP":"33","winP":"33","placeP":"0"},"breedersCup":{"starts":4,"earnings":640000,"show":0,"win":0,"place":0,"showP":"0","winP":"0","placeP":"0"},"currentYear":{"starts":6,"earnings":302500,"show":0,"win":3,"place":0,"showP":"0","winP":"50","placeP":"0"},"lifetime":{"starts":35,"earnings":2605087,"show":5,"win":13,"place":3,"showP":"14","winP":"37","placeP":"9"}},"yearlySummary":[{"showsP":"0","winsP":"50","placesP":"0","starts":6,"earnings":302500,"racingYear":2026,"shows":0,"wins":3,"places":0},{"showsP":"33","winsP":"33","placesP":"0","starts":6,"earnings":514830,"racingYear":2025,"shows":2,"wins":2,"places":0}],"morningLineOdds":[],"bio":"\u003cp\u003eGold Phoenix (IRE) made headlines this summer at Del Mar. When the 8-year-old gelding won the Eddie Read Stakes (G2) on July 26, he became the first horse in the track’s 89-year history to win six stakes races there. \u0026nbsp;\r\u003c/p\u003e\u003cp\u003eWhile he also won the race in 2023, his biggest claim to fame is winning the Del Mar Handicap (G2) for four consecutive years from 2022-2025. On Aug. 29, he finished fourth in this year’s contest but was only beaten three-quarters of a length by Test Score. \r\u003c/p\u003e\u003cp\u003eEarlier this year, while racing at Santa Anita, Gold Phoenix won the March 21 San Luis Rey Stakes (G3) and the June 14 San Juan Capistrano Stakes (G3). \u0026nbsp;\r\u003c/p\u003e\u003cp\u003eOther graded stakes victories on his resume include the 2025 John Henry Turf Championship Stakes (G2), 2024 Charles Whittingham Stakes (G2), and 2023 Frank E. Kilroe Mile Stakes (G1). \r\u003c/p\u003e\u003cp\u003eGold Phoenix has competed in the past four runnings of the Longines Breeders’ Cup Turf (G1). He finished fifth (2025), fourth (2024 and 2023), and 10th (2022). \r\u003c/p\u003e\u003cp\u003eA winner in his career debut in Ireland in 2021, Gold Phoenix then was sold privately and came to the United States. Phil D’Amato trains him for Agave Racing Stable, Sterling Stables, Little Red Feather Racing and Marsha Naify. \r\u003c/p\u003e\u003cp\u003eBy Belardo (IRE), Gold Phoenix is out of the Mizzen Mast mare Magnifica.\u003c/p\u003e","gradedStakesPoints":14,"regionWinnerBadges":[],"breederName":"Mighty Universe Ltd","uid":"blt7720fd6cb5618eb9","hasAutogeneratedPage":true,"url":"/redirect/horse/blt7720fd6cb5618eb9?ht=pre-entries","pageTitle":"Gold Phoenix (IRE)","jockeyName":"","ownerName":"Little Red Feather Racing (William Koch), Agave Racing Stable (Mark Martinez), Sterling Stables, LLC (Kevin Bogart) \u0026 Marsha Naify","trainer":"Phil