quit and won at odds of 150-1 with Field of Gold fourth.\u0026nbsp;\u003c/p\u003e","gradedStakesPoints":0,"regionWinnerBadges":[],"breederName":"Juddmonte Farms (East) Ltd","uid":"blt8757e843d6d3cff7","hasAutogeneratedPage":true,"url":"/redirect/horse/blt8757e843d6d3cff7?ht=pre-entries","pageTitle":"Qirat (GB)","jockeyName":"","ownerName":"Juddmonte (Fahad Bin Khalid)","trainer":"Ralph M. Beckett","country":{"uid":"blt440e3ce320965a9b","title":"United Kingdom / England","abbreviation":"GBR","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt02676e7705186e63/61aa4e462e86841fa22388f0/united-kingdom.png","alt":""}},"horseName":"Qirat","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/bltf5b060d9697c848c/68910307ad1f9a49867ab7b7/Contender_Photo_Qirat_.jpg"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/bltf5b060d9697c848c/68910307ad1f9a49867ab7b7/Contender_Photo_Qirat_.jpg"},"cta":null,"races":[{"uid":"blt31ae65439327eecf","ContentTypeUid":"collection_race","challengeSeriesWinner":false,"isEligible":true,"eligibleRank":17,"finishPosition":null,"classicRanking":null,"postPosition":"17","scratched":false,"win":"","place":"","show":"","deadHeat":false,"silks":null}],"isChallengeSeriesWinner":true,"silks":null,"isHoC":false,"year":2026,"isHistoricalEntry":false,"relatedArticles":[],"win":"","show":"","place":""},{"sireName":"Duramente (JPN)","damName":"Atab (IRE)","sex":"Horse","color":"Dark Bay or Brown","foalingDate":"March, 07 2020 00:00:00","age":6,"pastPerformances":[{"trackName":"NAKAYAMA","raceName":"Sprinters S.","grade":"1","raceDate":"September, 27 2026 00:00:00","purseUsa":2059827,"positionAtFinish":14},{"trackName":"ASCOT","raceName":"Queen Elizabeth II Jubilee S.","grade":"1","raceDate":"June, 20 2026 00:00:00","purseUsa":1323440,"positionAtFinish":8},{"trackName":"MEYDAN RACECOURSE","raceName":"Al Quoz Sprint Sponsored By Azizi Developments","grade":"1","raceDate":"Ma