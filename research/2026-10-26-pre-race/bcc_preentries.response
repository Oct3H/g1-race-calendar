rix Pelleas","grade":" ","raceDate":"July, 22 2024 00:00:00","purseUsa":59534,"positionAtFinish":1},{"trackName":"LONGCHAMP","raceName":"Prix de Belleville","grade":" ","raceDate":"October, 15 2023 00:00:00","purseUsa":52581,"positionAtFinish":1}],"record":{"previousYear":{"starts":6,"earnings":314154,"show":0,"win":2,"place":2,"showP":"0","winP":"33","placeP":"33"},"breedersCup":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"currentYear":{"starts":4,"earnings":124681,"show":1,"win":1,"place":1,"showP":"25","winP":"25","placeP":"25"},"lifetime":{"starts":14,"earnings":533293,"show":1,"win":6,"place":3,"showP":"7","winP":"43","placeP":"21"}},"yearlySummary":[{"showsP":"25","winsP":"25","placesP":"25","starts":4,"earnings":124681,"racingYear":2026,"shows":1,"wins":1,"places":1},{"showsP":"0","winsP":"33","placesP":"33","starts":6,"earnings":314154,"racingYear":2025,"shows":0,"wins":2,"places":2}],"morningLineOdds":[],"bio":"\u003cp\u003eMap Of Stars (GB) began his year with a third-place effort in the Prix Lord Seymour (Listed) at Longchamp on April 12. The 5-year-old then ran fifth of six in the May 3 Prix d'Hedouville (G3), which was contested on very soft ground. \r\u003c/p\u003e\u003cp\u003eOn June 16, Map Of Stars competed at Royal Ascot in the Wolferton Stakes (Listed). He took on 15 challengers, and he won the 1 ½-mile race by a half-length over Wimbledon Hawkeye (GB). The two rivals met again on Aug. 15 in the Prix Gontaut-Biron at Deauville, but that time Wimbledon Hawkeye turned the tables on Map Of Stars and defeated him by a neck.\r\u003c/p\u003e\u003cp\u003eLast year, Map Of Stars won the Prix d'Harcourt (G2) and Prix Exbury (G3). He also finished second in the Prix Ganay (G1) and Grosser Dallmayr-Preis - Bayerisches Zuchtrennen (G1). He was gelded at the end of the 2025 season.\r\u003c/p\u003e\u003cp\u003eIn 2024, Map Of Stars won two of three starts, and he also won his lone start as a juvenile in 2023.\r\u003c/p\u003e\u003cp\u003eFrancis-Henri Graffard trains Map Of Stars for Wathnan Racing. He was bred by Al Asayl France.\r\u003c/p\u003e\u003cp\u003eMap Of Stars is by Sea The Stars (IRE) and out of the Dubawi (IRE) mare Bateel (IRE).\r\u003c/p\u003e","gradedStakesPoints":0,"regionWinnerBadges":[],"breederName":"Al Asayl France","uid":"bltbda58de4d2747d14","hasAutogeneratedPage":true,"url":"/redirect/horse/bltbda58de4d2747d14?ht=pre-entries","pageTitle":"Map of Stars (GB)","jockeyName":"","ownerName":"Wathnan Racing (Tameem Binhamad Kh H Al-Thani)","trainer":"Francis-Henri Graffard","country":{"uid":"blt440e3ce320965a9b","title":"United Kingdom / England","abbreviation":"GBR","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt02676e7705186e63/61aa4e462e86841fa22388f0/united-kingdom.png","alt":""}},"horseName":"Map of Stars","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/bltfccacb9861f5e3bc/6abec4a8758e4eb20ce12e5a/Contender_Photo_Map_of_Stars_.jpg"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/bltfccacb9861f5e3bc/6abec4a8758e4eb20ce12e5a/Contender_Photo_Map_of_Stars_.jpg"},"cta":null,"races":[{"uid":"blt21de548e7ed632cc","ContentTypeUid":"collection_race","challengeSeriesWinner":false,"isEligible":true,"eligibleRank":19,"finishPosition":null,"classicRanking":null,"postPosition":"19","scratched":false,"win":"","place":"","show":"","deadHeat":false,"silks":null}],"isChallengeSeriesWinner":false,"silks":null,"isHoC":false,"year":2026,"isHistoricalEntry":false,"relatedArticles":[],"win":"","show":"","place":""},{"sireName":"Belardo (IRE)","damName":"Magnifica","sex":"Gelding","color":"Chestnut","foalingDate":"April, 22 2018 00:00:00","age":8,"pastPerformances":[{"trackName":"DEL MAR","raceName":"Del Mar H. Presented by The Japan Racing Association","grade":"2","raceDate":"August, 29 2026 00:00:00","purseUsa":300000,"positionAtFinish":4},{"trackName":"DEL MAR","raceName":"Eddi