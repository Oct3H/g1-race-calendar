ame":"Stormy Liberal S.","grade":" ","raceDate":"November, 30 2025 00:00:00","purseUsa":100000,"positionAtFinish":5},{"trackName":"SANTA ANITA PARK","raceName":"Eddie D S.","grade":"2","raceDate":"September, 27 2025 00:00:00","purseUsa":200000,"positionAtFinish":2},{"trackName":"DEL MAR","raceName":" ","grade":" ","raceDate":"August, 23 2025 00:00:00","purseUsa":82000,"positionAtFinish":1},{"trackName":"DEL MAR","raceName":" ","grade":" ","raceDate":"July, 25 2025 00:00:00","purseUsa":82000,"positionAtFinish":2},{"trackName":"KENTUCKY DOWNS","raceName":"Aristocrat Franklin-Simpson S.","grade":"1","raceDate":"September, 07 2024 00:00:00","purseUsa":2000000,"positionAtFinish":2},{"trackName":"SARATOGA","raceName":"Mahony S.","grade":" ","raceDate":"August, 11 2024 00:00:00","purseUsa":150000,"positionAtFinish":6},{"trackName":"CHURCHILL DOWNS","raceName":" ","grade":" ","raceDate":"June, 16 2024 00:00:00","purseUsa":127000,"positionAtFinish":1},{"trackName":"CHURCHILL DOWNS","raceName":" ","grade":" ","raceDate":"May, 04 2024 00:00:00","purseUsa":127000,"positionAtFinish":4},{"trackName":"TURFWAY PARK","raceName":" ","grade":" ","raceDate":"March, 23 2024 00:00:00","purseUsa":70000,"positionAtFinish":1},{"trackName":"TURFWAY PARK","raceName":" ","grade":" ","raceDate":"February, 16 2024 00:00:00","purseUsa":70000,"positionAtFinish":3}],"record":{"previousYear":{"starts":5,"earnings":108100,"show":0,"win":1,"place":2,"showP":"0","winP":"20","placeP":"40"},"breedersCup":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"currentYear":{"starts":3,"earnings":487500,"show":0,"win":2,"place":1,"showP":"0","winP":"67","placeP":"33"},"lifetime":{"starts":14,"earnings":1099245,"show":1,"win":5,"place":4,"showP":"7","winP":"36","placeP":"29"}},"yearlySummary":[{"showsP":"0","winsP":"67","placesP":"33","starts":3,"earnings":487500,"racingYear":2026,"shows":0,"wins":2,"places":1},{"showsP":"0","winsP":"20","placesP":"40","starts":5,"earnings":108100,"racingYear":2025,"shows":0,"wins":1,"places":2}],"morningLineOdds":[],"bio":"\u003cp\u003eYellow Card is based in Southern California with trainer Michael McCarthy but the 5-year-old son of Lost Treasure (IRE) has done most of his best work out east. \r\u003c/p\u003e\u003cp\u003eYellow Card started on the Turfway Park all-weather track in early 2024, recording a third and a win. He finished fourth in a conditions allowance heat on the Churchill Downs dirt, then switched to the turf and got an impressive, off-the pace victory. \r\u003c/p\u003e\u003cp\u003eHe was sixth in a turf sprint at Saratoga and jumped up to finish second in the Franklin-Simpson Stakes (G1) at Kentucky Downs, surrendering a late lead to Howard Wolowitz. \r\u003c/p\u003e\u003cp\u003eAfter a break of 11 months, Yellow Card reappeared to start 2025 at Del Mar, then shipped up to Santa Anita where he was second in the Eddie D. Stakes (G2). After two off-the-board efforts, he won the Clockers Corner Stakes to start 2026 and headed back east. \r\u003c/p\u003e\u003cp\u003eA runner-up finish in the Shakertown Stakes (G2) at Keeneland's spring meeting led to a victory, in stakes-record time, in the Twin Spires Turf Sprint (G2) at Churchill Downs. In that, he won a long duel with the highly regarded Joe Shiesty. \r\u003c/p\u003e\u003cp\u003eThe reward was a return ticket to California and another long layoff before a planned Breeders' Cup start -- back east.\u0026nbsp;\u003c/p\u003e","gradedStakesPoints":12,"regionWinnerBadges":[],"breederName":"Tiffiney K Veloudis","uid":"blt1c89e2c8cad34dbc","hasAutogeneratedPage":true,"url":"/redirect/horse/blt1c89e2c8cad34dbc?ht=pre-entries","pageTitle":"Yellow Card","jockeyName":"","ownerName":"James M. Daniell","trainer":"Michael W. McCarthy","country":{"uid":"blt1af49e3a6a89373f","title":"USA","abbreviation":"USA","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt9de45bbdff160673/60d219911e0505677a882fa1/USAFlag.png"}},"hors