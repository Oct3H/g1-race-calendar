 16 2023 00:00:00","purseUsa":12704,"positionAtFinish":2},{"trackName":"SAN ISIDRO","raceName":"Alamos 2013","grade":" ","raceDate":"January, 14 2023 00:00:00","purseUsa":11283,"positionAtFinish":4},{"trackName":"SAN ISIDRO","raceName":"Snow Moon I","grade":" ","raceDate":"June, 19 2022 00:00:00","purseUsa":12590,"positionAtFinish":5},{"trackName":"HIPODROMO ARGENTINO DE PALERMO","raceName":"Especial Julio F. Penna","grade":" ","raceDate":"May, 26 2022 00:00:00","purseUsa":14278,"positionAtFinish":2}],"record":{"previousYear":{"starts":3,"earnings":139200,"show":0,"win":1,"place":1,"showP":"0","winP":"33","placeP":"33"},"breedersCup":{"starts":2,"earnings":550000,"show":0,"win":1,"place":0,"showP":"0","winP":"50","placeP":"0"},"currentYear":{"starts":3,"earnings":429500,"show":2,"win":0,"place":0,"showP":"67","winP":"0","placeP":"0"},"lifetime":{"starts":23,"earnings":1365923,"show":4,"win":7,"place":6,"showP":"17","winP":"30","placeP":"26"}},"yearlySummary":[{"showsP":"67","winsP":"0","placesP":"0","starts":3,"earnings":429500,"racingYear":2026,"shows":2,"wins":0,"places":0},{"showsP":"0","winsP":"33","placesP":"33","starts":3,"earnings":139200,"racingYear":2025,"shows":0,"wins":1,"places":1}],"morningLineOdds":[],"bio":"\u003cp\u003eWinner of the 2024 Big Ass Fans Breeders‘ Cup Dirt Mile (G1), Full Serrano (ARG) returns after finishing fifth in last year’s edition as the second choice. After racing 14 times in his native Argentina, he has competed sparingly in the U.S. while chasing some of the country’s largest purses. Full Serrano started just three times in both 2024 and 2025 and has that same number under his girth this season. \r\u003c/p\u003e\u003cp\u003eAfter his 2024 Dirt Mile score, he was out of competition for 10 months. He returned with an allowance race triumph and a runner-up in the Goodwood Stakes (G1). \r\u003c/p\u003e\u003cp\u003e“He just had some little issues that came up,” owner Kosta Hronis told Thoroughbred Daily News in a post three months before he closed his season in the 2025 Dirt Mile. \r\u003c/p\u003e\u003cp\u003eBack in action this year, Full Serrano pocketed third money in the $3 million Pegasus World Cup Invitational Stakes (G1) at Gulfstream Park in January. After checking in fourth in the Oaklawn Mile Stakes (G3), he picked up the third-place check in the $1 million Pacific Classic Stakes (G1) on Aug. 22. \u0026nbsp;\r\u003c/p\u003e\u003cp\u003eHronis purchased Full Serrano from Argentina on the advice of trainer John Sadler for what he call a “modest” price. One of six Argentina-breds to win a Breeders’ Cup race, he is seeking to become the second to win the same race twice following Bayakoa (ARG)’s Breeders’ Cup Distaff (G1) scores in 1989-90.\u0026nbsp; \u0026nbsp;\u003c/p\u003e","gradedStakesPoints":8,"regionWinnerBadges":[],"breederName":"Stud Haras Gran Muneca S. A.","uid":"blt91cbc2d946741cdd","hasAutogeneratedPage":true,"url":"/redirect/horse/blt91cbc2d946741cdd?ht=pre-entries","pageTitle":"Full Serrano (ARG)","jockeyName":"","ownerName":"Hronis Racing, LLC (Kosta Hronis)","trainer":"John W. Sadler","country":{"uid":"blt1af49e3a6a89373f","title":"USA","abbreviation":"USA","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt9de45bbdff160673/60d219911e0505677a882fa1/USAFlag.png"}},"horseName":"Full Serrano","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt91c09bf06fa0235c/6890de157735e010ba44e87b/Contender_Photo_Full_Serrano_(ARG).jpg"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt91c09bf06fa0235c/6890de157735e010ba44e87b/Contender_Photo_Full_Serrano_(ARG).jpg"},"cta":null,"races":[{"uid":"blt830ffcd3734ad389","ContentTypeUid":"collection_race","challengeSeriesWinner":false,"isEligible":false,"eligibleRank":null,"finishPosition":null,"classicRanking":null,"postPosition":"","scratched":false,"win":"","place":"","show":"","deadHeat":false,"silks":null}],"isChallengeSeriesWinner":false,"silks":null,"isHoC":false,"year":2026,"isHistoricalEntry":false,"relatedArticles":[],"win":"","show":"","place":""},{"sireName":"Gun Runner","damName":"Sky Dreamer","sex":"Colt","color":"Chestnut","foalingDate":"March, 15 2023 00:00:00","age":3,"pastPerformances":[{"trackName":"PARX RACING","raceName":"Pennsylvania Derby","grade":"1","raceDate":"September, 19 2026 00:00:00","purseUsa":1000000,"positionAtFinish":2},{"trackName":"MONMOUTH PARK","raceName":"NYRA Bets Haskell S.","grade":"1","raceDate":"July, 18 2026 00:00:00","purseUsa":1005000,"positionAtFinish":5},{"trackName":"CHURCHILL DOWNS","raceName":"Matt Winn S.","grade":"3","raceDate":"June, 07 2026 00:00:00","purseUsa":500000,"positionAtFinish":1},{"trackName":"CHURCHILL DOWNS","raceName":"Kentucky Derby presented by Woodford Reserve","grade":"1","raceDate":"May, 02 2026 00:00:00","purseUsa":5000000,"positionAtFinish":11},{"trackName":"KEENELAND","raceName":"Toyota Blue Grass S.","grade":"1","raceDate":"April, 04 2026 00:00:00","purseUsa":1250000,"positionAtFinish":1},{"trackName":"TAMPA BAY DOWNS","raceName":"ESMARK Tampa Bay Derby","grade":"3","raceDate":"March, 07 2026 00:00:00","purseUsa":400000,"positionAtFinish":2},{"trackName":"CHURCHILL DOWNS","raceName":"Kentucky Jockey Club S.","grade":"2","raceDate":"November, 29 2025 00:00:00","purseUsa":400000,"positionAtFinish":1},{"trackName":"KEENELAND","raceName":" ","grade":" ","raceDate":"October, 10 2025 00:00:00","purseUsa":110000,"positionAtFinish":1},{"trackName":"SARATOGA","raceName":" ","grade":" ","raceDate":"August, 30 2025 00:00:00","purseUsa":100000,"positionAtFinish":3},{"trackName":"SARATOGA","raceName":" ","grade":" ","raceDate":"July, 26 2025 00:00:00","purseUsa":100000,"positionAtFinish":5}],"record":{"previousYear":{"starts":4,"earnings":320703,"show":1,"win":2,"place":0,"showP":"25","winP":"50","placeP":"0"},"breedersCup":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"currentYear":{"starts":6,"earnings":1341255,"show":0,"win":2,"place":2,"showP":"0","winP":"33","placeP":"33"},"lifetime":{"starts":10,"earnings":1661958,"show":1,"win":4,"place":2,"showP":"10","winP":"40","placeP":"20"}},"yearlySummary":[{"showsP":"0","winsP":"33","placesP":"33","starts":6,"earnings":1341255,"racingYear":2026,"shows":0,"wins":2,"places":2},{"showsP":"25","winsP":"50","placesP":"0","starts":4,"earnings":320703,"racingYear":2025,"shows":1,"wins":2,"places":0}],"morningLineOdds":[],"bio":"\u003cp\u003eSpendthrift Farm's Further Ado has shown talent through two years of racing, winning the 2025 Kentucky Jockey Cup (G2) and the 2026 Matt Winn Stakes (G3) at Churchill Downs, and delivering other noteworthy performances. But the Gun Runner colt has performed best on the main track at Keeneland, where he broke his maiden by 20 lengths last fall and Blue Grass Stakes (G1) by 11 lengths this spring. \u0026nbsp; \r\u003c/p\u003e\u003cp\u003eHis affinity for the course makes the 3-year-old a contender for the $7 million Longines Breeders' Cup Classic (G1) Oct. 31 at Keeneland. \u0026nbsp;\r\u003c/p\u003e\u003cp\u003eThe Classic would mark just his second start at 1 1/4 miles after this year's Kentucky Derby (G1) at Churchill Downs, where he weakened to 11th after threatening on the second turn as the favorite. \r\u003c/p\u003e\u003cp\u003eMost recently, the Brad Cox trainee finished second in the Sept. 19 Pennsylvania Derby (G1) over 1 1/8 miles at Parx, rallying to finish a half-length behind The Puma after being stuck in traffic on the second turn of the race. That was his second runner-up finish to The Puma in graded company this year after a defeat in Tampa Bay Derby (G3) in the spring. \u0026nbsp;\r\u003c/p\u003e\u003cp\u003eFurther Ado begins stud duty next year at Spendthrift Farm.\u003c/p\u003e","gradedStakesPoints":22,"regionWinnerBadges":[],"breederName":"John C. Oxley","uid":"blt1db286c8a9e1335f","hasAutogeneratedPage":true,"url":"/redirect/horse/blt1db286c8a9e1335f?ht=pre-entri