aceP":"13"},"breedersCup":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"currentYear":{"starts":5,"earnings":920500,"show":0,"win":2,"place":1,"showP":"0","winP":"40","placeP":"20"},"lifetime":{"starts":17,"earnings":2405025,"show":3,"win":6,"place":4,"showP":"18","winP":"35","placeP":"24"}},"yearlySummary":[{"showsP":"0","winsP":"40","placesP":"20","starts":5,"earnings":920500,"racingYear":2026,"shows":0,"wins":2,"places":1},{"showsP":"38","winsP":"38","placesP":"13","starts":8,"earnings":1360950,"racingYear":2025,"shows":3,"wins":3,"places":1}],"morningLineOdds":[],"bio":"\u003cp\u003eWith his victory in the Aug. 29 Del Mar Handicap (G2), Test Score earned his way into the Longines Breeders' Cup Turf (G1). The race is part of the Breeder’s Cup Win and You’re In series. \u0026nbsp;Test Score showed his gameness in the 1 3/8-mile turf contest, defeating Atitlan by a neck. \r\u003c/p\u003e\u003cp\u003eTest Score began the year by taking the Jan. 24 Pegasus World Cup Turf Invitational Stakes (G1), which he also won by a neck. The 4-year-old colt also finished second in the June 6 Manhattan (G1) and was off the board in the May 2 Turf Classic (G1) and Aug. 1 Arlington Million (G1). \u0026nbsp;\r\u003c/p\u003e\u003cp\u003eIn 2025, Test Score’s victories came in the Belmont Derby Invitational Stakes (G1), Twilight Derby (G2) and Transylvania Stakes (G3). \u0026nbsp;He began his career in 2024 and broke his maiden at Keeneland in his third start. \u0026nbsp;\r\u003c/p\u003e\u003cp\u003eGraham Motion trains Test Score for Amerman Racing LLC. The Amermans have had previous Breeders’ Cup success with Adoration (2003 Breeders’ Cup Distaff) and Oscar Performance (2016 Breeders’ Cup Juvenile Turf). \u0026nbsp;\r\u003c/p\u003e\u003cp\u003eTest Score is by Lookin At Lucky and out of the Kitten’s Joy mare Joy of Learning.\u003c/p\u003e","gradedStakesPoints":6,"regionWinnerBadges":[],"breederName":"Jerry Amerman","uid":"blt8c255176106d1944","hasAutogeneratedPage":true,"url":"/redirect/horse/blt8c255176106d1944?ht=pre-entries","pageTitle":"Test Score","jockeyName":"","ownerName":"Amerman Racing, LLC (Mr. and Mrs. John Amerman)","trainer":"H. Graham Motion","country":{"uid":"blt1af49e3a6a89373f","title":"USA","abbreviation":"USA","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt9de45bbdff160673/60d219911e0505677a882fa1/USAFlag.png"}},"horseName":"Test Score","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/bltcf2d55c65271e76a/6a972f2927a5311d2ddc923d/Contender_Photo_Test_Score.jpg"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/bltcf2d55c65271e76a/6a972f2927a5311d2ddc923d/Contender_Photo_Test_Score.jpg"},"cta":null,"races":[{"uid":"blt21de548e7ed632cc","ContentTypeUid":"collection_race","challengeSeriesWinner":false,"isEligible":false,"eligibleRank":null,"finishPosition":null,"classicRanking":null,"postPosition":"","scratched":false,"win":"","place":"","show":"","deadHeat":false,"silks":null}],"isChallengeSeriesWinner":true,"silks":null,"isHoC":false,"year":2026,"isHistoricalEntry":false,"relatedArticles":[],"win":"","show":"","place":""},{"sireName":"Farhh (GB)","damName":"Affinity (GB)","sex":"Mare","color":"Bay","foalingDate":"May, 02 2020 00:00:00","age":6,"pastPerformances":[{"trackName":"WOODBINE","raceName":"Woodbine Mile S.","grade":"1","raceDate":"September, 12 2026 00:00:00","purseUsa":1000000,"positionAtFinish":2},{"trackName":"KENTUCKY DOWNS","raceName":"AGS Kentucky Turf Cup Invitational S.","grade":"2","raceDate":"September, 05 2026 00:00:00","purseUsa":2000000,"positionAtFinish":1},{"trackName":"SARATOGA","raceName":"Fourstardave S.","grade":"1","raceDate":"August, 08 2026 00:00:00","purseUsa":750000,"positionAtFinish":1},{"trackName":"HOPPEGARTEN","raceName":"Westminster 136. Grosser Preis von Berlin - V4/3","grade":"1","raceDate":"August, 09 2026 00:00:00","purseUsa":179163,"positionAtFi