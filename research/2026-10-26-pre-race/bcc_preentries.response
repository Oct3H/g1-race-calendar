 00:00:00","purseUsa":600000,"positionAtFinish":3},{"trackName":"BELMONT PARK","raceName":"Belmont Derby Invitational S.","grade":"1","raceDate":"July, 08 2023 00:00:00","purseUsa":750000,"positionAtFinish":1},{"trackName":"BELMONT PARK","raceName":"Pennine Ridge S.","grade":"2","raceDate":"June, 03 2023 00:00:00","purseUsa":200000,"positionAtFinish":2},{"trackName":"CHURCHILL DOWNS","raceName":"American Turf S. presented by BMW","grade":"2","raceDate":"May, 06 2023 00:00:00","purseUsa":500000,"positionAtFinish":2},{"trackName":"GULFSTREAM PARK","raceName":" ","grade":" ","raceDate":"March, 11 2023 00:00:00","purseUsa":86000,"positionAtFinish":1},{"trackName":"GULFSTREAM PARK","raceName":" ","grade":" ","raceDate":"January, 21 2023 00:00:00","purseUsa":84000,"positionAtFinish":1}],"record":{"previousYear":{"starts":6,"earnings":607780,"show":1,"win":3,"place":0,"showP":"17","winP":"50","placeP":"0"},"breedersCup":{"starts":1,"earnings":50000,"show":0,"win":0,"place":0,"showP":"0","winP":"0","placeP":"0"},"currentYear":{"starts":2,"earnings":220280,"show":0,"win":1,"place":1,"showP":"0","winP":"50","placeP":"50"},"lifetime":{"starts":22,"earnings":2630760,"show":3,"win":10,"place":4,"showP":"14","winP":"45","placeP":"18"}},"yearlySummary":[{"showsP":"0","winsP":"50","placesP":"50","starts":2,"earnings":220280,"racingYear":2026,"shows":0,"wins":1,"places":1},{"showsP":"17","winsP":"50","placesP":"0","starts":6,"earnings":607780,"racingYear":2025,"shows":1,"wins":3,"places":0}],"morningLineOdds":[],"bio":"\u003cp\u003eFar Bridge, a stalwart of the turf division, has made two starts in 2026. \r\u003c/p\u003e\u003cp\u003eThe first came in the March 28 Pan American (G3) at Gulfstream Park, which he won by a neck over Corruption. The 6-year-old developed an issue with a suspensory branch after that victory and needed time off. \u0026nbsp;\r\u003c/p\u003e\u003cp\u003eHis second start came in the Oct. 1 Joe Hirsch Turf Classic (G1) at Belmont Park. This time, he finished second by a half-length to Minaret Station. \u0026nbsp;\r\u003c/p\u003e\u003cp\u003eLast year, Far Bridge won the Bowling Green (G2), Man o’ War (G2) and the Pan American. In 2024, he won both the Joe Hirsch and the Sword Dancer (G1). His first score at the highest level came in the 2023 Belmont Derby Invitational (G1). \r\u003c/p\u003e\u003cp\u003eFar Bridge is trained by Miguel Clement, who took over for his father, Christophe Clement, following Christophe’s passing in May 2025. Far Bridge races for the LSU Stables of Larry, Leslie and Randy Sarf, which bought Far Bridge privately in 2023 following his second start. \r\u003c/p\u003e\u003cp\u003eFar Bridge was bred by Calumet Farm, which raced him at the beginning of his career. He is by English Channel and out of the winning Kitten’s Joy mare Fitpitcher.\u0026nbsp;\u003c/p\u003e","gradedStakesPoints":10,"regionWinnerBadges":[],"breederName":"Calumet Farm","uid":"blt3797788aeb058d1f","hasAutogeneratedPage":true,"url":"/redirect/horse/blt3797788aeb058d1f?ht=pre-entries","pageTitle":"Far Bridge","jockeyName":"","ownerName":"LSU Stables (Lawrence Sarf)","trainer":"Miguel Clement","country":{"uid":"blt1af49e3a6a89373f","title":"USA","abbreviation":"USA","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt9de45bbdff160673/60d219911e0505677a882fa1/USAFlag.png"}},"horseName":"Far Bridge","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/bltb9969216fe2b4113/68aca9b0974c2b4a63e6c14b/Contender_Photo_Far_Bridge.jpg"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/bltb9969216fe2b4113/68aca9b0974c2b4a63e6c14b/Contender_Photo_Far_Bridge.jpg"},"cta":null,"races":[{"uid":"blt21de548e7ed632cc","ContentTypeUid":"collection_race","challengeSeriesWinner":false,"isEligible":true,"eligibleRank":17,"finishPosition":null,"classicRanking":null,"postPosition":"17","scratched":false,"win":"","place":"","show":"","deadHeat":false,"silks":null}],"isChallen