tionAtFinish":1},{"trackName":"MEYDAN RACECOURSE","raceName":"Nad Al Sheba Turf Sprint Sponsored By Emirates Skycargo","grade":"3","raceDate":"March, 01 2025 00:00:00","purseUsa":326760,"positionAtFinish":5},{"trackName":"MEYDAN RACECOURSE","raceName":"Dubai Trophy Sponsored By Azizi Developments","grade":" ","raceDate":"February, 07 2025 00:00:00","purseUsa":95305,"positionAtFinish":2},{"trackName":"MEYDAN RACECOURSE","raceName":"Al Wasl Stakes Sponsored By Dp World","grade":" ","raceDate":"January, 10 2025 00:00:00","purseUsa":81690,"positionAtFinish":3},{"trackName":"MEYDAN RACECOURSE","raceName":"Palm Beach Towers","grade":" ","raceDate":"December, 13 2024 00:00:00","purseUsa":47653,"positionAtFinish":3},{"trackName":"MEYDAN RACECOURSE","raceName":"Como Residences","grade":" ","raceDate":"November, 22 2024 00:00:00","purseUsa":44930,"positionAtFinish":1},{"trackName":"JEBEL ALI","raceName":"Commercial Bank Of Dubai S.                                                                              000000000","grade":" ","raceDate":"November, 02 2024 00:00:00","purseUsa":16338,"positionAtFinish":2}],"record":{"previousYear":{"starts":7,"earnings":1259935,"show":1,"win":3,"place":1,"showP":"14","winP":"43","placeP":"14"},"breedersCup":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"currentYear":{"starts":5,"earnings":1237605,"show":0,"win":1,"place":1,"showP":"0","winP":"20","placeP":"20"},"lifetime":{"starts":15,"earnings":2532531,"show":2,"win":5,"place":3,"showP":"13","winP":"33","placeP":"20"}},"yearlySummary":[{"showsP":"0","winsP":"20","placesP":"20","starts":5,"earnings":1237605,"racingYear":2026,"shows":0,"wins":1,"places":1},{"showsP":"14","winsP":"43","placesP":"14","starts":7,"earnings":1259935,"racingYear":2025,"shows":1,"wins":3,"places":1}],"morningLineOdds":[],"bio":"\u003cp\u003eAfter spending his career in the Middle East, Dark Saffron returns to his home state for the Cygames Breeders’ Cup Sprint (G1).\u003cbr /\u003eHe earned a guaranteed spot in the Sprint when he zipped to the lead and held off last year’s Sprint winner Bentornato to capture the “Win and You’re In” Dubai Golden Shaheen (G1) for the second straight year on March 28.\u003c/p\u003e\u003cp\u003eHis season began with a trio of uncharacteristic off-the-board efforts that his jockey Connor Beasley attributed to a starting gate mishap.\u003c/p\u003e\u003cp\u003e“He had a bit of an incident …\u0026nbsp; and banged his head and sort of lost his way,” Beasley said. “I think he lost a bit of confidence for his next three or four runs, but his last run (second in the Mahab Al Shimaal [G3]), we felt he was coming back to himself.”\u003c/p\u003e\u003cp\u003eThe Flameaway colt was sold for $25,000 at the 2023 Keeneland September Yearling Sale before being purchased by his current connections for $120,000 at the Ocala Breeders’ Sales Co.’s April auction in 2024. That November he debuted as a runner-up at Jebel Ali before winning next out at Meydan Racecourse, another Dubai track in the United Arab Emirates, where he has since raced exclusively.\u0026nbsp;\u003c/p\u003e","gradedStakesPoints":0,"regionWinnerBadges":[],"breederName":"Brookdale Farm LLC","uid":"blt632b59ef13667b9a","hasAutogeneratedPage":true,"url":"/redirect/horse/blt632b59ef13667b9a?ht=pre-entries","pageTitle":"Dark Saffron","jockeyName":"","ownerName":"Sultan Ali","trainer":"Ahmad bin Harmash","country":{"uid":"blt7f7d5d2e3f0b2809","title":"United Arab Emirates","abbreviation":"ARE","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt143bcf923cbd448a/61aa4f1092da7e58659cfc10/united-arab-emirates.png","alt":""}},"horseName":"Dark Saffron","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt4859374af03d9e38/6a736d6ced03cca070aca790/Contender_Photo_Dark_Saffron.jpg"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt4859374af03d9e38/6a736d6ced03cca070aca790/Contender_Photo_Dark_Saffron.jpg"},"cta":null,"races":[{"uid":"bltf6749e738cff0ef2","ContentTypeUid":"collection_race","challengeSeriesWinner":false,"isEligible":false,"eligibleRank":null,"finishPosition":null,"classicRanking":null,"postPosition":"","scratched":false,"win":"","place":"","show":"","deadHeat":false,"silks":null}],"isChallengeSeriesWinner":true,"silks":null,"isHoC":false,"year":2026,"isHistoricalEntry":false,"relatedArticles":[],"win":"","show":"","place":""},{"sireName":"Maxfield","damName":"In It for the Gold","sex":"Colt","color":"Bay","foalingDate":"February, 25 2023 00:00:00","age":3,"pastPerformances":[{"trackName":"SARATOGA","raceName":"H. Allen Jerkens Memorial S.","grade":"1","raceDate":"August, 29 2026 00:00:00","purseUsa":500000,"positionAtFinish":1},{"trackName":"SARATOGA","raceName":"Woody Stephens S. Presented by Mohegan Sun","grade":"1","raceDate":"June, 06 2026 00:00:00","purseUsa":500000,"positionAtFinish":1},{"trackName":"CHURCHILL DOWNS","raceName":"Pat Day Mile S. presented by SAP","grade":"2","raceDate":"May, 02 2026 00:00:00","purseUsa":750000,"positionAtFinish":2},{"trackName":"FAIR GROUNDS","raceName":" ","grade":" ","raceDate":"March, 19 2026 00:00:00","purseUsa":55000,"positionAtFinish":1},{"trackName":"CHURCHILL DOWNS","raceName":" ","grade":" ","raceDate":"September, 19 2025 00:00:00","purseUsa":120000,"positionAtFinish":1}],"record":{"previousYear":{"starts":1,"earnings":69300,"show":0,"win":1,"place":0,"showP":"0","winP":"100","placeP":"0"},"breedersCup":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"currentYear":{"starts":4,"earnings":725200,"show":0,"win":3,"place":1,"showP":"0","winP":"75","placeP":"25"},"lifetime":{"starts":5,"earnings":794500,"show":0,"win":4,"place":1,"showP":"0","winP":"80","placeP":"20"}},"yearlySummary":[{"showsP":"0","winsP":"75","placesP":"25","starts":4,"earnings":725200,"racingYear":2026,"shows":0,"wins":3,"places":1},{"showsP":"0","winsP":"100","placesP":"0","starts":1,"earnings":69300,"racingYear":2025,"shows":0,"wins":1,"places":0}],"morningLineOdds":[],"bio":"\u003cp\u003eEnglishman is so fast that his name has been spoken by racing experts in the same breath with luminaries such as Cygames Breeders’ Cup Sprint (G1) winner and Hall of Famer Kona Gold and champion Sprint winners Groovy and Orientate. \u0026nbsp;\r\u003c/p\u003e\u003cp\u003eHis speed was on full display when he rocketed to the front and never was challenged in the H. Allen Jerkens Memorial Stakes (G1) on Aug. 29 at Saratoga in his most recent start. His time of 1:20.71 for the 7 furlongs nearly lowered the record of 1:20.40 he set in Saratoga’s Woody Stephens Stakes (G1) on June 6. \u0026nbsp; \r\u003c/p\u003e\u003cp\u003eWhen not racing out-of-state, Englisman is based at Keeneland where he routinely clocks the best of dozens of half-mile workout times. \u0026nbsp; \r\u003c/p\u003e\u003cp\u003e“He breaks so fast and clears the field, and it’s hard for anyone to get up there and challenge him,” trainer Cherie DeVaux said after the H. Allen Jerkens. “(Regular jockey Jose Ortiz) has been key in developing him especially in his races.” \r\u003c/p\u003e\u003cp\u003eIn five starts, Englishman’s lone defeat is his runner-up effort in the Pat Day Mile (G2) in his only attempt beyond 7 furlongs. He debuted at Churchill Downs on Sept. 19, 2025 going 7 furlongs and winning by 7 1/4 lengths and then posted an allowance victory at Fair Grounds on March 19 winning by 7 1/2 lengths going 6 furlongs. \r\u003c/p\u003e\u003cp\u003eFrom the first crop of Grade 1 winner Maxfield, Englishman was sourced for $400,000 at the 2024 Keeneland September Yearling Sale. The previous year, he was sold for $240,000 as a weanling at Keeneland’s November sale. \u0026nbsp;\u003c/p\u003e","gradedStakesPoints":24,"regionWinnerBadges":[],"breederName":"Fifth Avenue Bloodstock","uid":"blt3089ffcf64f5da2e","hasAutogeneratedPage":true,"url":"/redirect/horse/blt3089ffcf64f5da2e?ht=