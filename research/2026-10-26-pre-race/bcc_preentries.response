":"September, 08 2024 00:00:00","purseUsa":76000,"positionAtFinish":1},{"trackName":"SANTA ANITA PARK","raceName":" ","grade":" ","raceDate":"June, 13 2024 00:00:00","purseUsa":55000,"positionAtFinish":5},{"trackName":"SANTA ANITA PARK","raceName":"Desert Code S.","grade":" ","raceDate":"May, 19 2024 00:00:00","purseUsa":100000,"positionAtFinish":4},{"trackName":"SANTA ANITA PARK","raceName":" ","grade":" ","raceDate":"May, 04 2024 00:00:00","purseUsa":55000,"positionAtFinish":3},{"trackName":"SANTA ANITA PARK","raceName":" ","grade":" ","raceDate":"April, 04 2024 00:00:00","purseUsa":65000,"positionAtFinish":1},{"trackName":"DUNDALK","raceName":"Irish Stallion Farms EBF","grade":" ","raceDate":"December, 06 2023 00:00:00","purseUsa":16197,"positionAtFinish":2},{"trackName":"DUNDALK","raceName":"View Restaurant At Dundalk Stadium Median Auction","grade":" ","raceDate":"November, 15 2023 00:00:00","purseUsa":13055,"positionAtFinish":2}],"record":{"previousYear":{"starts":7,"earnings":102780,"show":4,"win":1,"place":0,"showP":"57","winP":"14","placeP":"0"},"breedersCup":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"currentYear":{"starts":6,"earnings":282080,"show":1,"win":2,"place":1,"showP":"17","winP":"33","placeP":"17"},"lifetime":{"starts":22,"earnings":542918,"show":6,"win":6,"place":4,"showP":"27","winP":"27","placeP":"18"}},"yearlySummary":[{"showsP":"17","winsP":"33","placesP":"17","starts":6,"earnings":282080,"racingYear":2026,"shows":1,"wins":2,"places":1},{"showsP":"57","winsP":"14","placesP":"0","starts":7,"earnings":102780,"racingYear":2025,"shows":4,"wins":1,"places":0}],"morningLineOdds":[],"bio":"\u003cp\u003eSorrento Sky (IRE) was bred in Ireland and is named for the charming city on Italy's Amalfi Coast but found his niche in Southern California. \r\u003c/p\u003e\u003cp\u003eA son of Prince of Lir (IRE), Sorrento Sky started in Dundalk in Ireland, finishing second twice at the end of 2023. He was whisked away from those efforts to Santa Anita, where he won his first start for trainer Phil D'Amato, going 6 1/2 furlongs on the grass. \r\u003c/p\u003e\u003cp\u003eHe posted top-three finishes in nine of his next 12 starts, a stretch that included thirds in 2025 in the San Simeon Stakes (G3) and the Eddie D Stakes (G2). \r\u003c/p\u003e\u003cp\u003eSorrento Sky started 2026 finishing second in the Clocker's Corner Stakes at Santa Anita, then followed with fourth-place showings in the San Simeon Stakes and the Siren Lure Stakes (Listed), both at Santa Anita. \r\u003c/p\u003e\u003cp\u003eHis picked things up as the season wore on. A second in a Del Mar allowance event in July led to a victory in the Green Flash Handicap (G2) at Del Mar, earning a \"Win and You're In\" Challenge bid to the Prevagen Breeders' Cup Turf Sprint (G1). He followed with a win in a return engagement in the Eddie D. \r\u003c/p\u003e","gradedStakesPoints":6,"regionWinnerBadges":[],"breederName":"Miss Colleen Dwyer","uid":"blta282cca23d4973a0","hasAutogeneratedPage":true,"url":"/redirect/horse/blta282cca23d4973a0?ht=pre-entries","pageTitle":"Sorrento Sky (IRE)","jockeyName":"","ownerName":"Michael Nentwig, Agave Racing Stable (Mark Martinez), Benowitz Family Trust (Sandra Benowitz), CYBT (John Rochfort), McLean Racing Stables (Ian B. McLean), Saul Gevertz \u0026 Marc Lantzman","trainer":"Philip D'Amato","country":{"uid":"blta32e5b692b12a246","title":"Ireland","abbreviation":"IRE","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt613f9a736c40223a/61aa4c2b2f8b9e70946988d3/ireland.png","alt":""}},"horseName":"Sorrento Sky","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt0029f833730803fe/6a95c85e2707c54f07328d6f/Contender_Photo_Sorrento_Sky_.jpg"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt0029f833730803fe/6a95c85e2707c54f07328d6f/Contender_Photo_Sorrento_Sky_.jpg"},"cta":null,"races":[{"uid":"bltc81