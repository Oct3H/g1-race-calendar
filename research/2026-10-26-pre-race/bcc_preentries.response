itionAtFinish":3},{"trackName":"LINGFIELD","raceName":"Midnite Winter Derby Trial Conditions Stakes (Class 2) (Gbbplus Race)","grade":" ","raceDate":"January, 31 2026 00:00:00","purseUsa":41056,"positionAtFinish":1},{"trackName":"LONGCHAMP","raceName":"Qatar Prix de Royallieu","grade":"1","raceDate":"October, 04 2025 00:00:00","purseUsa":352270,"positionAtFinish":12},{"trackName":"LONGCHAMP","raceName":"Qatar Prix Vermeille","grade":"1","raceDate":"September, 07 2025 00:00:00","purseUsa":703157,"positionAtFinish":4},{"trackName":"DEAUVILLE","raceName":"Sumbe Prix Jean Romanet","grade":"1","raceDate":"August, 24 2025 00:00:00","purseUsa":468874,"positionAtFinish":2},{"trackName":"CURRAGH","raceName":"Paddy Power Pretty Polly S.","grade":"1","raceDate":"June, 28 2025 00:00:00","purseUsa":351572,"positionAtFinish":3},{"trackName":"SAINT CLOUD","raceName":"Prix Corrida","grade":"2","raceDate":"May, 19 2025 00:00:00","purseUsa":145317,"positionAtFinish":2},{"trackName":"LONGCHAMP","raceName":"Qatar Prix de l'Arc de Triomphe","grade":"1","raceDate":"October, 06 2024 00:00:00","purseUsa":5412215,"positionAtFinish":7},{"trackName":"LONGCHAMP","raceName":"Qatar Prix Vermeille","grade":"1","raceDate":"September, 15 2024 00:00:00","purseUsa":649466,"positionAtFinish":7},{"trackName":"LONGCHAMP","raceName":"Prix de Malleret","grade":"2","raceDate":"July, 13 2024 00:00:00","purseUsa":140718,"positionAtFinish":1},{"trackName":"CHANTILLY","raceName":"Prix de Diane Longines","grade":"1","raceDate":"June, 16 2024 00:00:00","purseUsa":1070899,"positionAtFinish":2},{"trackName":"LONGCHAMP","raceName":"St Mark'S Basilica Coolmore Prix Saint-Alary","grade":"2","raceDate":"May, 12 2024 00:00:00","purseUsa":140069,"positionAtFinish":3},{"trackName":"LONGCHAMP","raceName":"Al Shira'Aa Racing Prix Vanteaux","grade":"3","raceDate":"April, 07 2024 00:00:00","purseUsa":86730,"positionAtFinish":3},{"trackName":"CHANTILLY","raceName":"Prix de la Chambre de Marbre","grade":" ","raceDate":"December, 30 2023 00:00:00","purseUsa":37529,"positionAtFinish":1},{"trackName":"DEAUVILLE","raceName":"Prix de la Cerisaie","grade":" ","raceDate":"November, 15 2023 00:00:00","purseUsa":32638,"positionAtFinish":1}],"record":{"previousYear":{"starts":5,"earnings":210946,"show":1,"win":0,"place":2,"showP":"20","winP":"0","placeP":"40"},"breedersCup":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"currentYear":{"starts":8,"earnings":901803,"show":2,"win":3,"place":0,"showP":"25","winP":"38","placeP":"0"},"lifetime":{"starts":21,"earnings":1500565,"show":5,"win":6,"place":3,"showP":"24","winP":"29","placeP":"14"}},"yearlySummary":[{"showsP":"25","winsP":"38","placesP":"0","starts":8,"earnings":901803,"racingYear":2026,"shows":2,"wins":3,"places":0},{"showsP":"20","winsP":"0","placesP":"40","starts":5,"earnings":210946,"racingYear":2025,"shows":1,"wins":0,"places":2}],"morningLineOdds":[],"bio":"\u003cp\u003e\u003cspan\u003e\u003c/span\u003eShe was the only female in the field but Survie (IRE) took the boys to school in the 1 ½-mile Christophe Clement Turf (G1) at Saratoga Aug. 15 as she once again displayed her devastating turn of foot and stamina, rallying from last to first through the lane under Manny Franco to become the first of her sex to win this prestigious event since 1988. \u0026nbsp;\r\u003c/p\u003e\u003cp\u003eThe 5-year-old daughter of European champion Churchill (IRE) has been a top-quality filly in Europe throughout her career with seven graded stakes placings and a win in the 2024 Prix de Malleret (G2) at Longchamp immediately after her runner-up finish in the Prix de Diane (G1) at Chantilly. \u0026nbsp;\r\u003c/p\u003e\u003cp\u003eSince English trainer George Boughey sent her stateside this summer she has excelled. Just two weeks before winning the Christophe Clement, which is a “Win and You’re In” qualifier for the Breeders’ Cup Longines Turf (G1), she also turned for home and turned it on through the stretch to take the Glen Falls (G2) against fillies and mares on the same course at the same distance. \u0026nbsp;\r\u003c/p\u003e\u003cp\u003eThree weeks after the Clement victory, Survie was back in Europe in the 1 1/2-mile Prix Vermeille (G1) at Parislongchamp. However, she did not fire in finishing a nonthreatening 10th of 13 being eased late after not finding racing room in the stretch. \r\u003c/p\u003e\u003cp\u003eSurvie, which means “survive” in English, is out of the Le Havre (IRE) mare Sotteville (FR). She was sold by her French connections at auction last December to Michael Tabor for $2,636.068.\u003cspan style=\"color: rgb(29, 34, 40);\"\u003e\u003c/span\u003e\u003cspan\u003e\u003c/span\u003e\u003c/p\u003e","gradedStakesPoints":16,"regionWinnerBadges":[],"breederName":"Franklin Finance S.A.","uid":"blta9ec55dad9f7143f","hasAutogeneratedPage":true,"url":"/redirect/horse/blta9ec55dad9f7143f?ht=pre-entries","pageTitle":"Survie (IRE)","jockeyName":"","ownerName":"Doreen Tabor","trainer":"George Boughey","country":{"uid":"blt1af49e3a6a89373f","title":"USA","abbreviation":"USA","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt9de45bbdff160673/60d219911e0505677a882fa1/USAFlag.png"}},"horseName":"Survie","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt87c957fa18a46f11/6a74b6dbcbb9ed962953d7bf/Contender_Photo_Survie.jpg"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt87c957fa18a46f11/6a74b6dbcbb9ed962953d7bf/Contender_Photo_Survie.jpg"},"cta":null,"races":[{"uid":"bltc3fc513333460ff5","ContentTypeUid":"collection_race","challengeSeriesWinner":false,"isEligible":false,"eligibleRank":null,"finishPosition":null,"classicRanking":null,"postPosition":"","scratched":false,"win":"","place":"","show":"","deadHeat":false,"silks":null}],"isChallengeSeriesWinner":true,"silks":null,"isHoC":false,"year":2026,"isHistoricalEntry":true,"relatedArticles":[],"win":"","show":"","place":""},{"sireName":"Collected","damName":"Creative Thinking","sex":"Filly","color":"Chestnut","foalingDate":"April, 12 2022 00:00:00","age":4,"pastPerformances":[{"trackName":"SANTA ANITA PARK","raceName":"Rodeo Drive S.","grade":"2","raceDate":"October, 03 2026 00:00:00","purseUsa":200000,"positionAtFinish":1},{"trackName":"DEL MAR","raceName":"John C. Mabee S.","grade":"2","raceDate":"September, 07 2026 00:00:00","purseUsa":250000,"positionAtFinish":2},{"trackName":"SANTA ANITA PARK","raceName":"Gamely S.","grade":"1","raceDate":"May, 25 2026 00:00:00","purseUsa":300000,"positionAtFinish":1},{"trackName":"SANTA ANITA PARK","raceName":"Buena Vista S.","grade":"2","raceDate":"February, 28 2026 00:00:00","purseUsa":200000,"positionAtFinish":1},{"trackName":"DEL MAR","raceName":"Del Mar Oaks Presented by Keeneland Sales S.","grade":"1","raceDate":"August, 16 2025 00:00:00","purseUsa":300000,"positionAtFinish":3},{"trackName":"DEL MAR","raceName":"San Clemente H.","grade":"2","raceDate":"July, 19 2025 00:00:00","purseUsa":200000,"positionAtFinish":1},{"trackName":"SANTA ANITA PARK","raceName":" ","grade":" ","raceDate":"June, 14 2025 00:00:00","purseUsa":67000,"positionAtFinish":1},{"trackName":"DEL MAR","raceName":"John Deere Breeders' Cup Juvenile Fillies Turf","grade":"1","raceDate":"November, 01 2024 00:00:00","purseUsa":1000000,"positionAtFinish":9},{"trackName":"SANTA ANITA PARK","raceName":"Surfer Girl S.","grade":"3","raceDate":"October, 06 2024 00:00:00","purseUsa":100000,"positionAtFinish":1},{"trackName":"DEL MAR","raceName":"Del Mar Juvenile Fillies Turf S.","grade":" ","raceDate":"September, 07 2024 00:00:00","purseUsa":100000,"positionAtFinish":1},{"trackName":"DEL MAR","raceName":" ","grade":" ","raceDate":"August, 17 2024 00:00:00","purseUsa":75000,"positionAtFinish":1},{"trackName":"DEL MAR","raceName":" ","grade":" ","raceDate":"July, 27 2024 00:00:00","purseUsa":75000,"positionAtFinish":3}],"record":{"previousYear":{"starts":3,"earnings":196200,"show":1,"win":2,"place":0,"showP":"33","winP":"67","placeP":"0"},"breedersCup":{"starts":1,"earnings":10000,"show":0,"win":0,"place":0,"showP":"0","winP":"0","placeP":"0"},"currentYear":{"starts":4,"earnings":470000,"show":0,"win":3,"place":1,"showP":"0","winP":"75","placeP":"25"},"lifetime":{"starts":12,"earnings":850200,"show":2,"win":8,"place":1,"showP":"17","winP":"67","placeP":"8"}},"yearlySummary":[{"showsP":"0","winsP":"75","placesP":"25","starts":4,"earnings":470000,"racingYear":2026,"shows":0,"wins":3,"places":1},{"showsP":"33","winsP":"67","placesP":"0","starts":3,"earnings":196200,"racingYear":2025,"shows":1,"wins":2,"places":0}],"morningLineOdds":[],"bio":"\u003cp\u003eThought Process came back from a six-month vacation after the conclusion of her 3-year-old season to win two graded stakes in 2026 at Santa Anita as she pleased, and in the process, she established herself as one of the leading turf females on the West Coast. \r\u003c/p\u003e\u003cp\u003eThe daughter of Collected and Creative Thinking by Creative Cause, who had been away from the races for 6 ½ months, returned Feb. 28 with a 2-length score in the 1-mile Buena Vista (G2) and followed that with a 2 ¾-length triumph in the May 25 Gamely (G1) while traveling a furlong farther. After a short break she tried the Del Mar course in the 1 1/8-mile John C. Mabee (G2), in which she was outkicked in the stretch to be the runner-up by a length on Sept. 7.\r\u003c/p\u003e\u003cp\u003eShe was back in the winner’s circle Oct. 3 after a front-running, geared down 4 1/4-length victory in the 1 1/4-mile Rodeo Drive (G1) at Santa Anita.\r\u003c/p\u003e\u003cp\u003eThe Phil D'Amato trainee was a graded stakes winner at ages 2 and 3, though she has yet to race outside of Southern California. After winning the 2024 Surfer Girl (G3) at Del Mar, she finished ninth in the John Deere Breeders' Cup Juvenile Fillies Turf (G1). She is owned by the partnership of The Estate of Brereton C. Jones, Little Red Feather Racing and Madaket Stables. \r\u003c/p\u003e","gradedStakesPoints":26,"regionWinnerBadges":[],"breederName":"Brereton C. Jones","uid":"bltc2aa16cc34716d05","hasAutogeneratedPage":true,"url":"/redirect/horse/bltc2aa16cc34716d05?ht=pre-entries","pageTitle":"Thought Process","jockeyName":"","ownerName":"Little Red Feather Racing (William Koch), Madaket Stables, LLC (Sol Kumin) \u0026 The Estate of Brereton C. Jones (Elizabeth Lloyd Jones)","trainer":"Philip D'Amato","country":{"uid":"blt1af49e3a6a89373f","title":"USA","abbreviation":"USA","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt9de45bbdff160673/60d219911e0505677a882fa1/USAFlag.png"}},"horseName":"Thought Process","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt88406151f21bb6ff/6ac1a47c758e4e716ae137b9/Contender_Photo_-_Thought_Process.jpg"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt88406151f21bb6ff/6ac1a47c758e4e716ae137b9/Contender_Photo_-_Thought_Process.jpg"},"cta":null,"races":[{"uid":"bltc3fc513333460ff5","ContentTypeUid":"collection_race","challengeSeriesWinner":false,"isEligible":false,"eligibleRank":null,"finishPosition":null,"classicRanking":null,"postPosition":"","scratched":false,"win":"","place":"","show":"","deadHeat":false,"silks":null}],"isChallengeSeriesWinner":true,"silks":null,"isHoC":false,"year":2026,"isHistoricalEntry":false,"relatedArticles":[],"win":"","show":"","place":""},{"sireName":"Justify","damName":"Savvy Star","sex":"Mare","color":"Dark Bay or Brown","foalingDate":"March, 16 2021 00:00:00","age":5,"pastPerformances":[{"trackName":"KENTUCKY DOWNS","raceName":"Global Tote Kentucky Downs Ladies Marathon Invitational S.","grade":"3","raceDate":"September, 06 2026 00:00:00","purseUsa":1500000,"positionAtFinish":1},{"trackName":"COLONIAL DOWNS","raceName":"Beverly D. S.","grade":"2","raceDate":"August, 01 2026 00:00:00","purseUsa":500000,"positionAtFinish":4},{"trackName":"DEL MAR","raceName":"Maker's Mark Breeders' Cup Filly \u0026 Mare Turf","grade":"1","raceDate":"November, 01 2025 00:00:00","purseUsa":2000000,"positionAtFinish":7},{"trackName":"KENTUCKY DOWNS","raceName":"Light \u0026 Wonder Ladies Marathon Invitational S.","grade":"3","raceDate":"September, 06 2025 00:00:00","purseUsa":2000000,"positionAtFinish":1},{"trackName":"KENTUCKY DOWNS","raceName":" ","grade":" ","raceDate":"August, 28 2025 00:00:00","purseUsa":200000,"positionAtFinish":1},{"trackName":"CHURCHILL DOWNS","raceName":" ","grade":" ","raceDate":"June, 12 2025 00:00:00","purseUsa":127000,"positionAtFinish":1},{"trackName":"CHURCHILL DOWNS","raceName":" ","grade":" ","raceDate":"May, 01 2025 00:00:00","purseUsa":120000,"positionAtFinish":1},{"trackName":"FAIR GROUNDS","raceName":" ","grade":" ","raceDate":"March, 23 2025 00:00:00","purseUsa":52000,"positionAtFinish":2},{"trackName":"FAIR GROUNDS","raceName":" ","grade":" ","raceDate":"February, 22 2025 00:00:00","purseUsa":52000,"positionAtFinish":3}],"record":{"previousYear":{"starts":7,"earnings":1462604,"show":1,"win":4,"place":1,"showP":"14","winP":"57","placeP":"14"},"breedersCup":{"starts":1,"earnings":20000,"show":0,"win":0,"place":0,"showP":"0","winP":"0","placeP":"0"},"currentYear":{"starts":2,"earnings":911100,"show":0,"win":1,"place":0,"showP":"0","winP":"50","placeP":"0"},"lifetime":{"starts":9,"earnings":2373704,"show":1,"win":5,"place":1,"showP":"11","winP":"56","placeP":"11"}},"yearlySummary":[{"showsP":"0","winsP":"50","placesP":"0","starts":2,"earnings":911100,"racingYear":2026,"shows":0,"wins":1,"places":0},{"showsP":"14","winsP":"57","placesP":"14","starts":7,"earnings":1462604,"racingYear":2025,"shows":1,"wins":4,"places":1}],"morningLineOdds":[],"bio":"\u003cp\u003eStellify made light work of the Ladies Marathon Invitational (G3) at Kentucky Downs on Sept. 6 with a gate-to-wire score while defending her title and keeping her perfect record on the course intact. Her victory in the 1 5/16-mile contest was so dominant that she drew clear by 5 ½ lengths under a hand ride by Flavien Prat. \u0026nbsp;\r\u003c/p\u003e\u003cp\u003eLightly raced by trainer Brad Cox in 2026, Stellify was making just her second appearance since a seventh-place finish in the 2025 Maker's Mark Filly \u0026amp; Mare Turf. On Aug. 1, the 5-year-old mare ran fourth in the Beverly D. (G2) at Colonial Downs when she did not get her preferred position on the lead after being bumped at the start.. \r\u003c/p\u003e\u003cp\u003eThe daughter of Hall of Famer and 2018 Triple Crown winner Justify and the Medaglia D'Oro mare Savvy Star was unraced until her 4-year-old season, when she ran off a four-race win streak. In addition to her victory in the 2025 Ladies Marathon Invitational, last year she established a Churchill Downs course record of 2:11.73 for 1 3/8 miles when winning in allowance company by 4 lengths. \r\u003c/p\u003e\u003cp\u003eShe is owned by the partnership of Steve Smith's Elements Racing, George Messina and Lee Michael, who caught lightning in a bottle when they bought her for $140,000 as a yearling. The $2.3 million earner is their only graded stakes winner and Messina's son, Trace, is one of Cox's top assistants. \u0026nbsp;\u003c/p\u003e","gradedStakesPoints":4,"regionWinnerBadges":[],"breederName":"WinStar Farm, LLC","uid":"blt3d563af9d0504f96","hasAutogeneratedPage":true,"url":"/redirect/horse/blt3d563af9d0504f96?ht=pre-entries","pageTitle":"Stellify","jockeyName":"","ownerName":"Elements Racing, LLC (Stephen Smith), George Messina \u0026 Michael Lee","trainer":"Brad Cox","country":{"uid":"blt1af49e3a6a89373f","title":"USA","abbreviation":"USA","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt9de45bbdff160673/60d219911e0505677a882fa1/USAFlag.png"}},"horseName":"Stellify","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt1260bba9fa78b103/6aa1c7c037d7f3de218ebaab/Contender_Photo_Stellify.jpg"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt1260bba9fa78b103/6aa1c7c037d7f3de218ebaab/Contender_Photo_Stellify.jpg"},"cta":null,"races":[{"uid":"bltc3fc513333460ff5","ContentTypeUid":"collection_race","challengeSeriesWinner":false,"isEligible":true,"eligibleRank":15,"finishPosition":null,"classicRanking":null,"postPosition":"15","scratched":false,"win":"","place":"","show":"","deadHeat":false,"silks":null}],"isChallengeSeriesWinner":false,"silks":null,"isHoC":false,"year":2026,"isHistoricalEntry":false,"relatedArticles":[],"win":"","show":"","place":""},{"sireName":"Churchill (IRE)","damName":"Balankiya (IRE)","sex":"Filly","color":"Bay","foalingDate":"April, 16 2022 00:00:00","age":4,"pastPerformances":[{"trackName":"BELMONT PARK","raceName":"Flower Bowl S.","grade":"2","raceDate":"October, 01 2026 00:00:00","purseUsa":500000,"positionAtFinish":3},{"trackName":"SARATOGA","raceName":"Waya S.","grade":"3","raceDate":"August, 28 2026 00:00:00","purseUsa":225000,"positionAtFinish":1},{"trackName":"COLONIAL DOWNS","raceName":" ","grade":" ","raceDate":"July, 19 2026 00:00:00","purseUsa":74000,"positionAtFinish":3},{"trackName":"AQUEDUCT","raceName":"Jockey Club Oaks","grade":"3","raceDate":"November, 15 2025 00:00:00","purseUsa":350000,"positionAtFinish":8},{"trackName":"COLONIAL DOWNS","raceName":"Old Dominion Oaks","grade":" ","raceDate":"September, 06 2025 00:00:00","purseUsa":250000,"positionAtFinish":2},{"trackName":"SARATOGA","raceName":"Fasig-Tipton Saratoga Oaks Invitational S.","grade":"2","raceDate":"August, 09 2025 00:00:00","purseUsa":500000,"positionAtFinish":2},{"trackName":"COLONIAL DOWNS","raceName":" ","grade":" ","raceDate":"July, 09 2025 00:00:00","purseUsa":72000,"positionAtFinish":1},{"trackName":"TAMPA BAY DOWNS","raceName":" ","grade":" ","raceDate":"December, 07 2024 00:00:00","purseUsa":53000,"positionAtFinish":1},{"trackName":"LAUREL PARK","raceName":" ","grade":" ","raceDate":"October, 26 2024 00:00:00","purseUsa":48200,"positionAtFinish":5}],"record":{"previousYear":{"starts":4,"earnings":196700,"show":0,"win":1,"place":2,"showP":"0","winP":"25","placeP":"50"},"breedersCup":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"currentYear":{"starts":3,"earnings":191150,"show":2,"win":1,"place":0,"showP":"67","winP":"33","placeP":"0"},"lifetime":{"starts":9,"earnings":408140,"show":2,"win":3,"place":2,"showP":"22","winP":"33","placeP":"22"}},"yearlySummary":[{"showsP":"67","winsP":"33","placesP":"0","starts":3,"earnings":191150,"racingYear":2026,"shows":2,"wins":1,"places":0},{"showsP":"0","winsP":"25","placesP":"50","starts":4,"earnings":196700,"racingYear":2025,"shows":0,"wins":1,"places":2}],"morningLineOdds":[],"bio":"\u003cp\u003eEvershed (IRE) recorded her breakthrough victory in the Waya (G3) on the Saratoga lawn Aug. 28 after two previously unsuccessful attempts in graded stakes events, but the race at 1 3/8 miles wasn't trainer Arnaud Delacour's original intention. He said he had to go to Plan B after a second level allowance race wasn't available for the daughter of Churchill (IRE). The change-up proved fortuitous as it resulted in the most important win of the 4-year-old filly's career and at the same time provided the steppingstone to the Flower Bowl (G2) Oct. 1, in which she ran third behind Maker's Mark Breeders’ Cup Filly \u0026amp; Mare Turf (G1) contender Kathynmarissa. \u0026nbsp;\r\u003c/p\u003e\u003cp\u003eDelacour is delighted with Mark Grier's color bearer, who returned to the races in July after a series of setbacks had kept her on the sidelines for eight months. In her first start of 2026 she finished third in an optional claiming race at Colonial Downs. \"She keeps improving. Since she came back she hasn't missed a beat. I couldn't be happier,\" he said. \r\u003c/p\u003e\u003cp\u003eEvershed, who was the runner-up in the 2025 Saratoga Oaks Invitational (G2), is out of Balankiya (IRE) by Darshaan (GB), who was a champion sire and broodmare 