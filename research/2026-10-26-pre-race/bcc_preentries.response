1","raceDate":"August, 02 2025 00:00:00","purseUsa":750000,"positionAtFinish":4},{"trackName":"SANDOWN PARK","raceName":"Coral-Eclipse","grade":"1","raceDate":"July, 05 2025 00:00:00","purseUsa":1364797,"positionAtFinish":5},{"trackName":"CURRAGH","raceName":"Tattersalls Irish Two Thousand Guineas","grade":"1","raceDate":"May, 24 2025 00:00:00","purseUsa":568202,"positionAtFinish":3},{"trackName":"DONCASTER","raceName":"William Hill Futurity Trophy S.","grade":"1","raceDate":"October, 26 2024 00:00:00","purseUsa":279822,"positionAtFinish":1},{"trackName":"CURRAGH","raceName":"Montane Developments Beresford S.","grade":"2","raceDate":"September, 28 2024 00:00:00","purseUsa":129893,"positionAtFinish":1},{"trackName":"CURRAGH","raceName":"Coolmore Stud Wootton Bassett Irish E.B.F. Futurity S.","grade":"2","raceDate":"August, 24 2024 00:00:00","purseUsa":129893,"positionAtFinish":2},{"trackName":"LEOPARDSTOWN","raceName":"Japan Racing Association Tyros S.","grade":"3","raceDate":"July, 25 2024 00:00:00","purseUsa":54122,"positionAtFinish":1},{"trackName":"CURRAGH","raceName":"Spar Shop At The Curragh Irish E.B.F.","grade":" ","raceDate":"June, 05 2024 00:00:00","purseUsa":21759,"positionAtFinish":1},{"trackName":"LEOPARDSTOWN","raceName":"Irish Stallion Farms E.B.F.","grade":" ","raceDate":"May, 17 2024 00:00:00","purseUsa":19561,"positionAtFinish":4}],"record":{"previousYear":{"starts":5,"earnings":191529,"show":1,"win":0,"place":0,"showP":"20","winP":"0","placeP":"0"},"breedersCup":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"currentYear":{"starts":4,"earnings":953965,"show":2,"win":2,"place":0,"showP":"50","winP":"50","placeP":"0"},"lifetime":{"starts":15,"earnings":1458018,"show":3,"win":6,"place":1,"showP":"20","winP":"40","placeP":"7"}},"yearlySummary":[{"showsP":"50","winsP":"50","placesP":"0","starts":4,"earnings":953965,"racingYear":2026,"shows":2,"wins":2,"places":0},{"showsP":"20","winsP":"0","placesP":"0","starts":5,"earnings":191529,"racingYear":2025,"shows":1,"wins":0,"places":0}],"morningLineOdds":[],"bio":"\u003cp\u003eWhen Hotazhell (GB) did not appear among the confirmations for the Oct. 17 British Champions Day at Ascot in England, it was clear the 4-year-old son of Too Darn Hot (GB) was headed for a career finale in the Breeders' Cup World Championships at Keeneland. \r\u003c/p\u003e\u003cp\u003eThe travel makes sense as he has won in Ireland, England and Germany and finished an unlucky fourth as the favorite in the 2025 Saratoga Derby Invitational (G1). The question would be, which race? Hotazhell has Group 1 victories at both 1 mile and 1 1/4 miles, leaving it to trainer Jessica Harrington and the Silverton Hill Partnership owners to pick the trip. \r\u003c/p\u003e\u003cp\u003eHotazhell, out of the Danehill Dancer (IRE) mare Azenar (GB), was an early success story. He finished second in the Futurity Stakes (G2) at the Curragh in August 2024, won the prestigious Beresford Stakes (G2) at the same track and the Futurity Trophy (G1) at Doncaster before winter break. \r\u003c/p\u003e\u003cp\u003eHotazhell wasn't quite so hot at 3, going 0-for-5, including a 10th-place finish when ambitiously placed in the Prix de l'Arc de Triomphe (G1). After an eight-month break he returned in 2026 to post two thirds in Ireland, then won the Grosser Dallmayr-Preis-Bayerisches Zuchtrennen (Group 1) in Munich and the Irish Champion Stakes (G1) at odds of 50-1.\u0026nbsp;\u003c/p\u003e","gradedStakesPoints":0,"regionWinnerBadges":[],"breederName":"Blue Diamond Stud Farm (UK) Ltd","uid":"blt87a5f751670d3414","hasAutogeneratedPage":true,"url":"/redirect/horse/blt87a5f751670d3414?ht=pre-entries","pageTitle":"Hotazhell (GB)","jockeyName":"","ownerName":"Silverton Hill, LLC (Bonnie and Tommy Hamilton)","trainer":"Jessica Harrington","country":{"uid":"blt440e3ce320965a9b","title":"United Kingdom / England","abbreviation":"GBR","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt02676e7705186e63/61aa4e462e86841fa22388f0/united-kingdom.png","alt":""}},"horseName":"Hotazhell","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt01256eb97a81d9bc/6ad25621bcf6e0334ee5750e/Contender_Photo_Hotazhell.jpg"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt01256eb97a81d9bc/6ad25621bcf6e0334ee5750e/Contender_Photo_Hotazhell.jpg"},"cta":null,"races":[{"uid":"blt21de548e7ed632cc","ContentTypeUid":"collection_race","challengeSeriesWinner":false,"isEligible":false,"eligibleRank":null,"finishPosition":null,"classicRanking":null,"postPosition":"","scratched":false,"win":"","place":"","show":"","deadHeat":false,"silks":null}],"isChallengeSeriesWinner":true,"silks":null,"isHoC":false,"year":2026,"isHistoricalEntry":false,"relatedArticles":[],"win":"","show":"","place":""},{"sireName":"Instilled Regard","damName":"Beau Recall (IRE)","sex":"Colt","color":"Bay","foalingDate":"March, 17 2022 00:00:00","age":4,"pastPerformances":[{"trackName":"BELMONT PARK","raceName":"Joe Hirsch Turf Classic S.","grade":"1","raceDate":"October, 01 2026 00:00:00","purseUsa":500000,"positionAtFinish":1},{"trackName":"SARATOGA","raceName":"Christophe Clement Turf S.","grade":"1","raceDate":"August, 15 2026 00:00:00","purseUsa":750000,"positionAtFinish":2},{"trackName":"SARATOGA","raceName":"Bowling Green S. Presented by Emerald Ecovations","grade":"2","raceDate":"July, 11 2026 00:00:00","purseUsa":250000,"positionAtFinish":3},{"trackName":"CHURCHILL DOWNS","raceName":"Arlington S.","grade":"3","raceDate":"May, 30 2026 00:00:00","purseUsa":275000,"positionAtFinish":2},{"trackName":"CHURCHILL DOWNS","raceName":"Opening Verse S.","grade":" ","raceDate":"April, 30 2026 00:00:00","purseUsa":350000,"positionAtFinish":4},{"trackName":"CHURCHILL DOWNS","raceName":"American Derby","grade":" ","raceDate":"June, 28 2025 00:00:00","purseUsa":250000,"positionAtFinish":1},{"trackName":"KEENELAND","raceName":"Castle \u0026 Key Bourbon S.","grade":"2","raceDate":"October, 06 2024 00:00:00","purseUsa":350000,"positionAtFinish":1},{"trackName":"HORSESHOE INDIANAPOLIS","raceName":" ","grade":" ","raceDate":"September, 06 2024 00:00:00","purseUsa":32000,"positionAtFinish":1},{"trackName":"ELLIS PARK","raceName":" ","grade":" ","raceDate":"August, 05 2024 00:00:00","purseUsa":71000,"positionAtFinish":3}],"record":{"previousYear":{"starts":1,"earnings":154000,"show":0,"win":1,"place":0,"showP":"0","winP":"100","placeP":"0"},"breedersCup":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"currentYear":{"starts":5,"earnings":525288,"show":1,"win":1,"place":2,"showP":"20","winP":"20","placeP":"40"},"lifetime":{"starts":9,"earnings":903256,"show":2,"win":4,"place":2,"showP":"22","winP":"44","placeP":"22"}},"yearlySummary":[{"showsP":"20","winsP":"20","placesP":"40","starts":5,"earnings":525288,"racingYear":2026,"shows":1,"wins":1,"places":2},{"showsP":"0","winsP":"100","placesP":"0","starts":1,"earnings":154000,"racingYear":2025,"shows":0,"wins":1,"places":0}],"morningLineOdds":[],"bio":"\u003cp\u003eMinaret Station became a Grade 1 winner in his most recent start, but it was not without some drama. He won the Oct. 1 Joe Hirsch Turf Classic Stakes (G1) at Belmont Park but had to survive a stewards' inquiry to keep the victory. Minaret Station defeated Far Bridge by a half-length but had drifted in the stretch of the 1 ½-mile contest. \r\u003c/p\u003e\u003cp\u003eIn his previous start, Minaret Station narrowly lost at the highest level when he finished second by three-quarters of a length to Survie (IRE) in the Aug. 15 Christophe Clement Turf Stakes (G1) at Saratoga. \u0026nbsp;\r\u003c/p\u003e\u003cp\u003eA consistent runner, Minaret Station also finished third in the July 11 Bowling Green Stakes (G2) and second in the May 30 Arlington Stakes (G3). He began the year by finishing fourth in the April 30 Opening Verse Stakes (Listed), the only time he hasn’t finished in the top three in his nine-start career. \r\u003c/p\u003e\u003cp\u003eLast year, Minaret Station won the American Derby (Listed) in his only start. In 2024, he won the Bourbon Stakes (G2) at Keeneland. \r\u003c/p\u003e\u003cp\u003eWill Walden trains Minaret Station for Larry Best’s OXO Equine. The 4-year-old colt, who races as a homebred, is by Instilled Regard and out of the multiple graded stakes-winning Sir Prancealot (IRE) mare Beau Recall (IRE).\u0026nbsp;\u003c/p\u003e","gradedStakesPoints":20,"regionWinnerBadges":[],"breederName":"OXO Equine LLC","uid":"bltcfcf189368e0c836","hasAutogeneratedPage":true,"url":"/redirect/horse/bltcfcf189368e0c836?ht=pre-entries","pageTitle":"Minaret Station","jockeyName":"","ownerName":"OXO Equine, LLC (Larry Best)","trainer":"William Walden","country":{"uid":"blt1af49e3a6a89373f","title":"USA","abbreviation":"USA","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt9de45bbdff160673/60d219911e0505677a882fa1/USAFlag.png"}},"horseName":"Minaret Station","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt5ae426df87fcc291/6ac6a9e402eecb71c4076294/Contender_Photo_Minaret_Station_.jpg"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt5ae426df87fcc291/6ac6a9e402eecb71c4076294/Contender_Photo_Minaret_Station_.jpg"},"cta":null,"races":[{"uid":"blt21de548e7ed632cc","ContentTypeUid":"collection_race","challengeSeriesWinner":false,"isEligible":false,"eligibleRank":null,"finishPosition":null,"classicRanking":null,"postPosition":"","scratched":false,"win":"","place":"","show":"","deadHeat":false,"silks":null}],"isChallengeSeriesWinner":false,"silks":null,"isHoC":false,"year":2026,"isHistoricalEntry":false,"relatedArticles":[],"win":"","show":"","place":""},{"sireName":"Churchill (IRE)","damName":"Sotteville (FR)","sex":"Mare","color":"Bay","foalingDate":"March, 19 2021 00:00:00","age":5,"pastPerformances":[{"trackName":"LONGCHAMP"