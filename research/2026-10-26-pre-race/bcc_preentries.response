eDate":"April, 19 2026 00:00:00","purseUsa":82407,"positionAtFinish":3},{"trackName":"CURRAGH","raceName":"Moyglare Jewels Blandford S.","grade":"2","raceDate":"September, 14 2025 00:00:00","purseUsa":234698,"positionAtFinish":3},{"trackName":"CURRAGH","raceName":"Snow Fairy Fillies S.","grade":"3","raceDate":"August, 30 2025 00:00:00","purseUsa":70117,"positionAtFinish":1},{"trackName":"KILLARNEY","raceName":"Irish Stallion Farms E.B.F. Cairn Rouge S.","grade":" ","raceDate":"July, 16 2025 00:00:00","purseUsa":58012,"positionAtFinish":1},{"trackName":"NAVAN","raceName":"Darley Irish E.B.F. Kooyonga S.","grade":" ","raceDate":"June, 07 2025 00:00:00","purseUsa":62673,"positionAtFinish":2},{"trackName":"NEWMARKET","raceName":"Betfred One Thousand Guineas S.","grade":"1","raceDate":"May, 04 2025 00:00:00","purseUsa":728040,"positionAtFinish":7},{"trackName":"CURRAGH","raceName":"Moyglare Stud S.","grade":"1","raceDate":"September, 15 2024 00:00:00","purseUsa":432977,"positionAtFinish":4},{"trackName":"CURRAGH","raceName":"Sycamore Lodge Equine Hospital Irish E.B.F. Fillies","grade":" ","raceDate":"July, 21 2024 00:00:00","purseUsa":21649,"positionAtFinish":1},{"trackName":"CURRAGH","raceName":"Kildare House Hotel Irish E.B.F. Fillies","grade":" ","raceDate":"June, 28 2024 00:00:00","purseUsa":21408,"positionAtFinish":2}],"record":{"previousYear":{"starts":5,"earnings":108627,"show":1,"win":2,"place":1,"showP":"20","winP":"40","placeP":"20"},"breedersCup":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"currentYear":{"starts":5,"earnings":116487,"show":3,"win":0,"place":1,"showP":"60","winP":"0","placeP":"20"},"lifetime":{"starts":13,"earnings":259274,"show":4,"win":3,"place":3,"showP":"31","winP":"23","placeP":"23"}},"yearlySummary":[{"showsP":"60","winsP":"0","placesP":"20","starts":5,"earnings":116487,"racingYear":2026,"shows":3,"wins":0,"places":1},{"showsP":"20","winsP":"40","placesP":"20","starts":5,"earnings":108627,"racingYear":2025,"shows":1,"wins":2,"places":1}],"morningLineOdds":[],"bio":"\u003cp\u003eShe hadn’t posed for a winner’s circle photo in 2026 but after she demonstrated her trademark acceleration to rally for third in the 1 1/4-mile Blanford (G2) at the Curragh Sept. 13 her connections remained optimistic that Red Letter (GB) would have another red letter day during her 4-year-old campaign. \r\u003c/p\u003e\u003cp\u003eThe Juddmonte homebred daughter of their world class sire Frankel (GB) and the Dark Angel (IRE) mare Red Impression (GB) won three races at ages 2 and 3, and her score in the 1 1/8-mile Snow Fairy (G3) at the Curragh in 2025 established her credentials as a Group stakes winner. Red Letter’s first outing in June 2024 was her coming out party at the Curragh as she was narrowly beaten only a head by Lake Victoria, the eventual winner of the John Deere Breeders’ Cup Juvenile Filly Turf (G1) that year.\r\u003c/p\u003e\u003cp\u003eThis year Red Letter has been out five times, all in Group stakes and has three thirds. Her best effort was in the Middleton Fillies (G2) at York May 14 when she dwelt at the start but rallied from the back of the pack to take second, only three-quarters of a length behind See The Fire (GB).\r\u003c/p\u003e\u003cp\u003eJuddmonte has won the Filly \u0026amp; Mare Turf three times with homebreds Midday (GB) (2009), Intercontinental (GB) (2005), and Banks Hill (GB) (2001). \r\u003c/p\u003e","gradedStakesPoints":0,"regionWinnerBadges":[],"breederName":"Juddmonte Farms Ltd.","uid":"blte156a649209b6a49","hasAutogeneratedPage":true,"url":"/redirect/horse/blte156a649209b6a49?ht=pre-entries","pageTitle":"Red Letter (GB)","jockeyName":"","ownerName":"Juddmonte (Fahad Bin Khalid)","trainer":"Ger Lyons","country":{"uid":"blta32e5b692b12a246","title":"Ireland","abbreviation":"IRE","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt613f9a736c40223a/61aa4c2b2f8b9e70946988d3/ireland.png","alt":""}},"horseName":"Red Let