ow":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"currentYear":{"starts":7,"earnings":738644,"show":0,"win":1,"place":2,"showP":"0","winP":"14","placeP":"29"},"lifetime":{"starts":21,"earnings":1421521,"show":1,"win":5,"place":4,"showP":"5","winP":"24","placeP":"19"}},"yearlySummary":[{"showsP":"0","winsP":"14","placesP":"29","starts":7,"earnings":738644,"racingYear":2026,"shows":0,"wins":1,"places":2},{"showsP":"17","winsP":"17","placesP":"33","starts":6,"earnings":443550,"racingYear":2025,"shows":1,"wins":1,"places":2}],"morningLineOdds":[],"bio":"\u003cp\u003eTime to Dazzle started her career with three wins from six starts at Woodbine in Canada and Gulfstream Park in Florida but much of her success, including two of her three graded stakes wins, has come in her native Kentucky. \r\u003c/p\u003e\u003cp\u003eThe 5-year-old Not This Time mare got her first graded win in the Ontario Colleen (G3) July 27, 2024. Trainer Mark Casse then sent Time to Dazzle to Kentucky Downs for her next start and she finished fourth in the Music City Stakes (G2). \r\u003c/p\u003e\u003cp\u003eAfter four starts in New York, Not This Time was back at Kentucky Downs in late August 2025, this time for a double dip. After finishing fourth in the Ladies Turf Sprint (G2), she returned on less than two weeks' rest to finish second in a conditioned allowance sprint. A trip upstate to Keeneland produced a victory in the Franklin Stakes (G2). \r\u003c/p\u003e\u003cp\u003eShe started 2026 with a fourth-place finish in the 1351 Sprint (G2) in Saudi Arabia. Back in North America, she was winless in four starts, including a second in the Ladies Turf Sprint at Kentucky Downs, before scoring a repeat victory in the Franklin. \r\u003c/p\u003e\u003cp\u003eOut of the Unbridled's Song mare Staria, Time to Dazzle was bred by Dr. Rodney Orr.\u0026nbsp;\u003c/p\u003e","gradedStakesPoints":12,"regionWinnerBadges":[],"breederName":"Rodney Orr","uid":"bltc46c316afba1b552","hasAutogeneratedPage":tru