00000,"positionAtFinish":3},{"trackName":"KEENELAND","raceName":"Bank of America Valley View S.","grade":"2","raceDate":"October, 24 2025 00:00:00","purseUsa":400000,"positionAtFinish":2},{"trackName":"KENTUCKY DOWNS","raceName":"AGS Music City S.","grade":"2","raceDate":"September, 06 2025 00:00:00","purseUsa":2000000,"positionAtFinish":4},{"trackName":"SARATOGA","raceName":"Lake George S. Presented by Surfside","grade":"3","raceDate":"July, 26 2025 00:00:00","purseUsa":175000,"positionAtFinish":2},{"trackName":"SARATOGA","raceName":"Wild Applause S.","grade":" ","raceDate":"July, 03 2025 00:00:00","purseUsa":150000,"positionAtFinish":1},{"trackName":"CHURCHILL DOWNS","raceName":"Regret S.","grade":"3","raceDate":"May, 31 2025 00:00:00","purseUsa":275000,"positionAtFinish":7},{"trackName":"CHURCHILL DOWNS","raceName":" ","grade":" ","raceDate":"April, 30 2025 00:00:00","purseUsa":127000,"positionAtFinish":1},{"trackName":"GULFSTREAM PARK","raceName":"Sanibel Island S.","grade":" ","raceDate":"March, 29 2025 00:00:00","purseUsa":165000,"positionAtFinish":4},{"trackName":"GULFSTREAM PARK","raceName":"Herecomesthebride S.","grade":"3","raceDate":"March, 01 2025 00:00:00","purseUsa":215000,"positionAtFinish":4},{"trackName":"GULFSTREAM PARK","raceName":" ","grade":" ","raceDate":"January, 26 2025 00:00:00","purseUsa":89000,"positionAtFinish":1},{"trackName":"GULFSTREAM PARK","raceName":" ","grade":" ","raceDate":"December, 22 2024 00:00:00","purseUsa":65000,"positionAtFinish":4}],"record":{"previousYear":{"starts":10,"earnings":448185,"show":1,"win":3,"place":2,"showP":"10","winP":"30","placeP":"20"},"breedersCup":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"currentYear":{"starts":6,"earnings":1512830,"show":1,"win":3,"place":1,"showP":"17","winP":"50","placeP":"17"},"lifetime":{"starts":17,"earnings":1962615,"show":2,"win":6,"place":3,"showP":"12","winP":"35","placeP":"18"}},"yearlySummary":[{"showsP":"17","winsP":"50","placesP":"17","starts":6,"earnings":1512830,"racingYear":2026,"shows":1,"wins":3,"places":1},{"showsP":"10","winsP":"30","placesP":"20","starts":10,"earnings":448185,"racingYear":2025,"shows":1,"wins":3,"places":2}],"morningLineOdds":[],"bio":"\u003cp\u003eClassic Q proved once again that she is a top-class filly when she rallied through the lane in the late stages of the First Lady (G1) at Keeneland to win by a margin of inches and claim her second top-level victory of the year and of her career. \"She amazes me,\" said trainer Mark Casse, a dual Hall of Fame member. \r\u003c/p\u003e\u003cp\u003eFollowing a protracted photo finish, the gray 4-year-old daughter of Grade 1 winner Classic Empire, who also was conditioned by Casse, was declared the winner of the 1-mile test on the turf over Lush Lips (GB). Her come-from-behind the pace was a change in tactics from her front-running tallies in the Distaff Turf Mile (G2) at Churchill Downs in May and the Just a Game (G1) at 1 mile on the Saratoga green in June. \r\u003c/p\u003e\u003cp\u003eIn the First Lady she bounced back from a third-place finish behind Bless the Broken in the Ladies Turf (G2) at Kentucky Downs in September. Casse originally thought to run the filly against the boys in the FanDuel Breeders' Cup Mile (G1) but ultimately decided to keep her with her own gender in the Maker's Mark Filly \u0026amp; Mare Turf (G1), which will be her final race before entrance in the Fasig-Tipton November Sale \r\u003c/p\u003e\u003cp\u003eClassic Q is out of the Scat Daddy mare Lovely Em and is owned by the partnership of Gary Barber, Blue Crevalle Racing and Eclipse Thoroughbred Partners. Originally purchased as a yearling for $40,000, she has earned $1.96 million.\u0026nbsp;\u003c/p\u003e","gradedStakesPoints":30,"regionWinnerBadges":[],"breederName":"Winning Bloodstock","uid":"bltcf1cb8a9b6f7184f","hasAutogeneratedPage":true,"url":"/redirect/horse/bltcf1cb8a9b6f7184f?ht=pre-entries","pageTitle":"Classic Q","jockeyName":"","ownerName":"Gary Barber, Blue Crevalle Racing (Hugh Dailey) \u0026 Eclipse Thoroughbred Partners (Aron Wellman)","trainer":"Mark E. Casse","country":{"uid":"blt1af49e3a6a89373f","title":"USA","abbreviation":"USA","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt9de45bbdff160673/60d219911e0505677a882fa1/USAFlag.png"}},"horseName":"Classic Q","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/bltf5d9b1f0f1d3b47e/6ac68b121cd7466a3717d62b/Contender_Photo_Classic_Q_.jpg"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/bltf5d9b1f0f1d3b47e/6ac68b121cd7466a3717d62b/Contender_Photo_Classic_Q_.jpg"},"cta":null,"races":[{"uid":"blt31ae65439327eecf","ContentTypeUid":"collection_race","challengeSeriesWinner":false,"isEligible":false,"eligibleRank":null,"finishPosition":null,"classicRanking":null,"postPosition":"","scratched":false,"win":"","place":"","show":"","deadHeat":false,"silks":null}],"isChallengeSeriesWinner":false,"silks":null,"isHoC":false,"year":2026,"isHistoricalEntry":false,"relatedArticles":[],"win":"","show":"","place":""},{"sireName":"Liam's Map","damName":"Giulio's Jewel","sex":"Horse","color":"Dark Bay or Brown","foalingDate":"January, 30 2021 00:00:00","age":5,"pastPerformances":[{"trackName":"WOODBINE","raceName":"Woodbine Mile S.","grade":"1","raceDate":"September, 12 2026 00:00:00","purseUsa":1000000,"positionAtFinish":2},{"trackName":"KENTUCKY DOWNS","raceName":"AGS Kentucky Turf Cup Invitational S.","grade":"2","raceDate":"September, 05 2026 00:00:00","purseUsa":2000000,"positionAtFinish":1},{"trackName":"SARATOGA","raceName":"Fourstardave S.","grade":"1","raceDate":"August, 08 2026 00:00:00","purseUsa":750000,"positionAtFinish":1},{"trackName":"HOPPEGARTEN","raceName":"Westminster 136. Grosser Preis von Berlin - V4/3","grade":"1","raceDate":"August, 09 2026 00:00:00","purseUsa":179163,"positionAtFinish":1},{"trackName":"SARATOGA","raceName":"Resorts World Cas