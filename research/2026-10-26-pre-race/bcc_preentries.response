n":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"currentYear":{"starts":8,"earnings":442035,"show":1,"win":4,"place":0,"showP":"13","winP":"50","placeP":"0"},"lifetime":{"starts":21,"earnings":616630,"show":3,"win":6,"place":3,"showP":"14","winP":"29","placeP":"14"}},"yearlySummary":[{"showsP":"13","winsP":"50","placesP":"0","starts":8,"earnings":442035,"racingYear":2026,"shows":1,"wins":4,"places":0},{"showsP":"22","winsP":"11","placesP":"22","starts":9,"earnings":134045,"racingYear":2025,"shows":2,"wins":1,"places":2}],"morningLineOdds":[],"bio":"\u003cp\u003eForged Steel has been unbreakable this year at Santa Anita, winning both of his races there in the Hollywood Gold Cup (G2) and Goodwood Stakes (G2), and not in photo finishes, either. \r\u003c/p\u003e\u003cp\u003eHe ran away to a 9 1/2-length score in the May 25 Hollywood Gold Cup and then four months later defeated stablemate Caldera by 1 1/4 lengths in the Goodwood. The latter victory earned him a paid, automatic berth in the Oct. 31 Longines Breeders' Cup Classic (G1) at Keeneland via the Breeders' Cup Challenge Series: Win and You're In. \r\u003c/p\u003e\u003cp\u003eHis Goodwood success came despite Forged Steel being outrun to the early lead, his preferred running position. So, the Vekoma colt settled in second early before taking command on the turn and asserting his superiority. He ran 1 1/8 miles in 1:48.48. \r\u003c/p\u003e\u003cp\u003eThough other stakes outings this year in the Suburban Stakes (G2) at Saratoga and the Pacific Classic (G1) at Del Mar resulted in off-the-board finishes, Forged Steel also has shown the ability to win outside of Santa Anita. Earlier victories in his career came at Oaklawn Park, Tampa Bay Downs and Gulfstream Park. \r\u003c/p\u003e\u003cp\u003eSaffie Joseph Jr. trains him for owners C2 Racing Stable, Mathis Stables and TCC Stables. \r\r\u003c/p\u003e","gradedStakesPoints":16,"regionWinnerBadges":[],"breederName":"Richard E. Wilson","uid":"blt9cf36ecc9bebf2e3","ha