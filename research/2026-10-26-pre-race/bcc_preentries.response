sitionAtFinish":1},{"trackName":"TURFWAY PARK","raceName":" ","grade":" ","raceDate":"January, 31 2024 00:00:00","purseUsa":70000,"positionAtFinish":4}],"record":{"previousYear":{"starts":4,"earnings":116837,"show":1,"win":0,"place":0,"showP":"25","winP":"0","placeP":"0"},"breedersCup":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"currentYear":{"starts":4,"earnings":198583,"show":0,"win":1,"place":1,"showP":"0","winP":"25","placeP":"25"},"lifetime":{"starts":15,"earnings":753938,"show":1,"win":5,"place":2,"showP":"7","winP":"33","placeP":"13"}},"yearlySummary":[{"showsP":"0","winsP":"25","placesP":"25","starts":4,"earnings":198583,"racingYear":2026,"shows":0,"wins":1,"places":1},{"showsP":"25","winsP":"0","placesP":"0","starts":4,"earnings":116837,"racingYear":2025,"shows":1,"wins":0,"places":0}],"morningLineOdds":[],"bio":"\u003cp\u003eKehoe Beach suffered through a dry spell in 2025 but, with the turn of the calendar, things improved for the Omaha Beach mare in 2026. \r\u003c/p\u003e\u003cp\u003eBred by John Bates, Ron Kirk and Michael Riordan, Kehoe Beach is out of the Street Cry (IRE) mare Sweet Awakening. \u0026nbsp;\r\u003c/p\u003e\u003cp\u003eOwned by Thomas Bachman and trained by Wesley Ward, Kehoe Beach won her second start in April 2024 on the dirt at Keeneland, then came alive in the second half of the season after switching to turf. She won allowance events at Kentucky Downs and Keeneland, then stretched out to win the 1 1/16-mile Mrs. Revere Stakes (G2) at Churchill Downs Nov. 29. \r\u003c/p\u003e\u003cp\u003eThe promise of that season didn't carry over to 2025 as Kehoe Beach went winless in four starts. Experiments on all-weather surfaces at Turfway Park and Woodbine, separated by a five-month respite, didn't pan out to start 2026. \r\u003c/p\u003e\u003cp\u003eAnother retreat to the grass did the trick again as Kehoe Beach won another allowance at all-grass Kentucky Downs and finished second in the Franklin Stakes (G2) at Keeneland's fall meeting. \r\u003c/p\u003e\u003cp\u003eThe actual Kehoe Beach is near the northern tip of Point Reyes National Seashore north of San Francisco.\u0026nbsp;\u003c/p\u003e","gradedStakesPoints":4,"regionWinnerBadges":[],"breederName":"John Bates, Ron Kirk \u0026 Michael Riordan","uid":"blt3ad45e6d1550ec37","hasAutogeneratedPage":true,"url":"/redirect/horse/blt3ad45e6d1550ec37?ht=pre-entries","pageTitle":"Kehoe Beach","jockeyName":"","ownerName":"Thomas W. Bachman","trainer":"Wesley A. Ward","country":{"uid":"blt1af49e3a6a89373f","title":"USA","abbreviation":"USA","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt9de45bbdff160673/60d219911e0505677a882fa1/USAFlag.png"}},"horseName":"Kehoe Beach","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt5f7fe8321b64c82d/6ad252c404e852dbe47d28df/Contender_Photo_Kehoe_Beach.jpg"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt5f7fe8321b64c82d/6ad252c404e852dbe47d28df/Contender_Photo_Kehoe_Beach.jpg"},"cta":null,"races":[{"uid":"bltc81c6f52eeba2605","ContentTypeUid":"collection_race","challengeSeriesWinner":false,"isEligible":true,"eligibleRank":23,"finishPosition":null,"classicRanking":null,"postPosition":"23","scratched":false,"win":"","place":"","show":"","deadHeat":false,"silks":null}],"isChallengeSeriesWinner":false,"silks":null,"isHoC":false,"year":2026,"isHistoricalEntry":false,"relatedArticles":[],"win":"","show":"","place":""},{"sireName":"Noble Mission (GB)","damName":"Pearly Blue","sex":"Gelding","color":"Bay","foalingDate":"April, 28 2019 00:00:00","age":7,"pastPerformances":[{"trackName":"KEENELAND","raceName":" ","grade":" ","raceDate":"April, 22 2023 00:00:00","purseUsa":130000,"positionAtFinish":9},{"trackName":"TURFWAY PARK","raceName":" ","grade":" ","raceDate":"March, 23 2023 00:00:00","purseUsa":80000,"positionAtFinish":2},{"trackName":"WOODBINE","raceName":"Bold Venture S.","grade"