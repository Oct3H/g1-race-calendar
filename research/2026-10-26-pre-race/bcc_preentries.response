24 00:00:00","purseUsa":1500000,"positionAtFinish":1},{"trackName":"COLONIAL DOWNS","raceName":"Secretariat S.","grade":"2","raceDate":"August, 11 2024 00:00:00","purseUsa":500000,"positionAtFinish":2},{"trackName":"CHURCHILL DOWNS","raceName":"American Derby","grade":" ","raceDate":"June, 29 2024 00:00:00","purseUsa":250000,"positionAtFinish":1},{"trackName":"CHURCHILL DOWNS","raceName":" ","grade":" ","raceDate":"June, 07 2024 00:00:00","purseUsa":127000,"positionAtFinish":1},{"trackName":"CHURCHILL DOWNS","raceName":" ","grade":" ","raceDate":"May, 02 2024 00:00:00","purseUsa":120000,"positionAtFinish":1},{"trackName":"FAIR GROUNDS","raceName":" ","grade":" ","raceDate":"February, 15 2024 00:00:00","purseUsa":57000,"positionAtFinish":5}],"record":{"previousYear":{"starts":8,"earnings":647704,"show":0,"win":3,"place":3,"showP":"0","winP":"38","placeP":"38"},"breedersCup":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"currentYear":{"starts":5,"earnings":112499,"show":1,"win":0,"place":0,"showP":"20","winP":"0","placeP":"0"},"lifetime":{"starts":13,"earnings":760203,"show":1,"win":3,"place":3,"showP":"8","winP":"23","placeP":"23"}},"yearlySummary":[{"showsP":"20","winsP":"0","placesP":"0","starts":5,"earnings":112499,"racingYear":2026,"shows":1,"wins":0,"places":0},{"showsP":"0","winsP":"38","placesP":"38","starts":8,"earnings":647704,"racingYear":2025,"shows":0,"wins":3,"places":3}],"morningLineOdds":[],"bio":"\u003cp\u003ePuerto Rico (IRE) competed against the top sprinter-milers in Europe throughout his early career, including some of his better known Coolmore mates. His record reflects the quality of his competition but might understate his own ability. \r\u003c/p\u003e\u003cp\u003eThe Wootton Bassett (GB) colt, out of the Galileo (IRE) mare April Showers, took six tries to find the winner's enclosure for the first time, finally scoring in the Champagne Stakes (G2) at Doncaster last September. \r\u003c/p\u003e\u003cp\u003eAlong the way, he finished second in three consecutive races, including the Railway Stakes (G2) at the Curragh, won by fellow Aidan O'Brien trainee True Love (IRE), and the Richmond Stakes (G2) at Goodwood in July. \r\u003c/p\u003e\u003cp\u003ePuerto Rico then wound up 2025 with a three-race winning streak capped by the Prix Jean-Luc Lagardere (G1) on Arc Day in Paris and the Criterium International (G1) at Saint-Cloud. \r\u003c/p\u003e\u003cp\u003eO'Brien had Puerto Rico start 2026 in the French 1,000 Guineas (G1), where he settled for a close fourth-place finish. He was winless in three subsequent starts back in England, two of which were won by Bow Echo (IRE) and the other by Notable Speech (GB). He just missed in a return to Paris, finishing third, beaten two heads, in the Prix de la Foret (G1), won by True Love.\u003c/p\u003e","gradedStakesPoints":0,"regionWinnerBadges":[],"breederName":"April Showers Syndicate","uid":"blt288502bc177fb439","hasAutogeneratedPage":true,"url":"/redirect/horse/blt288502bc177fb439?ht=pre-entries","pageTitle":"Puerto Rico (IRE)","jockeyName":"","ownerName":"Derrick Smith, Mrs. John Magnier \u0026 Michael Tabor","trainer":"Aidan P. O'Brien","country":{"uid":"blta32e5b692b12a246","title":"Ireland","abbreviation":"IRE","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt613f9a736c40223a/61aa4c2b2f8b9e70946988d3/ireland.png","alt":""}},"horseName":"Puerto Rico","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt26b6216ce0c2f465/68f26e440f11765c9c37b436/Contender_Photo_Puerto_Rico.jpg"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt26b6216ce0c2f465/68f26e440f11765c9c37b436/Contender_Photo_Puerto_Rico.jpg"},"cta":null,"races":[{"uid":"blt31ae65439327eecf","ContentTypeUid":"collection_race","challengeSeriesWinner":false,"isEligible":true,"eligibleRank":16,"finishPosition":null,"classicRanking":null,"postPosition":"16","scratched":false,"w