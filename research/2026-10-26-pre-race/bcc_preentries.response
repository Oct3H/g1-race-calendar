l}],"isChallengeSeriesWinner":true,"silks":null,"isHoC":false,"year":2026,"isHistoricalEntry":false,"relatedArticles":[],"win":"","show":"","place":""},{"sireName":"Blame","damName":"Collections Choice","sex":"Filly","color":"Dark Bay or Brown","foalingDate":"April, 08 2023 00:00:00","age":3,"pastPerformances":[{"trackName":"CHURCHILL DOWNS","raceName":"Dogwood S. presented by Resolute Racing","grade":"3","raceDate":"September, 19 2026 00:00:00","purseUsa":300000,"positionAtFinish":2},{"trackName":"SARATOGA","raceName":"Test S. Presented by Ticketmaster","grade":"1","raceDate":"August, 08 2026 00:00:00","purseUsa":500000,"positionAtFinish":1},{"trackName":"CHURCHILL DOWNS","raceName":"Leslie's Lady S.","grade":" ","raceDate":"June, 07 2026 00:00:00","purseUsa":225000,"positionAtFinish":1},{"trackName":"CHURCHILL DOWNS","raceName":"Longines Kentucky Oaks","grade":"1","raceDate":"May, 01 2026 00:00:00","purseUsa":1500000,"positionAtFinish":4},{"trackName":"OAKLAWN PARK","raceName":"Honeybee S.","grade":"3","raceDate":"March, 01 2026 00:00:00","purseUsa":750000,"positionAtFinish":1},{"trackName":"SANTA ANITA PARK","raceName":"Las Virgenes S.","grade":" ","raceDate":"February, 08 2026 00:00:00","purseUsa":100000,"positionAtFinish":2},{"trackName":"SANTA ANITA PARK","raceName":"Santa Ynez S.","grade":" ","raceDate":"January, 10 2026 00:00:00","purseUsa":100000,"positionAtFinish":1},{"trackName":"DEL MAR","raceName":"NetJets Breeders' Cup Juvenile Fillies","grade":"1","raceDate":"October, 31 2025 00:00:00","purseUsa":2000000,"positionAtFinish":2},{"trackName":"SANTA ANITA PARK","raceName":"Oak Leaf S. presented by Oak Tree Racing Association","grade":"2","raceDate":"October, 04 2025 00:00:00","purseUsa":200000,"positionAtFinish":1},{"trackName":"DEL MAR","raceName":"Del Mar Debutante S.","grade":"1","raceDate":"September, 06 2025 00:00:00","purseUsa":300000,"positionAtFinish":2},{"trackName":"DEL MAR","raceName":" ","grade":" ","raceDate":"August, 17 2025 00:00:00","purseUsa":100000,"positionAtFinish":1}],"record":{"previousYear":{"starts":4,"earnings":568000,"show":0,"win":2,"place":2,"showP":"0","winP":"50","placeP":"50"},"breedersCup":{"starts":1,"earnings":340000,"show":0,"win":0,"place":1,"showP":"0","winP":"0","placeP":"100"},"currentYear":{"starts":7,"earnings":1026415,"show":0,"win":4,"place":2,"showP":"0","winP":"57","placeP":"29"},"lifetime":{"starts":11,"earnings":1594415,"show":0,"win":6,"place":4,"showP":"0","winP":"55","placeP":"36"}},"yearlySummary":[{"showsP":"0","winsP":"57","placesP":"29","starts":7,"earnings":1026415,"racingYear":2026,"shows":0,"wins":4,"places":2},{"showsP":"0","winsP":"50","placesP":"50","starts":4,"earnings":568000,"racingYear":2025,"shows":0,"wins":2,"places":2}],"morningLineOdds":[],"bio":"\u003cp\u003eCampaigned by Mike Pegram, Karl Watson and Paul Weitman, Explora has proven to be a model of consistency throughout her young career. \r\u003c/p\u003e\u003cp\u003eA debut winner for trainer Bob Baffert at Del Mar last summer, the dark bay filly finished a length back in second to stablemate Bottle of Rouge in the 7-furlong Del Mar Debutante Stakes (G1). Stretching to 1 1/16 miles for her next two starts, she won the Oak Leaf Stakes (G2) by a 4 ¼-length margin at Santa Anita in early October before having to settle for second -- beaten three-quarters of a length by ultimate divisional champion Super Corredora -- in the NetJets Breeders’ Cup Juvenile Fillies (G1), held at Del Mar on Halloween. \r\u003c/p\u003e\u003cp\u003eLaunching her sophomore campaign with an eye-catching 5 ¼-length victory over La Wally in Santa Anita’s Santa Ynez Stakes (Listed) over 7 furlongs on Jan. 10, the Kentucky-bred filly found only Meaning too tough -- finishing second by 1 ½ lengths -- in the 1-mile Las Virgenes Stakes on Feb. 8. \r\u003c/p\u003e\u003cp\u003eDefeating subsequent Acorn (G1) and Coaching Club American Oaks (G1) heroine Counting Stars in the Honeybee Stakes (G3) at Oaklawn in March, she found the 9-furlong distance of the Kentucky Oaks (G1) too tall an order and tired late to be fourth, beaten 2 ½ lengths by Always a Runner. \r\u003c/p\u003e\u003cp\u003eCut back to 7 furlongs for her next two starts, Explora immediately proved her affinity for sprint distances, winning both Churchill Downs’ Leslie’s Lady Stakes (Listed) on June 7 followed by a 5-length tally in the Test Stakes (G1) at Saratoga on Aug. 8. \r\u003c/p\u003e\u003cp\u003eExplora returned to Churchill Downs for the 7-furlong Dogwood (G3) on Sept. 19 but after being pressured on the front end for most of the race by Movie Night, she was caught in the shadow of the wire by Conceit who prevailed by a head. \r\u003c/p\u003e\u003cp\u003eBreeders Steve and Denise Smith own and operate Kentucky-based Mesingw Farm, named after the spirit guardian of the forest and the animals. \u0026nbsp;\u003c/p\u003e","gradedStakesPoints":16,"regionWinnerBadges":[],"breederName":"Mesingw Farm, LLC","uid":"blt31ff8ddc82f0e0a6","hasAutogeneratedPage":true,"url":"/redirect/horse/blt31ff8ddc82f0e0a6?ht=pre-entries","pageTitle":"Explora","jockeyName":"","ownerName":"Michael E. Pegram, Karl Watson \u0026 Paul Weitman","trainer":"Bob Baffert","country":{"uid":"blt1af49e3a6a89373f","title":"USA","abbreviation":"USA","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt9de45bbdff160673/60d219911e0505677a882fa1/USAFlag.png"}},"horseName":"Explora","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/bltb39f2ffd1bc7ac5e/6a7b75ec4423e152639fa90c/Contender_Photo_Explora.jpg"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/bltb39f2ffd1bc7ac5e/6a7b75ec4423e152639fa90c/Contender_Photo_Explora.jpg"},"cta":null,"races":[{"uid":"bltf0689a11ba6900ce","ContentTypeUid":"collection_race","challengeSeriesWinner":false,"isEligible":false,"eligibleRank":null,"finishPosition":null,"classicRanking":null,"postPosition":"","scratched":false,"win":"","place":"","show":"","deadHeat":false,"silks":null}],"isChallengeSeriesWinner":false,"silks":null,"isHoC":false,"year":2026,"isHistoricalEntry":false,"relatedArticles":[],"win":"","show":"","place":""},{"sireName":"Volatile","damName":"Table Manners","sex":"Filly","color":"Bay","foalingDate":"April, 08 2022 00:00:00","age":4,"pastPerformances":[{"trackName":"HOLLYWOOD CASINO AT CHARLES TOWN RACES","raceName":"Misty Bennett Pink Ribbon S.","grade":" ","raceDate":"August, 28 2026 00:00:00","purseUsa":300000,"positionAtFinish":1},{"trackName":"CHURCHILL DOWNS","raceName":"Chicago S.","grade":"2","raceDate":"June, 20 2026 00:00:00","purseUsa":300000,"positionAtFinish":2},{"trackName":"CHURCHILL DOWNS","raceName":"Winning Colors S.","grade":"3","raceDate":"May, 25 2026 00:00:00","purseUsa":250000,"positionAtFinish":3},{"trackName":"OAKLAWN PARK","raceName":"Matron S.","grade":" ","raceDate":"March, 27 2026 00:00:00","purseUsa":250000,"positionAtFinish":2},{"trackName":"OAKLAWN PARK","raceName":"Bugler Overnight S.","grade":" ","raceDate":"February, 06 2026 00:00:00","purseUsa":135000,"positionAtFinish":1},{"trackName":"OAKLAWN PARK","raceName":"Oaklawn Anywhere Overnight S.","grade":" ","raceDate":"December, 28 2025 00:00:00","purseUsa":135000,"positionAtFinish":1},{"trackName":"CHURCHILL DOWNS","raceName":" ","grade":" ","raceDate":"November, 26 2025 00:00:00","purseUsa":127000,"positionAtFinish":1},{"trackName":"CHURCHILL DOWNS","raceName":" ","grade":" ","raceDate":"October, 29 2025 00:00:00","purseUsa":127000,"positionAtFinish":6},{"trackName":"CHURCHILL DOWNS","raceName":" ","grade":" ","raceDate":"September, 19 2025 00:00:00","purseUsa":127000,"positionAtFinish":6},{"trackName":"ELLIS PARK","raceName":" ","grade":" ","raceDate":"August, 04 2025 00:00:00","purseUsa":102000,"positionAtFinish":2},{"trackName":"ELLIS PARK","raceName":" ","grade":" ","raceDate":"July, 13 2025 00:00:00","purseUsa":102000,"positionAtFinish":2},{"trackName":"CHURCHILL DOWNS","raceName":" ","grade":" ","raceDate":"June, 22 2025 00:00:00","purseUsa":127000,"positionAtFinish":7},{"trackName":"CHURCHILL DOWNS","raceName":" ","grade":" ","raceDate":"May, 02 2025 00:00:00","purseUsa":127000,"positionAtFinish":2},{"trackName":"KEENELAND","raceName":" ","grade":" ","raceDate":"April, 07 2025 00:00:00","purseUsa":120000,"positionAtFinish":5},{"trackName":"OAKLAWN PARK","raceName":" ","grade":" ","raceDate":"January, 31 2025 00:00:00","purseUsa":130000,"positionAtFinish":2},{"trackName":"CHURCHILL DOWNS","raceName":" ","grade":" ","raceDate":"December, 01 2024 00:00:00","purseUsa":120000,"positionAtFinish":1}],"record":{"previousYear":{"starts":10,"earnings":245451,"show":0,"win":2,"place":4,"showP":"0","winP":"20","placeP":"40"},"breedersCup":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"currentYear":{"starts":5,"earnings":382725,"show":1,"win":2,"place":2,"showP":"20","winP":"40","placeP":"40"},"lifetime":{"starts":16,"earnings":697176,"show":1,"win":5,"place":6,"showP":"6","winP":"31","placeP":"38"}},"yearlySummary":[{"showsP":"20","winsP":"40","placesP":"40","starts":5,"earnings":382725,"racingYear":2026,"shows":1,"wins":2,"places":2},{"showsP":"0","winsP":"20","placesP":"40","starts":10,"earnings":245451,"racingYear":2025,"shows":0,"wins":2,"places":4}],"morningLineOdds":[],"bio":"\u003cp\u003eA solid allowance horse in 2025, Foie Gras has proven a very clever purchase by her latest connections. \r\u003c/p\u003e\u003cp\u003eEarlier in her 3-year-old campaign, Foie Grass won once and finished second on four occasions prior to bringing $100,000 via the Fasig-Tipton December Digital Sale. \r\u003c/p\u003e\u003cp\u003eTurned over to Mike Maker, the bay filly duly won the 6-furlong Oaklawn Anywhere Overnight Stakes on Dec. 28 before recording her third straight victory as the 6-5 favorite in the Bugler Stakes over that track and trip later in February. \r\u003c/p\u003e\u003cp\u003eFinishing 1 ¾ lengths behind winner Haulin Ice in Hot Springs oval’s Matron Stakes (Listed) on March 27, the daughter of Volatile found herself only a neck behind top two finishers Usha and Zeitlos in the 6-furlong Winning Colors (G3) at Churchill Downs on May 25. \r\u003c/p\u003e\u003cp\u003eStretching to 7 furlongs for the Chicago Stakes (G2) back in Louisville on June 20, Foie Gras was a head second to Eclatant before rebounding to score by 7 ½ lengths as the 6-5 choice in the 7-furlong Misty Bennett Pink Ribbon Stakes at Charles Town on Aug. 28. \r\u003c/p\u003e\u003cp\u003eOut of the Algorithms mare Table Manners, Foie Gras was bred by Beau Lane in Kentucky.\u003c/p\u003e","gradedStakesPoints":5,"regionWinnerBadges":[],"breederName":"E. H. Beau Lane","uid":"blt2ef17c8332f51f5d","hasAutogeneratedPage":true,"url":"/redirect/horse/blt2ef17c8332f51f5d?ht=pre-entries","pageTitle":"Foie Gras","jockeyName":"","ownerName":"Paradise Farms Corp (Peter Proscia), P Shooter Stable (Jennifer Rice), Medallion Racing (Phillip Shelton) and Emcee Stable, LLC (Matt Hand)","trainer":"Michael J. Maker","country":{"uid":"blt1af49e3a6a89373f","title":"USA","abbreviation":"USA","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt9de45bbdff160673/60d219911e0505677a882fa1/USAFlag.png"}},"horseName":"Foie Gras","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/bltfdc6739302c4b811/6aa19e133eabd01e314431e0/Contender_Photo_Foie_Gras.jpg"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/bltfdc6739302c4b811/6aa19e133eabd01e314431e0/Contender_Photo_Foie_Gras.jpg"},"cta":null,"races":[{"uid":"bltf0689a11ba6900ce","ContentTypeUid":"collection_race","challengeSeriesWinner":false,"isEligible":false,"eligibleRank":null,"finishPosition":null,"classicRanking":null,"postPosition":"","scratched":false,"win":"","place":"","show":"","deadHeat":false,"silks":null}],"isChallengeSeriesWinner":false,"silks":null,"isHoC":false,"year":2026,"isHistoricalEntry":false,"relatedArticles":[],"win":"","show":"","place":""},{"sireName":"Vino Rosso","damName":"Abuntia","sex":"Filly","color":"Bay","foalingDate":"March, 02 2022 00:00:00","age":4,"pastPerformances":[{"trackName":"GULFSTREAM PARK","raceName":"Princess Rooney S.","grade":"3","raceDate":"September, 12 2026 00:00:00","purseUsa":225000,"positionAtFinish":1},{"trackName":"GULFSTREAM PARK","raceName":"Sheer Drama H.","grade":" ","raceDate":"August, 15 2026 00:00:00","purseUsa":100000,"positionAtFinish":1},{"trackName":"GULFSTREAM PARK","raceName":"Musical Romance H.","grade":" ","raceDate":"June, 27 2026 00:00:00","purseUsa":100000,"positionAtFinish":1},{"trackName":"OAKLAWN PARK","raceName":" ","grade":" ","raceDate":"April, 18 2026 00:00:00","purseUsa":125000,"positionAtFinish":1},{"trackName":"OAKLAWN PARK","raceName":" ","grade":" ","raceDate":"April, 02 2026 00:00:00","purseUsa":126000,"positionAtFinish":4},{"trackName":"OAKLAWN PARK","raceName":" ","grade":" ","raceDate":"February, 26 2026 00:00:00","purseUsa":125000,"positionAtFinish":4},{"trackName":"OAKLAWN PARK","raceName":" ","grade":" ","raceDate":"February, 07 2026 00:00:00","purseUsa":125000,"positionAtFinish":10},{"trackName":"OAKLAWN PARK","raceName":" ","grade":" ","raceDate":"December, 21 2025 00:00:00","purseUsa":115000,"positionAtFinish":2},{"trackName":"REMINGTON PARK","raceName":" ","grade":" ","raceDate":"November, 21 2025 00:00:00","purseUsa":39000,"positionAtFinish":1},{"trackName":"REMINGTON PARK","raceName":" ","grade":" ","raceDate":"October, 11 2025 00:00:00","purseUsa":39000,"positionAtFinish":2},{"trackName":"REMINGTON PARK","raceName":" ","grade":" ","raceDate":"September, 18 2025 00:00:00","purseUsa":39000,"positionAtFinish":2},{"trackName":"PRAIRIE MEADOWS","raceName":"Panthers S.","grade":" ","raceDate":"June, 07 2025 00:00:00","purseUsa":50000,"positionAtFinish":3},{"trackName":"OAKLAWN PARK","raceName":" ","grade":" ","raceDate":"April, 27 2025 00:00:00","purseUsa":130000,"positionAtFinish":2},{"trackName":"OAKLAWN PARK","raceName":" ","grade":" ","raceDate":"April, 04 2025 00:00:00","purseUsa":60000,"positionAtFinish":1},{"trackName":"OAKLAWN PARK","raceName":" ","grade":" ","raceDate":"March, 16 2025 00:00:00","purseUsa":63000,"positionAtFinish":2},{"trackName":"OAKLAWN PARK","raceName":" ","grade":" ","raceDate":"January, 31 2025 00:00:00","purseUsa":40000,"positionAtFinish":2},{"trackName":"OAKLAWN PARK","raceName":" ","grade":" ","raceDate":"January, 03 2025 00:00:00","purseUsa":75000,"positionAtFinish":9},{"trackName":"OAKLAWN PARK","raceName":" ","grade":" ","raceDate":"December, 13 2024 00:00:00","purseUsa":75000,"positionAtFinish":5}],"record":{"previousYear":{"starts":10,"earnings":150264,"show":1,"win":2,"place":6,"showP":"10","winP":"20","placeP":"60"},"breedersCup":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"currentYear":{"starts":7,"earnings":286661,"show":0,"win":4,"place":0,"showP":"0","winP":"57","placeP":"0"},"lifetime":{"starts":18,"earnings":437550,"show":1,"win":6,"place":6,"showP":"6","winP":"33","placeP":"33"}},"yearlySummary":[{"showsP":"0","winsP":"57","placesP":"0","starts":7,"earnings":286661,"racingYear":2026,"shows":0,"wins":4,"places":0},{"showsP":"10","winsP":"20","placesP":"60","starts":10,"earnings":150264,"racingYear":2025,"shows":1,"wins":2,"places":6}],"morningLineOdds":[],"bio":"\u003cp\u003eFailing to find any takers not once but twice when run through the sales ring and later a claimer, Kerry’s Kiss has jumped into the World Championships picture with a victory in the Princess Rooney Stakes (G3), a ‘Win and You’re In’ for the Breeders’ Cup Filly \u0026amp; Mare Sprint (G1) at Keeneland. \r\u003c/p\u003e\u003cp\u003eUnable to reach her reserve price as a foal at Keeneland in 2022 and again as a yearling at Fasig-Tipton the following season, the Kentucky-bred filly finally broke through with a win while facing maiden claiming company at Oaklawn Park in her fifth start in April of her 3-year-old season. Later third in the listed Panthers Stakes at Prairie Meadows, she returned three starts later to score while going a mile in a Remington Park allowance in November. \u0026nbsp;\r\u003c/p\u003e\u003cp\u003eKicking off her 4-year-old campaign with two fourths at the allowance level — both at Oaklawn over 1 1/16 miles -- she held on to post a front-running three-quarters of a length victory over that track and trip when following up in an April 18 optional claimer. \r\u003c/p\u003e\u003cp\u003eReturning to a sprint distance on June 27 under new ownership and now trained by Saffie Joseph Jr., the filly came home a 2 ¾-length winner over Indy Bay in Gulfstream Park’s Musical Romance Stakes over 6 ½ furlongs before adding another win over even-money Indy Bay in that oval’s 7-furlong Sheer Drama Stakes on Aug. 15. \r\u003c/p\u003e\u003cp\u003eSent off the 2-1 second choice in the Sept. 12 Princess Rooney, she went wire-to-wire while holding off favored Simply Joking by 1 ½ lengths.\u0026nbsp;\u003c/p\u003e","gradedStakesPoints":4,"regionWinnerBadges":[],"breederName":"Virginia Moore \u0026 Malia Hopkins","uid":"bltc1f3d8ab1f4aeffc","hasAutogeneratedPage":true,"url":"/redirect/horse/bltc1f3d8ab1f4aeffc?ht=pre-entries","pageTitle":"Kerry's Kiss","jockeyName":"","ownerName":"Epic Horses, LLC (Robert McCoy), BAG Racing Stables, LLC (Jim Grant) \u0026 The White House Stables, LLC (Rufus White)","trainer":"Saffie Joseph Jr.","country":{"uid":"blt1af49e3a6a89373f","title":"USA","abbreviation":"USA","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt9de45bbdff160673/60d219911e0505677a882fa1/USAFlag.png"}},"horseName":"Kerry's Kiss","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt2dc085e52b8f7573/6aabf43992a5878670ee11c7/Contender_Photo_Kerry_s_Kiss_.jpg"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt2dc085e52b8f7573/6aabf43992a5878670ee11c7/Contender_Photo_Kerry_s_Kiss_.jpg"},"cta":null,"races":[{"uid":"bltf0689a11ba6900ce","ContentTypeUid":"collection_race","challengeSeriesWinner":false,"isEligible":false,"eligibleRank":null,"finishPosition":null,"classicRanking":null,"postPosition":"","scratched":false,"win":"","place":"","show":"","deadHeat":false,"silks":null}],"isChallengeSeriesWinner":true,"silks":null,"isHoC":false,"year":2026,"isHistoricalEntry":false,"relatedArticles":[],"win":"","show":"","place":""},{"sireName":"Twirling Candy","damName":"Spanish Star","sex":"Filly","color":"Bay","foalingDate":"March, 16 2022 00:00:00","age":4,"pastPerformances":[{"trackName":"SARATOGA","raceName":"Resorts World Casino Ballerina S.","grade":"1","raceDate":"August, 29 2026 00:00:00","purseUsa":500000,"positionAtFinish":2},{"trackName":"ELLIS PARK","raceName":"Twin Bridges S.","grade":" ","raceDate":"July, 19 2026 00:00:00","purseUsa":175000,"positionAtFinish":1},{"trackName":"KENTUCKY DOWNS","raceName":"AGS Music City S.","grade":"2","raceDate":"September, 06 2025 00:00:00","purseUsa":2000000,"positionAtFinish":8},{"trackName":"SARATOGA","raceName":"Test S. Presented by Ticketmaster","grade":"1","raceDate":"August, 02 2025 00:00:00","purseUsa":500000,"positionAtFinish":1},{"trackName":"CHURCHILL DOWNS","raceName":"Leslie's Lady Overnight S.","grade":" ","raceDate":"June, 08 2025 00:00:00","purseUsa":175000,"positionAtFinish":1},{"trackName":"CHURCHILL DOWNS","raceName":"Mamzelle S.","grade":"3","raceDate":"May, 10 2025 00:00:00","purseUsa":225000,"positionAtFinish":2},{"trackName":"KEENELAND","raceName":"FanDuel Limestone S.","grade":" ","raceDate":"April, 11 2025 00:00:00","purseUsa":300000,"positionAtFinish":6},{"trackName":"DEL MAR","raceName":"John Deere Breeders' Cup Juvenile Fillies Turf","grade":"1","raceDate":"November, 01 2024 00:00:00","purseUsa":1000000,"positionAtFinish":5},{"trackName":"KENTUCKY DOWNS","raceName":"Untapable S.","grade":" ","raceDate":"September, 08 2024 00:00:00","purseUsa":1000000,"positionAtFinish":1},{"trackName":"ELLIS PARK","raceName":" ","grade":" ","raceDate":"July, 27 2024 00:00:00","purseUsa":71000,"positionAtFinish":1}],"record":{"previousYear":{"starts":5,"earnings":445368,"show":0,"win":2,"place":1,"showP":"0","winP":"40","placeP":"20"},"breedersCup":{"starts":1,"earnings":30000,"show":0,"win":0,"place":0,"showP":"0","winP":"0","placeP":"0"},"currentYear":{"starts":2,"earnings":206208,"show":0,"win":1,"place":1,"showP":"0","winP":"50","placeP":"50"},"lifetime":{"starts":10,"earnings":1312076,"show":0,"win":5,"place":2,"showP":"0","winP":"50","placeP":"20"}},"yearlySummary":[{"showsP":"0","winsP":"50","placesP":"50","starts":2,"earnings":206208,"racingYear":2026,"shows":0,"wins":1,"places":1},{"showsP":"0","winsP":"40","placesP":"20","starts":5,"earnings":445368,"racingYear":2025,"shows":0,"wins":2,"places":1}],"morningLineOdds":[],"bio":"\u003cp\u003eKilwin, a winner of her first two career starts including the 6 ½-furlong Untapable Stakes at Kentucky Downs, came home fifth to eventual European champion 2-year-old filly Lake Victoria (IRE) in the 2024 Breeders’ Cup Juvenile Fillies Turf at Del Mar. \r\u003c/p\u003e\u003cp\u003eSixth behind Shisospicy in Keeneland’s Limestone Stakes (Listed) in her sophomore debut, she was runner-up to that rival next time out in the 5 ½-furlong Mamzelle Stakes (G3) at Churchill Downs later in May. \r\u003c/p\u003e\u003cp\u003eSent off at 8-1 odds while trying dirt for the first time in Churchill’s Leslie’s Lady Overnight Stakes over 7 furlongs in June, Kilwin settled a little closer to the front early, and closed late to win by 1 ¼ lengths over Vodka With a Twist. \r\u003c/p\u003e\u003cp\u003eAccompanied by Jose Ortiz for the first time in Saratoga’s Test Stakes (G1), the filly seemingly lost all chance after stumbling badly at the start of the 7-furlong race but bounced back to earn a neck victory. \r\u003c/p\u003e\u003cp\u003eIn her 2025 finale, Kilwin was a well-beaten eighth while reverting to the turf for the 6 ½-furlong Music City Stakes (G2) at Kentucky Downs. \r\u003c/p\u003e\u003cp\u003eCutting back to 6 furlongs for her 4-year-old unveiling in Ellis Park’s Twin Bridges Stakes on July 19, the Kentucky-bred filly came from off the pace to win by 2 ¼ lengths and returned to finish second -- beaten 5 ½ lengths by Ways and Means in the 7-furlong Ballerina Stakes (G1) at Saratoga on Aug. 29. \r\u003c/p\u003e\u003cp\u003eKilwin was bred by Gilder-Schwarz Farms, the operation of Wendy Schwarz Gilder and her brother Andrew Schwarz. Out of Spanish Star (by Blame), she was a $225,000 Keeneland September yearling purchase but failed to find any takers when a 25 percent interest RNA’d for $575,000 at the Keeneland Championship Sale prior to the 2024 World Championships. She subsequently brought $3 million at the Keeneland November Sale in 2025. \r\u003c/p\u003e\u003cp\u003eSpanish Star, a half-sister to Belmont Stakes (G1) scorer Sir Winston (by Awesome Again), is also the dam of Grade 2 winner One Timer (by Trappe Shot) and Iowa Oaks winner Just Basking (by Arrogate), who finished third the Alabama Stakes (G1). \r\u003c/p\u003e\u003cp\u003eKilwin, campaigned by Braxton Lynch, Brian Klatsky and Brendan O‘Brien’s BBN Racing and Rick Howard, is named after the confectionary store, Kilwins.\u0026nbsp;\u003c/p\u003e","gradedStakesPoints":6,"regionWinnerBadges":[],"breederName":"Gilder-Schwarz Farms LLC","uid":"blt712def717e3ac6bd","hasAutogeneratedPage":true,"url":"/redirect/horse/blt712def717e3ac6bd?ht=pre-entries","pageTitle":"Kilwin","jockeyName":"","ownerName":"BBN Racing, LLC (Ann Braxton Lynch) and Rick Howard","trainer":"George R. Arnold II","country":{"uid":"blt1af49e3a6a89373f","title":"USA","abbreviation":"USA","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt9de45bbdff160673/60d219911e0505677a882fa1/USAFlag.png"}},"horseName":"Kilwin","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt3ae6eb3ae705309c/6ad796df3c7af06ad61c8852/Contender_Photo_Kilwin_(1).jpg"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt3ae6eb3ae705309c/6ad796df3c7af06ad61c8852/Contender_Photo_Kilwin_(1).jpg"},"cta":null,"races":[{"uid":"bltf0689a11ba6900ce","ContentTypeUid":"collection_race","challengeSeriesWinner":false,"isEligible":false,"eligibleRank":null,"finishPosition":null,"classicRanking":null,"postPosition":"","scratched":false,"win":"","place":"","show":"","deadHeat":false,"silks":null}],"isChallengeSeriesWinner":false,"silks":null,"isHoC":false,"year":2026,"isHistoricalEntry":false,"relatedArticles":[],"win":"","show":"","place":""},{"sireName":"Bolt d'Oro","damName":"Troublesome","sex":"Filly","color":"Bay","foalingDate":"February, 09 2022 00:00:00","age":4,"pastPerformances":[{"trackName":"CHURCHILL DOWNS","raceName":"Open Mind S.","grade":" ","raceDate":"September, 12 2026 00:00:00","purseUsa":300000,"positionAtFinish":2},{"trackName":"SARATOGA","raceName":"Test S. Presented by Ticketmaster","grade":"1","raceDate":"August, 02 2025 00:00:00","purseUsa":500000,"positionAtFinish":4},{"trackName":"SARATOGA","raceName":"DK Horse Acorn S.","grade":"1","raceDate":"June, 06 2025 00:00:00","purseUsa":500000,"positionAtFinish":2},{"trackName":"CHURCHILL DOWNS","raceName":"Eight Belles S. presented by Sysco","grade":"2","raceDate":"May, 02 2025 00:00:00","purseUsa":600000,"positionAtFinish":1},{"trackName":"KEENELAND","raceName":"Central Bank Ashland S.","grade":"1","raceDate":"April, 07 2025 00:00:00","purseUsa":750000,"positionAtFinish":6},{"trackName":"OAKLAWN PARK","raceName":"Honeybee S.","grade":"3","raceDate":"February, 23 2025 00:00:00","purseUsa":500000,"positionAtFinish":7},{"trackName":"SANTA ANITA PARK","raceName":"Fasig-Tipton Santa Ynez S.","grade":" ","raceDate":"January, 05 2025 00:00:00","purseUsa":100000,"positionAtFinish":1},{"trackName":"LOS ALAMITOS RACE COURSE","raceName":"Starlet S.","grade":"2","raceDate":"December, 07 2024 00:00:00","purseUsa":200000,"positionAtFinish":2},{"trackName":"DEL MAR","raceName":" ","grade":" ","raceDate":"November, 08 2024 00:00:00","purseUsa":54000,"positionAtFinish":1}],"record":{"previousYear":{"starts":6,"earnings":563275,"show":0,"win":2,"place":1,"showP":"0","winP":"33","placeP":"17"},"breedersCup":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"currentYear":{"starts":1,"earnings":59000,"show":0,"win":0,"place":1,"showP":"0","winP":"0","placeP":"100"},"lifetime":{"starts":9,"earnings":694675,"show":0,"win":3,"place":3,"showP":"0","winP":"33","placeP":"33"}},"yearlySummary":[{"showsP":"0","winsP":"0","placesP":"100","starts":1,"earnings":59000,"racingYear":2026,"shows":0,"wins":0,"places":1},{"showsP":"0","winsP":"33","placesP":"17","starts":6,"earnings":563275,"racingYear":2025,"shows":0,"wins":2,"places":1}],"morningLineOdds":[],"bio":"\u003cp\u003eReddam Racing’s Look Forward gave evidence of her talent early, breaking through with a front-running victory in a 6-furlong test at Del Mar on Nov. 8, 2024. \u0026nbsp;\r\u003c/p\u003e\u003cp\u003eAfter concluding 2024 with a runner-up effort behind the talented Tenma in the 1 1/16-mile Starlet (G2) at Los Alamitos, the daughter of Bolt d’Oro was off the board in the Honeybee (G3) at Oaklawn Park and Keeneland’s Ashland (G1). \r\u003c/p\u003e\u003cp\u003eSent off at 7-1 to get back on track in the 7-furlong Eight Belles (G2) at Churchill Downs in May, Look Forward closed from just off the pace to best Blue Fire by 1 ¼ lengths with Evanescence another length back in third. \r\u003c/p\u003e\u003cp\u003eSecond to La Cara in a sloppy renewal of the Acorn (G1) over 1 1/8 miles in Saratoga, the bay filly was fourth behind winner Kilwin when cutting back to 7 furlongs in the Test (G1) in August. \r\u003c/p\u003e\u003cp\u003eSidelined for the remainder of her 3-year-old season, Look Forward made her 4-year-old debut while returning to Louisville, finishing three-quarters of a length behind winner Usha in the 6-furlong Open Mind (Listed) on Sept. 12.\u0026nbsp;\u003c/p\u003e","gradedStakesPoints":0,"regionWinnerBadges":[],"breederName":"Woods Edge Farm, LLC \u0026 Ballyfair Bloodstock","uid":"blt20e6fb17631e7e27","hasAutogeneratedPage":true,"url":"/redirect/horse/blt20e6fb17631e7e27?ht=pre-entries","pageTitle":"Look Forward","jockeyName":"","ownerName":"Reddam Racing, LLC (J. Paul Reddam)","trainer":"Michael W. McCarthy","country":{"uid":"blt1af49e3a6a89373f","title":"USA","abbreviation":"USA","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt9de45bbdff160673/60d219911e0505677a882fa1/USAFlag.png"}},"horseName":"Look Forward","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/bltb17c3f314c9c8af9/6ad23e6e6f7ed11519bf5bea/Contender_Photo_Look_Forward.jpg"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/bltb17c3f314c9c8af9/6ad23e6e6f7ed11519bf5bea/Contender_Photo_Look_Forward.jpg"},"cta":null,"races":[{"uid":"bltf0689a11ba6900ce","ContentTypeUid":"collection_race","challengeSeriesWinner":false,"isEligible":false,"eligibleRank":null,"finishPosition":null,"classicRanking":null,"postPosition":"","scratched":false,"win":"","place":"","show":"","deadHeat":false,"silks":null}],"isChallengeSeriesWinner":false,"silks":null,"isHoC":false,"year":2026,"isHistoricalEntry":false,"relatedArticles":[],"win":"","show":"","place":""},{"sireName":"Majestic Harbor","damName":"Miss Oops","sex":"Mare","color":"Bay","foalingDate":"March, 12 2020 00:00:00","age":6,"pastPerformances":[{"trackName":"SANTA ANITA PARK","raceName":"Zenyatta S. presented by FanDuel","grade":"2","raceDate":"September, 27 2026 00:00:00","purseUsa":200000,"positionAtFinish":2},{"trackName":"DEL MAR","raceName":"Clement L. Hirsch S. Presented by Oak Tree Racing Association","grade":"1","raceDate":"August, 01 2026 00:00:00","purseUsa":400000,"positionAtFinish":4},{"trackName":"CHURCHILL DOWNS","