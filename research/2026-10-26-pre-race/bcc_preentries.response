, 31 2025 00:00:00","purseUsa":1000000,"positionAtFinish":8},{"trackName":"NEWMARKET","raceName":"Tattersalls Sceptre Sessions Cheveley Park S.","grade":"1","raceDate":"September, 27 2025 00:00:00","purseUsa":368559,"positionAtFinish":1},{"trackName":"CURRAGH","raceName":"Keeneland Phoenix S.","grade":"1","raceDate":"August, 09 2025 00:00:00","purseUsa":407467,"positionAtFinish":2},{"trackName":"CURRAGH","raceName":"GAIN Railway S.","grade":"2","raceDate":"July, 19 2025 00:00:00","purseUsa":139510,"positionAtFinish":1},{"trackName":"ASCOT","raceName":"Queen Mary S.","grade":"2","raceDate":"June, 18 2025 00:00:00","purseUsa":201432,"positionAtFinish":1},{"trackName":"NAVAN","raceName":"Irish Stallion Farms E.B.F.","grade":" ","raceDate":"May, 17 2025 00:00:00","purseUsa":20094,"positionAtFinish":2},{"trackName":"CURRAGH","raceName":"Holden Plant Rentals First Flier S.","grade":" ","raceDate":"May, 05 2025 00:00:00","purseUsa":56518,"positionAtFinish":2}],"record":{"previousYear":{"starts":7,"earnings":507528,"show":0,"win":3,"place":3,"showP":"0","winP":"43","placeP":"43"},"breedersCup":{"starts":1,"earnings":10000,"show":0,"win":0,"place":0,"showP":"0","winP":"0","placeP":"0"},"currentYear":{"starts":8,"earnings":1008642,"show":1,"win":3,"place":2,"showP":"13","winP":"38","placeP":"25"},"lifetime":{"starts":15,"earnings":1516170,"show":1,"win":6,"place":5,"showP":"7","winP":"40","placeP":"33"}},"yearlySummary":[{"showsP":"13","winsP":"38","placesP":"25","starts":8,"earnings":1008642,"racingYear":2026,"shows":1,"wins":3,"places":2},{"showsP":"0","winsP":"43","placesP":"43","starts":7,"earnings":507528,"racingYear":2025,"shows":0,"wins":3,"places":3}],"morningLineOdds":[],"bio":"\u003cp\u003eWhen trainer Aidan O'Brien sent True Love to the 2025 Breeders' Cup Juvenile Turf Sprint (G1), he was brimming with confidence. The No Nay Never filly held a record of three wins and three seconds from six starts with the victories including the Cheveley Park Stakes (G1) at Newmarket in her previous start. \r\u003c/p\u003e\u003cp\u003eO'Brien reckoned True Love's speed as her not-so-secret power. But things didn’t work out as the filly was assigned the No. 8 gate, missed the break, had to swing seven wide into the stretch to find daylight and finished eighth as the favorite. \r\u003c/p\u003e\u003cp\u003eShe has a chance for redemption in 2026 thanks to a \"Win and You're In\" Challenge bid she earned while winning the Prix de la Foret (G1) on the Prix de l'Arc de Triomphe undercard in Paris Oct. 4. \r\u003c/p\u003e\u003cp\u003eThat effort turned the tide on her season. After a warmup win in Ireland, True Love stepped up to win the 1000 Guineas (G1) at Newmarket. That, however, was followed by five starts without a win including a fifth in the Prix Maurice de Geest (G1) and a sixth in the Matron (G1) in Ireland leading into the Foret. \r\u003c/p\u003e\u003cp\u003eBred by Coolmore, she was produced by the Fastnet Rock (AUS) mare Alluringly.\u0026nbsp;\u003c/p\u003e\u003cp\u003e\u0026nbsp;\u003c/p\u003e","gradedStakesPoints":0,"regionWinnerBadges":[],"breederName":"Coolmore","uid":"blta91b20e34b414fe6","hasAutogeneratedPage":true,"url":"/redirect/horse/blta91b20e34b414fe6?ht=pre-entries","pageTitle":"True Love (IRE)","jockeyName":"","ownerName":"Derrick Smith , Mrs. John Magnier \u0026 Michael Tabor","trainer":"Aidan P. O'Brien","country":{"uid":"blta32e5b692b12a246","title":"Ireland","abbreviation":"IRE","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt613f9a736c40223a/61aa4c2b2f8b9e70946988d3/ireland.png","alt":""}},"horseName":"True Love","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/bltd4eff6248889f0c4/68de967d9cb8ab81a269f2fc/Contender_Photo_True_Love.jpg"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/bltd4eff6248889f0c4/68de967d9cb8ab81a269f2fc/Contender_Photo_True_Love.jpg"},"cta":null,"races":[{"uid":"blt31ae65439327eecf","ContentTypeUid":"collection_race","challengeSeriesWinner":false,"isEligible":false,"eligibleRank":null,"finishPosition":null,"classicRanking":null,"postPosition":"","scratched":false,"win":"","place":"","show":"","deadHeat":false,"silks":null}],"isChallengeSeriesWinner":true,"silks":null,"isHoC":false,"year":2026,"isHistoricalEntry":false,"relatedArticles":[],"win":"","show":"","place":""},{"sireName":"Ten Sovereigns (IRE)","damName":"Zindziswa","sex":"Ridgling","color":"Bay","foalingDate":"February, 08 2022 00:00:00","age":4,"pastPerformances":[{"trackName":"KEENELAND","raceName":"Coolmore Turf Mile S.","grade":"1","raceDate":"October, 03 2026 00:00:00","purseUsa":1250000,"positionAtFinish":5},{"trackName":"SARATOGA","raceName":"Fourstardave S.","grade":"1","raceDate":"August, 08 2026 00:00:00","purseUsa":750000,"positionAtFinish":3},{"trackName":"SARATOGA","raceName":"Kelso S.","grade":"3","raceDate":"July, 05 2026 00:00:00","purseUsa":225000,"positionAtFinish":1},{"trackName":"SARATOGA","raceName":"Poker S.","grade":"3","raceDate":"June, 07 2026 00:00:00","purseUsa":300000,"positionAtFinish":3},{"trackName":"KEENELAND","raceName":"Maker's Mark Mile S.","grade":"1","raceDate":"April, 10 2026 00:00:00","purseUsa":650000,"positionAtFinish":1},{"trackName":"SARATOGA","raceName":"National Museum of Racing Hall of Fame S.","grade":"2","raceDate":"August, 01 2025 00:00:00","purseUsa":400000,"positionAtFinish":1},{"trackName":"SARATOGA","raceName":"Manila S.","grade":"3","raceDate":"July, 04 2025 00:00:00","purseUsa":200000,"positionAtFinish":1},{"trackName":"CHURCHILL DOWNS","raceName":"American Turf S. presented by Ford","grade":"1","raceDate":"May, 03 2025 00:00:00","purseUsa":1000000,"positionAtFinish":1},{"trackName":"TAMPA BAY DOWNS","raceName":"Columbia S.","grade":" ","raceDate":"March, 08 2025 00:00:00","purseUsa":125000,"positionAtFinish":1},{"trackName":"DEL MAR","raceName":"Breeders' Cup Juvenile Turf","grade":"1","raceDate":"November, 01 2024 00:00:00","purseUsa":1000000,"positionAtFinish":7},{"trackName":"BELMONT AT THE BIG A","raceName":"Pilgrim S.","grade":"2","raceDate":"September, 28 2024 00:00:00","purseUsa":200000,"positionAtFinish":1},{"trackName":"SARATOGA","raceName":"With Anticipation S.","grade":"3","raceDate":"August, 29 2024 00:00:00","purseUsa":175000,"positionAtFinish":1},{"trackName":"SAINT CLOUD","raceName":"Prix Chapeau Rouge","grade":" ","raceDate":"June, 04 2024 00:00:00","purseUsa":32713,"positionAtFinish":1}],"record":{"previousYear":{"starts":4,"earnings":701780,"show":0,"win":3,"place":0,"showP":"0","winP":"75","placeP":"0"},"breedersCup":{"starts":1,"earnings":10000,"show":0,"win":0,"place":0,"showP":"0","winP":"0","placeP":"0"},"currentYear":{"starts":5,"earnings":541500,"show":2,"win":2,"place":0,"showP":"40","winP":"40","placeP":"0"},"lifetime":{"starts":13,"earnings":1475887,"show":2,"win":8,"place":0,"showP":"15","winP":"62","placeP":"0"}},"yearlySummary":[{"showsP":"40","winsP":"40","placesP":"0","starts":5,"earnings":541500,"racingYear":2026,"shows":2,"wins":2,"places":0},{"showsP":"0","winsP":"75","placesP":"0","starts":4,"earnings":701780,"racingYear":2025,"shows":0,"wins":3,"places":0}],"morningLineOdds":[],"bio":"\u003cp\u003eZulu Kingdom (IRE) won his career bow at Saint-Cloud in June 2024 for trainer Andre Fabre by more than 3 lengths, immediately changed hands and shipped to New York. Less than three months later, he stepped right up to win the With Anticipation Stakes (G3) for new owners Madaket Stables, LLC, Michael Dubb, William Strauss and Michael Caruso and trainer Chad Brown. \r\u003c/p\u003e\u003cp\u003eHe ran the win string to three with a victory in the Pilgrim Stakes (G2) at Aqueduct in September but the Breeders' Cup Juvenile Turf (G1) at Del Mar was too much as Zulu Kingdom vied for the lead but faded to finish seventh beaten 4 1/2 lengths. \r\u003c/p\u003e\u003cp\u003eThe Ten Sovereigns colt, out of the Smart Strike mare Zindziswa, bounced back in 2025, winning the Columbia Stakes at Tampa Bay Downs, the American Turf (G1) at Churchill Downs and the Manila Stakes (G3) at Saratoga before finishing fourth in the National Museum of Racing Hall of Fame Stakes (G2). \r\u003c/p\u003e\u003cp\u003eAfter an eight-month break, he won the Maker's Mark Mile (G1) at Keeneland to start 2026, finished third in the Poker Stakes (G3), won the Kelso Stakes (G3), and was third in the Fourstardave (G1), all at Saratoga. A return trip to Keeneland resulted in a fifth-place showing in the Coolmore Turf Mile (G1).\u0026nbsp;\u003c/p\u003e","gradedStakesPoints":19,"regionWinnerBadges":[],"breederName":"Ecurie Peregrine SAS","uid":"blt537467f5d5c24aef","hasAutogeneratedPage":true,"url":"/redirect/horse/blt537467f5d5c24aef?ht=pre-entries","pageTitle":"Zulu Kingdom (IRE)","jockeyName":"","ownerName":"Madaket Stables, LLC (Sol Kumin), Michael Dubb, William Strauss \u0026 Michael J. Caruso","trainer":"Chad C. Brown","country":{"uid":"blt1af49e3a6a89373f","title":"USA","abbreviation":"USA","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt9de45bbdff160673/60d219911e0505677a882fa1/USAFlag.png"}},"horseName":"Zulu Kingdom","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/bltaea6a87ff6f74738/6a7b724d28883968bf07e057/Contender_Photo_Zulu_Kingdom.jpg"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/bltaea6a87ff6f74738/6a7b724d28883968bf07e057/Contender_Photo_Zulu_Kingdom.jpg"},"cta":null,"races":[{"uid":"blt31ae65439327eecf","ContentTypeUid":"collection_race","challengeSeriesWinner":false,"isEligible":false,"eligibleRank":null,"finishPosition":null,"classicRanking":null,"postPosition":"","scratched":false,"win":"","place":"","show":"","deadHeat":false,"silks":null}],"isChallengeSeriesWinner":false,"silks":null,"isHoC":false,"year":2026,"isHistoricalEntry":true,"relatedArticles":[],"win":"","show":"","place":""},{"sireName":"Lord Kanaloa (JPN)","damName":"Impede (GB)","sex":"Colt","color":"Bay","foalingDate":"January, 31 2023 00:00:00","age":3,"pastPerformances":[{"trackName":"TOKYO","raceName":"NHK Mile Cup","grade":"1","raceDate":"May, 10 2026 00:00:00","purseUsa":1582845,"positionAtFinish":2},{"trackName":"HANSHIN","raceName":"Churchill Downs Cup","grade":"3","raceDate":"April, 04 2026 00:00:00","purseUsa":484159,"positionAtFinish":1},{"trackName":"TOKYO","raceName":" ","grade":" ","raceDate":"February, 01 2026 00:00:00","purseUsa":79704,"positionAtFinish":1}],"record":{"previousYear":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"breedersCup":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"currentYear":{"starts":3,"earnings":640785,"show":0,"win":2,"place":1,"showP":"0","winP":"67","placeP":"33"},"lifetime":{"starts":3,"earnings":640785,"show":0,"win":2,"place":1,"showP":"0","winP":"67","placeP":"33"}},"yearlySummary":[{"showsP":"0","winsP":"67","placesP":"33","starts":3,"earnings":640785,"racingYear":2026,"shows":0,"wins":2,"places":1},{"showsP":"NA","winsP":"NA","placesP":"NA","starts":0,"earnings":0,"racingYear":2025,"shows":0,"wins":0,"places":0}],"morningLineOdds":[],"bio":"\u003cp\u003eAsk Ikigomi, unraced at age 2, burst suddenly into the top ranks of Japanese milers in just three starts in the first half of 2026.\u0026nbsp;\u003c/p\u003e\u003cp\u003eA son of the famed Japanese sprinter, Lord Kanaloa (JPN), Ask Ikigomi got off on the right foot with a victory in a race for 3-year-old first-time starters going 1 mile on a firm Tokyo Racecourse surface Feb. 1\u0026nbsp;\u003c/p\u003e\u003cp\u003eFrom there, trainer Hideaki Fujiwara sent Ask Ikigomi directly into graded stakes competition in the Churchill Downs Stakes (G3) at Hanshin Racecourse April 4. He produced another win there.\u0026nbsp;\u003c/p\u003e\u003cp\u003eThat effort boosted him right into one of the division's most prestigious races, the NHK Mile Cup (G1) for 3-year-olds, May 10 back\u0026nbsp;at\u0026nbsp;Tokyo. With Keita Tosaki in the irons, Ask\u0026nbsp;Ikigome\u0026nbsp;and Rodeo Drive (JPN), advanced together from well back in the 18-horse field and finished a nose apart, with Rodeo Drive getting the nod.\u0026nbsp;\u003c/p\u003e\u003cp\u003eAsk Ikigomi was bred by Northern Farm and carries the black-and-white silks of\u0026nbsp;Hirosaki\u0026nbsp;Toshihiro HD Co. Ltd.\u0026nbsp;\u003c/p\u003e\u003cp\u003eHis dam, Impede (GB), is a daughter of Bated Breath (GB), who was a useful sprinter for Juddmonte in 2010-12 including a second in the Nearctic Stakes (G1) at Woodbine.\u003c/p\u003e","gradedStakesPoints":0,"regionWinnerBadges":[],"breederName":"Northern Racing","uid":"blt4e0cf4369d968256","hasAutogeneratedPage":true,"url":"/redirect/horse/blt4e0cf4369d968256?ht=pre-entries","pageTitle":"Ask Ikigomi (JPN)","jockeyName":"","ownerName":"Hirosaki Toshihiro HD Co. Ltd. (Toshihiro Hirosaki)","trainer":"Hideaki Fujiwara","country":{"uid":"bltddddd2aba803f27e","title":"Japan","abbreviation":"JPN","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blta6f52e264bde8855/61aa4c7d55cf14733fc5bc35/japan.png","alt":""}},"horseName":"Ask Ikigomi","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt71c9ee84d7ca97dd/6a7b74afef5bef3c874f9855/Contender_Photo_Ask_Ikigomi.jpg"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt71c9ee84d7ca97dd/6a7b74afef5bef3c874f9855/Contender_Photo_Ask_Ikigomi.jpg"},"cta":null,"races":[{"uid":"blt31ae65439327eecf","ContentTypeUid":"collection_race","challengeSeriesWinner":false,"isEligible":true,"eligibleRank":15,"finishPosition":null,"classicRanking":null,"postPosition":"15","scratched":false,"win":"","place":"","show":"","deadHeat":false,"silks":null}],"isChallengeSeriesWinner":false,"silks":null,"isHoC":false,"year":2026,"isHistoricalEntry":false,"relatedArticles":[],"win":"","show":"","place":""},{"sireName":"Wootton Bassett (G