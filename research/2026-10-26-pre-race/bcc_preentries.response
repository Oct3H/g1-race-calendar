entstack.io/v3/assets/blt9b0ea57b1efe7a70/blt0e47340b4d496606/66f20005dec4865314332d64/Longines_Logo_Color_For-Race-Pages-01.svg"},"white":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/bltf33c9614ab2b50b5/66e30fb0bc8b1c7ddb3aa315/Logo_Longines_white_RGB(2).png"},"black":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt0e47340b4d496606/66f20005dec4865314332d64/Longines_Logo_Color_For-Race-Pages-01.svg"}},"sponsoredUrls":[],"sponsoredSection":""}],"sponsorLogo":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/bltb2341aaa147a6de7/62963af60d6f4a0fbcbefc6b/Longines5.31.svg","alt":""},"date":"2026-10-31T22:16:00.000Z","priorYearChampionPhoto":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt8f12bce1410f3f84/69247ccc03d66b4b934f39ba/Classic_-_Forever_Young.jpg"},"displayPostTime":true,"isCompleted":false,"isLive":false,"purse":"$7,000,000","distance":"1 1/4 miles","grade":1,"ageV2":"3+","division":"Longines Classic","exacta":"","trifecta":"","superfecta":"","superHighFive":"","dailyDouble":"","pick3":"","pick4":"","pick5":"","pick6":"","region":""},"isTvScheduled":true,"broadcast":{"partners":[{"logo":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/bltf79bd4e964d5f80e/68d41e0fc07c892e73863c80/NBC_Logo_2025.svg"},"time":""},{"logo":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt29c35e9a30ccbba3/68d1ca298c48984dc7622c30/22-BC-162_New-BCcom_Network-Logo-SVGs_146x60-v1-05-Peacock.svg"},"time":""}]},"trackDetails":[{"uid":"bltc1d1c6b40525bf04","details":{"name":"Keeneland","logo":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt276fb8147db83742/629e62383d4e745ed3ae5859/keeneland.png"},"image":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/bltb0b7768e84d44449/614ce97164c8007a9bdec19c/Keeneland_Track_Image.jpeg"},"locationBcbc":"Keeneland","timeZone":-4}}],"raceDescription":"\u003ch1\u003eThe defining event of Thoroughbred Racing. Where the champions are crowned.\u0026nbsp;\u003c/h1\u003e\u003cp\u003eEvery sport has a definitive year-ending event to crown its champions. In Thoroughbred racing, the Breeders’ Cup World Championships is the culmination of the horse racing season worldwide, and the $7 million Longines Breeders’ Cup Classic is the defining race of this international event. The Longines Breeders’ Cup Classic, run at 1 1/4 miles on the dirt track, draws the top international Thoroughbreds, including winners of the Triple Crown races, year after year. It is open to male and female horses three-years old and older, and is limited to 14 starters.\u0026nbsp;\u003c/p\u003e","surface":"","bettingCtaOverride":{"cta":[]},"horseType":"pre-entries","horses":[{"sireName":"Real Steel (JPN)","damName":"Forever Darling","sex":"Horse","color":"Bay","foalingDate":"February, 24 2021 00:00:00","age":5,"pastPerformances":[{"trackName":"BELMONT PARK","raceName":"Jockey Club Gold Cup S.","grade":"1","raceDate":"September, 18 2026 00:00:00","purseUsa":1000000,"positionAtFinish":1},{"trackName":"MEYDAN RACECOURSE","raceName":"Dubai World Cup Sponsored By Emirates Airline","grade":"1","raceDate":"March, 28 2026 00:00:00","purseUsa":12000000,"positionAtFinish":2},{"trackName":"KING ABDULAZIZ RACECOURSE","raceName":"Saudi Cup","grade":"1","raceDate":"February, 14 2026 00:00:00","purseUsa":20000000,"positionAtFinish":1},{"trackName":"DEL MAR","raceName":"Longines Breeders' Cup Classic","grade":"1","raceDate":"November, 01 2025 00:00:00","purseUsa":7000000,"positionAtFinish":1},{"trackName":"FUNABASHI","raceName":"Nippon TV Hai","grade":" ","raceDate":"October, 01 2025 00:00:00","purseUsa":459651,"positionAtFinish":1},{"trackName":"MEYDAN RACECOURSE","raceName":"Dubai World Cup Sponsored By Emirates Airline","grade":"1","raceDate":"April, 05 2025 00:00:00","purseUsa":12000000,"positionAtFinish":3},{"trackName":"KING ABDULAZIZ RACECOURSE","raceName":"Saudi Cup","grade":"1","raceDate":"February, 22 2025 00:00:00","purseUsa":20000000,"positionAtFinish":1},{"trackName":"OI","raceName":"Tokyo Daishoten","grade":"1","raceDate":"December, 29 2024 00:00:00","purseUsa":1077016,"positionAtFinish":1},{"trackName":"DEL MAR","raceName":"Longines Breeders' Cup Classic","grade":"1","raceDate":"November, 02 2024 00:00:00","purseUsa":7000000,"positionAtFinish":3},{"trackName":"OI","raceName":"Japan Dirt Classic","grade":" ","raceDate":"October, 02 2024 00:00:00","purseUsa":739869,"positionAtFinish":1},{"trackName":"CHURCHILL DOWNS","raceName":"Kentucky Derby presented by Woodford Reserve","grade":"1","raceDate":"May, 04 2024 00:00:00","purseUsa":5000000,"positionAtFinish":3},{"trackName":"MEYDAN RACECOURSE","raceName":"U.A.E. Derby Sponsored by Atlantis The Royal","grade":"2","raceDate":"March, 30 2024 00:00:00","purseUsa":1000000,"positionAtFinish":1},{"trackName":"KING ABDULAZIZ RACECOURSE","raceName":"Boutique Group Saudi Derby","grade":"3","raceDate":"February, 24 2024 00:00:00","purseUsa":1500000,"positionAtFinish":1},{"trackName":"KAWASAKI","raceName":"Zennippon Nisai Yushun","grade":" ","raceDate":"December, 13 2023 00:00:00","purseUsa":490828,"positionAtFinish":1},{"trackName":"MOMBETSU","raceName":"JBC Nisai Yushun","grade":" ","raceDate":"November, 03 2023 00:00:00","purseUsa":395408,"positionAtFinish":1},{"trackName":"KYOTO","raceName":" ","grade":" ","raceDate":"October, 14 2023 00:00:00","purseUsa":91725,"positionAtFinish":1}],"record":{"previousYear":{"starts":4,"earnings":15110383,"show":1,"win":3,"place":0,"showP":"25","winP":"75","placeP":"0"},"breedersCup":{"starts":2,"earnings":4270000,"show":1,"win":1,"place":0,"showP":"50","winP":"50","placeP":"0"},"currentYear":{"starts":3,"earnings":12955000,"show":0,"win":2,"place":1,"showP":"0","winP":"67","placeP":"33"},"lifetime":{"starts":16,"earnings":32313590,"show":3,"win":12,"place":1,"showP":"19","winP":"75","placeP":"6"}},"yearlySummary":[{"showsP":"0","winsP":"67","placesP":"33","starts":3,"earnings":12955000,"racingYear":2026,"shows":0,"wins":2,"places":1},{"showsP":"25","winsP":"75","placesP":"0","starts":4,"earnings":15110383,"racingYear":2025,"shows":1,"wins":3,"places":0}],"morningLineOdds":[],"bio":"\u003cp\u003eJapanese star Forever Young (JPN), hero of last year’s Longines Breeders’ Cup Classic (G1) at Del Mar, has his sights set on another Breeders’ Cup Classic appearance Oct. 31 at Keeneland. \r\u003c/p\u003e\u003cp\u003eThe 5-year-old Real Steel (JPN) horse, a winner of more than $32 million for owner Susumu Fujita and trainer Yoshito Yahagi, has built his reputation through a combination of consistency, class and versatility. Twice he has won the $20 million Saudi Cup (G1) – the world’s richest horse race. His Saudi Cup win this year earned him an automatic, paid berth in the Classic via the Breeders’ Cup Challenge Series: Win and You’re In. \r\u003c/p\u003e\u003cp\u003eHe repeatedly has shone in the United States. Besides his 2025 Breeders’ Cup Classic victory, he ran third in the 2024 Kentucky Derby (G1) at Churchill Downs and in the 2024 Breeders’ Cup Classic at Del Mar. \r\u003c/p\u003e\u003cp\u003eOn the strength of his 2025 Breeders’ Cup Classic victory, he was named the champion older dirt male of last year despite racing just once in the United States. \r\u003c/p\u003e\u003cp\u003eRunner-up to Magnitude in the Dubai World Cup (G1) in late March, Forever Young is expected to start twice in the U.S. fall, with the Sept. 18. Jockey Club Gold Cup (G1) at a reopened Belmont Park serving as a steppingstone to the Classic. And what a steppingstone it was as he blew past pacesetting Phileas Fogg approaching the top of the stretch and cruised to a 3 ¼-length victory while racing wide through the stretch.\u0026nbsp;\u003c/p\u003e","gradedStakesPoints":10,"regionWinnerBadges":[],"breederName":"Northern Racing","uid":"blt5634fab41087aeeb","hasAutogeneratedPage":true,"url":"/redirect/horse/blt5634fab41087aeeb?ht=pre-entries","pageTitle":"Forever Young (JPN)","jockeyName":"","ownerName":"Susumu Fujita","trainer":"Yoshito Yahagi","country":{"uid":"bltddddd2aba803f27e","title":"Japan","abbreviation":"JPN","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blta6f52e264bde8855/61aa4c7d55cf14733fc5bc35/japan.png","alt":""}},"horseName":"Forever Young","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt4811b196d9296062/6a7369bfc8b7ac173751fc3c/Contender_Photo_Forever_Young.jpg"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt4811b196d9296062/6a7369bfc8b7ac173751fc3c/Contender_Photo_Forever_Young.jpg"},"cta":null,"races":[{"uid":"blte4254e02f2a052b4","ContentTypeUid":"collection_race","challengeSeriesWinner":true,"isEligible":false,"eligibleRank":null,"finishPosition":null,"classicRanking":1,"postPosition":"","scratched":false,"win":"","place":"","show":"","deadHeat":false,"silks":null}],"isChallengeSeriesWinner":true,"silks":null,"isHoC":false,"year":2026,"isHistoricalEntry":true,"relatedArticles":[],"win":"","show":"","place":""},{"sireName":"Vekoma","damName":"Scorecard","sex":"Colt","color":"Gray or Roan","foalingDate":"March, 12 2022 00:00:00","age":4,"pastPerformances":[{"trackName":"SANTA ANITA PARK","raceName":"Goodwood S.","grade":"1","raceDate":"September, 26 2026 00:00:00","purseUsa":300000,"positionAtFinish":1},{"trackName":"DEL MAR","raceName":"Pacific Classic S.","grade":"1","raceDate":"August, 22 2026 00:00:00","purseUsa":1000000,"positionAtFinish":7},{"trackName":"SARATOGA","raceName":"Suburban S. Presented by Subourbon Life","grade":"2","raceDate":"July, 04 2026 00:00:00","purseUsa":500000,"positionAtFinish":5},{"trackName":"SANTA ANITA PARK","raceName":"Hollywood Gold Cup S.","grade":"2","raceDate":"May, 25 2026 00:00:00","purseUsa":200000,"positionAtFinish":1},{"trackName":"OAKLAWN PARK","raceName":" ","grade":" ","raceDate":"May, 02 2026 00:00:00","purseUsa":126000,"positionAtFinish":1},{"trackName":"