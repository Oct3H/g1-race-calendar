21 00:00:00","purseUsa":75000,"positionAtFinish":2},{"trackName":"KENTUCKY DOWNS","raceName":"Kentucky Downs Juvenile Mile S.","grade":" ","raceDate":"September, 06 2021 00:00:00","purseUsa":500000,"positionAtFinish":5},{"trackName":"FAIR GROUNDS","raceName":"Colonel Power S.","grade":" ","raceDate":"February, 14 2026 00:00:00","purseUsa":100000,"positionAtFinish":5},{"trackName":"ARLINGTON","raceName":"Arlington-Washington Futurity","grade":" ","raceDate":"August, 28 2021 00:00:00","purseUsa":75000,"positionAtFinish":1},{"trackName":"FAIR GROUNDS","raceName":" ","grade":" ","raceDate":"December, 18 2025 00:00:00","purseUsa":56000,"positionAtFinish":1},{"trackName":"PRESQUE ISLE DOWNS","raceName":" ","grade":" ","raceDate":"July, 14 2021 00:00:00","purseUsa":30000,"positionAtFinish":1},{"trackName":"CHURCHILL DOWNS","raceName":"Pat Day Mile S. presented by SAP","grade":"2","raceDate":"May, 03 2025 00:00:00","purseUsa":600000,"positionAtFinish":9},{"trackName":"FAIR GROUNDS","raceName":"Twinspires.com Louisiana Derby","grade":"2","raceDate":"March, 22 2025 00:00:00","purseUsa":1000000,"positionAtFinish":5},{"trackName":"FAIR GROUNDS","raceName":"Fasig-Tipton Risen Star S.","grade":"2","raceDate":"February, 15 2025 00:00:00","purseUsa":500000,"positionAtFinish":3},{"trackName":"FAIR GROUNDS","raceName":"Lecomte S.","grade":"3","raceDate":"January, 18 2025 00:00:00","purseUsa":250000,"positionAtFinish":2},{"trackName":"FAIR GROUNDS","raceName":"Gun Runner S.","grade":" ","raceDate":"December, 21 2024 00:00:00","purseUsa":100000,"positionAtFinish":1},{"trackName":"KEENELAND","raceName":" ","grade":" ","raceDate":"October, 06 2024 00:00:00","purseUsa":100000,"positionAtFinish":1},{"trackName":"ELLIS PARK","raceName":" ","grade":" ","raceDate":"August, 24 2024 00:00:00","purseUsa":71000,"positionAtFinish":4}],"record":{"previousYear":{"starts":9,"earnings":283511,"show":1,"win":2,"place":3,"showP":"11","winP":"22","placeP":"33"},"breedersCup":{"starts":1,"earnings":520000,"show":0,"win":1,"place":0,"showP":"0","winP":"100","placeP":"0"},"currentYear":{"starts":5,"earnings":80910,"show":3,"win":0,"place":1,"showP":"60","winP":"0","placeP":"20"},"lifetime":{"starts":36,"earnings":2001162,"show":4,"win":13,"place":7,"showP":"11","winP":"36","placeP":"19"}},"yearlySummary":[{"showsP":"60","winsP":"0","placesP":"20","starts":5,"earnings":80910,"racingYear":2026,"shows":3,"wins":0,"places":1},{"showsP":"11","winsP":"22","placesP":"33","starts":9,"earnings":283511,"racingYear":2025,"shows":1,"wins":2,"places":3}],"morningLineOdds":[],"bio":"\u003cp\u003eIt was clear that Nobals had potential when he won his first start in July 2021 on the Presque Isle Downs all-weather course and followed that with a victory in the Arlington-Washington Futurity (Listed) at Arlington Park.\r\u003c/p\u003e\u003cp\u003eHe's lived up to that potential for trainer Larry Rivelli and owner Patricia's Hope LLC, winning on both all-weather and turf all the way to a 12-1 upset win in the 2023 Breeders' Cup Turf Sprint (G1) at Santa Anita.\r\u003c/p\u003e\u003cp\u003eHe entered his 7-year-old season with 13 wins from 31 starts, the victories coming at tracks as far afield as Woodbine, Churchill Downs, Horseshoe Indianapolis and Colonial Downs. He won the Kennedy Road Stakes (G2) on Woodbine's all-weather track in both 2024 and 2025.\r\u003c/p\u003e\u003cp\u003eNobals made his 2026 graded stakes debut in the 6-furlong Nearctic (G2) at Woodbine on Oct. 3 finishing second of seven beaten 3 lengths\r\u003c/p\u003e\u003cp\u003eFor all the success, Rivelli has not been able to get Nobals back to the Breeders' Cup. And he's 0-for-2 on the Keeneland turf.\r\u003c/p\u003e\u003cp\u003eThe odyssey might be appropriate as Rivelli was a nine-time champion trainer at now-closed and demolished Arlington, which also was home base for Vince Foglia's Patricia's Hope. Nobals' victory in the Futurity came just one month before Arlington's final race.\r\u003c/p\u003e","gradedStakesPoints":0,"regionWinnerBadges":[],"breederName":"John A. Chandler","uid":"blta3ec470e462a8747","hasAutogeneratedPage":true,"url":"/redirect/horse/blta3ec470e462a8747?ht=pre-entries","pageTitle":"Nobals","jockeyName":"","ownerName":"Patricia's Hope LLC (Vince Foglia)","trainer":"Larry Rivelli","country":{"uid":"blt1af49e3a6a89373f","title":"USA","abbreviation":"USA","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt9de45bbdff160673/60d219911e0505677a882fa1/USAFlag.png"}},"horseName":"Nobals","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/bltddf69072a6d31c45/6ab2e38598a4e369f753f35b/Contender_Photo_Nobals.jpg"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/bltddf69072a6d31c45/6ab2e38598a4e369f753f35b/Contender_Photo_Nobals.jpg"},"cta":null,"races":[{"uid":"bltc81c6f52eeba2605","ContentTypeUid":"collection_race","challengeSeriesWinner":false,"isEligible":true,"eligibleRank":24,"finishPosition":null,"classicRanking":null,"postPosition":"24","scratched":false,"win":"","place":"","show":"","deadHeat":false,"silks":null}],"isChallengeSeriesWinner":false,"silks":null,"isHoC":false,"year":2026,"isHistoricalEntry":false,"relatedArticles":[],"win":"","show":"","place":""},{"sireName":"Goldencents","damName":"Afternoon","sex":"Gelding","color":"Bay","foalingDate":"March, 20 2022 00:00:00","age":4,"pastPerformances":[{"trackName":"KEENELAND","raceName":" ","grade":" ","raceDate":"October, 22 2026 00:00:00","purseUsa":150000,"positionAtFinish":7},{"trackName":"KENTUCKY DOWNS","raceName":"Light and Wonder Kentucky Downs Turf Sprint S.","grade":"2","raceDate":"September, 05 2026 00:00:00","purseUsa":1750000,"positionAtFinish":2},{"trackName":"ELLIS PARK","raceName":"Tri-State Turf Sprint S.","grade":" ","raceDate":"August, 02 2026 00:00:00","purseUsa":250000,"positionAtFinish":8},{"trackName":"WOODBINE","raceName":"bet365 Highlander S.","grade":"2","raceDate":"June, 27 2026 00:00:00","purseUsa":200000,"positionAtFinish":6},{"trackName":"CHURCHILL DOWNS","raceName":" ","grade":" ","raceDate":"April, 26 2026 00:00:00","purseUsa":141000,"positionAtFinish":1},{"trackName":"KEENELAND","raceName":"Bryan Station S.","grade":"3","raceDate":"October, 25 2025 00:00:00","purseUsa":600000,"positionAtFinish":6},{"trackName":"KENTUCKY DOWNS","raceName":"Ainsworth Franklin-Simpson S.","grade":"1","raceDate":"September, 06 2025 00:00:00","purseUsa":2000000,"positionAtFinish":2},{"trackName":"PRESQUE ISLE DOWNS","raceName":"Tom Ridge S.","grade":" ","raceDate":"June, 30 2025 00:00:00","purseUsa":100000,"positionAtFinish":1},{"trackName":"CHURCHILL DOWNS","raceName":"American Turf S. presented by Ford","grade":"1","raceDate":"May, 03 2025 00:00:00","purseUsa":1000000,"positionAtFinish":9},{"trackName":"KEENELAND","raceName":"Transylvania S. Presented by Keeneland Select","grade":"3","raceDate":"April, 07 2025 00:00:00","purseUsa":600000,"positionAtFinish":11},{"trackName":"FAIR GROUNDS","raceName":"Black Gold S.","grade":" ","raceDate":"March, 01 2025 00:00:00","purseUsa":100000,"positionAtFinish":2},{"trackName":"FAIR GROUNDS","raceName":"Lecomte S.","grade":"3","raceDate":"January, 18 2025 00:00:00","purseUsa":250000,"positionAtFinish":4},{"trackName":"FAIR GROUNDS","raceName":" ","grade":" ","raceDate":"November, 28 2024 00:00:00","purseUsa":59000,"positionAtFinish":1},{"trackName":"KEENELAND","raceName":"Castle \u0026 Key Bourbon S.","grade":"2","raceDate":"October, 06 2024 00:00:00","purseUsa":350000,"positionAtFinish":2},{"trackName":"KENTUCKY DOWNS","raceName":" ","grade":" ","raceDate":"September, 08 2024 00:00:00","purseUsa":170000,"positionAtFinish":1}],"record":{"previousYear":{"starts":7,"earnings":493220,"show":0,"win":1,"place":2,"showP":"0","winP":"14","placeP":"29"},"breedersCup":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"currentYear":{"starts":5,"earnings":419753,"show":0,"win":1,"place":1,"showP":"0","winP":"20","placeP":"20"},"lifetime":{"starts":15,"earnings":1114248,"show":0,"win":4,"place":4,"showP":"0","winP":"27","placeP":"27"}},"yearlySummary":[{"showsP":"0","winsP":"20","placesP":"20","starts":5,"earnings":419753,"racingYear":2026,"shows":0,"wins":1,"places":1},{"showsP":"0","winsP":"14","placesP":"29","starts":7,"earnings":493220,"racingYear":2025,"shows":0,"wins":1,"places":2}],"morningLineOdds":[],"bio":"\u003cp\u003eSouth Florida-based trainer Carlo Vaccarazza landed Golden Afternoon for the bargain price of $70,000 in 2024 at the Ocala Spring Sale of 2-year-olds in training and, with his son, Nicholas, has turned that investment into more than $1.1 million -- and counting. \r\u003c/p\u003e\u003cp\u003eGolden Afternoon, by Goldencents out of the Street Cry (IRE) mare Afternoon, won two of his first three starts in 2024, starting with an auspicious first-up win at Kentucky Downs, followed by a second in the Bourbon Stakes (G2) on the Keenland grass. \r\u003c/p\u003e\u003cp\u003eHe got a chance on the main track in January of 2025 in the Lecomte Stakes (G3) at Fair Grounds. Despite posting a decent fourth-place finish, the Vaccarazzas put him back to work on the turf, where he turned in sub-par performances in the Transylvania Stakes (G3) at Keeneland and the American Turf (G1) at Churchill Downs. \r\u003c/p\u003e\u003cp\u003eHis happy place, though, has been where he started. Back at Kentucky Downs in September, he finished second in the Franklin-Simpson Stakes (G1), bagging a $379,000 share of the purse. And, after a slow start to 2026, he returned to the same track to finish second in the 2026 Kentucky Downs Turf Sprint (G2), earning another $334,250.\u0026nbsp;\u003c/p\u003e","gradedStakesPoints":4,"regionWinnerBadges":[],"breederName":"Alexander-Groves Thoroughbreds","uid":"blt599f2f23b0dffdd9","hasAutogeneratedPage":true,"url":"/redirect/horse/blt599f2f23b0dffdd9?ht=pre-entries","pageTitle":"Golden Afternoon","jockeyName":"","ownerName":"Vaccarezza Racing LLC (Carlo Vaccarezza), Michael P.Cloonan, Eddie Greco, Pat Greco and Scott Jaffe","trainer":"Nicholas Vaccarezza","country":{"uid":"blt1af49e3a6a89373f","title":"USA","abbreviation":"USA","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt9de45bbdff160673/60d219911e0505677a882fa1/USAFlag.png"}},"horseName":"Golden Afternoon","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/bltc20c5ecbf109734b/6ab2e44da2b3c1549ac7f4d5/Contender_Photo_Golden_Afternoon.jpg"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/bltc20c5ecbf109734b/6ab2e44da2b3c1549ac7f4d5/Contender_Photo_Golden_Afternoon.jpg"},"cta":null,"races":[{"uid":"bltc81c6f52eeba2605","ContentTypeUid":"collection_race","challengeSeriesWinner":false,"isEligible":true,"eligibleRank":25,"finishPosition":null,"classicRanking":null,"postPosition":"25","scratched":false,"win":"","place":"","show":"","deadHeat":false,"silks":null}],"isChallengeSeriesWinner":false,"silks":null,"isHoC":false,"year":2026,"isHistoricalEntry":false,"relatedArticles":[],"win":"","show":"","place":""}]},{"uid":"blt830ffcd3734ad389","raceName":"Breeders' Cup Dirt Mile","raceDetails":{"type":"World Championships","bcType":"Dirt Mile","sponsor":[],"sponsorLogo":null,"date":"2026-10-31T18:26:00.000Z","priorYearChampionPhoto":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt4fe5564d2acf1114/69247cd2d74c899cbf1e3f70/Dirt_Mile_-_Nysos.jpg"},"displayPostTime":true,"isCompleted":false,"isLive":false,"purse":"$1,000,000","distance":"1 Mile","grade":1,"ageV2":"3+","division":"Dirt Mile","exacta":"","trifecta":"","superfecta":"","superHighFive":"","dailyDouble":"","pick3":"","pick4":"","pick5":"","pick6":"","region":""},"isTvScheduled":true,"broadcast":{"partners":[{"logo":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/bltceb0312138059807/632b128204361d715f5522c1/USA_Network-Logo-SVGs_146x60-USA.svg"},"time":""},{"l