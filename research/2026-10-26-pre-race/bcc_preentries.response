a":70000,"positionAtFinish":1},{"trackName":"SARATOGA","raceName":"Coronation Cup S.","grade":" ","raceDate":"July, 12 2024 00:00:00","purseUsa":150000,"positionAtFinish":6},{"trackName":"GULFSTREAM PARK","raceName":" ","grade":" ","raceDate":"May, 19 2024 00:00:00","purseUsa":61000,"positionAtFinish":2},{"trackName":"GULFSTREAM PARK","raceName":" ","grade":" ","raceDate":"March, 24 2024 00:00:00","purseUsa":22000,"positionAtFinish":1}],"record":{"previousYear":{"starts":8,"earnings":564800,"show":2,"win":1,"place":4,"showP":"25","winP":"13","placeP":"50"},"breedersCup":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"currentYear":{"starts":5,"earnings":1301213,"show":1,"win":2,"place":0,"showP":"20","winP":"40","placeP":"0"},"lifetime":{"starts":20,"earnings":1993305,"show":3,"win":6,"place":6,"showP":"15","winP":"30","placeP":"30"}},"yearlySummary":[{"showsP":"20","winsP":"40","placesP":"0","starts":5,"earnings":1301213,"racingYear":2026,"shows":1,"wins":2,"places":0},{"showsP":"25","winsP":"13","placesP":"50","starts":8,"earnings":564800,"racingYear":2025,"shows":2,"wins":1,"places":4}],"morningLineOdds":[],"bio":"\u003cp\u003eIn Our Time has been remarkably consistent through 2 1/2 years of racing, rising from a modest start to the top ranks of the U.S. turf sprint division. \r\u003c/p\u003e\u003cp\u003eThe Not This Time mare made her debut in a 6-furlong maiden claiming event at Gulfsteam Park March 24, 2024, with no takers for the $12,000 price tag. She won that race and the tag went up to $75,000 in her next start, again with no takers. \r\u003c/p\u003e\u003cp\u003eAlong with sharply improved performance came a change of ownership, a switch to the Saffie Joseph Jr. barn and no more claimers. Through 2025, she was consistently in the money in important stakes, including second-place finishes in the Franklin Stakes (G2) at Keeneland and the Matriarch (G1) at Del Mar. \r\u003c/p\u003e\u003cp\u003eShe started 2026 with a ninth-place finish as the favorite in the Pegasus World Cup Filly \u0026amp; Mare Turf (G1), fading from the lead while trying 1 1/16 miles. Back to a more comfortable 5 1/2 furlongs, she won the Giant's Causeway (G2) at Keeneland, then finished fifth and third in two starts at Saratoga. \r\u003c/p\u003e\u003cp\u003eIn Our Time's breakthrough finally came in the Kentucky Downs Ladies Turf Sprint (G1) Aug. 29 as she led all the way to a 3 1/2-length victory.\u0026nbsp;\u003c/p\u003e","gradedStakesPoints":18,"regionWinnerBadges":[],"breederName":"Brian Kahn","uid":"bltb24156f44144e1b0","hasAutogeneratedPage":true,"url":"/redirect/horse/bltb24156f44144e1b0?ht=pre-entries","pageTitle":"In Our Time","jockeyName":"","ownerName":"Resolute Racing (John Stewart) \u0026 Miller Racing, LLC (Myron Miller)","trainer":"Saffie Joseph Jr.","country":{"uid":"blt1af49e3a6a89373f","title":"USA","abbreviation":"USA","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt9de45bbdff160673/60d219911e0505677a882fa1/USAFlag.png"}},"horseName":"In Our Time","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/bltac00b1efc530e5e8/6aa1a68e89368106563e013c/Contender_Photo_In_Our_Time.jpg"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/bltac00b1efc530e5e8/6aa1a68e89368106563e013c/Contender_Photo_In_Our_Time.jpg"},"cta":null,"races":[{"uid":"bltc81c6f52eeba2605","ContentTypeUid":"collection_race","challengeSeriesWinner":false,"isEligible":false,"eligibleRank":null,"finishPosition":null,"classicRanking":null,"postPosition":"","scratched":false,"win":"","place":"","show":"","deadHeat":false,"silks":null}],"isChallengeSeriesWinner":false,"silks":null,"isHoC":false,"year":2026,"isHistoricalEntry":false,"relatedArticles":[],"win":"","show":"","place":""},{"sireName":"Air Force Blue","damName":"Ready to Unleash","sex":"Gelding","color":"Bay","foalingDate":"February, 23 2021 00:00:00","age":5,"pastPerformances":[{"t