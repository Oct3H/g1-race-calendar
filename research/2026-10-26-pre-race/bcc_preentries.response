TA","raceName":"Toki S.","grade":" ","raceDate":"August, 27 2023 00:00:00","purseUsa":352360,"positionAtFinish":3},{"trackName":"KYOTO","raceName":"Aoi S.","grade":"3","raceDate":"May, 27 2023 00:00:00","purseUsa":540507,"positionAtFinish":2},{"trackName":"KYOTO","raceName":"Tachibana S.","grade":" ","raceDate":"May, 07 2023 00:00:00","purseUsa":281835,"positionAtFinish":1},{"trackName":"KYOTO","raceName":" ","grade":" ","raceDate":"April, 29 2023 00:00:00","purseUsa":109162,"positionAtFinish":2},{"trackName":"CHUKYO","raceName":" ","grade":" ","raceDate":"January, 21 2023 00:00:00","purseUsa":80884,"positionAtFinish":1},{"trackName":"CHUKYO","raceName":" ","grade":" ","raceDate":"January, 08 2023 00:00:00","purseUsa":79323,"positionAtFinish":4},{"trackName":"HANSHIN","raceName":" ","grade":" ","raceDate":"December, 17 2022 00:00:00","purseUsa":72403,"positionAtFinish":2},{"trackName":"HANSHIN","raceName":" ","grade":" ","raceDate":"November, 12 2022 00:00:00","purseUsa":96521,"positionAtFinish":9}],"record":{"previousYear":{"starts":5,"earnings":638256,"show":0,"win":1,"place":1,"showP":"0","winP":"20","placeP":"20"},"breedersCup":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"currentYear":{"starts":4,"earnings":370990,"show":1,"win":0,"place":1,"showP":"25","winP":"0","placeP":"25"},"lifetime":{"starts":23,"earnings":2934474,"show":2,"win":5,"place":6,"showP":"9","winP":"22","placeP":"26"}},"yearlySummary":[{"showsP":"25","winsP":"0","placesP":"25","starts":4,"earnings":370990,"racingYear":2026,"shows":1,"wins":0,"places":1},{"showsP":"0","winsP":"20","placesP":"20","starts":5,"earnings":638256,"racingYear":2025,"shows":0,"wins":1,"places":1}],"morningLineOdds":[],"bio":"\u003cp\u003eLugal (JPN) has proved his ability at tracks around the world. His issue has been a bit of all-or-nothing, boom or bust record. \r\u003c/p\u003e\u003cp\u003eThe 6-year-old son of Duramente (JPN) scored his first win in his fourth start in January \u0026nbsp;2023. He was promoted quickly to the stakes ranks and consistently was among the first few finishers until he tried the top level for the first time and finished 10th in the 2024 Takamatsunomiya Kinen (G1). \r\u003c/p\u003e\u003cp\u003eAfter a six-month break, trainer Haruki Sugiyama brought him back in the Sprinters Stakes (G1) and was rewarded with a victory. \r\u003c/p\u003e\u003cp\u003eHis first overseas trip ended in an 11th-place finish in the Hong Kong Sprint (G1) in December 2024. After starting 2025 with four disappointing results, he returned to the winner's enclosure after the Hanshin Cup (G2). \r\u003c/p\u003e\u003cp\u003eThe New Year found Lugal representing Japan in Dubai, where he demonstrated he could compete overseas by finishing second in the Al Quoz Sprint (G1). The down side of the pattern resurfaced in June as he settled for eighth in the Queen Elizabeth II Jubilee Cup (G1) at Royal Ascot, then returned home to finish 14th in the Sprinters Stakes. \r\u003c/p\u003e\u003cp\u003eLugal is out of the New Approach (IRE) mare Atab (IRE).\u0026nbsp;\u003c/p\u003e","gradedStakesPoints":0,"regionWinnerBadges":[],"breederName":"Mishima Bokujo","uid":"blt3f6808a168280930","hasAutogeneratedPage":true,"url":"/redirect/horse/blt3f6808a168280930?ht=pre-entries","pageTitle":"Lugal (JPN)","jockeyName":"","ownerName":"Yoshimasa Ema","trainer":"Haruki Sugiyama","country":{"uid":"bltddddd2aba803f27e","title":"Japan","abbreviation":"JPN","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blta6f52e264bde8855/61aa4c7d55cf14733fc5bc35/japan.png","alt":""}},"horseName":"Lugal","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt9ddd4f7666c8babb/6ac69ddbe7a20ef7e334c46f/Contender_Photo_Lugal_(JPN)_.jpg"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt9ddd4f7666c8babb/6ac69ddbe7a20ef7e334c46f/Contender_Photo_Lugal_(JPN)_.jpg"},"cta":null,"races":[{"uid":"bltc81c