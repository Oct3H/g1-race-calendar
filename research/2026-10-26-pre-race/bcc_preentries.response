ame":"HAMILTON PARK","raceName":"Wyvis Roofing Ebf Maiden Stakes (Class 4) (Hamilton Park 2yo Series Qualifier) (Gbb Race)","grade":" ","raceDate":"May, 27 2026 00:00:00","purseUsa":15464,"positionAtFinish":1},{"trackName":"SARATOGA","raceName":" ","grade":" ","raceDate":"July, 29 2023 00:00:00","purseUsa":136500,"positionAtFinish":2}],"record":{"previousYear":{"starts":8,"earnings":358814,"show":1,"win":4,"place":0,"showP":"13","winP":"50","placeP":"0"},"breedersCup":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"currentYear":{"starts":7,"earnings":145625,"show":1,"win":0,"place":2,"showP":"14","winP":"0","placeP":"29"},"lifetime":{"starts":25,"earnings":674027,"show":3,"win":5,"place":5,"showP":"12","winP":"20","placeP":"20"}},"yearlySummary":[{"showsP":"14","winsP":"0","placesP":"29","starts":7,"earnings":145625,"racingYear":2026,"shows":1,"wins":0,"places":2},{"showsP":"13","winsP":"50","placesP":"0","starts":8,"earnings":358814,"racingYear":2025,"shows":1,"wins":4,"places":0}],"morningLineOdds":[],"bio":"\u003cp\u003eMoonlight is a bit of a newcomer for his current connections who purchased him for $250,000 on July 14 at Fasig-Tipton’s Horses of Racing Age Sale in Lexington, Kentucky. Eleven days later, he began rewarding them when he was third in the Bing Crosby Stakes (G1) at Del Mar as a 47-1 longshot. He further returned on his investment when narrowly beaten in the Pat O’Brien Stakes (G2) at Del Mar on Aug. 29.\u0026nbsp;\u003c/p\u003e\u003cp\u003eThe 5-year-old has rotated through several ownerships via public auctions after first being purchased for $170,000 as yearling. Resold as a 2-year-old in training, Moonlight flashed promise that year in winning his second career start and placing in graded company. After going winless in his first four tries as a sophomore, he was sold for $90,000 at Fasig-Tipton’s August digital sale in 2024. The next year he won the Cherokee Mile Stakes at Churchill Downs and three allowance races while pocketing $358,814. He was less productive in the first half of 2026 and was purchased by current owner Tom Kagele at the aforementioned July auction.\u0026nbsp;\u0026nbsp;\u003c/p\u003e\u003cp\u003eMoonlight’s name – a nod to his dam Sundown – was given to him by his breeder Peter Blum before he first was sold at auction.\u003c/p\u003e","gradedStakesPoints":8,"regionWinnerBadges":[],"breederName":"Peter E. Blum Thoroughbreds, LLC","uid":"bltc29fb73d99695223","hasAutogeneratedPage":true,"url":"/redirect/horse/bltc29fb73d99695223?ht=pre-entries","pageTitle":"Moonlight","jockeyName":"","ownerName":"Tom Kagele","trainer":"Peter Miller","country":{"uid":"blt1af49e3a6a89373f","title":"USA","abbreviation":"USA","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt9de45bbdff160673/60d219911e0505677a882fa1/USAFlag.png"}},"horseName":"Moonlight","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt6e418dda009d3e76/6ab2e301ace1f22eaccde4ac/Contender_Photo_Moonlight.jpg"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt6e418dda009d3e76/6ab2e301ace1f22eaccde4ac/Contender_Photo_Moonlight.jpg"},"cta":null,"races":[{"uid":"bltf6749e738cff0ef2","ContentTypeUid":"collection_race","challengeSeriesWinner":false,"isEligible":false,"eligibleRank":null,"finishPosition":null,"classicRanking":null,"postPosition":"","scratched":false,"win":"","place":"","show":"","deadHeat":false,"silks":null}],"isChallengeSeriesWinner":false,"silks":null,"isHoC":false,"year":2026,"isHistoricalEntry":false,"relatedArticles":[],"win":"","show":"","place":""},{"sireName":"Firing Line","damName":"Applelicious","sex":"Gelding","color":"Chestnut","foalingDate":"March, 29 2019 00:00:00","age":7,"pastPerformances":[{"trackName":"KEENELAND","raceName":"Stoll Keenon Ogden Phoenix S.","grade":"2","raceDate":"October, 02 2026 00:00:00","purseUsa":400000,"positionAtFinish":1},{"trackName":"SARATOGA","raceN