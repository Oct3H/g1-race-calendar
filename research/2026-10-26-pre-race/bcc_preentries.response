me":"Bryan Station S.","grade":"3","raceDate":"October, 26 2024 00:00:00","purseUsa":600000,"positionAtFinish":1},{"trackName":"KENTUCKY DOWNS","raceName":"Global Tote Gun Runner S.","grade":" ","raceDate":"September, 08 2024 00:00:00","purseUsa":1500000,"positionAtFinish":1},{"trackName":"COLONIAL DOWNS","raceName":"Secretariat S.","grade":"2","raceDate":"August, 11 2024 00:00:00","purseUsa":500000,"positionAtFinish":2},{"trackName":"CHURCHILL DOWNS","raceName":"American Derby","grade":" ","raceDate":"June, 29 2024 00:00:00","purseUsa":250000,"positionAtFinish":1},{"trackName":"CHURCHILL DOWNS","raceName":" ","grade":" ","raceDate":"June, 07 2024 00:00:00","purseUsa":127000,"positionAtFinish":1},{"trackName":"CHURCHILL DOWNS","raceName":" ","grade":" ","raceDate":"May, 02 2024 00:00:00","purseUsa":120000,"positionAtFinish":1},{"trackName":"FAIR GROUNDS","raceName":" ","grade":" ","raceDate":"February, 15 2024 00:00:00","purseUsa":57000,"positionAtFinish":5}],"record":{"previousYear":{"starts":6,"earnings":801085,"show":1,"win":2,"place":1,"showP":"17","winP":"33","placeP":"17"},"breedersCup":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"currentYear":{"starts":7,"earnings":492609,"show":1,"win":1,"place":0,"showP":"14","winP":"14","placeP":"0"},"lifetime":{"starts":20,"earnings":2894979,"show":2,"win":8,"place":2,"showP":"10","winP":"40","placeP":"10"}},"yearlySummary":[{"showsP":"14","winsP":"14","placesP":"0","starts":7,"earnings":492609,"racingYear":2026,"shows":1,"wins":1,"places":0},{"showsP":"17","winsP":"33","placesP":"17","starts":6,"earnings":801085,"racingYear":2025,"shows":1,"wins":2,"places":1}],"morningLineOdds":[],"bio":"\u003cp\u003eBrilliant Berti was on a brilliant roll, indeed, early in his career for Klein Racing and trainer Cherie DeVaux. Now, at age 5, the son of Noble Mission (GB) looks to return to that level of success. \r\u003c/p\u003e\u003cp\u003eBrilliant Berti won his second start, on Thursday of Kentucky Derby (G1) week at Churchill Downs. After a picture-perfect win in an allowance race, DeVaux jumped the rest of his conditions to contest the American Derby (Listed) and he won that by 2 1/4 lengths. \r\u003c/p\u003e\u003cp\u003eAnother jump in class resulted in a second in the Secretariat Stakes (G2) at Colonial Downs, followed by two more wins at Kentucky Downs and Keeneland. \r\u003c/p\u003e\u003cp\u003eHe kicked off his 4-year-old season in 2025 by finishing eighth in the Muniz Memorial (G2) at Fair Grounds, followed by victories in the Opening Verse (Listed) and the Wise Dan (G2) at Churchill Downs on June 28. At that point, he had seven wins from 11 starts. \r\u003c/p\u003e\u003cp\u003eFrom there, things went slightly south as Brilliant Berti, albeit keeping the best of company throughout and never outclassed, posted only one win in his next nine races. He was third in the 2025 Turf Mile (G1) at Keeneland and fourth in the 2026 edition.\u0026nbsp;\u003c/p\u003e","gradedStakesPoints":1,"regionWinnerBadges":[],"breederName":"Klein Racing","uid":"blte512be02adb7b384","hasAutogeneratedPage":true,"url":"/redirect/horse/blte512be02adb7b384?ht=pre-entries","pageTitle":"Brilliant Berti","jockeyName":"","ownerName":"Klein Racing (Richard Klein)","trainer":"Cherie DeVaux","country":{"uid":"blt1af49e3a6a89373f","title":"USA","abbreviation":"USA","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt9de45bbdff160673/60d219911e0505677a882fa1/USAFlag.png"}},"horseName":"Brilliant Berti","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt0fe72bab25b44668/6ac69b3702eecb17410761ed/Contender_Photo_Brilliant_Berti.jpg"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt0fe72bab25b44668/6ac69b3702eecb17410761ed/Contender_Photo_Brilliant_Berti.jpg"},"cta":null,"races":[{"uid":"blt31ae65439327eecf","ContentTypeUid":"collection_race","challengeSeriesWinner":false,"isEligible":true,"eligibleRank":19,"finishPosition":null,"classicRanking":null,"postPosition":"19","scratched":false,"win":"","place":"","show":"","deadHeat":false,"silks":null}],"isChallengeSeriesWinner":false,"silks":null,"isHoC":false,"year":2026,"isHistoricalEntry":false,"relatedArticles":[],"win":"","show":"","place":""},{"sireName":"Ten Sovereigns (IRE)","damName":"Lamyaa (GB)","sex":"Filly","color":"Bay","foalingDate":"January, 28 2022 00:00:00","age":4,"pastPerformances":[{"trackName":"KEENELAND","raceName":"First Lady S.","grade":"1","raceDate":"October, 03 2026 00:00:00","purseUsa":800000,"positionAtFinish":2},{"trackName":"ELLIS PARK","raceName":"Ellis Park Turf S.","grade":" ","raceDate":"August, 23 2026 00:00:00","purseUsa":175000,"positionAtFinish":2},{"trackName":"GULFSTREAM PARK","raceName":"Honey Fox S. presented by MyRacehorse","grade":"3","raceDate":"February, 28 2026 00:00:00","purseUsa":175000,"positionAtFinish":1},{"trackName":"CHURCHILL DOWNS","raceName":"Mrs. Revere S.","grade":"2","raceDate":"November, 28 2025 00:00:00","purseUsa":300000,"positionAtFinish":1},{"trackName":"KEENELAND","raceName":"Queen Elizabeth II Challenge Cup S. Presented by Dixiana","grade":"1","raceDate":"October, 11 2025 00:00:00","purseUsa":800000,"positionAtFinish":1},{"trackName":"DEL MAR","raceName":"Del Mar Oaks Presented by Keeneland Sales S.","grade":"1","raceDate":"August, 16 2025 00:00:00","purseUsa":300000,"positionAtFinish":2},{"trackName":"CHURCHILL DOWNS","raceName":"Tepin S.","grade":" ","raceDate":"June, 28 2025 00:00:00","purseUsa":250000,"positionAtFinish":1},{"trackName":"CHURCHILL DOWNS","raceName":"Edgewood S. presented by Accenture","grade":"2","raceDate":"May, 02 2025 00:00:00","purseUsa":600000,"positionAtFinish":2},{"trackName":"TAMPA BAY DOWNS","raceName":"Florida Oaks","grade":"3","raceDate":"March, 08 2025 00:00:00","purseUsa":200000,"positionAtFinish":2},{"trackName":"GULFSTREAM PARK","raceName":" ","grade":" ","raceDate":"January, 10 2025 00:00:00","purseUsa":96000,"positionAtFinish":1},{"trackName":"GULFSTREAM PARK","raceName":" ","grade":" ","raceDate":"November, 23 2024 00:00:00","purseUsa":65000,"positionAtFinish":1},{"trackName":"KENTUCKY DOWNS","raceName":" ","grade":" ","raceDate":"September, 11 2024 00:00:00","purseUsa":170000,"positionAtFinish":9},{"trackName":"TIPPERARY","raceName":"Irish Stallion Farms Ebf Fillies Maiden","grade":" ","raceDate":"August, 09 2024 00:00:00","purseUsa":19484,"positionAtFinish":2},{"trackName":"LEOPARDSTOWN","raceName":"Irish Stallion Farms E.B.F. Fillies","grade":" ","raceDate":"July, 11 2024 00:00:00","purseUsa":19484,"positionAtFinish":9}],"record":{"previousYear":{"starts":7,"earnings":887858,"show":0,"win":4,"place":3,"showP":"0","winP":"57","placeP":"43"},"breedersCup":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"currentYear":{"starts":3,"earnings":229640,"show":0,"win":1,"place":2,"showP":"0","winP":"33","placeP":"67"},"lifetime":{"starts":14,"earnings":1146400,"show":0,"win":6,"place":6,"showP":"0","winP":"43","placeP":"43"}},"yearlySummary":[{"showsP":"0","winsP":"33","placesP":"67","starts":3,"earnings":229640,"racingYear":2026,"shows":0,"wins":1,"places":2},{"showsP":"0","winsP":"57","placesP":"43","starts":7,"earnings":887858,"racingYear":2025,"shows":0,"wins":4,"places":3}],"morningLineOdds":[],"bio":"\u003cp\u003eSince transferring to the stable of Brendan Walsh, the performance of Lush Lips (GB) qualifies as a chef's kiss. In 11 starts for Walsh, she has finished second five times and won the rest, including a trio of graded stakes with the highlight coming in the Queen Elizabeth II Challenge Cup (G1) at Keeneland in October 2025. \u0026nbsp;\r\u003c/p\u003e\u003cp\u003eFollowing her first top level score, she commanded $3.7 million in the Keeneland November Breeding Stock Sale and promptly returned to the track three weeks later to reward new owners Dixiana Farms with a victory in the Mrs. Revere (G2) at Churchill Downs. \u0026nbsp;\r\u003c/p\u003e\u003cp\u003eWhen Lush Lips kicked off her 4-year-old campaign at Gulfstream Park Feb. 28, she extended her graded stakes winning streak to three in the Honey Fox (G3). She then went to the bench with what Walsh termed an \"unspecified injury\" for six months and returned Aug. 23 to be second in the Ellis Park Turf Stakes. \u0026nbsp;In the First Lady (G1) at Keeneland Oct. 3 Lush Lips appeared to be the clear winner until being run down late to lose by a short nose at the wire to Classic Q, who is also hopeful for the Maker's Mark Breeders’ Cup Filly \u0026amp; Mare Turf (G1). \r\u003c/p\u003e\u003cp\u003eLush Lips is by Ten Sovereigns (IRE) out of Lamyaa (GB) by Arcano (IRE). She began her career in Ireland and ran her first three times for trainer Donnacha O'Brien.\u0026nbsp;\u003c/p\u003e","gradedStakesPoints":10,"regionWinnerBadges":[],"breederName":"The Pocock Family","uid":"blt7da23de964cc6685","hasAutogeneratedPage":true,"url":"/redirect/horse/blt7da23de964cc6685?ht=pre-entries","pageTitle":"Lush Lips (GB)","jockeyName":"","ownerName":"Dixiana Farms, LLC (William Shively)","trainer":"Brendan P. Walsh","country":{"uid":"blt1af49e3a6a89373f","title":"USA","abbreviation":"USA","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt9de45bbdff160673/60d219911e0505677a882fa1/USAFlag.png"}},"horseName":"Lush Lips","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt44d1d9ed30c4f5c4/6ac68f02512a6d7d2ae35a78/Contender_Photo_Lush_Lips_.jpg"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt44d1d9ed30c4f5c4/6ac68f02512a6d7d2ae35a78/Contender_Photo_Lush_Lips_.jpg"},"cta":null,"races":[{"uid":"blt31ae65439327eecf","ContentTypeUid":"collection_race","challengeSeriesWinner":false,"isEligible":true,"eligibleRank":20,"finishPosition":null,"classicRanking":null,"postPosition":"20","scratched":false,"win":"","place":"","show":"","deadHeat":false,"silks":null}],"isChallengeSeriesWinner":false,"silks":null,"isHoC":false,"year":2026,"isHistoricalEntry":false,"relatedArticles":[],"win":"","show":"","place":""},{"sireName":"--","damName":"--","record":{"previousYear":{"earnings":-1,"place":-1,"show":-1,"starts":-1,"win":-1,"showP":"100","winP":"100","placeP":"100"},"breedersCup":{"earnings":-1,"place":-1,"show":-1,"starts":-1,"win":-1,"showP":"100","winP":"100","placeP":"100"},"currentYear":{"earnings":-1,"place":-1,"show":-1,"starts":-1,"win":-1,"showP":"100","winP":"100","placeP":"100"},"lifetime":{"earnings":-1,"place":-1,"show":-1,"starts":-1,"win":-1,"showP":"100","winP":"100","placeP":"100"}},"yearlySummary":[{"showsP":"100","winsP":"100","placesP":"100","starts":-1,"earnings":-1,"racingYear":2026,"shows":-1,"wins":-1,"places":-1},{"showsP":"100","winsP":"100","placesP":"100","starts":-1,"earnings":-1,"racingYear":2025,"shows":-1,"wins":-1,"places":-1}],"morningLineOdds":[],"bio":"\u003cp\u003eVictorious in late March in the Dubai Turf sponsored by DP World (G1), Facteur Cheval (IRE) is under consideration for another top-level stakes target this fall, though on dirt in the $7 million Longines Breeders' Cup Classic (G1) Nov. 2 at Del Mar. \u003c/p\u003e\u003cp\u003eA 5-year-old gelding owned by Gary Barber and Team Valor International, Facteur Cheval returned from his success in Dubai to run sixth in the June 18 Queen Anne Stakes (G1) at Royal Ascot and third in the July 31 Qatar Sussex Stakes (G1) at Goodwood. Those races, like the Dubai Turf, came on grass, though over a shorter distance of a mile. \u003c/p\u003e\u003cp\u003eIn the Sussex, he was beaten just 1 3/4 lengths after a poor start, losing to Notable Speech (GB) and Maljoom (IRE). \u003c/p\u003e\u003cp\u003eEarlier in his career, Facteur Cheval won the 2022 Prix Perth (G3) at Saint-Cloud in France. \u003c/p\u003e\u003cp\u003eBred in Ireland by McCracken Farms, Facteur Cheval has a grassy pedigree being by Ribchester (IRE) out of the Shamardal mare Jawlaat (IRE). But Team Valor founder and CEO Barry Irwin regards Facteur Cheval as having the size and look of an American dirt horse. \u003c/p\u003e\u003cp\u003eTeam Valor has experienced success by shifting its top runners to dirt, notably with the Graham Motion-trained Animal Kingdom in the 2011 Kentucky Derby (G1 that was his initial start on dirt. \u003c/p\u003e\u003cp\u003eThough the 1 1/4-mile Breeders' Cup Classic would be the longest race of Facteur Cheval's career, he stayed 1 1/8 miles in the Dubai Turf over an international field. \u003c/p\u003e\u003cp\u003eWithout the turn of foot necessary to take down top company on firm turf, Facteur Cheval prefers give in the ground when racing on turf. This grinding style could point to him being a horse that can handle dirt. A workout on dirt at Meydan prior to the Dubai Turf also encouraged trainer Jerome Reynier about his main-track ability.\u003c/p\u003e","gradedStakesPoints":0,"regionWinnerBadges":[],"breederName":"McCracken Farms","uid":"bltcf2e453e47e8411e","hasAutogeneratedPage":true,"url":"/redirect/horse/bltcf2e453e47e8411e?ht=pre-entries","pageTitle":"Facteur Cheval 2026","jockeyName":"","ownerName":"Gary Barber and Team Valor International (Barry Irwin)","trainer":"Mark E. Casse","country":{"uid":"blt1af49e3a6a89373f","title":"USA","abbreviation":"USA","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt9de45bbdff160673/60d219911e0505677a882fa1/USAFlag.png"}},"horseName":"Facteur Cheval","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt50e958b4c1ef8f10/66bb863d473507fac1091a2b/Facteur_Cheval.png"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt50e958b4c1ef8f10/66bb863d473507fac1091a2b/Facteur_Cheval.png"},"cta":null,"races":[{"uid":"blt31ae65439327eecf","ContentTypeUid":"collection_race","challengeSeriesWinner":false,"isEligible":true,"eligibleRank":21,"finishPosition":null,"classicRanking":null,"postPosition":"21","scratched":false,"win":"","place":"","show":"","deadHeat":false,"silks":null}],"isChallengeSeriesWinner":false,"silks":null,"isHoC":false,"year":2026,"isHistoricalEntry":true,"relatedArticles":[],"win":"","show":"","place":""},{"sireName":"Make Believe (GB)","damName":"Sunset Dazzle (IRE)","sex":"Mare","color":"Bay","foalingDate":"March, 08 2021 00:00:00","age":5,"pastPerformances":[{"trackName":"KEENELAND","raceName":"First Lady S.","grade":"1","raceDate":"October, 03 2026 00:00:00","purseUsa":800000,"positionAtFinish":4},{"trackName":"KENTUCKY DOWNS","raceName":"Never Say Die Kentucky Downs Ladies Turf Sprint S.","grade":"1","raceDate":"August, 29 2026 00:00:00","purseUsa":1750000,"positionAtFinish":5},{"trackName":"WOODBINE","raceName":"Nassau S.","grade":"2","raceDate":"July, 19 2026 00:00:00","purseUsa":200000,"positionAtFinish":1},{"trackName":"CHURCHILL DOWNS","raceName":"Old Forester Mint Julep S.","grade":"3","raceDate":"May, 30 2026 00:00:00","purseUsa":275000,"positionAtFinish":3},{"trackName":"CHURCHILL DOWNS","raceName":"Longines Churchill Distaff Turf Mile S.","grade":"2","raceDate":"May, 02 2026 00:00:00","purseUsa":1000000,"positionAtFinish":5},{"trackName":"KEENELAND","raceName":" ","grade":" ","raceDate":"April, 10 2026 00:00:00","purseUsa":130000,"positionAtFinish":4},{"trackName":"TURFWAY PARK","raceName":"My Charmer S. Presented by Claiborne Farm","grade":" ","raceDate":"December, 21 2025 00:00:00","purseUsa":250000,"positionAtFinish":7},{"trackName":"CHURCHILL DOWNS","raceName":" ","grade":" ","raceDate":"November, 22 2025 00:00:00","purseUsa":127000,"positionAtFinish":1},{"trackName":"KEENELAND","raceName":" ","grade":" ","raceDate":"October, 10 2025 00:00:00","purseUsa":120000,"positionAtFinish":6},{"trackName":"SARATOGA","raceName":" ","grade":" ","raceDate":"August, 23 2024 00:00:00","purseUsa":100000,"positionAtFinish":1},{"trackName":"LEOPARDSTOWN","raceName":"Al Shiraaa Racing Mutamakina S.","grade":"3","raceDate":"May, 12 2024 00:00:00","purseUsa":56567,"positionAtFinish":3},{"trackName":"DUNDALK","raceName":"Get Best Odds Guaranteed At BetVictor","grade":" ","raceDate":"April, 12 2024 00:00:00","purseUsa":13944,"positionAtFinish":3},{"trackName":"DUNDALK","raceName":"Irish Stallion Farms EBF Median Auction","grade":" ","raceDate":"December, 06 2023 00:00:00","purseUsa":23756,"positionAtFinish":6},{"trackName":"DUNDALK","raceName":"Irish Stallion Farms E.B.F. Fillies","grade":" ","raceDate":"September, 29 2023 00:00:00","purseUsa":15850,"positionAtFinish":6}],"record":{"previousYear":{"starts":3,"earnings":43874,"show":0,"win":1,"place":0,"showP":"0","winP":"33","placeP":"0"},"breedersCup":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"currentYear":{"starts":6,"earnings":192321,"show":1,"win":1,"place":0,"showP":"17","winP":"17","placeP":"0"},"lifetime":{"starts":14,"earnings":297937,"show":3,"win":3,"place":0,"showP":"21","winP":"21","placeP":"0"}},"yearlySummary":[{"showsP":"17","winsP":"17","placesP":"0","starts":6,"earnings":192321,"racingYear":2026,"shows":1,"wins":1,"places":0},{"showsP":"0","winsP":"33","placesP":"0","starts":3,"earnings":43874,"racingYear":2025,"shows":0,"wins":1,"places":0}],"morningLineOdds":[],"bio":"\u003cp\u003eIn her first trip north of the border, 5-year-old Vina Arana (IRE) captured the first stakes victory of her career when she rallied from the back of the pack and rolled down the lane under Adam Beschizza to produce a decisive 4-length win in the Nassau (G2) at Woodbine July 19. \u0026nbsp;\r\u003c/p\u003e\u003cp\u003eRacing nearly exclusively for trainer Jack Sisterson since coming over from Ireland in the late summer of 2024 after four winless races in her native land, the Nassau was her third overall victory after previously scoring in a maiden special weight and an allowance test. “We always thought she had a performance like this in her,” Sisterson said of the daughter of Make Believe (GB) and the Teofilo (IRE) mare Sunset Dazzle (IRE). \u0026nbsp;\r\u003c/p\u003e\u003cp\u003ePrior to her win in the Nassau Vina Arana was graded stakes placed when she began her 2026 campaign. In her third start of the year she delivered a third-place effort in the Mint Julep (G3) at Churchill Downs on May 30. Following the Nassau, she stepped up into Grade 1 company, finishing fifth in the Ladies Turf Sprint at Kentucky Downs Aug. 29 and then fourth in the First Lady (G1) at Keeneland Oct. 3. \u0026nbsp;\r\u003c/p\u003e\u003cp\u003eVina Arana was privately purchased by Sterling Stables and MHM stables in August 2024. \u0026nbsp;\u003c/p\u003e","gradedStakesPoints":1,"regionWinnerBadges":[],"breederName":"Funcheon Bloodstock LTD","uid":"blt545a6b8bcef7ef56","hasAutogeneratedPage":true,"url":"/redirect/horse/blt545a6b8bcef7ef56?ht=pre-entries","pageTitle":"Vina Arana (IRE)","jockeyName":"","ownerName":"MHM Stables LLC (Matthew Mazzucchi) and Sterling Stables (Kevin Bogart)","trainer":"Jack Sisterson","country":{"uid":"blt1af49e3a6a89373f","title":"USA","abbreviation":"USA","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt9de45bbdff160673/60d219911e0505677a882fa1/USAFlag.png"}},"horseName":"Vina Arana","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt28d8b2e835c2b9b4/6ace98c78f4f8c0ee66be61a/Contender_Photo_Vina_Arana_.jpg"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt28d8b2e835c2b9b4/6ace98c78f4f8c0ee66be61a/Contender_Photo_Vina_Arana_.jpg"},"cta":null,"races":[{"uid":"blt31ae65439327eecf","ContentTypeUid":"collection_race","challengeSeriesWinner":false,"isEligible":true,"eligibleRank":23,"finishPosition":null,"classicRanking":null,"postPosition":"23","scratched":false,"win":"","place":"","show":"","deadHeat":false,"silks":null}],"isChallengeSeriesWinner":false,"silks":null,"isHoC":false,"year":2026,"isHistoricalEntry":false,"relatedArticles":[],"win":"","show":"","place":""}]},{"u