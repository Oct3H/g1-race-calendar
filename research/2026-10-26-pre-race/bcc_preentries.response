0000,"positionAtFinish":5},{"trackName":"FAIR GROUNDS","raceName":"Fasig-Tipton Risen Star S.","grade":"2","raceDate":"February, 15 2025 00:00:00","purseUsa":500000,"positionAtFinish":3},{"trackName":"FAIR GROUNDS","raceName":"Lecomte S.","grade":"3","raceDate":"January, 18 2025 00:00:00","purseUsa":250000,"positionAtFinish":2},{"trackName":"FAIR GROUNDS","raceName":"Gun Runner S.","grade":" ","raceDate":"December, 21 2024 00:00:00","purseUsa":100000,"positionAtFinish":1},{"trackName":"KEENELAND","raceName":" ","grade":" ","raceDate":"October, 06 2024 00:00:00","purseUsa":100000,"positionAtFinish":1},{"trackName":"ELLIS PARK","raceName":" ","grade":" ","raceDate":"August, 24 2024 00:00:00","purseUsa":71000,"positionAtFinish":4}],"record":{"previousYear":{"starts":5,"earnings":159100,"show":1,"win":1,"place":1,"showP":"20","winP":"20","placeP":"20"},"breedersCup":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"currentYear":{"starts":7,"earnings":599842,"show":1,"win":4,"place":1,"showP":"14","winP":"57","placeP":"14"},"lifetime":{"starts":15,"earnings":883146,"show":3,"win":7,"place":2,"showP":"20","winP":"47","placeP":"13"}},"yearlySummary":[{"showsP":"14","winsP":"57","placesP":"14","starts":7,"earnings":599842,"racingYear":2026,"shows":1,"wins":4,"places":1},{"showsP":"20","winsP":"20","placesP":"20","starts":5,"earnings":159100,"racingYear":2025,"shows":1,"wins":1,"places":1}],"morningLineOdds":[],"bio":"\u003cp\u003eBuilt engineered his ticket to the Cygames Breeders’ Cup Sprint (G1) by taking the “Win and You’re In” Alfred G. Vanderbilt Stakes (G2) on July 25 at Saratoga. \u0026nbsp;\r\u003c/p\u003e\u003cp\u003eBuilt added to his resume in his next start on Sept. 12 at Churchill Downs in the 6 ½-furlong Louisville Thoroughbred Society Stakes by taking command on the far turn en route to a 1 1/2-length victory. \r\u003c/p\u003e\u003cp\u003eHe already has proven he can win at Keeneland after scoring his initial career victory there as a 2-year-old on Oct. 6, 2024 in his second start. He closed that season with a score in the Gun Runner Stakes (Listed) at Fair Grounds at 1 1/16 miles that had his connections dreaming of the 2025 Kentucky Derby (G1). \r\u003c/p\u003e\u003cp\u003e\u0026nbsp;Built then picked up qualifying points in Fair Grounds stakes races but bypassed the Derby in favor of the undercard’s Pat Day Mile (G2) in which he was unplaced. He was out of competition until winning a Fair Grounds allowance sprint on Dec. 18 and has since continued racing at less than a mile. \r\u003c/p\u003e\u003cp\u003eBuilt’s trainer Wayne Catalano and owner Eclipse Thoroughbred Partners teamed to win the 2021 Qatar Racing Breeders’ Cup Sprint (G1) with Aloha West at Del Mar. He was purchased by his current owner as a 2-year-old for $260,000 at the 2024 April Ocala Breeders’ Sales Co. auction. He previously sold for $82,000 at the Keeneland September Yearling Sale.\u0026nbsp;\u003c/p\u003e","gradedStakesPoints":8,"regionWinnerBadges":[],"breederName":"Robert Low \u0026 Lawana Low","uid":"blt7e8cc9940b94f713","hasAutogeneratedPage":true,"url":"/redirect/horse/blt7e8cc9940b94f713?ht=pre-entries","pageTitle":"Built","jockeyName":"","ownerName":"Eclipse Thoroughbred Partners (Aron Wellman)","trainer":"Wayne M. Catalano","country":{"uid":"blt1af49e3a6a89373f","title":"USA","abbreviation":"USA","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt9de45bbdff160673/60d219911e0505677a882fa1/USAFlag.png"}},"horseName":"Built","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/bltb10aff0e1b6a0e62/6a972cc3075f970eeb3e205b/Contender_Photo_Built.jpg"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/bltb10aff0e1b6a0e62/6a972cc3075f970eeb3e205b/Contender_Photo_Built.jpg"},"cta":null,"races":[{"uid":"bltf6749e738cff0ef2","ContentTypeUid":"collection_race","challengeSeriesWinner":false,"isEligible":false,"eligibleRank":