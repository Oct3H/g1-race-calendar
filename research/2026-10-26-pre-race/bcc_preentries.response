Date":"October, 26 2024 00:00:00","purseUsa":279822,"positionAtFinish":1},{"trackName":"CURRAGH","raceName":"Montane Developments Beresford S.","grade":"2","raceDate":"September, 28 2024 00:00:00","purseUsa":129893,"positionAtFinish":1},{"trackName":"CURRAGH","raceName":"Coolmore Stud Wootton Bassett Irish E.B.F. Futurity S.","grade":"2","raceDate":"August, 24 2024 00:00:00","purseUsa":129893,"positionAtFinish":2},{"trackName":"LEOPARDSTOWN","raceName":"Japan Racing Association Tyros S.","grade":"3","raceDate":"July, 25 2024 00:00:00","purseUsa":54122,"positionAtFinish":1},{"trackName":"CURRAGH","raceName":"Spar Shop At The Curragh Irish E.B.F.","grade":" ","raceDate":"June, 05 2024 00:00:00","purseUsa":21759,"positionAtFinish":1},{"trackName":"LEOPARDSTOWN","raceName":"Irish Stallion Farms E.B.F.","grade":" ","raceDate":"May, 17 2024 00:00:00","purseUsa":19561,"positionAtFinish":4}],"record":{"previousYear":{"starts":5,"earnings":191529,"show":1,"win":0,"place":0,"showP":"20","winP":"0","placeP":"0"},"breedersCup":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"currentYear":{"starts":4,"earnings":953965,"show":2,"win":2,"place":0,"showP":"50","winP":"50","placeP":"0"},"lifetime":{"starts":15,"earnings":1458018,"show":3,"win":6,"place":1,"showP":"20","winP":"40","placeP":"7"}},"yearlySummary":[{"showsP":"50","winsP":"50","placesP":"0","starts":4,"earnings":953965,"racingYear":2026,"shows":2,"wins":2,"places":0},{"showsP":"20","winsP":"0","placesP":"0","starts":5,"earnings":191529,"racingYear":2025,"shows":1,"wins":0,"places":0}],"morningLineOdds":[],"bio":"\u003cp\u003eWhen Hotazhell (GB) did not appear among the confirmations for the Oct. 17 British Champions Day at Ascot in England, it was clear the 4-year-old son of Too Darn Hot (GB) was headed for a career finale in the Breeders' Cup World Championships at Keeneland. \r\u003c/p\u003e\u003cp\u003eThe travel makes sense as he has won in Ireland, England and Germany and finished an unlucky fourth as the favorite in the 2025 Saratoga Derby Invitational (G1). The question would be, which race? Hotazhell has Group 1 victories at both 1 mile and 1 1/4 miles, leaving it to trainer Jessica Harrington and the Silverton Hill Partnership owners to pick the trip. \r\u003c/p\u003e\u003cp\u003eHotazhell, out of the Danehill Dancer (IRE) mare Azenar (GB), was an early success story. He finished second in the Futurity Stakes (G2) at the Curragh in August 2024, won the prestigious Beresford Stakes (G2) at the same track and the Futurity Trophy (G1) at Doncaster before winter break. \r\u003c/p\u003e\u003cp\u003eHotazhell wasn't quite so hot at 3, going 0-for-5, including a 10th-place finish when ambitiously placed in the Prix de l'Arc de Triomphe (G1). After an eight-month break he returned in 2026 to post two thirds in Ireland, then won the Grosser Dallmayr-Preis-Bayerisches Zuchtrennen (Group 1) in Munich and the Irish Champion Stakes (G1) at odds of 50-1.\u0026nbsp;\u003c/p\u003e","gradedStakesPoints":0,"regionWinnerBadges":[],"breederName":"Blue Diamond Stud Farm (UK) Ltd","uid":"blt87a5f751670d3414","hasAutogeneratedPage":true,"url":"/redirect/horse/blt87a5f751670d3414?ht=pre-entries","pageTitle":"Hotazhell (GB)","jockeyName":"","ownerName":"Silverton Hill, LLC (Bonnie and Tommy Hamilton)","trainer":"Jessica Harrington","country":{"uid":"blt440e3ce320965a9b","title":"United Kingdom / England","abbreviation":"GBR","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt02676e7705186e63/61aa4e462e86841fa22388f0/united-kingdom.png","alt":""}},"horseName":"Hotazhell","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt01256eb97a81d9bc/6ad25621bcf6e0334ee5750e/Contender_Photo_Hotazhell.jpg"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt01256eb97a81d9bc/6ad25621bcf6e0334ee5750e/Contender_Photo_Hotazhell.jpg"},"cta":null,"races":[{"uid":"blt31ae65439327eecf