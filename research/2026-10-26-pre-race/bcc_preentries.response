57b1efe7a70/bltb0b7768e84d44449/614ce97164c8007a9bdec19c/Keeneland_Track_Image.jpeg"},"locationBcbc":"Keeneland","timeZone":-4}}],"raceDescription":"\u003ch1\u003eA\u0026nbsp;proving\u0026nbsp;ground\u0026nbsp;for\u0026nbsp;international\u0026nbsp;legends.\u003c/h1\u003e\u0026nbsp;\u003cp\u003eThe world's top grass milers compete in the FanDuel Breeders' Cup Mile presented by Permanently Disabled Jockeys Fund (PDJF), contested around to turns on the turf course for a purse of $2 million. Open to male and female horses three years and older, the Mile is a demanding race favoring horses quick out of the gate and securing a strong position for the stretch drive to the wire.\r\u003c/p\u003e\u003cp\u003e\u0026nbsp;\u003c/p\u003e","surface":"","bettingCtaOverride":{"cta":[]},"horseType":"pre-entries","horses":[{"sireName":"Blue Point (IRE)","damName":"Mayhem (IRE)","sex":"Filly","color":"Bay","foalingDate":"March, 06 2022 00:00:00","age":4,"pastPerformances":[{"trackName":"NEWMARKET","raceName":"BetMGM Sun Chariot S.","grade":"1","raceDate":"October, 03 2026 00:00:00","purseUsa":496494,"positionAtFinish":1},{"trackName":"LEOPARDSTOWN","raceName":"Coolmore America Justify Matron S.","grade":"1","raceDate":"September, 12 2026 00:00:00","purseUsa":463950,"positionAtFinish":1},{"trackName":"DEAUVILLE","raceName":"Prix Rothschild - F.E.E. - World Pool By PMU","grade":"1","raceDate":"August, 02 2026 00:00:00","purseUsa":345999,"positionAtFinish":1},{"trackName":"NEWMARKET","raceName":"Tattersalls Sceptre Sessions Falmouth S.","grade":"1","raceDate":"July, 10 2026 00:00:00","purseUsa":502829,"positionAtFinish":1},{"trackName":"ASCOT","raceName":"Duke Of Cambridge S.","grade":"2","raceDate":"June, 17 2026 00:00:00","purseUsa":335663,"positionAtFinish":1},{"trackName":"GOODWOOD","raceName":"Fitzdares Conqueror Fillies S.","grade":" ","raceDate":"May, 02 2026 00:00:00","purseUsa":95031,"positionAtFinish":1},{"trackName":"NEWMARKET","raceName":"BetMGM Sun Chariot S.","grade":"1","raceDate":"October, 04 2025 00:00:00","purseUsa":370650,"positionAtFinish":2},{"trackName":"SANDOWN PARK","raceName":"BetMGM Atalanta S.","grade":"3","raceDate":"August, 30 2025 00:00:00","purseUsa":114789,"positionAtFinish":2},{"trackName":"SANDOWN PARK","raceName":"Coral Distaff","grade":" ","raceDate":"July, 05 2025 00:00:00","purseUsa":75064,"positionAtFinish":1},{"trackName":"NEWBURY","raceName":"Darley Ebf Fillies Novice Stakes (Class 2) (Gbb Race)","grade":" ","raceDate":"June, 12 2025 00:00:00","purseUsa":54189,"positionAtFinish":1},{"trackName":"ROYAL WINDSOR","raceName":"British Stallion Studs Ebf Fillies Novice Stakes (Class 2) (Gbb Race)","grade":" ","raceDate":"May, 19 2025 00:00:00","purseUsa":53104,"positionAtFinish":1},{"trackName":"SOUTHWELL","raceName":"Weekly Free Bets With Betmgm Extra Maiden Fillies Stakes (Class 3) (Gbb Race)","grade":" ","raceDate":"April, 06 2025 00:00:00","purseUsa":38724,"positionAtFinish":5}],"record":{"previousYear":{"starts":6,"earnings":202238,"show":0,"win":3,"place":2,"showP":"0","winP":"50","placeP":"33"},"breedersCup":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"currentYear":{"starts":6,"earnings":1281933,"show":0,"win":6,"place":0,"showP":"0","winP":"100","placeP":"0"},"lifetime":{"starts":12,"earnings":1484171,"show":0,"win":9,"place":2,"showP":"0","winP":"75","placeP":"17"}},"yearlySummary":[{"showsP":"0","winsP":"100","placesP":"0","starts":6,"earnings":1281933,"racingYear":2026,"shows":0,"wins":6,"places":0},{"showsP":"0","winsP":"50","placesP":"33","starts":6,"earnings":202238,"racingYear":2025,"shows":0,"wins":3,"places":2}],"morningLineOdds":[],"bio":"\u003cp\u003eDuring her 3-year-old campaign in 2025 she knocked on the graded stakes door while racing in Great Britain and this year Juddmonte’s Blue Bolt (IRE) came back even bigger, stronger and better to kick it down. Undefeated in her first five 2026 starts, the imposing daughter of Blue Point (IRE) made her seasonal reappearance at Goodwood May 2 in the Conquerer Fillies Stakes (Listed) and then justified her favoritism in the 1-mile Duke of Cambridge Stakes (G2) with a convincing Royal Ascot win June 17. \r\u003c/p\u003e\u003cp\u003eAfterward trainer Andrew Balding declared her “a star” and she proved him right next time out, taking another step forward with her brilliant turn of foot as she beat the favored Precise (IRE) to become a first-time G1 winner in the 1-mile Falmouth Stakes at Newmarket July 10. At the wire she was 2 lengths clear under regular jockey Colin Keane, Juddmonte’s No. 1 rider.\r\u003c/p\u003e\u003cp\u003eBlue Bolt got the best of Precise again in the Prix Rothschild (G1) at Deauville on Aug. 2 by getting up in the final yards to prevail by a half-length. In the 1-mile Matron (G1) at Leopardstown on Sept. 12, Blue Bolt hit the front in the upper stretch and drew off for a 2 1/4-length victory.\r\u003c/p\u003e\u003cp\u003eBlue Bolt, who was unraced as a juvenile, is out of the Whipper mare Mayhem (IRE). She stands to become the fourth Maker’s Mark Filly \u0026amp; Mare Turf winner for Juddmonte, which was victorious with British-breds Banks Hill (2001), Intercontinental (2005), and Midday (2009).\r\u003c/p\u003e","gradedStakesPoints":0,"regionWinnerBadges":[],"breederName":"C-Squared Investments","uid":"blt5e54407417aa79cd","hasAutogeneratedPage":true,"url":"/redirect/horse/blt5e54407417aa79cd?ht=pre-entries","pageTitle":"Blue Bolt (IRE)","jockeyName":"","ownerName":"Juddmonte (Fahad Bin Khalid)","trainer":"Andrew Balding","country":{"uid":"blt440e3ce320965a9b","title":"United Kingdom / England","abbreviation":"GBR","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt02676e7705186e63/61aa4e462e86841fa22388f0/united-kingdom.png","alt":""}},"horseName":"Blue Bolt","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt0e8713db2572dbd9/6a739f305e874b2ef81afbed/Contender_Photo_Blue_Bolt.jpg"},"regularI