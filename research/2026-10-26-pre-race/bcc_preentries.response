previousYear":{"starts":8,"earnings":717665,"show":2,"win":1,"place":0,"showP":"25","winP":"13","placeP":"0"},"breedersCup":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"currentYear":{"starts":3,"earnings":1679142,"show":1,"win":1,"place":0,"showP":"33","winP":"33","placeP":"0"},"lifetime":{"starts":30,"earnings":3769591,"show":5,"win":7,"place":4,"showP":"17","winP":"23","placeP":"13"}},"yearlySummary":[{"showsP":"33","winsP":"33","placesP":"0","starts":3,"earnings":1679142,"racingYear":2026,"shows":1,"wins":1,"places":0},{"showsP":"25","winsP":"13","placesP":"0","starts":8,"earnings":717665,"racingYear":2025,"shows":2,"wins":1,"places":0}],"morningLineOdds":[],"bio":"\u003cp\u003eDeep Monster (JPN) made his first start outside of Japan a winning one when he took the H.H. The Amir Trophy (G2) in Doha, Qatar, on Feb. 14. The 8-year-old led inside the final furlong of the 1 ½-mile race and kept on well to defeat Goliath (GER) by a neck. Giavellotto (IRE) was third. \u0026nbsp;\r\u003c/p\u003e\u003cp\u003eFollowing that victory, Deep Monster headed to Hong Kong for the May 24 Champions \u0026amp; Chater Cup (G1). He finished third, 2 lengths behind the winning Romantic Warrior (IRE). \u0026nbsp;\r\u003c/p\u003e\u003cp\u003eLast year, Deep Monster won the Kyoto Daishoten (G2) to notch his first graded stakes victory. In 2023, he won the Andromeda Stakes, and he took the Sumire Stakes in 2021. Deep Monster also finished second in the 2024 Challenge Cup (G3) as well as third in the 2025 Niigata Kinen (G3) and the 2024 and 2025 Kokura Kinen (G3). \r\u003c/p\u003e\u003cp\u003eYasutoshi Ikee trains Deep Monster for the DMM Dream Club Co Ltd, which won the 2021 Maker's Mark Breeders' Cup Filly \u0026amp; Mare Turf (G1) with Loves Only You (JPN). \r\u003c/p\u003e\u003cp\u003eDeep Monster was bred by Yano Bokujo. He is by the legendary Deep Impact (JPN) and out of the Bellamy Road mare Sisterly Love.\u0026nbsp;\u003c/p\u003e","gra