:"DEL MAR","raceName":" ","grade":" ","raceDate":"November, 23 2025 00:00:00","purseUsa":43000,"positionAtFinish":1},{"trackName":"SANTA ANITA PARK","raceName":" ","grade":" ","raceDate":"October, 12 2025 00:00:00","purseUsa":61000,"positionAtFinish":6},{"trackName":"DEL MAR","raceName":" ","grade":" ","raceDate":"September, 07 2025 00:00:00","purseUsa":81000,"positionAtFinish":12},{"trackName":"DEL MAR","raceName":" ","grade":" ","raceDate":"August, 09 2025 00:00:00","purseUsa":81000,"positionAtFinish":1},{"trackName":"DEL MAR","raceName":" ","grade":" ","raceDate":"July, 24 2025 00:00:00","purseUsa":30000,"positionAtFinish":1},{"trackName":"GULFSTREAM PARK","raceName":" ","grade":" ","raceDate":"June, 14 2025 00:00:00","purseUsa":34000,"positionAtFinish":4},{"trackName":"TAMPA BAY DOWNS","raceName":" ","grade":" ","raceDate":"April, 26 2025 00:00:00","purseUsa":53000,"positionAtFinish":3},{"trackName":"TAMPA BAY DOWNS","raceName":" ","grade":" ","raceDate":"March, 19 2025 00:00:00","purseUsa":22000,"positionAtFinish":2}],"record":{"previousYear":{"starts":8,"earnings":102410,"show":1,"win":3,"place":1,"showP":"13","winP":"38","placeP":"13"},"breedersCup":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"currentYear":{"starts":6,"earnings":456160,"show":2,"win":2,"place":2,"showP":"33","winP":"33","placeP":"33"},"lifetime":{"starts":14,"earnings":558570,"show":3,"win":5,"place":3,"showP":"21","winP":"36","placeP":"21"}},"yearlySummary":[{"showsP":"33","winsP":"33","placesP":"33","starts":6,"earnings":456160,"racingYear":2026,"shows":2,"wins":2,"places":2},{"showsP":"13","winsP":"38","placesP":"13","starts":8,"earnings":102410,"racingYear":2025,"shows":1,"wins":3,"places":1}],"morningLineOdds":[],"bio":"\u003cp\u003eA year after proving himself as a competitive mid-level claimer, Listenupshance put “Grade One Winner” on his resume with his narrow score in the Bing Crosby Stakes (G1) at Del Mar on July 25. \r\u003c/p\u003e\u003cp\u003eA $10,000 purchase at the 2023 Fasig-Tipton October sale in Lexington, Listenupshance debuted with a runner-up effort against maiden claimers at Tampa Bay Downs in 2025. After winning at that level last summer at Del Mar, he was purchased privately by current co-owner Run Fast Racing, a micro-share syndicate anchored by celebrities such as rapper Lil Wayne. The plan was simple – keep Listenupshance racing against his own kind so that others would experience winning and want to invest. But the goal got sidetracked when only higher level races were available. In his first start for his new connections, the gelding surprisingly won at 17-1 odds at an elevated level at Del Mar. \r\u003c/p\u003e\u003cp\u003eAfter closing 2025 with another victory, Listenupshance was promoted to the allowance and stakes ranks where he has thrived. In the Bing Crosby, he caught the front runner at the top of the stretch then held off a late charge by Maximum Bourbon to win by a nose. As part of the Win and You’re In Challenge Series, the race’s prize includes a fees-paid entry into the Cygames Breeders’ Cup Sprint (G1). \u0026nbsp;\r\u003c/p\u003e\u003cp\u003eListenupshance got the best of Maximum Bourbon again on Sept. 27 when they hooked up in the 6-furlong Santa Anita Sprint Championship (G2). Listenupshance took the lead shortly after the start and remained there the rest of the way to post a three-quarters of a length victory over Maximum Bourbon.\u0026nbsp;\u003c/p\u003e","gradedStakesPoints":19,"regionWinnerBadges":[],"breederName":"Al and Michelle Crawford Racing","uid":"blt36f6b80eee014a70","hasAutogeneratedPage":true,"url":"/redirect/horse/blt36f6b80eee014a70?ht=pre-entries","pageTitle":"Listenupshance","jockeyName":"","ownerName":"Run Fast Racing (Adam Kluger) \u0026 Great Friends Stable (Scott Kaplan \u0026 Craig Dado)","trainer":"Doug F. O'Neill","country":{"uid":"blt1af49e3a6a89373f","title":"USA","abbreviation":"USA","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt9de45bbdff160673/60d219911e0505677a882fa1/USAFlag.png"}},"horseName":"Listenupshance","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt3ac0598b68dd7394/6a95c58227a5310a90dc8a9e/Contender_Photo_Listenupshance.jpg"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt3ac0598b68dd7394/6a95c58227a5310a90dc8a9e/Contender_Photo_Listenupshance.jpg"},"cta":null,"races":[{"uid":"bltf6749e738cff0ef2","ContentTypeUid":"collection_race","challengeSeriesWinner":false,"isEligible":false,"eligibleRank":null,"finishPosition":null,"classicRanking":null,"postPosition":"","scratched":false,"win":"","place":"","show":"","deadHeat":false,"silks":null}],"isChallengeSeriesWinner":true,"silks":null,"isHoC":false,"year":2026,"isHistoricalEntry":false,"relatedArticles":[],"win":"","show":"","place":""},{"sireName":"Lord Kanaloa (JPN)","damName":"Eau Super (JPN)","sex":"Horse","color":"Bay","foalingDate":"April, 27 2020 00:00:00","age":6,"pastPerformances":[{"trackName":"URAWA","raceName":"Sakitama Hai","grade":" ","raceDate":"June, 24 2026 00:00:00","purseUsa":841689,"positionAtFinish":1},{"trackName":"FUNABASHI","raceName":"Kashiwa Kinen","grade":" ","raceDate":"May, 05 2026 00:00:00","purseUsa":864840,"positionAtFinish":3},{"trackName":"KOCHI","raceName":"Kurofune Sho","grade":" ","raceDate":"March, 24 2026 00:00:00","purseUsa":340842,"positionAtFinish":4},{"trackName":"TOKYO","raceName":"Negishi S.","grade":"3","raceDate":"February, 01 2026 00:00:00","purseUsa":491281,"positionAtFinish":1},{"trackName":"TOKYO","raceName":"Musashino S.","grade":"3","raceDate":"November, 15 2025 00:00:00","purseUsa":491775,"positionAtFinish":5},{"trackName":"TOKYO","raceName":"Green Channel Cup","grade":" ","raceDate":"October, 04 2025 00:00:00","purseUsa":309184,"positionAtFinish":4},{"trackName":"FUNABASHI","raceName":"Kashiwa Kinen","grade":" ","raceDate":"May, 05 2025 00:00:00","purseUsa":939851,"positionAtFinish":4},{"trackName":"NAGOYA","raceName":"Kakitsubata Kinen","grade":" ","raceDate":"February, 24 2025 00:00:00","purseUsa":361761,"positionAtFinish":1},{"trackName":"TOKYO","raceName":"Negishi S.","grade":"3","raceDate":"February, 02 2025 00:00:00","purseUsa":489758,"positionAtFinish":2},{"trackName":"TOKYO","raceName":"Shimotsuki S.","grade":" ","raceDate":"November, 17 2024 00:00:00","purseUsa":270810,"positionAtFinish":1},{"trackName":"TOKYO","raceName":"TV Shizuoka Sho","grade":" ","raceDate":"October, 13 2024 00:00:00","purseUsa":217857,"positionAtFinish":1},{"trackName":"TOKYO","raceName":"BS Eleven Sho","grade":" ","raceDate":"May, 12 2024 00:00:00","purseUsa":224962,"positionAtFinish":6},{"trackName":"TOKYO","raceName":"Kamakura S.","grade":" ","raceDate":"April, 21 2024 00:00:00","purseUsa":226613,"positionAtFinish":2},{"trackName":"CHUKYO","raceName":"Suzuka Tokubetsu","grade":" ","raceDate":"March, 24 2024 00:00:00","purseUsa":194475,"positionAtFinish":1},{"trackName":"TOKYO","raceName":" ","grade":" ","raceDate":"January, 28 2024 00:00:00","purseUsa":146708,"positionAtFinish":3},{"trackName":"CHUKYO","raceName":"Narumi Tokubetsu","grade":" ","raceDate":"December, 03 2023 00:00:00","purseUsa":200620,"positionAtFinish":3},{"trackName":"CHUKYO","raceName":"India Trophy","grade":" ","raceDate":"July, 08 2023 00:00:00","purseUsa":207211,"positionAtFinish":7},{"trackName":"TOKYO","raceName":" ","grade":" ","raceDate":"April, 23 2023 00:00:00","purseUsa":110939,"positionAtFinish":1},{"trackName":"CHUKYO","raceName":" ","grade":" ","raceDate":"January, 21 2023 00:00:00","purseUsa":114843,"positionAtFinish":3},{"trackName":"CHUKYO","raceName":"Kantsubaki Sho","grade":" ","raceDate":"December, 18 2022 00:00:00","purseUsa":142829,"positionAtFinish":2},{"trackName":"CHUKYO","raceName":" ","grade":" ","raceDate":"September, 24 2022 00:00:00","purseUsa":69055,"positionAtFinish":1},{"trackName":"CHUKYO","raceName":" ","grade":" ","raceDate":"September, 10 2022 00:00:00","purseUsa":93987,"positionAtFinish":8}],"record":{"previousYear":{"starts":5,"earnings":410693,"show":0,"win":1,"place":1,"showP":"0","winP":"20","placeP":"20"},"breedersCup":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"currentYear":{"starts":4,"earnings":887539,"show":1,"win":2,"place":0,"showP":"25","winP":"50","placeP":"0"},"lifetime":{"starts":22,"earnings":1894625,"show":4,"win":8,"place":3,"showP":"18","winP":"36","placeP":"14"}},"yearlySummary":[{"showsP":"25","winsP":"50","placesP":"0","starts":4,"earnings":887539,"racingYear":2026,"shows":1,"wins":2,"places":0},{"showsP":"0","winsP":"20","placesP":"20","starts":5,"earnings":410693,"racingYear":2025,"shows":0,"wins":1,"places":1}],"morningLineOdds":[],"bio":"\u003cp\u003eLord Fons (JPN) joins an expanding roster of Japan-based horses that venture to the premiere races in the U.S. The trend is inspired in part by the overwhelming success of 2025 Longines Breeders’ Cup Classic (G1) winner Forever Young (JPN), who was third in the 2024 Kentucky Derby (G1). Two other competitors from Japan won Breeders’ Cup World Championship races in 2021– Marche Lorraine (JPN) (Longines Distaff) and Loves Only You (JPN) (Maker’s Mark Filly and Mare Turf).\u0026nbsp;\u0026nbsp;\u003c/p\u003e\u003cp\u003eRacing exclusively in his homeland, Lord Fons proved his ability in top-shelf competition when he won the 7-furlong Negishi Stakes (G3) in February. He was a\u0026nbsp;game second\u0026nbsp;in the race last year while racing on the outside and being impeded by a riderless runner. At the same distance, he held off the late challengers to capture the\u0026nbsp;Sakitama\u0026nbsp;Hai on June 24.\u0026nbsp;\u003c/p\u003e\u003cp\u003eAlthough winless at the Dirt Mile distance, Lord Fons showed his aptitude for it with a gallant third-place effort in the Kashiwa Kinen in May.\u0026nbsp;\u003c/p\u003e\u003cp\u003eTrainer Shogo Yasuda was the assistant trainer and exercise rider for Lord Fons’ sire Lord Kanaloa (JPN). He told global horse racing news network Idol Horse that Lord Fons is better suited for the Dirt Mile rather than a sprint because it is a two-turn race.\u0026nbsp;\u0026nbsp;\u003c/p\u003e","gradedStakesPoints":0,"regionWinnerBadges":[],"breederName":"K.I. Farm","uid":"blt9eecfb66bd7d0b3b","hasAutogeneratedPage":true,"url":"/redirect/horse/blt9eecfb66bd7d0b3b?ht=pre-entries","pageTitle":"Lord Fons (JPN)","jockeyName":"","ownerName":"Lord Horse Club Co. Ltd. (Tomoyuki Nakamura)","trainer":"Shogo Yasuda","country":{"uid":"bltddddd2aba803f27e","title":"Japan","abbreviation":"JPN","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blta6f52e264bde8855/61aa4c7d55cf14733fc5bc35/japan.png","alt":""}},"horseName":"Lord Fons","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt43920d8e01ab5222/6a7c734fafd7db1f5652a6e4/Contender_Photo_Lord_Fons.jpg"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt43920d8e01ab5222/6a7c734fafd7db1f5652a6e4/Contender_Photo_Lord_Fons.jpg"},"cta":null,"races":[{"uid":"bltf6749e738cff0ef2","ContentTypeUid":"collection_race","challengeSeriesWinner":false,"isEligible":false,"eligibleRank":null,"finishPosition":null,"classicRanking":null,"postPosition":"","scratched":false,"win":"","place":"","show":"","deadHeat":false,"silks":null}],"isChallengeSeriesWinner":false,"silks":null,"isHoC":false,"year":2026,"isHistoricalEntry":false,"relatedArticles":[],"win":"","show":"","place":""},{"sireName":"Audible","damName":"Sundown","sex":"Horse","color":"Gray or Roan","foalingDate":"March, 12 2021 00:00:00","age":5,"pastPerformances":[{"trackName":"FAIR GROUNDS","raceName":" ","grade":" ","raceDate":"February, 15 2025 00:00:00","purseUsa":55000,"positionAtFinish":3},{"trackName":"FAIR GROUNDS","raceName":" ","grade":" ","raceDate":"January, 04 2025 00:00:00","purseUsa":59000,"positionAtFinish":4},{"trackName":"CHURCHILL DOWNS","raceN