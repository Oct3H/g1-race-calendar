},"displayPostTime":true,"isCompleted":false,"isLive":false,"purse":"$2,000,000","distance":"1 1/8 Miles","grade":1,"ageV2":"3+","division":"Longines Distaff","exacta":"","trifecta":"","superfecta":"","superHighFive":"","dailyDouble":"","pick3":"","pick4":"","pick5":"","pick6":"","region":""},"isTvScheduled":true,"broadcast":{"partners":[{"logo":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/bltf79bd4e964d5f80e/68d41e0fc07c892e73863c80/NBC_Logo_2025.svg"},"time":""},{"logo":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt29c35e9a30ccbba3/68d1ca298c48984dc7622c30/22-BC-162_New-BCcom_Network-Logo-SVGs_146x60-v1-05-Peacock.svg"},"time":""}]},"trackDetails":[{"uid":"bltc1d1c6b40525bf04","details":{"name":"Keeneland","logo":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt276fb8147db83742/629e62383d4e745ed3ae5859/keeneland.png"},"image":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/bltb0b7768e84d44449/614ce97164c8007a9bdec19c/Keeneland_Track_Image.jpeg"},"locationBcbc":"Keeneland","timeZone":-4}}],"raceDescription":"\u003ch1\u003eThe world's most accomplished fillies and mares.\u003cbr /\u003e\u003c/h1\u003e\u003cp\u003eThe Longines Breeders’ Cup Distaff brings together the best female dirt horses for a championship showdown at 1 1/8 miles on the main track. The race is open to three-year old and older females, who compete for a purse of $2 million. The great Zenyatta won the 2008 Breeders’ Cup Distaff before going on to win the Breeders' Cup Classic in 2009.\u003c/p\u003e","surface":"","bettingCtaOverride":{"cta":[]},"horseType":"pre-entries","horses":[{"sireName":"Tiz the Law","damName":"Speedy Vanessa","sex":"Filly","color":"Bay","foalingDate":"February, 23 2022 00:00:00","age":4,"pastPerformances":[{"trackName":"DEL MAR","raceName":"Clement L. Hirsch S. Presented by Oak Tree Racing Association","grade":"1","raceDate":"August, 01 2026 00:00:00","purseUsa":400000,"positionAtFinish":1},{"trackName":"BELMONT AT THE BIG A","raceName":"Ruffian S.","grade":"2","raceDate":"May, 09 2026 00:00:00","purseUsa":200000,"positionAtFinish":6},{"trackName":"KEENELAND","raceName":"Baird Doubledogdare S.","grade":"2","raceDate":"April, 17 2026 00:00:00","purseUsa":400000,"positionAtFinish":2},{"trackName":"COLONIAL DOWNS","raceName":"Fasig-Tipton Sandy Bottom S.","grade":" ","raceDate":"March, 14 2026 00:00:00","purseUsa":100000,"positionAtFinish":1},{"trackName":"GULFSTREAM PARK","raceName":"Royal Delta S.","grade":"3","raceDate":"February, 14 2026 00:00:00","purseUsa":175000,"positionAtFinish":3},{"trackName":"TAMPA BAY DOWNS","raceName":" ","grade":" ","raceDate":"December, 13 2025 00:00:00","purseUsa":56500,"positionAtFinish":1},{"trackName":"KEENELAND","raceName":" ","grade":" ","raceDate":"October, 18 2025 00:00:00","purseUsa":120000,"positionAtFinish":1},{"trackName":"KEENELAND","raceName":" ","grade":" ","raceDate":"October, 03 2025 00:00:00","purseUsa":120000,"positionAtFinish":4},{"trackName":"MONMOUTH PARK","raceName":" ","grade":" ","raceDate":"July, 19 2025 00:00:00","purseUsa":50300,"positionAtFinish":4},{"trackName":"CHURCHILL DOWNS","raceName":" ","grade":" ","raceDate":"June, 19 2025 00:00:00","purseUsa":127000,"positionAtFinish":9},{"trackName":"CHURCHILL DOWNS","raceName":" ","grade":" ","raceDate":"May, 17 2025 00:00:00","purseUsa":127000,"positionAtFinish":6},{"trackName":"KEENELAND","raceName":" ","grade":" ","raceDate":"April, 12 2025 00:00:00","purseUsa":120000,"positionAtFinish":6},{"trackName":"CHURCHILL DOWNS","raceName":" ","grade":" ","raceDate":"November, 15 2024 00:00:00","purseUsa":127000,"positionAtFinish":6},{"trackName":"KEENELAND","raceName":" ","grade":" ","raceDate":"October, 10 2024 00:00:00","purseUsa":100000,"positionAtFinish":1},{"trackName":"CHURCHILL DOWNS","raceName":" ","grade":" ","raceDate":"September, 13 2024 00:00:00","purseUsa":120000,"positionAtFinish":5},{"trackName":"ELLIS PARK","raceName":" ","grade":" ","raceDate":"August, 03 2024 00:00:00","purseUsa":71000,"positionAtFinish":3}],"record":{"previousYear":{"starts":7,"earnings":102063,"show":0,"win":2,"place":0,"showP":"0","winP":"29","placeP":"0"},"breedersCup":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"currentYear":{"starts":5,"earnings":394700,"show":1,"win":2,"place":1,"showP":"20","winP":"40","placeP":"20"},"lifetime":{"starts":16,"earnings":566193,"show":2,"win":5,"place":1,"showP":"13","winP":"31","placeP":"6"}},"yearlySummary":[{"showsP":"20","winsP":"40","placesP":"20","starts":5,"earnings":394700,"racingYear":2026,"shows":1,"wins":2,"places":1},{"showsP":"0","winsP":"29","placesP":"0","starts":7,"earnings":102063,"racingYear":2025,"shows":0,"wins":2,"places":0}],"morningLineOdds":[],"bio":"\u003cp\u003eEunomia, who has displayed an affinity for the Keeneland main track throughout her career, could take to that track again for the Longines Breeders’ Cup Distaff (G1) off her career-best effort. \u0026nbsp;\r\u003c/p\u003e\u003cp\u003eEunomia, a 4-year-old daughter of Tiz the Law, won her maiden in 2024 at Keeneland, and was an allowance winner in Lexington in 2025. She was privately purchased late last year, and currently races for St. Elias Stables and WSS Racing, with Saffie Joseph Jr. training. For her new connections, she stepped into graded stakes company this year, finishing third in the Royal Delta Stakes (G3) in February at Gulfstream Park. She then won the listed Sandy Bottom Stakes at Colonial Downs. \r\u003c/p\u003e\u003cp\u003eEunomia showed her liking for Keeneland again, finishing second in the Doubledogdare Stakes (G2) at the 2026 spring meet, missing by just a neck as the favorite. She was then sixth in the Ruffian Stakes (G2) in New York, after stumbling at the start. \u0026nbsp;\r\u003c/p\u003e\u003cp\u003eGiven a freshening, Eunomia resurfaced about three months later, in the Clement L. Hirsch Stakes (G1) on Aug. 1 at Del Mar, a Breeders’ Cup Challenge Series race. The filly earned a berth in the Distaff by dueling and then holding on for a game half-length win. Now she heads back to Keeneland, with similar spacing between races.\u0026nbsp;\u003c/p\u003e","gradedStakesPoints":15,"regionWinnerBadges":[],"breederName":"Breed First LLC","uid":"bltb1253bfe9394b476","hasAutogeneratedPage":true,"url":"/redirect/horse/bltb1253bfe9394b476?ht=pre-entries","pageTitle":"Eunomia","jockeyName":"","ownerName":"St. Elias Stables (Vincent Viola), , WSS Racing, LLC (William S.Simon), Turf Express Racing, Inc. (Mark Cornett) \u0026 Miller Racing, LLC (Myron Miller)","trainer":"Saffie Joseph Jr.","country":{"uid":"blt1af49e3a6a89373f","title":"USA","abbreviation":"USA","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt9de45bbdff160673/60d219911e0505677a882fa1/USAFlag.png"}},"horseName":"Eunomia","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt4e8e8f5502c809ff/6ac7f9c8d1edc63260573e30/Contender_Photo_Eunomia.png"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt4e8e8f5502c809ff/6ac7f9c8d1edc63260573e30/Contender_Photo_Eunomia.png"},"cta":null,"races":[{"uid":"blt4416a4da2e82f3d3","ContentTypeUid":"collection_race","challengeSeriesWinner":false,"isEligible":false,"eligibleRank":null,"finishPosition":null,"classicRanking":null,"postPosition":"","scratched":false,"win":"","place":"","show":"","deadHeat":false,"silks":null}],"isChallengeSeriesWinner":true,"silks":null,"isHoC":false,"year":2026,"isHistoricalEntry":false,"relatedArticles":[],"win":"","show":"","place":""},{"sireName":"Tiz the Law","damName":"Sweetbaby","sex":"Filly","color":"Chestnut","foalingDate":"March, 20 2022 00:00:00","age":4,"pastPerformances":[{"trackName":"KEENELAND","raceName":"Juddmonte Spinster S.","grade":"1","raceDate":"October, 04 2026 00:00:00","purseUsa":650000,"positionAtFinish":1},{"trackName":"SARATOGA","raceName":"Personal Ensign S.","grade":"1","raceDate":"August, 29 2026 00:00:00","purseUsa":500000,"positionAtFinish":1},{"trackName":"SARATOGA","raceName":"Shuvee S.","grade":"2","raceDate":"July, 24 2026 00:00:00","purseUsa":250000,"positionAtFinish":1},{"trackName":"SARATOGA","raceName":"Ogden Phipps S. Presented by Ford","grade":"1","raceDate":"June, 05 2026 00:00:00","purseUsa":500000,"positionAtFinish":2},{"trackName":"CHURCHILL DOWNS","raceName":"Fasig-Tipton La Troienne S.","grade":"1","raceDate":"May, 01 2026 00:00:00","purseUsa":1000000,"positionAtFinish":2},{"trackName":"AQUEDUCT","raceName":"Comely S.","grade":"3","raceDate":"December, 07 2025 00:00:00","purseUsa":200000,"positionAtFinish":1},{"trackName":"AQUEDUCT","raceName":"Mother Goose S.","grade":"2","raceDate":"November, 08 2025 00:00:00","purseUsa":300000,"positionAtFinish":1},{"trackName":"BELMONT AT THE BIG A","raceName":" ","grade":" ","raceDate":"September, 28 2025 00:00:00","purseUsa":88000,"positionAtFinish":2},{"trackName":"SARATOGA","raceName":" ","grade":" ","raceDate":"September, 01 2025 00:00:00","purseUsa":110000,"positionAtFinish":3},{"trackName":"BELMONT AT THE BIG A","raceName":" ","grade":" ","raceDate":"October, 13 2024 00:00:00","purseUsa":90000,"positionAtFinish":1}],"record":{"previousYear":{"starts":4,"earnings":305800,"show":1,"win":2,"place":1,"showP":"25","winP":"50","placeP":"25"},"breedersCup":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"currentYear":{"starts":5,"earnings":1086500,"show":0,"win":3,"place":2,"showP":"0","winP":"60","placeP":"40"},"lifetime":{"starts":10,"earnings":1441800,"show":1,"win":6,"place":3,"showP":"10","winP":"60","placeP":"30"}},"yearlySummary":[{"showsP":"0","winsP":"60","placesP":"40","starts":5,"earnings":1086500,"racingYear":2026,"shows":0,"wins":3,"places":2},{"showsP":"25","winsP":"50","placesP":"25","starts":4,"earnings":305800,"racingYear":2025,"shows":1,"wins":2,"places":1}],"morningLineOdds":[],"bio":"\u003cp\u003eFully Subscribed’s greatest strength has always been her consistency. Following a victory in the Oct. 4 Spinster (G1) at Keeneland , the filly sports a 10-6-3-1 lifetime record. After knocking at the door, she broke through with her first top-level victory in the Personal Ensign Stakes (G1), becoming racing’s newest millionaire and earning an automatic berth into the Longines Breeders’ Cup Distaff (G1). \r\u003c/p\u003e\u003cp\u003eFully Subscribed, by Tiz the Law, was bred by Payson Stud in Kentucky. She was a $300,000 2-year-old purchase by Klaravich Stables, a longtime client of trainer Chad Brown. She won her only start at age 2, but did not come to hand until late in her 3-year-old year, winning the Mother Goose Stakes (G2) and Comely Stakes (G3), both at Aqueduct. \r\u003c/p\u003e\u003cp\u003eShe opened 2026 with a length runner-up effort to Shred the Gnar in a big field of 10 for the La Troienne Stakes (G1) at Churchill Downs before heading to Saratoga. She was second in the Ogden Phipps Stakes (G1), well behind Eclipse Award champion Nitrogen but well clear of the rest. She then won the Shuvee Stakes (G2) by a half-length over Grade 1 winner Scottish Lassie. \u0026nbsp;\r\u003c/p\u003e\u003cp\u003eIn the Personal Ensign on Aug. 29, Fully Subscribed again faced Scottish Lassie in a field of six, and this time dominated by 9 ¾ lengths, earning her biggest win to date. She followed that up in the 1 1/8-mile Spinster by taking command on the far turn and cruising to a 3 1/4-length victory over Counting Stars.\r\u003c/p\u003e","gradedStakesPoints":38,"regionWinnerBadges":[],"breederName":"Payson Stud Inc","uid":"bltd85e5c7986250395","hasAutogeneratedPage":true,"url":"/redirect/horse/bltd85e5c7986250395?ht=pre-entries","pageTitle":"Fully Subscribed","jockeyName":"","ownerName":"Klaravich Stables, Inc. (Seth Klarman)","trainer":"Chad C. Brown","country":{"uid":"blt1af49e3a6a89373f","title":"USA","abbreviation":"USA","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt9de45bbdff160673/60d219911e0505677a882fa1/USAFlag.png"}},"horseName":"Fully Subscribed","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt8914761590799639/6ac2d0f40491eb006a048049/contender_photo_-_fully_subscribed_-_new.jpg"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt8914761590799639/6ac2d0f40491eb006a048049/contender_photo_-_fully_subscribed_-_new.jpg"},"cta":null,"races":[{"uid":"blt4416a4da2e82f3d3","ContentTypeUid":"collection_race","challengeSeriesWinner":false,"isEligible":false,"eligibleRank":null,"finishPosition":null,"classicRanking":null,"postPosition":"","scratched":false,"win":"","place":"","show":"","deadHeat":false,"silks":null}],"isChallengeSeriesWinner":true,"silks":null,"isHoC":false,"year":2026,"isHistoricalEntry":false,"relatedArticles":[],"win":"","show":"","place":""},{"sireName":"Nyquist","damName":"Gap Year","sex":"Filly","color":"Bay","foalingDate":"March, 05 2022 00:00:00","age":4,"pastPerformances":[{"trackName":"KEENELAND","raceName":"Juddmonte Spinster S.","grade":"1","raceDate":"October, 04 2026 00:00:00","purseUsa":650000,"positionAtFinish":3},{"trackName":"CHURCHILL DOWNS","raceName":"Fasig-Tipton Locust Grove S.","grade":"2","raceDate":"September, 12 2026 00:00:00","purseUsa":400000,"positionAtFinish":3},{"trackName":"CHURCHILL DOWNS","raceName":"Fasig-Tipton Fleur de Lis S.","grade":"2","raceDate":"June, 27 2026 00:00:00","purseUsa":500000,"positionAtFinish":1},{"trackName":"CHURCHILL DOWNS","raceName":"Shawnee S.","grade":"2","raceDate":"May, 30 2026 00:00:00","purseUsa":300000,"positionAtFinish":2},{"trackName":"AQUEDUCT","raceName":"Distaff S.","grade":"3","raceDate":"April, 04 2026 00:00:00","purseUsa":150000,"positionAtFinish":2},{"trackName":"CHURCHILL DOWNS","raceName":"Seneca Overnight S.","grade":" ","raceDate":"September, 20 2025 00:00:00","purseUsa":175000,"positionAtFinish":1},{"trackName":"SARATOGA","raceName":"Coaching Club American Oaks Invitational S.","grade":"1","raceDate":"July, 19 2025 00:00:00","purseUsa":500000,"positionAtFinish":2},{"trackName":"CHURCHILL DOWNS","raceName":"Monomoy Girl Overnight S.","grade":" ","raceDate":"June, 14 2025 00:00:00","purseUsa":175000,"positionAtFinish":2},{"trackName":"DEL MAR","raceName":"NetJets Breeders' Cup Juvenile Fillies","grade":"1","raceDate":"November, 01 2024 00:00:00","purseUsa":2000000,"positionAtFinish":1},{"trackName":"KEENELAND","raceName":"Darley Alcibiades S.","grade":"1","raceDate":"October, 04 2024 00:00:00","purseUsa":600000,"positionAtFinish":1},{"trackName":"SARATOGA","raceName":"Spinaway S.","grade":"1","raceDate":"August, 31 2024 00:00:00","purseUsa":300000,"positionAtFinish":1},{"trackName":"SARATOGA","raceName":" ","grade":" ","raceDate":"July, 21 2024 00:00:00","purseUsa":100000,"positionAtFinish":1}],"record":{"previousYear":{"starts":3,"earnings":242200,"show":0,"win":1,"place":2,"showP":"0","winP":"33","placeP":"67"},"breedersCup":{"starts":1,"earnings":1040000,"show":0,"win":1,"place":0,"showP":"0","winP":"100","placeP":"0"},"currentYear":{"starts":5,"earnings":502500,"show":2,"win":1,"place":2,"showP":"40","winP":"20","placeP":"40"},"lifetime":{"starts":12,"earnings":2367400,"show":2,"win":6,"place":4,"showP":"17","winP":"50","placeP":"33"}},"yearlySummary":[{"showsP":"40","winsP":"20","placesP":"40","starts":5,"earnings":502500,"racingYear":2026,"shows":2,"wins":1,"places":2},{"showsP":"0","winsP":"33","placesP":"67","starts":3,"earnings":242200,"racingYear":2025,"shows":0,"wins":1,"places":2}],"morningLineOdds":[],"bio":"\u003cp\u003eTwo years from her career best, Immersive has retained solid form, and, with an automatic berth in the Longines Breeders’ Cup Distaff (G1) secured, she can look to add her name to an elite list. \r\u003c/p\u003e\u003cp\u003eImmersive, Godolphin's homebred trained by Brad Cox, was undefeated as a 2-year-old in 2024, with three Grade 1 wins capped by the NetJets Breeders’ Cup Juvenile Fillies (G1) at Del Mar. She was overwhelmingly voted the divisional Eclipse Award champion. \r\u003c/p\u003e\u003cp\u003eBone bruising took Immersive off the Kentucky Oaks (G1) trail, and she won just once from her next five starts. Although she was never worse than second, some of the runner-up efforts were puzzling when she towered over fields on paper. \r\u003c/p\u003e\u003cp\u003eOne of those runner-up results came in her second start of 2026 in the Shawnee (G2) at Churchill Downs to Splendora. Immersive was back to her best form in the Breeders’ Cup Challenge Series Fleur de Lis Stakes (G2). She battled her way around the Churchill Downs oval with Grade 1 winner Shred the Gnar, fighting back gamely when that talented filly put a head in front, and then holding off a late charge from Regaled for a three-quarter-length victory. \r\u003c/p\u003e\u003cp\u003eShe ran into Splendora again in her next start, the Locust Grove (G2) at Churchill Downs on Sept. 12. She tracked that rival in the 1 1/16-mile race but tired in the stretch to finish third of four beaten 8 1/2 lengths by Splendora.\r\u003c/p\u003e\u003cp\u003eStarting next in the 1 1/8-mile Spinster (G1) at Keeneland on Oct. 4, Immersive set the pace in the race that was reduced to three starters. She was overtaken on the far turn by Fully Subscribed and wound up third beaten 9 1/4 lengths.\r\u003c/p\u003e\u003cp\u003eIf Immersive wins the Distaff, she would become just the eighth horse to win two different races at the Breeders' Cup. She would join a group including Hall of Famers Zenyatta, who won the 2008 Distaff (then known as the Ladies’ Classic) and 2009 Classic; and Beholder, who won the 2012 Juvenile Fillies, then the Distaff in 2013 and 2016. \r\u003c/p\u003e","gradedStakesPoints":18,"regionWinnerBadges":[],"breederName":"Godolphin","uid":"blt6aa5d09b235bdac8","hasAutogeneratedPage":true,"url":"/redirect/horse/blt6aa5d09b235bdac8?ht=pre-entries","pageTitle":"Immersive","jockeyName":"","ownerName":"Godolphin, LLC (Mohammed Al Maktoum, et al.)","trainer":"Brad Cox","country":{"uid":"blt1af49e3a6a89373f","title":"USA","abbreviation":"USA","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt9de45bbdff160673/60d219911e0505677a882fa1/USAFlag.png"}},"horseName":"Immersive","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt0b14913ca7d01163/6a736d921f7b5a617a78e1b4/Contender_Photo_Immersive.jpg"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt0b14913ca7d01163/6a736d921f7b5a617a78e1b4/Contender_Photo_Immersive.jpg"},"cta":null,"races":[{"uid":"blt4416a4da2e82f3d3","ContentTypeUid":"collection_race","challengeSeriesWinner":true,"isEligible":false,"eligibleRank":null,"finishPosition":null,"classicRanking":null,"postPosition":"","scratched":false,"win":"","place":"","show":"","deadHeat":false,"silks":null}],"isChallengeSeriesWinner":true,"silks":null,"isHoC":false,"year":2026,"isHistoricalEntry":true,"relatedArticles":[],"win":"","show":"","place":""},{"sireName":"Essential Quality","damName":"Fateer","sex":"Filly","color":"Dark Bay or Brown","foalingDate":"March, 13 2023 00:00:00","age":3,"pastPerformances":[{"trackName":"PARX RACING","raceName":"Cotillion S.","grade":"1","raceDate":"September, 19 2026 00:00:00","purseUsa":1000000,"positionAtFinish":3},{"trackName":"SARATOGA","raceName":"Alabama S. Presented by Keeneland Sales","grade":"1","raceDate":"August, 22 2026 00:00:00","purseUsa":600000,"positionAtFinish":2},{"trackName":"SARATOGA","raceName":"Coaching Club American Oaks","grade":"1","raceDate":"July, 25 2026 00:00:00","purseUsa":500000,"positionAtFinish":3},{"trackName":"SARATOGA","raceName":" ","grade":" ","raceDate":"June, 04 2026 00:00:00","purseUsa":120000,"positionAtFinish":2},{"trackName":"CHURCHILL DOWNS","raceName":" ","grade":" ","raceDate":"May, 01 2026 00:00:00","purseUsa":127000,"positionAtFinish":6},{"trackName":"CHURCHILL DOWNS","raceName":" ","grade":" ","raceDate":"November, 06 2025 00:00:00","purseUsa":120000,"positionAtFinish":1},{"trackName":"KEENELAND","raceName":" ","grade":" ","raceDate":"October, 09 2025 00:00:00","purseUsa":110000,"positionAtFinish":2},{"trackName":"CHURCHILL DOWNS","raceName":" ","grade":" ","raceDate":"September, 11 2025 00:00:00","purseUsa":120000,"positionAtFinish":5}],"record":{"previousYear":{"starts":3,"earnings":94075,"show":0,"win":1,"place":1,"showP":"0","winP":"33","placeP":"33"},"breedersCup":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"currentYear":{"starts":5,"earnings":299541,"show":2,"win":0,"place":2,"showP":"40","winP":"0","placeP":"40"},"lifetime":{"starts":8,"earnings":393616,"show":2,"win":1,"place":3,"showP":"25","winP":"13","placeP":"38"}},"yearlySummary":[{"showsP":"40","winsP":"0","placesP":"40","starts":5,"earnings":299541,"racingYear":2026,"shows":2,"wins":0,"places":2},{"showsP":"0","winsP":"33","placesP":"33","starts":3,"earnings":94075,"racingYear":2025,"shows":0,"wins":1,"places":1}],"morningLineOdds":[],"bio":"\u003cp\u003eThis filly has only one win from eight starts to date, in a maiden last year. But don’t use that as the true measure of her ability. She has consistently measured up well against the best of her generation. \u0026nbsp;\r\u003c/p\u003e\u003cp\u003eMeasure, from the first crop of champion Essential Quality, is trained by Mark Casse for the partnership of Gary Barber, Bridlewood Farm and Eclipse Thoroughbred Partners. She showed good promise when finishing second against older allowance foes in June at Saratoga, closing from sixth in a field of seven. \u0026nbsp;\r\u003c/p\u003e\u003cp\u003eThat prompted her connections to take a shot in deeper waters. The filly finished third in the Coaching Club American Oaks (G1) behind multiple Grade 1 winner Counting Stars and Kentucky Oaks (G1) winner Always a Runner. Continuing in Saratoga’s divisional series, she closed from last in a field of six, despite a tepid pace, in the Alabama Stakes (G1), missing My Gun’s Loaded by a neck, with Counting Stars third. In the Cotillion Stakes (G1), Sept. 19 at Parx, the filly was third to Bodacious Bay and Always a Runner. \u0026nbsp;\r\u003c/p\u003e\u003cp\u003eMeasure is part of an embarrassment of riches for Casse in the Longines Breeders’ Cup Distaff (G1) division, who also trains champion Nitrogen, as well as Counting Stars.\u003c/p\u003e","gradedStakesPoints":14,"regionWinnerBadges":[],"breederName":"Town \u0026 Country Farms","uid":"bltd5cebd55d401d1dc","hasAutogeneratedPage":true,"url":"/redirect/horse/bltd5cebd55d401d1dc?ht=pre-entries","pageTitle":"Measure","jockeyName":"","ownerName":"Bridlewood Farm (John C. Malone), Gary Barber \u0026 Eclipse Thoroughbred Partners (Aron Wellman)","trainer":"Mark E. Casse","country":{"uid":"blt1af49e3a6a89373f","title":"USA","abbreviation":"USA","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt9de45bbdff160673/60d219911e0505677a882fa1/USAFlag.png"}},"horseName":"Measure","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt26e6f3a4f867a968/6abab24ae53f5f70d903df41/Contender_Photo_Measure.jpg"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt26e6f3a4f867a968/6abab24ae53f5f70d903df41/Contender_Photo_Measure.jpg"},"cta":null,"races":[{"uid":"blt4416a4da2e82f3d3","ContentTypeUid":"collection_race","challengeSeriesWinner":false,"isEligible":false,"eligibleRank":null,"finishPosition":null,"classicRanking":null,"postPosition":"","scratched":false,"win":"","place":"","show":"","deadHeat":false,"silks":null}],"isChallengeSeriesWinner":false,"silks":null,"isHoC":false,"year":2026,"isHistoricalEntry":false,"relatedArticles":[],"win":"","show":"","place":""},{"sireName":"Medaglia d'Oro","damName":"Tiffany Case","sex":"Filly","color":"Bay","foalingDate":"March, 06 2022 00:00:00","age":4,"pastPerformances":[{"trackName":"LAUREL PARK","raceName":" ","grade":" ","raceDate":"April, 06 2024 00:00:00","purseUsa":53345,"positionAtFinish":4},{"trackName":"LAUREL PARK","raceName":" ","grade":" ","raceDate":"March, 03 2024 00:00:00","purseUsa":38470,"positionAtFinish":5},{"trackName":"BELMONT PARK","raceName":"Beldame S.","grade":"2","raceDate":"September, 25 2026 00:00:00","purseUsa":250000,"positionAtFinish":1},{"trackName":"SARATOGA","raceName":"Whitney S.","grade":"1","raceDate":"August, 08 2026 00:00:00","purseUsa":1000000,"positionAtFinish":2},{"trackName":"SARATOGA","raceName":"Ogden Phipps S. Presented by Ford","grade":"1","raceDate":"June, 05 2026 00:00:00","purseUsa":500000,"positionAtFinish":1},{"trackName":"OAKLAWN PARK","raceName":"Apple Blossom H.","grade":"1","raceDate":"April, 11 2026 00:00:00","purseUsa":1250000,"positionAtFinish":2},{"trackName":"OAKLAWN PARK","raceName":"Azeri S.","grade":"2","raceDate":"March, 07 2026 00:00:00","purseUsa":400000,"positionAtFinish":3},{"trackName":"OAKLAWN PARK","raceName":"Bayakoa S.","grade":"3","raceDate":"February, 07 2026 00:00:00","purseUsa":250000,"positionAtFinish":1},{"trackName":"DEL MAR","raceName":"Longines Breeders' Cup Distaff","grade":"1","raceDate":"November, 01 2025 00:00:00","purseUsa":2000000,"positionAtFinish":2},{"trackName":"KEENELAND","raceName":"Juddmonte Spinster S.","grade":"1","raceDate":"October, 05 2025 00:00:00","purseUsa":650000,"positionAtFinish":2},{"trackName":"SARATOGA","raceName":"Alabama S. Presented by Keeneland Sales","grade":"1","raceDate":"August, 16 2025 00:00:00","purseUsa":600000,"positionAtFinish":1},{"trackName":"SARATOGA","raceName":"Belmont Oaks Invitational S.","grade":"1","raceDate":"July, 05 2025 00:00:00","purseUsa":500000,"positionAtFinish":2},{"trackName":"SARATOGA","raceName":"Wonder Again S.","grade":"3","raceDate":"June, 07 2025 00:00:00","purseUsa":300000,"positionAtFinish":1},{"trackName":"CHURCHILL DOWNS","raceName":"Edgewood S. presented by Accenture","grade":"2","raceDate":"May, 02 2025 00:00:00","purseUsa":600000,"positionAtFinish":1},{"trackName":"KEENELAND","raceName":"Appalachian S. Presented by Japan Racing Association","grade":"2","raceDate":"April, 08 2025 00:00:00","purseUsa":500000,"positionAtFinish":1},{"trackName":"TAMPA BAY DOWNS","raceName":"Florida Oaks","grade":"3","raceDate":"March, 08 2025 00:00:00","purseUsa":200000,"positionAtFinish":1},{"trackName":"GULFSTREAM PARK","raceName":"Ginger Brew S.","grade":" ","raceDate":"January, 04 2025 00:00:00","purseUsa":165000,"positionAtFinish":1},{"trackName":"DEL MAR","raceName":"John Deere Breeders' Cup Juvenile Fillies Turf","grade":"1","raceDate":"November, 01 2024 00:00:00","purseUsa":1000000,"positionAtFinish":3},{"trackName":"WOODBINE","raceName":"Johnnie Walker Natalma S.","grade":"1","raceDate":"September, 14 2024 00:00:00","purseUsa":500000,"positionAtFinish":3},{"trackName":"WOODBINE","raceName":" ","grade":" ","raceDate":"August, 30 2024 00:00:00","purseUsa":111300,"positionAtFinish":2}],"record":{"previousYear":{"starts":9,"earnings":1909400,"show":0,"win":6,"place":3,"showP":"0","winP":"67","placeP":"33"},"breedersCup":{"starts":2,"earnings":430000,"show":1,"win":0,"place":1,"showP":"50","winP":"0","placeP":"50"},"currentYear":{"starts":6,"earnings":1021750,"show":1,"win":3,"place":2,"showP":"17","winP":"50","placeP":"33"},"lifetime":{"starts":18,"earnings":3068354,"show":3,"win":9,"place":6,"showP":"17","winP":"50","placeP":"33"}},"yearlySummary":[{"showsP":"17","winsP":"50","placesP":"33","starts":6,"earnings":1021750,"racingYear":2026,"shows":1,"wins":3,"places":2},{"showsP":"0","winsP":"67","placesP":"33","starts":9,"earnings":1909400,"racingYear":2025,"shows":0,"wins":6,"places":3}],"morningLineOdds":[],"bio":"\u003cp\u003eNitrogen, the Eclipse Award champion 3-year-old filly of 2025, has continued to boldly campaign toward a potential third consecutive appearance at the Breeders’ Cup. \u0026nbsp;\r\u003c/p\u003e\u003cp\u003eNitrogen, D. J. Stable's homebred daughter of Medaglia d'Oro, never has missed the board in 17 career starts for Mark Casse while competing almost exclusively in stakes on dirt and turf. Well-regarded from the start, she finished third in the 2024 John Deere Breeders' Cup Juvenile Fillies Turf (G1) while still a maiden. She went on to win six stakes in her championship campaign last year – four on the turf but two on the dirt, including the historic Alabama Stakes (G1). She was second to the older Scylla in a full field of 12 in the Longines Breeders’ Cup Distaff (G1) at Del Mar. \u0026nbsp;\r\u003c/p\u003e\u003cp\u003eNitrogen has continued her consistency and her brilliance in 2026, highlighted by a 12 ¾-length victory in the Ogden Phipps Stakes (G1) at Saratoga, which earned her an automatic berth into this year’s Distaff. She missed the track record for 1 1/8 miles by 0.29 seconds, even though she was geared down late. \u0026nbsp;\r\u003c/p\u003e\u003cp\u003eNitrogen’s dominance prompted her connections to try the Whitney Stakes (G1) against top male runners. The filly stumbled at the start and recovered to set a quick pace while under pressure. She continued to dig in gamely through the stretch to be second, losing nothing in defeat to the reigning Horse of the Year Sovereignty. \u0026nbsp;\r\u003c/p\u003e\u003cp\u003eNitrogen received her final Distaff tuneup at Belmont Park on Sept. 25 in the 1 1/8-mile Beldame (G2). Facing four overmatched foes, Nitrogen went right to the front and never was threatened in posting a geared-down 2 3/4-length victory.\u003c/p\u003e","gradedStakesPoints":34,"regionWinnerBadges":[],"breederName":"D. J. Stable, LLC","uid":"blt5df42ce012253fe3","hasAutogeneratedPage":true,"url":"/redirect/horse/blt5df42ce012253fe3?ht=pre-entries","pageTitle":"Nitrogen","jockeyName":"","ownerName":"D.J. Stable LLC (Leonard C. Green)","trainer":"Mark E. Casse","country":{"uid":"blt1af49e3a6a89373f","title":"USA","abbreviation":"USA","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt9de45bbdff160673/60d219911e0505677a882fa1/USAFlag.png"}},"horseName":"Nitrogen","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blte2eb4677a138684c/68a71eee1f38a3f454e88249/Nitrogen_Contender_Photo_copy.jpg"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blte2eb4677a138684c/68a71eee1f38a3f454e88249/Nitrogen_Contender_Photo_copy.jpg"},"cta":null,"races":[{"uid":"blt4416a4da2e82f3d3","ContentTypeUid":"collection_race","challengeSeriesWinner":true,"isEligible":false,"eligibleRank":null,"finishPosition":null,"classicRanking":null,"postPosition":"","scratched":false,"win":"","place":"","show":"","deadHeat":false,"silks":null}],"isChallengeSeriesWinner":true,"silks":null,"isHoC":false,"year":2026,"isHistoricalEntry":true,"relatedArticles":[],"win":"","show":"","place":""},{"sireName":"Mohaymen","damName":"Ascot Walk","sex":"Mare","color":"Dark Bay or Brown","foalingDate":"April, 26 2021 00:00:00","age":5,"pastPerformances":[{"trackName":"LAUREL PARK","raceName":" ","grade":" ","raceDate":"April, 06 2024 00:00:00","purseUsa":53345,"positionAtFinish":4},{"trackName":"LAUREL PARK","raceName":" ","grade":" ","raceDate":"March, 03 2024 00:00:00","purseUsa":38470,"positionAtFinish":5},{"trackName":"BELMONT PARK","raceName":"Beldame S.","grade":"2","raceDate":"September, 25 2026 00:00:00","purseUsa":250000,"positionAtFinish":1},{"trackName":"SARATOGA","raceName":"Whitney S.","grade":"1","raceDate":"August, 08 2026 00:00:00","purseUsa":1000000,"positionAtFinish":2},{"trackName":"SARATOGA","raceName":"Ogden Phipps S. Presented by Ford","grade":"1","raceDate":"June, 05 2026 00:00:00","purseUsa":500000,"positionAtFinish":1},{"trackName":"OAKLAWN PARK","raceName":"Apple Blossom H.","grade":"1","raceDate":"April, 11 2026 00:00:00","purseUsa":1250000,"positionAtFinish":2},{"trackName":"OAKLAWN PARK","raceName":"Azeri S.","grade":"2","raceDate":"March, 07 2026 00:00:00","purseUsa":400000,"positionAtFinish":3},{"trackName":"OAKLAWN PARK","raceName":"Bayakoa S.","grade":"3","raceDate":"February, 07 2026 00:00:00","purseUsa":250000,"positionAtFinish":1},{"trackName":"DEL MAR","raceName":"Longines Breeders' Cup Distaff","grade":"1","raceDate":"November, 01 2025 00:00:00","purseUsa":2000000,"positionAtFinish":2},{"trackName":"KEENELAND","raceName":"Juddmonte Spinster S.","grade":"1","raceDate":"October, 05 2025 00:00:00","purseUsa":650000,"positionAtFinish":2},{"trackName":"SARATOGA","raceName":"Alabama S. Presented by Keeneland Sales","grade":"1","raceDate":"August, 16 2025 00:00:00","purseUsa":600000,"positionAtFinish":1},{"trackName":"SARATOGA","raceName":"Belmont Oaks Invitational S.","grade":"1","raceDate":"July, 05 2025 00:00:00","purseUsa":500000,"positionAtFinish":2},{"trackName":"SARATOGA","raceName":"Wonder Again S.","grade":"3","raceDate":"June, 07 2025 00:00:00","purseUsa":300000,"positionAtFinish":1},{"trackName":"CHURCHILL DOWNS","raceName":"Edgewood S. presented by Accenture","grade":"2","raceDate":"May, 02 2025 00:00:00","purseUsa":600000,"positionAtFinish":1},{"trackName":"KEENELAND","raceName":"Appalachian S. Presented by Japan Racing Association","grade":"2","raceDate":"April, 08 2025 00:00:00","purseUsa":500000,"positionAtFinish":1},{"trackName":"TAMPA BAY DOWNS","raceName":"Florida Oaks","grade":"3","raceDate":"March, 08 2025 00:00:00","purseUsa":200000,"positionAtFinish":1},{"trackName":"GULFSTREAM PARK","raceName":"Ginger Brew S.","grade":" ","raceDate":"January, 04 2025 00:00:00","purseUsa":165000,"positionAtFinish":1},{"trackName":"DEL MAR","raceName":"John Deere Breeders' Cup Juvenile Fillies Turf","grade":"1","raceDate":"November, 01 2024 00:00:00","purseUsa":1000000,"positionAtFinish":3},{"trackName":"WOODBINE","raceName":"Johnnie Walker Natalma S.","grade":"1","raceDate":"September, 14 2024 00:00:00","purseUsa":500000,"positionAtFinish":3}],"record":{"previousYear":{"starts":8,"earnings":583113,"show":3,"win":2,"place":2,"showP":"38","winP":"25","placeP":"25"},"breedersCup":{"starts":1,"earnings":180000,"show":1,"win":0,"place":0,"showP":"100","winP":"0","placeP":"0"},"currentYear":{"starts":5,"earnings":603500,"show":0,"win":1,"place":2,"showP":"0","winP":"20","placeP":"40"},"lifetime":{"starts":24,"earnings":1301823,"show":4,"win":5,"place":4,"showP":"17","winP":"21","placeP":"17"}},"yearlySummary":[{"showsP":"0","winsP":"20","placesP":"40","starts":5,"earnings":603500,"racingYear":2026,"shows":0,"wins":1,"places":2},{"showsP":"38","winsP":"25","placesP":"25","starts":8,"earnings":583113,"racingYear":2025,"shows":3,"wins":2,"places":2}],"morningLineOdds":[],"bio":"\u003cp\u003eA mare who was bred on a $7,500 stud fee, first sold at public auction for just $9,500, and made her first start in a $30,000 maiden claiming race, Regaled has risen from modest beginnings to topping the millionaire mark in earnings. \r\u003c/p\u003e\u003cp\u003eRegaled, was weanling purchase by Timber Creek Farm at the 2021 Keeneland November breeding stock sale. She turned a profit for that operation in her first race, as she was claimed for $30,000 out of a fifth-place finish in March 2024 at Laurel Park. Racing for Brittnee Caballero, she climbed into the stakes ranks, finishing third in the 2024 Delaware Oaks (G3), and the following spring, recording two stakes placings in Maryland. \r\u003c/p\u003e\u003cp\u003eThose efforts made her an attractive prospect, and she attracted $300,000 at the Inglis USA May digital sale, going to Ribble Farms and Front Page Equestrian and trainer Whit Beckman. \r\u003c/p\u003e\u003cp\u003eRegaled registered two stakes placings in Kentucky and a win in the Delaware Handicap (G3), earning a trip to Del Mar. She was third behind Scylla in the Longines Breeders’ Cup Distaff (G1). \r\u003c/p\u003e\u003cp\u003eThis season, Regaled faced champions in her first four starts. She encountered Nitrogen in her first three outings while finishing second in the Azeri Stakes (G2) – with Nitrogen third – fourth in the Apple Blossom Handicap (G1), and fourth in the Ogden Phipps Stakes (G1). Most recently, she was second to champion Immersive in the Fleur de Lis Stakes (G2). \u0026nbsp;\r\u003c/p\u003e\u003cp\u003eShe returned to Delaware Park for the Oct. 3 Delaware Handicap and once again caught an off track and once again prevailed by closing from far back to win by 3 lengths in the 1 1/8-mile race.\r\u003c/p\u003e","gradedStakesPoints":12,"regionWinnerBadges":[],"breederName":"Chris Baccari","uid":"blt20228828428d9c9c","hasAutogeneratedPage":true,"url":"/redirect/horse/blt20228828428d9c9c?ht=pre-entries","pageTitle":"Regaled","jockeyName":"","ownerName":"Ribble Farms LLC (Alan Ribble), Hoolie Racing Stable, LLC (Andrew Hudson) and Kamp Racing Stables LLC (Ryan and Larissa Kamp)","trainer":"D. Whitworth Beckman","country":{"uid":"blt1af49e3a6a89373f","title":"USA","abbreviation":"USA","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt9de45bbdff160673/60d219911e0505677a882fa1/USAFlag.png"}},"horseName":"Regaled","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt694a45a5d95bf77a/68ea88949975a5046f97b36b/Contender_Photo_Regaled.jpg"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt694a45a5d95bf77a/68ea88949975a5046f97b36b/Contender_Photo_Regaled.jpg"},"cta":null,"races":[{"uid":"blt4416a4da2e82f3d3","ContentTypeUid":"collection_race","challengeSeriesWinner":false,"isEligible":false,"eligibleRank":null,"finishPosition":null,"classicRanking":null,"postPosition":"","scratched":false,"win":"","place":"","show":"","deadHeat":false,"silks":null}],"isChallengeSeriesWinner":false,"silks":null,"isHoC":false,"year":2026,"isHistoricalEntry":false,"relatedArticles":[],"win":"","show":"","place":""},{"sireName":"McKinzie","damName":"Bodebabe","sex":"Filly","color":"Dark Bay or Brown","foalingDate":"February, 11 2022 00:00:00","age":4,"pastPerformances":[{"trackName":"SARATOGA","raceName":"Personal Ensign S.","grade":"1","raceDate":"August, 29 2026 00:00:00","purseUsa":500000,"positionAtFinish":2},{"trackName":"SARATOGA","raceName":"Shuvee S.","grade":"2","raceDate":"July, 24 2026 00:00:00","purseUsa":250000,"positionAtFinish":2},{"trackName":"SARATOGA","raceName":" ","grade":" ","raceDate":"June, 07 2026 00:00:00","purseUsa":125000,"positionAtFinish":1},{"trackName":"PARX RACING","raceName":"Cotillion S.","grade":"1","raceDate":"September, 20 2025 00:00:00","purseUsa":1000000,"positionAtFinish":4},{"trackName":"SARATOGA","raceName":"Coaching Club American Oaks Invitational S.","grade":"1","raceDate":"July, 19 2025 00:00:00","purseUsa":500000,"positionAtFinish":1},{"trackName":"SARATOGA","raceName":"DK Horse Acorn S.","grade":"1","raceDate":"June, 06 2025 00:00:00","purseUsa":500000,"positionAtFinish":3},{"trackName":"BELMONT AT THE BIG A","raceName":" ","grade":" ","raceDate":"May, 01 2025 00:00:00","purseUsa":88000,"positionAtFinish":3},{"trackName":"DEL MAR","raceName":"NetJets Breeders' Cup Juvenile Fillies","grade":"1","raceDate":"November, 01 2024 00:00:00","purseUsa":2000000,"positionAtFinish":4},{"trackName":"BELMONT AT THE BIG A","raceName":"Frizette S.","grade":"1","raceDate":"October, 05 2024 00:00:00","purseUsa":400000,"positionAtFinish":1},{"trackName":"SARATOGA","raceName":" ","grade":" ","raceDate":"September, 01 2024 00:00:00","purseUsa":100000,"positionAtFinish":3}],"record":{"previousYear":{"starts":4,"earnings":403760,"show":2,"win":1,"place":0,"showP":"50","winP":"25","placeP":"0"},"breedersCup":{"starts":1,"earnings":100000,"show":0,"win":0,"place":0,"showP":"0","winP":"0","placeP":"0"},"currentYear":{"starts":3,"earnings":218750,"show":0,"win":1,"place":2,"showP":"0","winP":"33","placeP":"67"},"lifetime":{"starts":10,"earnings":954510,"show":3,"win":3,"place":2,"showP":"30","winP":"30","placeP":"20"}},"yearlySummary":[{"showsP":"0","winsP":"33","placesP":"67","starts":3,"earnings":218750,"racingYear":2026,"shows":0,"wins":1,"places":2},{"showsP":"50","winsP":"25","placesP":"0","starts":4,"earnings":403760,"racingYear":2025,"shows":2,"wins":1,"places":0}],"morningLineOdds":[],"bio":"\u003cp\u003eA near-millionaire who rarely missed the board, consistency at a top level has been a hallmark of Scottish Lassie’s career, as she has worked through setbacks to be a Grade 1 performer in each of her three seasons of racing. \u0026nbsp;\r\u003c/p\u003e\u003cp\u003eScottish Lassie, by McKinzie, was the first Grade 1 winner for her trainer Jorge Abreu, who owns a share in her with Sportsmen Stable, Parkland Thoroughbreds, Photos Finish LLC and Corms Racing Stable. In 2024, she won the Frizette Stakes (G1) in her second career start, while still a maiden. She then finished fourth in the NetJets Breeders’ Cup Juvenile Fillies (G1) behind Immersive at Del Mar. \u0026nbsp;\r\u003c/p\u003e\u003cp\u003eAfter an elongated winter break, Scottish Lassie was third in the Acorn Stakes (G1) in her second outing off that layoff. She then dominated the Coaching Club American Oaks (G1) at Saratoga by 15 ½ lengths, with Immersive second. A fourth-place in the Cotillion Stakes (G1) ended Scottish Lassie’s season; she was entered in the Longines Breeders’ Cup Distaff (G1), but was scratched two days prior with a leg issue. \u0026nbsp;\r\u003c/p\u003e\u003cp\u003eScottish Lassie won an allowance-optional claiming race in her first start in more than eight months, then finished second, beaten half a length by Fully Subscribed, in the Shuvee Stakes (G2) and second to that foe again in the Personal Ensign Stakes (G1).\u0026nbsp;\u003c/p\u003e","gradedStakesPoints":10,"regionWinnerBadges":[],"breederName":"Winchester Farm","uid":"bltdd4a7f60ca992272","hasAutogeneratedPage":true,"url":"/redirect/horse/bltdd4a7f60ca992272?ht=pre-entries","pageTitle":"Scottish Lassie","jockeyName":"","ownerName":"Parkland Thoroughbreds (Steve Weston), Sportsmen Stable (Joe D'Agostino), Photos Finish LLC (Robert Photos), Corms Racing Stable (Lucas Stritsman) \u0026 Jorge R. Abreu","trainer":"Jorge R. Abreu","country":{"uid":"blt1af49e3a6a89373f","title":"USA","abbreviation":"USA","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt9de45bbdff160673/60d219911e0505677a882fa1/USAFlag.png"}},"horseName":"Scottish Lassie","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt3bdbef6f1470b437/6701d949f22a6f562a3ac630/Arcticle-LargeCard-Default_600x540-Scottish_Lassie.png"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt3bdbef6f1470b437/6701d949f22a6f562a3ac630/Arcticle-LargeCard-Default_600x540-Scottish_Lassie.png"},"cta":null,"races":[{"uid":"blt4416a4da2e82f3d3","ContentTypeUid":"collection_race","challengeSeriesWinner":false,"isEligible":false,"eligibleRank":null,"finishPosition":null,"classicRanking":null,"postPosition":"","scratched":false,"win":"","place":"","show":"","deadHeat":false,"silks":null}],"isChallengeSeriesWinner":false,"silks":null,"isHoC":false,"year":2026,"isHistoricalEntry":true,"relatedArticles":[],"win":"","show":"","place":""},{"sireName":"Audible","damName":"Miss Freeze","sex":"Mare","color":"Dark Bay or Brown","foalingDate":"January, 27 2021 00:00:00","age":5,"pastPerformances":[{"trackName":"CHURCHILL DOWNS","raceName":"Fasig-Tipton Locust Grove S.","grade":"2","raceDate":"September, 12 2026 00:00:00","purseUsa":400000,"positionAtFinish":1},{"trackName":"MONMOUTH PARK","raceName":"Molly Pitcher S.","grade":"2","raceDate":"July, 18 2026 00:00:00","purseUsa":500000,"positionAtFinish":1},{"trackName":"CHURCHILL DOWNS","raceName":"Shawnee S.","grade":"2","raceDate":"May, 30 2026 00:00:00","purseUsa":300000,"positionAtFinish":1},{"trackName":"CHURCHILL DOWNS","raceName":"Derby City Distaff S. presented by Ford","grade":"1","raceDate":"May, 02 2026 00:00:00","purseUsa":1000000,"positionAtFinish":4},{"trackName":"SANTA ANITA PARK","raceName":"B. Wayne Hughes Beholder Mile S. presented by FanDuel","grade":"1","raceDate":"March, 07 2026 00:00:00","purseUsa":300000,"positionAtFinish":1},{"trackName":"SANTA ANITA PARK","raceName":"D. Wayne Lukas S.","grade":"2","raceDate":"February, 07 2026 00:00:00","purseUsa":200000,"positionAtFinish":1},{"trackName":"DEL MAR","raceName":"PNC Bank Breeders' Cup Filly \u0026 Mare Sprint","grade":"1","raceDate":"November, 01 2025 00:00:00","purseUsa":1000000,"positionAtFinish":1},{"trackName":"DEL MAR","raceName":"Tranquility Lake S.","grade":" ","raceDate":"September, 01 2025 00:00:00","purseUsa":100000,"positionAtFinish":1},{"trackName":"DEL MAR","raceName":" ","grade":" ","raceDate":"July, 24 2025 00:00:00","purseUsa":84000,"positionAtFinish":1},{"trackName":"SANTA ANITA PARK","raceName":"Santa Margarita S.","grade":"2","raceDate":"May, 25 2025 00:00:00","purseUsa":200000,"positionAtFinish":2},{"trackName":"SANTA ANITA PARK","raceName":"Santa Maria S.","grade":"2","raceDate":"April, 19 2025 00:00:00","purseUsa":200000,"positionAtFinish":2},{"trackName":"SANTA ANITA PARK","raceName":"Santa Monica S.","grade":"2","raceDate":"February, 01 2025 00:00:00","purseUsa":200000,"positionAtFinish":4},{"trackName":"SANTA ANITA PARK","raceName":"La Brea S. presented by Don Julio","grade":"1","raceDate":"December, 26 2024 00:00:00","purseUsa":300000,"positionAtFinish":2},{"trackName":"DEL MAR","raceName":" ","grade":" ","raceDate":"November, 17 2024 00:00:00","purseUsa":55000,"positionAtFinish":1},{"trackName":"SANTA ANITA PARK","raceName":" ","grade":" ","raceDate":"October, 20 2024 00:00:00","purseUsa":54000,"positionAtFinish":1},{"trackName":"SANTA ANITA PARK","raceName":" ","grade":" ","raceDate":"December, 29 2023 00:00:00","purseUsa":65000,"positionAtFinish":2}],"record":{"previousYear":{"starts":6,"earnings":722400,"show":0,"win":3,"place":2,"showP":"0","winP":"50","placeP":"33"},"breedersCup":{"starts":1,"earnings":520000,"show":0,"win":1,"place":0,"showP":"0","winP":"100","placeP":"0"},"currentYear":{"starts":6,"earnings":982900,"show":0,"win":5,"place":0,"showP":"0","winP":"83","placeP":"0"},"lifetime":{"starts":16,"earnings":1843700,"show":0,"win":10,"place":4,"showP":"0","winP":"63","placeP":"25"}},"yearlySummary":[{"showsP":"0","winsP":"83","placesP":"0","starts":6,"earnings":982900,"racingYear":2026,"shows":0,"wins":5,"places":0},{"showsP":"0","winsP":"50","placesP":"33","starts":6,"earnings":722400,"racingYear":2025,"shows":0,"wins":3,"places":2}],"morningLineOdds":[],"bio":"\u003cp\u003eSplendora, winner of the PNC Bank Filly \u0026amp; Mare Sprint (G1) last fall at Del Mar, has developed into a legitimate two-turn threat eyeing this year’s Longines Breeders’ Cup Distaff (G1) at Keeneland. \u0026nbsp;\r\u003c/p\u003e\u003cp\u003eMaryland-bred Splendora was a powerful 4 ¾-length winner of the Filly \u0026amp; Mare Sprint for Hall of Famer Bob Baffert and has been near-perfect this year. Campaigned by By Talla Racing and a newer player in Boyd Racing, which bought in this winter, she won the D. Wayne Lukas Stakes (G2) at 7 furlongs and B. Wayne Hughes Beholder Mile (G1) before a blip when fourth in the Derby City Distaff (G1). \r\u003c/p\u003e\u003cp\u003eShe quickly rebounded with three wins at 1 1/6 miles – besting champion Immersive in the Shawnee Stakes (G2) at Churchill Downs, then romping by 5 ½ lengths in the Molly Pitcher Stakes (G2) at Monmouth Park before posting a wire-to-wire 5 1/4-length victory in the Sept. 12 Locust Grove (G2) at Churchill Downs. \r\u003c/p\u003e\u003cp\u003eIf Splendora wins the Distaff, she would become just the eighth horse to win two different races at the Breeders' Cup. She would join a group including Hall of Famers Zenyatta, who won the 2008 Distaff (then known as the Ladies Classic) and 2009 Classic; and Beholder, who won the 2012 Juvenile Fillies, then the Distaff in 2013 and 2016. \u0026nbsp;\u003c/p\u003e","gradedStakesPoints":34,"regionWinnerBadges":[],"breederName":"The Elkstone Group LLC","uid":"blt123292bc8d55e405","hasAutogeneratedPage":true,"url":"/redirect/horse/blt123292bc8d55e405?ht=pre-entries","pageTitle":"Splendora","jockeyName":"","ownerName":"Boyd Racing, LLC (Randy Boyd) \u0026 By Talla Racing, LLC, (David M. Talla)","trainer":"Bob Baffert","country":{"uid":"blt1af49e3a6a89373f","title":"USA","abbreviation":"USA","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt9de45bbdff160673/60d219911e0505677a882fa1/USAFlag.png"}},"horseName":"Splendora","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt19dc82730431bd95/6a7373c4a20f984c96dee4ee/Contender_Photo_Splendora.jpg"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt19dc82730431bd95/6a7373c4a20f984c96dee4ee/Contender_Photo_Splendora.jpg"},"cta":null,"races":[{"uid":"blt4416a4da2e82f3d3","ContentTypeUid":"collection_race","challengeSeriesWinner":false,"isEligible":false,"eligibleRank":null,"finishPosition":null,"classicRanking":null,"postPosition":"","scratched":false,"win":"","place":"","show":"","deadHeat":false,"silks":null}],"isChallengeSeriesWinner":false,"silks":null,"isHoC":false,"year":2026,"isHistoricalEntry":true,"relatedArticles":[],"win":"","show":"","place":""},{"sireName":"Gun Runner","damName":"Super Simple","sex":"Filly","color":"Bay","foalingDate":"April, 29 2023 00:00:00","age":3,"pastPerformances":[{"trackName":"SANTA ANITA PARK","raceName":"Zenyatta S. presented by FanDuel","grade":"2","raceDate":"September, 27 2026 00:00:00","purseUsa":200000,"positionAtFinish":1},{"trackName":"SANTA ANITA PARK","raceName":"Santa Ysabel S.","grade":"3","raceDate":"March, 08 2026 00:00:00","purseUsa":100000,"positionAtFinish":6},{"trackName":"SANTA ANITA PARK","raceName":"Las Virgenes S.","grade":" ","raceDate":"February, 08 2026 00:00:00","purseUsa":100000,"positionAtFinish":4},{"trackName":"DEL MAR","raceName":"NetJets Breeders' Cup Juvenile Fillies","grade":"1","raceDate":"October, 31 2025 00:00:00","purseUsa":2000000,"positionAtFinish":1},{"trackName":"SANTA ANITA PARK","raceName":" ","grade":" ","raceDate":"October, 11 2025 00:00:00","purseUsa":60000,"positionAtFinish":1},{"trackName":"DEL MAR","raceName":" ","grade":" ","raceDate":"August, 09 2025 00:00:00","purseUsa":100000,"positionAtFinish":2},{"trackName":"DEL MAR","raceName":" ","grade":" ","raceDate":"July, 19 2025 00:00:00","purseUsa":100000,"positionAtFinish":5}],"record":{"previousYear":{"starts":4,"earnings":1093600,"show":0,"win":2,"place":1,"showP":"0","winP":"50","placeP":"25"},"breedersCup":{"starts":1,"earnings":1040000,"show":0,"win":1,"place":0,"showP":"0","winP":"100","placeP":"0"},"currentYear":{"starts":3,"earnings":126500,"show":0,"win":1,"place":0,"showP":"0","winP":"33","placeP":"0"},"lifetime":{"starts":7,"earnings":1220100,"show":0,"win":3,"place":1,"showP":"0","winP":"43","placeP":"14"}},"yearlySummary":[{"showsP":"0","winsP":"33","placesP":"0","starts":3,"earnings":126500,"racingYear":2026,"shows":0,"wins":1,"places":0},{"showsP":"0","winsP":"50","placesP":"25","starts":4,"earnings":1093600,"racingYear":2025,"shows":0,"wins":2,"places":1}],"morningLineOdds":[],"bio":"\u003cp\u003eChampion Super Corredora, winner of the 2025 NetJets Breeders’ Cup Juvenile Fillies (G1) at Del Mar, appears to be coming back to good form at exactly the right time. A win in the Longines Breeders’ Cup Distaff (G1) would put her in rare air. \r\u003c/p\u003e\u003cp\u003eSuper Corredora, by 2017 Breeders’ Cup Classic (G1) winner and Hall of Famer Gun Runner, is trained by John Sadler for West Point Thoroughbreds, Spartan Equine Racing, Robert Gardiner, and Michael Olszewski. Last year, she broke her maiden in her third career start, and then won the Juvenile Fillies at Del Mar. \r\u003c/p\u003e\u003cp\u003eBut Super Corredora, voted the Eclipse Award champion 2-year-old filly, started her 2026 campaign with after two subpar efforts. Her connections hit pause, and she was turned out for 90 days. Upon her return, Super Corredora led throughout to beat older foes by 2 ¾ lengths in the Zenyatta Stakes (G2) on Sept. 27 at Santa Anita, earning consideration for a trip to Keeneland. \r\u003c/p\u003e\u003cp\u003eSeventeen winners of the Juvenile Fillies have returned to contest another Breeders’ Cup event later in their careers. Only one has claimed the Distaff. Hall of Famer Beholder won the 2012 Juvenile Fillies, then the 2013 and 2016 editions of the Distaff.\r\u003c/p\u003e","gradedStakesPoints":6,"regionWinnerBadges":[],"breederName":"Woodford Thoroughbreds, LLC","uid":"blt8c3db9b65383a857","hasAutogeneratedPage":true,"url":"/redirect/horse/blt8c3db9b65383a857?ht=pre-entries","pageTitle":"Super Corredora","jockeyName":"","ownerName":"West Point Thoroughbreds, Inc. (Terrence Finley), Spartan Equine Racing, LLC (Andreas Wilfong), Robert C. Gardiner \u0026 Michael W. Olszewski","trainer":"John W. Sadler","country":{"uid":"blt1af49e3a6a89373f","title":"USA","abbreviation":"USA","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt9de45bbdff160673/60d219911e0505677a882fa1/USAFlag.png"}},"horseName":"Super Corredora","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt6193add38ae41c73/68fb9d69546d424685d756e3/Contender_Photo_Super_Corredora.png"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt6193add38ae41c73/68fb9d69546d424685d756e3/Contender_Photo_Super_Corredora.png"},"cta":null,"races":[{"uid":"blt4416a4da2e82f3d3","ContentTypeUid":"collection_race","challengeSeriesWinner":false,"isEligible":false,"eligibleRank":null,"finishPosition":null,"classicRanking":null,"postPosition":"","scratched":false,"win":"","place":"","show":"","deadHeat":false,"silks":null}],"isChallengeSeriesWinner":true,"silks":null,"isHoC":false,"year":2026,"isHistoricalEntry":false,"relatedArticles":[],"win":"","show":"","place":""}]},{"uid":"blt31ae65439327eecf","raceName":"Breeders' Cup Mile","raceDetails":{"type":"World Championships","bcType":"Mile","sponsor":[{"titl