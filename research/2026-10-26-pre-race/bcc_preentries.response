ARLINGTON","raceName":"Arlington-Washington Futurity","grade":" ","raceDate":"August, 28 2021 00:00:00","purseUsa":75000,"positionAtFinish":1},{"trackName":"FAIR GROUNDS","raceName":" ","grade":" ","raceDate":"December, 18 2025 00:00:00","purseUsa":56000,"positionAtFinish":1},{"trackName":"PRESQUE ISLE DOWNS","raceName":" ","grade":" ","raceDate":"July, 14 2021 00:00:00","purseUsa":30000,"positionAtFinish":1},{"trackName":"CHURCHILL DOWNS","raceName":"Pat Day Mile S. presented by SAP","grade":"2","raceDate":"May, 03 2025 00:00:00","purseUsa":600000,"positionAtFinish":9},{"trackName":"FAIR GROUNDS","raceName":"Twinspires.com Louisiana Derby","grade":"2","raceDate":"March, 22 2025 00:00:00","purseUsa":1000000,"positionAtFinish":5},{"trackName":"FAIR GROUNDS","raceName":"Fasig-Tipton Risen Star S.","grade":"2","raceDate":"February, 15 2025 00:00:00","purseUsa":500000,"positionAtFinish":3},{"trackName":"FAIR GROUNDS","raceName":"Lecomte S.","grade":"3","raceDate":"January, 18 2025 00:00:00","purseUsa":250000,"positionAtFinish":2},{"trackName":"FAIR GROUNDS","raceName":"Gun Runner S.","grade":" ","raceDate":"December, 21 2024 00:00:00","purseUsa":100000,"positionAtFinish":1},{"trackName":"KEENELAND","raceName":" ","grade":" ","raceDate":"October, 06 2024 00:00:00","purseUsa":100000,"positionAtFinish":1},{"trackName":"ELLIS PARK","raceName":" ","grade":" ","raceDate":"August, 24 2024 00:00:00","purseUsa":71000,"positionAtFinish":4}],"record":{"previousYear":{"starts":5,"earnings":159100,"show":1,"win":1,"place":1,"showP":"20","winP":"20","placeP":"20"},"breedersCup":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"currentYear":{"starts":7,"earnings":599842,"show":1,"win":4,"place":1,"showP":"14","winP":"57","placeP":"14"},"lifetime":{"starts":15,"earnings":883146,"show":3,"win":7,"place":2,"showP":"20","winP":"47","placeP":"13"}},"yearlySummary":[{"showsP":"14","winsP":"57","placesP":"14","starts":7,"earnings":599842,"racingYear":2026,"shows":1,"wins":4,"places":1},{"showsP":"20","winsP":"20","placesP":"20","starts":5,"earnings":159100,"racingYear":2025,"shows":1,"wins":1,"places":1}],"morningLineOdds":[],"bio":"\u003cp\u003eBuilt engineered his ticket to the Cygames Breeders’ Cup Sprint (G1) by taking the “Win and You’re In” Alfred G. Vanderbilt Stakes (G2) on July 25 at Saratoga. \u0026nbsp;\r\u003c/p\u003e\u003cp\u003eBuilt added to his resume in his next start on Sept. 12 at Churchill Downs in the 6 ½-furlong Louisville Thoroughbred Society Stakes by taking command on the far turn en route to a 1 1/2-length victory. \r\u003c/p\u003e\u003cp\u003eHe already has proven he can win at Keeneland after scoring his initial career victory there as a 2-year-old on Oct. 6, 2024 in his second start. He closed that season with a score in the Gun Runner Stakes (Listed) at Fair Grounds at 1 1/16 miles that had his connections dreaming of the 2025 Kentucky Derby (G1). \r\u003c/p\u003e\u003cp\u003e\u0026nbsp;Built then picked up qualifying points in Fair Grounds stakes races but bypassed the Derby in favor of the undercard’s Pat Day Mile (G2) in which he was unplaced. He was out of competition until winning a Fair Grounds allowance sprint on Dec. 18 and has since continued racing at less than a mile. \r\u003c/p\u003e\u003cp\u003eBuilt’s trainer Wayne Catalano and owner Eclipse Thoroughbred Partners teamed to win the 2021 Qatar Racing Breeders’ Cup Sprint (G1) with Aloha West at Del Mar. He was purchased by his current owner as a 2-year-old for $260,000 at the 2024 April Ocala Breeders’ Sales Co. auction. He previously sold for $82,000 at the Keeneland September Yearling Sale.\u0026nbsp;\u003c/p\u003e","gradedStakesPoints":8,"regionWinnerBadges":[],"breederName":"Robert Low \u0026 Lawana Low","uid":"blt7e8cc9940b94f713","hasAutogeneratedPage":true,"url":"/redirect/horse/blt7e8cc9940b94f713?ht=pre-entries","pageTitle":"Built","jockeyName":"","ownerName":"Eclipse Thoroughbred Partners (Aron Wellman)","trainer":"Wayne M. Catalano","country":{"uid":"blt1af49e3a6a89373f","title":"USA","abbreviation":"USA","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt9de45bbdff160673/60d219911e0505677a882fa1/USAFlag.png"}},"horseName":"Built","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/bltb10aff0e1b6a0e62/6a972cc3075f970eeb3e205b/Contender_Photo_Built.jpg"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/bltb10aff0e1b6a0e62/6a972cc3075f970eeb3e205b/Contender_Photo_Built.jpg"},"cta":null,"races":[{"uid":"blt830ffcd3734ad389","ContentTypeUid":"collection_race","challengeSeriesWinner":false,"isEligible":false,"eligibleRank":null,"finishPosition":null,"classicRanking":null,"postPosition":"","scratched":false,"win":"","place":"","show":"","deadHeat":false,"silks":null}],"isChallengeSeriesWinner":false,"silks":null,"isHoC":false,"year":2026,"isHistoricalEntry":false,"relatedArticles":[],"win":"","show":"","place":""},{"sireName":"Preservationist","damName":"Play for Gold","sex":"Colt","color":"Gray or Roan","foalingDate":"May, 11 2022 00:00:00","age":4,"pastPerformances":[{"trackName":"CHURCHILL DOWNS","raceName":"Lukas Classic S.","grade":"2","raceDate":"September, 26 2026 00:00:00","purseUsa":500000,"positionAtFinish":2},{"trackName":"MONMOUTH PARK","raceName":"Philip H. Iselin S.","grade":"3","raceDate":"August, 15 2026 00:00:00","purseUsa":150000,"positionAtFinish":2},{"trackName":"CHURCHILL DOWNS","raceName":" ","grade":" ","raceDate":"June, 28 2026 00:00:00","purseUsa":141000,"positionAtFinish":2},{"trackName":"CHURCHILL DOWNS","raceName":"Clark S. presented by Norton Healthcare","grade":"2","raceDate":"November, 28 2025 00:00:00","purseUsa":600000,"positionAtFinish":3},{"trackName":"KEENELAND","raceName":" ","grade":" ","raceDate":"October, 24 2025 00:00:00","purseUsa":130000,"positionAtFinish":1},{"trackName":"CHURCHILL DOWNS","raceName":"Bourbon Flight S.","grade":" ","raceDate":"September, 20 2025 00:00:00","purseUsa":300000,"positionAtFinish":2},{"trackName":"MOUNTAINEER CASINO RACETRACK \u0026 RESORT","raceName":"West Virginia Derby","grade":"3","raceDate":"August, 03 2025 00:00:00","purseUsa":400000,"positionAtFinish":1},{"trackName":"THISTLEDOWN","raceName":"Ohio Derby","grade":"3","raceDate":"June, 21 2025 00:00:00","purseUsa":500000,"positionAtFinish":2},{"trackName":"CHURCHILL DOWNS","raceName":"Kentucky Derby presented by Woodford Reserve","grade":"1","raceDate":"May, 03 2025 00:00:00","purseUsa":5000000,"positionAtFinish":9},{"trackName":"FAIR GROUNDS","raceName":"Twinspires.com Louisiana Derby","grade":"2","raceDate":"March, 22 2025 00:00:00","purseUsa":1000000,"positionAtFinish":2},{"trackName":"FAIR GROUNDS","raceName":"Fasig-Tipton Risen Star S.","grade":"2","raceDate":"February, 15 2025 00:00:00","purseUsa":500000,"positionAtFinish":2},{"trackName":"TURFWAY PARK","raceName":"Leonatus S.","grade":" ","raceDate":"January, 18 2025 00:00:00","purseUsa":125000,"positionAtFinish":2},{"trackName":"TURFWAY PARK","raceName":" ","grade":" ","raceDate":"December, 19 2024 00:00:00","purseUsa":41200,"positionAtFinish":1}],"record":{"previousYear":{"starts":9,"earnings":868893,"show":1,"win":2,"place":5,"showP":"11","winP":"22","placeP":"56"},"breedersCup":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"currentYear":{"starts":3,"earnings":158200,"show":0,"win":0,"place":3,"showP":"0","winP":"0","placeP":"100"},"lifetime":{"starts":13,"earnings":1051511,"show":1,"win":3,"place":8,"showP":"8","winP":"23","placeP":"62"}},"yearlySummary":[{"showsP":"0","winsP":"0","placesP":"100","starts":3,"earnings":158200,"racingYear":2026,"shows":0,"wins":0,"places":3},{"showsP":"11","winsP":"22","placesP":"56","starts":9,"earnings":868893,"racingYear":2025,"shows":1,"wins":2,"places":5}],"morningLineOdds":[],"bio":"\u003cp\u003eChunk of Gold epitomizes the adage that a superior horse can emerge from anywhere. A four-figure purchase at public auction, he has banked more than $1 million in 13 starts with a 3-8-1 record that includes his score in the 2025 West Virginia Derby (G3). His lone off-the-board showing was his ninth-place finish in the 2025 Kentucky Derby (G1).\r\u003c/p\u003e\u003cp\u003eAt the 2023 Fasig-Tipton October yearling sale in Lexington, Kentucky, Chris Melton liked what he saw in the young Chunk of Gold and was willing to pay $20,000. When he landed the winning bid at $2,500, Melton, a longtime Thoroughbred buyer, wondered if he had overlooked some flaws.\r\u003c/p\u003e\u003cp\u003e“He was a little immature, but you could tell he was going to grow up and be a good-looking horse,\" Melton told BloodHorse in a 2025 story.\r\u003c/p\u003e\u003cp\u003eMelton sold an interest in Chunk of Gold to southern Kentucky businessman Terry Stephens. After giving the colt his early lessons at his own training facility in southern Kentucky, Melton sent Chunk of Gold to trainer Ethan West. After he debuted at Turfway Park with a neck triumph in maiden special weight company in late 2024, Stephens bought out Melton. \r\u003c/p\u003e\u003cp\u003eThe nearly black Chunk of Gold registered as gray or roan is a son of the late Grade 1 winner Preservationist. \r\u003c/p\u003e","gradedStakesPoints":6,"regionWinnerBadges":[],"breederName":"Brereton C. Jones","uid":"bltfdbb736224125a8f","hasAutogeneratedPage":true,"url":"/redirect/horse/bltfdbb736224125a8f?ht=pre-entries","pageTitle":"Chunk of Gold","jockeyName":"","ownerName":"Terry L. Stephens","trainer":"Ethan W. West","country":{"uid":"blt1af49e3a6a89373f","title":"USA","abbreviation":"USA","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt9de45bbdff160673/60d219911e0505677a882fa1/USAFlag.png"}},"horseName":"Chunk of Gold","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt7e0ed98a5f64df60/6abe825a280ccc3fd9664778/Contender_Photo_Chunk_of_Gold_.jpg"},"regularImage":{"sr