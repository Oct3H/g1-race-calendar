aceDate":"June, 29 2024 00:00:00","purseUsa":250000,"positionAtFinish":8},{"trackName":"YORK","raceName":"Julia Graves Roses S.","grade":" ","raceDate":"August, 22 2026 00:00:00","purseUsa":136445,"positionAtFinish":1},{"trackName":"KEENELAND","raceName":" ","grade":" ","raceDate":"April, 13 2024 00:00:00","purseUsa":110000,"positionAtFinish":2},{"trackName":"GOODWOOD","raceName":"Veuve Clicquot Molecomb S.","grade":"3","raceDate":"July, 29 2026 00:00:00","purseUsa":146182,"positionAtFinish":4},{"trackName":"FAIR GROUNDS","raceName":"Risen Star S.","grade":"2","raceDate":"February, 17 2024 00:00:00","purseUsa":400000,"positionAtFinish":9},{"trackName":"NEWBURY","raceName":"Apple Print \u0026 Creative Rose Bowl S.","grade":" ","raceDate":"July, 17 2026 00:00:00","purseUsa":67399,"positionAtFinish":5},{"trackName":"AQUEDUCT","raceName":"Remsen S.","grade":"2","raceDate":"December, 02 2023 00:00:00","purseUsa":250000,"positionAtFinish":4},{"trackName":"CHURCHILL DOWNS","raceName":"Street Sense S.","grade":"3","raceDate":"October, 29 2023 00:00:00","purseUsa":200000,"positionAtFinish":2},{"trackName":"ASCOT","raceName":"Windsor Castle S.","grade":" ","raceDate":"June, 17 2026 00:00:00","purseUsa":167831,"positionAtFinish":5},{"trackName":"BELMONT AT THE BIG A","raceName":" ","grade":" ","raceDate":"September, 28 2023 00:00:00","purseUsa":90000,"positionAtFinish":1},{"trackName":"HAMILTON PARK","raceName":"Wyvis Roofing Ebf Maiden Stakes (Class 4) (Hamilton Park 2yo Series Qualifier) (Gbb Race)","grade":" ","raceDate":"May, 27 2026 00:00:00","purseUsa":15464,"positionAtFinish":1},{"trackName":"SARATOGA","raceName":" ","grade":" ","raceDate":"July, 29 2023 00:00:00","purseUsa":136500,"positionAtFinish":2}],"record":{"previousYear":{"starts":8,"earnings":358814,"show":1,"win":4,"place":0,"showP":"13","winP":"50","placeP":"0"},"breedersCup":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"currentYear":{"starts":7,"earnings":145625,"show":1,"win":0,"place":2,"showP":"14","winP":"0","placeP":"29"},"lifetime":{"starts":25,"earnings":674027,"show":3,"win":5,"place":5,"showP":"12","winP":"20","placeP":"20"}},"yearlySummary":[{"showsP":"14","winsP":"0","placesP":"29","starts":7,"earnings":145625,"racingYear":2026,"shows":1,"wins":0,"places":2},{"showsP":"13","winsP":"50","placesP":"0","starts":8,"earnings":358814,"racingYear":2025,"shows":1,"wins":4,"places":0}],"morningLineOdds":[],"bio":"\u003cp\u003eMoonlight is a bit of a newcomer for his current connections who purchased him for $250,000 on July 14 at Fasig-Tipton’s Horses of Racing Age Sale in Lexington, Kentucky. Eleven days later, he began rewarding them when he was third in the Bing Crosby Stakes (G1) at Del Mar as a 47-1 longshot. He further returned on his investment when narrowly beaten in the Pat O’Brien Stakes (G2) at Del Mar on Aug. 29.\u0026nbsp;\u003c/p\u003e\u003cp\u003eThe 5-year-old has rotated through several ownerships via public auctions after first being purchased for $170,000 as yearling. Resold as a 2-year-old in training, Moonlight flashed promise that year in winning his second career start and placing in graded company. After going winless in his first four tries as a sophomore, he was sold for $90,000 at Fasig-Tipton’s August digital sale in 2024. The next year he won the Cherokee Mile Stakes at Churchill Downs and three allowance races while pocketing $358,814. He was less productive in the first half of 2026 and was purchased by current owner Tom Kagele at the aforementioned July auction.\u0026nbsp;\u0026nbsp;\u003c/p\u003e\u003cp\u003eMoonlight’s name – a nod to his dam Sundown – was given to him by his breeder Peter Blum before he first was sold at auction.\u003c/p\u003e","gradedStakesPoints":8,"regionWinnerBadges":[],"breederName":"Peter E. Blum Thoroughbreds, LLC","uid":"bltc29fb73d99695223","hasAutogeneratedPage":true,"url":"/redirect/horse/bltc29fb73d99695223?ht=pre-entries","pageTitle":"Moonlight","jockeyName":"","ownerName":"Tom Kagele","trainer":"Peter Miller","country":{"uid":"blt1af49e3a6a89373f","title":"USA","abbreviation":"USA","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt9de45bbdff160673/60d219911e0505677a882fa1/USAFlag.png"}},"horseName":"Moonlight","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt6e418dda009d3e76/6ab2e301ace1f22eaccde4ac/Contender_Photo_Moonlight.jpg"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt6e418dda009d3e76/6ab2e301ace1f22eaccde4ac/Contender_Photo_Moonlight.jpg"},"cta":null,"races":[{"uid":"blt830ffcd3734ad389","ContentTypeUid":"collection_race","challengeSeriesWinner":false,"isEligible":true,"eligibleRank":16,"finishPosition":null,"classicRanking":null,"postPosition":"16","scratched":false,"win":"","place":"","show":"","deadHeat":false,"silks":null}],"isChallengeSeriesWinner":false,"silks":null,"isHoC":false,"year":2026,"isHistoricalEntry":false,"relatedArticles":[],"win":"","show":"","place":""}]},{"uid":"blt6bf61f758c07022b","raceName":"Breeders' Cup Juvenile Turf","raceDetails":{"type":"World Championships","bcType":"Juvenile Turf","sponsor":[{"title":"Brown Advisory","redirectUrl":"https://www.breederscup.com/races/2026-juvenile-turf","label":"Presented by","logos":{"color":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt5c48d0fdbe8d4ecb/69b17da9918e0109f2408e19/BrownAdvisory-logo_(3).png"},"white":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/bltdb5682924182ef7c/6a63a4e6f39ca9c4a2a0b3bd/BrownAdvisory_Footer_Corrected.svg"},"black":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt5c48d0fdbe8d4ecb/69b17da9918e0109f2408e19/BrownAdvisory-logo_(3).png"}},"sponsoredUrls":[],"sponsoredSection":""}],"sponsorLogo":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt5c48d0fdbe8d4ecb/69b17da9918e0109f2408e19/BrownAdvisory-logo_(3).png"},"date":"2026-10-30T21:35:00.000Z","priorYearChampionPhoto":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt2e5b63791e40e165/69247ccb7e585b8e30827821/Juvenile_Turf_-_gstaad.jpg"},"displayPostTime":true,"isCompleted":false,"isLive":false,"purse":"$1,000,000","distance":"1 Mile","grade":1,"ageV2":"2","division":"Juvenile Turf","exacta":"","trifecta":"","superfecta":"","superHighFive":"","dailyDouble":"","pick3":"","pick4":"","pick5":"","pick6":"","region":""},"isTvScheduled":true,"broadcast":{"partners":[{"logo":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/bltceb0312138059807/632b128204361d715f5522c1/USA_Network-Logo-SVGs_146x60-USA.svg"},"time":""},{"logo":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt29c35e9a30ccbba3/68d1ca298c48984dc7622c30/22-BC-162_New-BCcom_Network-Logo-SVGs_146x60-v1-05-Peacock.svg"},"time":""}]},"trackDetails":[{"uid":"bltc1d1c6b40525bf04","details":{"name":"Keeneland","logo":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt276fb8147db83742/629e62383d4e745ed3ae5859/keeneland.png"},"image":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/bltb0b7768e84d44449/614ce97164c8007a9bdec19c/Keeneland_Track_Image.jpeg"},"locationBcbc":"Keeneland","timeZone":-4}}],"raceDescription":"\u003ch1\u003eA\u0026nbsp;showcase\u0026nbsp;for\u0026nbsp;the\u0026nbsp;world's\u0026nbsp;rising\u0026nbsp;turf\u0026nbsp;stars.\u003cbr /\u003e\u003c/h1\u003e\u003cp\u003eRun at 1 mile on the grass course with a $1 million purse, the Breeders’ Cup Juvenile Turf, restricted to male two-year-olds, often forecasts the top turf horses of the future, whether they run in North America or in Europe’s top races.\u0026nbsp;\u003c/p\u003e\u003cp\u003e\u0026nbsp;\u003c/p\u003e","surface":"","bettingCtaOverride":{"cta":[]},"horseType":"pre-entries","horses":[{"sireName":"Karakontie (JPN)","damName":"More Than Gracious","sex":"Gelding","color":"Bay","foalingDate":"March, 31 2024 00:00:00","age":2,"pastPerformances":[{"trackName":"KEENELAND","raceName":"Castle \u0026 Key Bourbon S.","grade":"2","raceDate":"October, 04 2026 00:00:00","purseUsa":400000,"positionAtFinish":1},{"trackName":"KENTUCKY DOWNS","raceName":"Pepsi Kentucky Downs Juvenile Mile S.","grade":" ","raceDate":"September, 09 2026 00:00:00","purseUsa":750000,"positionAtFinish":3},{"trackName":"ELLIS PARK","raceName":" ","grade":" ","raceDate":"July, 05 2026 00:00:00","purseUsa":100000,"positionAtFinish":1},{"trackName":"CHURCHILL DOWNS","raceName":" ","grade":" ","raceDate":"May, 21 2026 00:00:00","purseUsa":120000,"positionAtFinish":6}],"record":{"previousYear":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"breedersCup":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"currentYear":{"starts":4,"earnings":363775,"show":1,"win":2,"place":0,"showP":"25","winP":"50","placeP":"0"},"lifetime":{"starts":4,"earnings":363775,"show":1,"win":2,"place":0,"showP":"25","winP":"50","placeP":"0"}},"yearlySummary":[{"showsP":"25","winsP":"50","placesP":"0","starts":4,"earnings":363775,"racingYear":2026,"shows":1,"wins":2,"places":0},{"showsP":"NA","winsP":"NA","placesP":"NA","starts":0,"earnings":0,"racingYear":2025,"shows":0,"wins":0,"places":0}],"morningLineOdds":[],"bio":"\u003cp\u003eAfter a promising third in the Kentucky Downs Juvenile Mile Stakes (Listed), the Brown Advisory Breeders’ Cup Juvenile Turf (G1) has been added to Agate’s calendar. A victory in the Bourbon (G2) at Keeneland on Oct. 4 confirmed the calendar spot.\r\u003c/p\u003e\u003cp\u003eMaking his third career start and first in a stakes, the son of Karakontie (JPN) got off to a slow start and was 10th after a half-mile. He then took a bad step nearing the 5-furlong marker, but still managed to close fast at the end to grab third, finishing 6 ¼ lengths behind.\r\u003c/p\u003e\u003cp\u003eIn the 1 1/16-mile Bourbon, a Win and You’re In race for the Juvenile Turf, Agate split horses at the sixteenth pole and drew off for a 1 3/4-length victory.\r\u003c/p\u003e\u003cp\u003eThe 2-year-old started his career May 21 at Churchill Downs with a sixth at 38-1 odds in a 5-furlong maiden turf race.\r\u003c/p\u003e\u003cp\u003eHe showed the benefits of that experience when he returned July 5 at Ellis Park with a maiden victory. Agate attended the pace throughout and drew away in the final furlong to win decisively by 4 1/2 lengths in 1:35.70 for the mile.\r\u003c/p\u003e\u003cp\u003eAgate is a Dede McGehee homebred out of the More Than Ready mare More Than Gracious, who won one of her nine career starts.\r\u003c/p\u003e","gradedStakesPoints":6,"regionWinnerBadges":[],"breederName":"Dede McGehee","uid":"blt3b17609decaaef79","hasAutogeneratedPage":true,"url":"/redirect/horse/blt3b17609decaaef79?ht=pre-entries","pageTitle":"Agate","jockeyName":"","ownerName":"Dede McGehee","trainer":"Kelsey Danner","country":{"uid":"blt1af49e3a6a89373f","title":"USA","abbreviation":"USA","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt9de45bbdff160673/60d219911e0505677a882fa1/USAFlag.png"}},"horseName":"Agate","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/bltbf881239ec9e5f72/6ac2d8810491eb46ce048051/contender_photo_-_agate.jpg"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/bltbf881239ec9e5f72/6ac2d8810491eb46ce048051/contender_photo_-_agate.jpg"},"cta":null,"races":[{"uid":"blt6bf61f758c07022b","ContentTypeUid":"collection_race","challengeSeriesWinner":false,"isEligible":false,"eligibleRank":null,"finishPosition":null,"classicRanking":null,"postPosition":"","scratched":false,"win":"","place":"","show":"","deadHeat":false,"silks":null}],"isChallengeSeriesWinner":true,"silks":null,"isHoC":false,"year":2026,"isHistoricalEntry":false,"relatedArticles":[],"win":"","show":"","place":""},{"sireName":"No Nay Never","damName":"La Joconde (IRE)","sex":"Colt","color":"Dark Bay or Brown","foalingDate":"March, 25 2024 00:00:00","age":2,"pastPerformances":[{"trackName":"LONGCHAMP","raceName":"Qatar Prix Jean-Luc Lagardere","grade":"1","raceDate":"October, 04 2026 00:00:00","purseUsa":450198,"positionAtFinish":6},{"trackName":"LONGCHAMP","raceName":"Qatar Prix la Rochette","grade":"3","raceDate":"September, 06 2026 00:00:00","purseUsa":85025,"positionAtFinish":1},{"trackName":"DEAUVILLE","raceName":"The Aga Khan Studs Prix Francois Boutin","grade":"3","raceDate":"August, 16 2026 00:00:00","purseUsa":84684,"positionAtFinish":1},{"trackName":"DEAUVILLE","raceName":"Prix Roland de Chambure","grade":" ","raceDate":"July, 04 2026 00:00:00","purseUsa":62784,"positionAtFinish":1},{"trackName":"SAINT CLOUD","raceName":"Prix Chapeau Rouge","grade":" ","raceDate":"June, 02 2026 00:00:00","purseUsa":31872,"positionAtFinish":1}],"record":{"previousYear":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"breedersCup":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"currentYear":{"starts":5,"earnings":132182,"show":0,"win":4,"place":0,"showP":"0","winP":"80","placeP":"0"},"lifetime":{"starts":5,"earnings":132182,"show":0,"win":4,"place":0,"showP":"0","winP":"80","placeP":"0"}},"yearlySummary":[{"showsP":"0","winsP":"80","placesP":"0","starts":5,"earnings":132182,"racingYear":2026,"shows":0,"wins":4,"places":0},{"showsP":"NA","winsP":"NA","placesP":"NA","starts":0,"earnings":0,"racingYear":2025,"shows":0,"wins":0,"places":0}],"morningLineOdds":[],"bio":"\u003cp\u003eThe undefeated American-bred Avec Toi promises to bring speed and famed European connections to the Brown Advisory Breeders’ Cup Juvenile Turf (G1). \r\u003c/p\u003e\u003cp\u003eA winner of all four starts overseas, the 2-year-old son of No Nay Never is trained by Christopher Head and owned by the Coolmore partners of Mrs. John Magnier, Michael Tabor and Derrick Smith, plus Westerberg, one of the breeders of the colt. \r\u003c/p\u003e\u003cp\u003eAvec Toi, which means “with you” in French, started his career June 2 at Saint-Cloud with a front-running, 4-length victory in which he was eased up in the final 110 yards. He covered the 7 furlongs on soft turf in 1:30.41. \r\u003c/p\u003e\u003cp\u003eHe returned July 4 at Deauville and again flashed his speed and lead throughout in the Prix Roland de Chambure, a listed stakes, by 2 ½ lengths. This time, he covered the 7 furlongs in 1:22.78 on good to firm turf. \r\u003c/p\u003e\u003cp\u003eAvec Toi stepped up to the Prix Francois Boutin (G3) Aug. 16 at Deauville and this time pressed the leader before taking over 2 furlongs from the wire and winning by 4 lengths. Final time was 1:24.68 on good turf. \r\u003c/p\u003e\u003cp\u003eAvec Toi was back in action three weeks later at Parislongchamp in the 7-furlong Prix la Rochette (G3). Taking the lead right out of the gate, Avec Toi held off Imperial Strike (IRE) by a short head to prevail as the odds-on favorite in the field of five. \r\u003c/p\u003e\u003cp\u003eHe was bred by Orpendale, Chelston, Wynatt and Westerberg out of the Frankel (GB) mare La Jaconde (IRE).\u0026nbsp;\u003c/p\u003e","gradedStakesPoints":0,"regionWinnerBadges":[],"breederName":"Orpendale/Chelston/Wynatt \u0026 Westerberg Ireland ULC","uid":"bltefc0a4e95c3f4810","hasAutogeneratedPage":true,"url":"/redirect/horse/bltefc0a4e95c3f4810?ht=pre-entries","pageTitle":"Avec Toi","jockeyName":"","ownerName":"Derrick Smith, Mrs. John Magnier, Michael Tabor \u0026 Westerberg (Lucia Walder)","trainer":"Christopher Head","country":{"uid":"blt952f4fa5875984b9","title":"France","abbreviation":"FRA","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt32d4aec5d5cd2faf/61490dcf77d06a0c9835e9fd/France_Flag.png"}},"horseName":"Avec Toi","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blte66e7c3f33facf3b/6334cddf4df1082a16b60e31/Fallback_Horse_Image.png"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blte66e7c3f33facf3b/6334cddf4df1082a16b60e31/Fallback_Horse_Image.png"},"cta":null,"races":[{"uid":"blt6bf61f758c07022b","ContentTypeUid":"collection_race","challengeSeriesWinner":false,"isEligible":false,"eligibleRank":null,"finishPosition":null,"classicRanking":null,"postPosition":"","scratched":false,"win":"","place":"","show":"","deadHeat":false,"silks":null}],"isChallengeSeriesWinner":false,"silks":null,"isHoC":false,"year":2026,"isHistoricalEntry":false,"relatedArticles":[],"win":"","show":"","place":""},{"sireName":"Not This Time","damName":"Sweetened","sex":"Colt","color":"Dark Bay or Brown","foalingDate":"February, 18 2024 00:00:00","age":2,"pastPerformances":[{"trackName":"KEENELAND","raceName":"Castle \u0026 Key Bourbon S.","grade":"2","raceDate":"October, 04 2026 00:00:00","purseUsa":400000,"positionAtFinish":2},{"trackName":"SARATOGA","raceName":"With Anticipation S.","grade":"3","raceDate":"September, 05 2026 00:00:00","purseUsa":225000,"positionAtFinish":2},{"trackName":"SARATOGA","raceName":" ","grade":" ","raceDate":"August, 08 2026 00:00:00","purseUsa":115000,"positionAtFinish":2}],"record":{"previousYear":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"breedersCup":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"currentYear":{"starts":3,"earnings":143000,"show":0,"win":0,"place":3,"showP":"0","winP":"0","placeP":"100"},"lifetime":{"starts":3,"earnings":143000,"show":0,"win":0,"place":3,"showP":"0","winP":"0","placeP":"100"}},"yearlySummary":[{"showsP":"0","winsP":"0","placesP":"100","starts":3,"earnings":143000,"racingYear":2026,"shows":0,"wins":0,"places":3},{"showsP":"NA","winsP":"NA","placesP":"NA","starts":0,"earnings":0,"racingYear":2025,"shows":0,"wins":0,"places":0}],"morningLineOdds":[],"bio":"\u003cp\u003eBold Leadership may be a maiden after three career starts but has earned consideration for the Brown Advisory Breeders’ Cup Juvenile Turf (G1) with two runner-up finishes in graded turf stakes. \r\u003c/p\u003e\u003cp\u003eHis career started Aug. 8 at Saratoga in a 1 1/16-mile maiden turf race. Seventh after a half-mile, he closed quickly in the stretch but fell a nose of catching the victorious Oscar at the finish line. \r\u003c/p\u003e\u003cp\u003eHad Bold Leadership won, he would have given trainer Todd Pletcher his 6,000th career win, a milestone the Hall of Famer reached later on that card. \r\u003c/p\u003e\u003cp\u003eA son of Not This Time, Bold Leadership returned Sept. 5 in the With Anticipation Stakes (G3) at Saratoga, a 1 1/16-mile stakes that went off with just two other starters. One of them was Pletcher stablemate Liam’s Law, who set the pace and held off Bold Leadership by a nose. \r\u003c/p\u003e\u003cp\u003eOn Oct. 4 at Keeneland, Bold Leadership was entered in Bourbon Stakes (G2) that offered a free, “Win and You’re In” spot in the Breeders’ Cup Juvenile Turf through the Breeders’ Cup Challenge Series. Seventh at the eighth pole, Bold Leadership turned in his customary late kick but could only manage second by 1 ¾ lengths to Agate. \r\u003c/p\u003e\u003cp\u003eOwned by Repole Stable and St. Elias Stables, he was bought for $875,000 at the Keeneland September Yearling Sale. He was bred by Summer Wind Equine out of the Candy Ride (ARG) mare Sweetened.\u003c/p\u003e","gradedStakesPoints":6,"regionWinnerBadges":[],"breederName":"Summer Wind Equine LLC","uid":"blt27fdd782eed6efbe","hasAutogeneratedPage":true,"url":"/redirect/horse/blt27fdd782eed6efbe?ht=pre-entries","pageTitle":"Bold Leadership","jockeyName":"","ownerName":"Repole Stable (Mike Repole) \u0026 St. Elias Stables (Vincent Viola)","trainer":"Todd A. Pletcher","country":{"uid":"blt1af49e3a6a89373f","title":"USA","abbreviation":"USA","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt9de45bbdff160673/60d219911e0505677a882fa1/USAFlag.png"}},"horseName":"Bold Leadership","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/bltebf12c878339f1f4/6ace42017963afbdc76ccc92/Contender_Photo_Bold_Leadership.jpg"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/bltebf12c878339f1f4/6ace42017963afbdc76ccc92/Contender_Photo_Bold_Leadership.jpg"},"cta":null,"races":[{"uid":"blt6bf61f758c07022b","ContentTypeUid":"collection_race","challengeSeriesWinner":false,"isEligible":false,"eligibleRank":null,"finishPosition":null,"classicRanking":null,"postPosition":"","scratched":false,"win":"","place":"","show":"","deadHeat":false,"silks":null}],"isChallengeSeriesWinner":false,"silks":null,"isHoC":false,"year":2026,"isHistoricalEntry":false,"relatedArticles":[],"win":"","show":"","place":""},{"sireName":"Mehmas (IRE)","damName":"Ripponette (FR)","sex":"Colt","color":"Bay","foalingDate":"March, 17 2024 00:00:00","age":2,"pastPerformances":[{"trackName":"LONGCHAMP","raceName":"Qatar Prix Jean-Luc Lagardere","grade":"1","raceDate":"October, 04 2026 00:00:00","purseUsa":450198,"positionAtFinish":4},{"trackName":"CURRAGH","raceName":"Goffs Vincent OBrien National S.","grade":"1","raceDate":"September, 13 2026 00:00:00","purseUsa":463932,"positionAtFinish":3},{"trackName":"CURRAGH","raceName":"Coolmore Stud City Of Troy Tom Cooper Irish E.B.F. Futurity S.","grade":"2","raceDate":"August, 22 2026 00:00:00","purseUsa":151798,"positionAtFinish":2},{"trackName":"LEOPARDSTOWN","raceName":"Japan Racing Association Tyros S.","grade":"3","raceDate":"July, 23 2026 00:00:00","purseUsa":79886,"positionAtFinish":1},{"trackName":"NAAS","raceName":"Irish E.B.F. Pat Smullen S.","grade":" ","raceDate":"July, 04 2026 00:00:00","purseUsa":57180,"positionAtFinish":4},{"trackName":"FAIRYHOUSE","raceName":"Irish Stallion Farms E.B.F.","grade":" ","raceDate":"June, 05 2026 00:00:00","purseUsa":25544,"positionAtFinish":1},{"trackName":"LEOPARDSTOWN","raceName":"Irish Stallion Farms E.B.F.","grade":" ","raceDate":"May, 15 2026 00:00:00","purseUsa":25673,"positionAtFinish":3}],"record":{"previousYear":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"breedersCup":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"currentYear":{"starts":7,"earnings":162300,"show":2,"win":2,"place":1,"showP":"29","winP":"29","placeP":"14"},"lifetime":{"starts":7,"earnings":162300,"show":2,"win":2,"place":1,"showP":"29","winP":"29","placeP":"14"}},"yearlySummary":[{"showsP":"29","winsP":"29","placesP":"14","starts":7,"earnings":162300,"racingYear":2026,"shows":2,"wins":2,"places":1},{"showsP":"NA","winsP":"NA","placesP":"NA","starts":0,"earnings":0,"racingYear":2025,"shows":0,"wins":0,"places":0}],"morningLineOdds":[],"bio":"\u003cp\u003eIn arriving from Europe, Florida Bay heads to the Brown Advisory Breeders’ Cup Juvenile Turf (G1) with an abundance of speed and experience. \r\u003c/p\u003e\u003cp\u003eA two-time winner, Florida Bay already has raced seven times, far more than the typical American contender with two or three starts under his belt. \r\u003c/p\u003e\u003cp\u003eThe son of Mehmas (IRE) started his career May 15 with a third at Leopardstown and posted a maiden win \u0026nbsp;June 5 at Fairyhouse. \r\u003c/p\u003e\u003cp\u003eNext he was entered in the Pat Smullen Stakes at Naas and finished fourth of seven. \r\u003c/p\u003e\u003cp\u003eTrainer Aidan O’Brien then tried Florida Bay in the July 23 Tyros Stakes (G3) at Leopardstown and he led throughout to post a 1 ¼-length victory in the 7-furlong stakes. \r\u003c/p\u003e\u003cp\u003eThe following month, O’Brien entered him in the Tom Cooper Irish E. B. F. Stakes (G2) at the Curragh and was rewarded with a second-place finish. \r\u003c/p\u003e\u003cp\u003eIn his past two starts, Florida Bay faced Group 1 competition. \r\u003c/p\u003e\u003cp\u003eIn the Sept. 13 Vincent O’Brien National Stakes (G1) at the Curragh, he set the pace but weakened in the final furlong and finished third in the 7-furlong test on yielding turf. \r\u003c/p\u003e\u003cp\u003eOn Oct. 4 in the Prix Jean-Luc Lagardere (G1), he led until the final 2 furlongs before dropping back to fourth, 3 lengths behind at the wire in the 7-furlong stakes on good turf. \r\u003c/p\u003e\u003cp\u003eHe is owned by the Coolmore partners of Mrs. John Magnier, Michael Tabor and Derrick Smith, as well as Westerberg and America’s Peter Brant. \r\u003c/p\u003e\u003cp\u003eKennedy, Wall and NWC Bloodstock bred the colt out of the La Havre (IRE) mare Ripponette (FR). He was sold for $527,786 at the Tattersalls October Yearling Sale Book 1.\u0026nbsp;\u003c/p\u003e","gradedStakesPoints":0,"regionWinnerBadges":[],"breederName":"Kennedy,Wall \u0026 Nwc Bloodstock","uid":"blta8c424e3b4845744","hasAutogeneratedPage":true,"url":"/redirect/horse/blta8c424e3b4845744?ht=pre-entries","pageTitle":"Florida Bay (IRE)","jockeyName":"","ownerName":"Mrs. John Magnier, Michael Tabor, Derrick Smith, Westerberg (Lucia Walder) \u0026 Peter M. Brant","trainer":"Aidan P. O'Brien","country":{"uid":"blta32e5b692b12a246","title":"Ireland","abbreviation":"IRE","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt613f9a736c40223a/61aa4c2b2f8b9e70946988d3/ireland.png","alt":""}},"horseName":"Florida Bay","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blte66e7c3f33facf3b/6334cddf4df1082a16b60e31/Fallback_Horse_Image.png"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blte66e7c3f33facf3b/6334cddf4df1082a16b60e31/Fallback_Horse_Image.png"},"cta":null,"races":[{"uid":"blt6bf61f758c07022b","ContentTypeUid":"collection_race","challengeSeriesWinner":false,"isEligible":false,"eligibleRank":null,"finishPosition":null,"classicRanking":null,"postPosition":"","scratched":false,"win":"","place":"","show":"","deadHeat":false,"silks":null}],"isChallengeSeriesWinner":false,"silks":null,"isHoC":false,"year":2026,"isHistoricalEntry":false,"relatedArticles":[],"win":"","show":"","place":""},{"sireName":"Blue Point (IRE)","damName":"Liwa Palace (GB)","sex":"Colt","color":"Bay","foalingDate":"February, 06 2024 00:00:00","age":2,"pastPerformances":[{"trackName":"LONGCHAMP","raceName":"Qatar Prix Jean-Luc Lagardere","grade":"1","raceDate":"October, 04 2026 00:00:00","purseUsa":450198,"positionAtFinish":2},{"trackName":"CURRAGH","raceName":"Goffs Vincent OBrien National S.","grade":"1","raceDate":"September, 13 2026 00:00:00","purseUsa":463932,"positionAtFinish":1},{"trackName":"CURRAGH","raceName":"Keeneland Phoenix S.","grade":"1","raceDate":"August, 09 2026 00:00:00","purseUsa":462355,"positionAtFinish":2},{"trackName":"LEOPARDSTOWN","raceName":"Japan Racing Association Tyros S.","grade":"3","raceDate":"July, 23 2026 00:00:00","purseUsa":79886,"positionAtFinish":2},{"trackName":"GOWRAN PARK","raceName":"Irish Stallion Farms E.B.F.","grade":" ","raceDate":"June, 12 2026 00:00:00","purseUsa":25474,"positionAtFinish":1},{"trackName":"CURRAGH","raceName":"Tally Ho Stud Irish E.B.F.","grade":" ","raceDate":"May, 23 2026 00:00:00","purseUsa":29006,"positionAtFinish":3}],"record":{"previousYear":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"breedersCup":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"currentYear":{"starts":6,"earnings":496240,"show":1,"win":2,"place":3,"showP":"17","winP":"33","placeP":"50"},"lifetime":{"starts":6,"earnings":496240,"show":1,"win":2,"place":3,"showP":"17","winP":"33","placeP":"50"}},"yearlySummary":[{"showsP":"17","winsP":"33","placesP":"50","starts":6,"earnings":496240,"racingYear":2026,"shows":1,"wins":2,"places":3},{"showsP":"NA","winsP":"NA","placesP":"NA","starts":0,"earnings":0,"racingYear":2025,"shows":0,"wins":0,"places":0}],"morningLineOdds":[],"bio":"\u003cp\u003eFolsom Blues (IRE) earned his free spot in the Brown Advisory Breeders’ Cup Juvenile Turf (G1) field through a Sept. 13 victory in the Vincent O’Brien National Stakes (G1) at the Curragh. \r\u003c/p\u003e\u003cp\u003eThe O’Brien is part of the Breeders’ Cup Challenge “Win and You’re In” series that awards free, guaranteed spots in Breeders’ Cup stakes at the World Championships. \r\u003c/p\u003e\u003cp\u003eBy Blue Point (IRE), the Group 1 winner has two victories and two seconds in five career starts. \r\u003c/p\u003e\u003cp\u003eHe was third in his May 23 debut at the Curragh and then moved to Gowran Park for a June 12 maiden win by 7 1/2 lengths. \r\u003c/p\u003e\u003cp\u003eMoved into stakes company, he was second by 1 ¼ lengths when he rallied from the rear in the Tyros Stakes (G3) at Leopardstown on July 23. \r\u003c/p\u003e\u003cp\u003eHe returned to the Curragh and was bumped in the final furlong while second in the Phoenix Stakes (G1). \r\u003c/p\u003e\u003cp\u003eIn the O’Brien, he drew off powerfully in the stretch to win by 6 lengths, covering 7 furlongs in 1:27.80 on yielding turf. \r\u003c/p\u003e\u003cp\u003eFolsom Blues is trained by Joseph Patrick O’Brien and is owned and bred by Al Shira’Aa Racing Limited. He is out of the Oasis Dream (GB) mare Liwa Palace (GB).\u0026nbsp;\u003c/p\u003e","gradedStakesPoints":0,"regionWinnerBadges":[],"breederName":"Al Shira'aa Racing Limited","uid":"bltf5c5d83b84d022d1","hasAutogeneratedPage":true,"url":"/redirect/horse/bltf5c5d83b84d022d1?ht=pre-entries","pageTitle":"Folsom Blues (IRE)","jockeyName":"","ownerName":"Al Shira’aa Racing Limited (Kieran Lalor)","trainer":"Joseph Patrick O'Brien","country":{"uid":"blta32e5b692b12a246","title":"Ireland","abbreviation":"IRE","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt613f9a736c40223a/61aa4c2b2f8b9e70946988d3/ireland.png","alt":""}},"horseName":"Folsom Blues","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt6a753782dbd67e6e/6aabf9dccbcf224b1c8f39f1/Contender_Photo_Folsom_Blues.jpg"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt6a753782dbd67e6e/6aabf9dccbcf224b1c8f39f1/Contender_Photo_Folsom_Blues.jpg"},"cta":null,"races":[{"uid":"blt6bf61f758c07022b","ContentTypeUid":"collection_race","challengeSeriesWinner":false,"isEligible":false,"eligibleRank":null,"finishPosition":null,"classicRanking":null,"postPosition":"","scratched":false,"win":"","place":"","show":"","deadHeat":false,"silks":null}],"isChallengeSeriesWinner":true,"silks":null,"isHoC":false,"year":2026,"isHistoricalEntry":false,"relatedArticles":[],"win":"","show":"","place":""},{"sireName":"Persian Force (IRE)","damName":"Princess Rose (GB)","sex":"Colt","color":"Bay","foalingDate":"March, 19 2024 00:00:00","age":2,"pastPerformances":[{"trackName":"NEWMARKET","raceName":"Tattersalls Middle Park S.","grade":"1","raceDate":"September, 26 2026 00:00:00","purseUsa":364236,"positionAtFinish":2},{"trackName":"DUNDALK","raceName":"Irish Stallion Farms E.B.F.","grade":" ","raceDate":"September, 18 2026 00:00:00","purseUsa":25247,"positionAtFinish":1},{"trackName":"ASCOT","raceName":"Norfolk S.","grade":"2","raceDate":"June, 20 2026 00:00:00","purseUsa":231602,"positionAtFinish":17},{"trackName":"NAAS","raceName":"Irish E.B.F. Median Sires Series","grade":" ","raceDate":"April, 27 2026 00:00:00","purseUsa":29245,"positionAtFinish":1},{"trackName":"CURRAGH","raceName":"Topgear At Capital Stud Irish E.B.F.","grade":" ","raceDate":"March, 15 2026 00:00:00","purseUsa":25222,"positionAtFinish":2}],"record":{"previousYear":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"breedersCup":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"currentYear":{"starts":5,"earnings":115173,"show":0,"win":2,"place":2,"showP":"0","winP":"40","placeP":"40"},"lifetime":{"starts":5,"earnings":115173,"show":0,"win":2,"place":2,"showP":"0","winP":"40","placeP":"40"}},"yearlySummary":[{"showsP":"0","winsP":"40","placesP":"40","starts":5,"earnings":115173,"racingYear":2026,"shows":0,"wins":2,"places":2},{"showsP":"NA","winsP":"NA","placesP":"NA","starts":0,"earnings":0,"racingYear":2025,"shows":0,"wins":0,"places":0}],"morningLineOdds":[],"bio":"\u003cp\u003eForce Noir (IRE) launched his career at the Curragh on March 15, coming home a close-up second to Ruler’s Control (IRE), who was subsequently fourth in the Windsor Castle Stakes (Listed) at Royal Ascot.\r\u003c/p\u003e\u003cp\u003eFavored in a 5-furlong maiden at Naas on April 27, Force Noir came home a much-the-best 4 ½-length winner over Lady Patrona (GB). Unable to replicate that form when facing the wolves in the Royal meeting’s June 20 Norfolk Stakes (G2) — a “Win and You’re In” for the Breeders’ Cup Juvenile Turf Sprint (G1) -- the Irish-bred was 17th behind winner Orthodox (GB) in the 21-horse field.\r\u003c/p\u003e\u003cp\u003eGiven a three-month respite thereafter, he marked his return with a 2 ½-length score over Hanney Boy (IRE) while negotiating 5 furlongs over the all-weather at Dundalk on Sept. 18 before returning less than two weeks later to finish only a neck behind Orthodox in the Middle Park Stakes (G1) in Newmarket.\r\u003c/p\u003e\u003cp\u003eBred by John Martin McLoughney, the colt, a $152,416 purchase at the Goffs Orby Sale in September 2025, is campaigned by the international horse racing and bloodstock operation Amo Racing, which is led by Kia Joorabchian.\r\u003c/p\u003e","gradedStakesPoints":0,"regionWinnerBadges":[],"breederName":"John Martin McLoughney","uid":"bltfee3cde5aae90b28","hasAutogeneratedPage":true,"url":"/redirect/horse/bltfee3cde5aae90b28?ht=pre-entries","pageTitle":"Force Noir (IRE)","jockeyName":"","ownerName":"Amo Racing USA (Kiavash Joorabchian)","trainer":"Robson De Aguiar","country":{"uid":"blta32e5b692b12a246","title":"Ireland","abbreviation":"IRE","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt613f9a736c40223a/61aa4c2b2f8b9e70946988d3/ireland.png","alt":""}},"horseName":"Force Noir","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt0632e737f3ad4506/6adcb2d35951187f653e088d/Contender_Photo_Force_Noir_.jpg"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt0632e737f3ad4506/6adcb2d35951187f653e088d/Contender_Photo_Force_Noir_.jpg"},"cta":null,"races":[{"uid":"blt6bf61f758c07022b","ContentTypeUid":"collection_race","challengeSeriesWinner":false,"isEligible":false,"eligibleRank":null,"finishPosition":null,"classicRanking":null,"postPosition":"","scratched":false,"win":"","place":"","show":"","deadHeat":false,"silks":null}],"isChallengeSeriesWinner":false,"silks":null,"isHoC":false,"year":2026,"isHistoricalEntry":false,"relatedArticles":[],"win":"","show":"","place":""},{"sireName":"No Nay Never","damName":"Gems (GB)","sex":"Colt","color":"Chestnut","foalingDate":"January, 09 2024 00:00:00","age":2,"pastPerformances":[{"trackName":"NEWMARKET","raceName":"Darley Dewhurst S.","grade":"1","raceDate":"October, 10 2026 00:00:00","purseUsa":661672,"positionAtFinish":3},{"trackName":"CURRAGH","raceName":"Heider Family Stables Round Tower S.","grade":"3","raceDate":"August, 29 2026 00:00:00","purseUsa":81076,"positionAtFinish":2},{"trackName":"ASCOT","raceName":"Coventry S.","grade":"2","raceDate":"June, 16 2026 00:00:00","purseUsa":268252,"positionAtFinish":1},{"trackName":"CURRAGH","raceName":"Kilkea Castle Marble Hill S.","grade":"3","raceDate":"May, 24 2026 00:00:00","purseUsa":81217,"positionAtFinish":1},{"trackName":"CURRAGH","raceName":"Visit The Irish National Stud And Gardens Irish European Breeders Fund Maiden","grade":" ","raceDate":"April, 19 2026 00:00:00","purseUsa":25899,"positionAtFinish":1}],"record":{"previousYear":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"breedersCup":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"currentYear":{"starts":5,"earnings":301737,"show":1,"win":3,"place":1,"showP":"20","winP":"60","placeP":"20"},"lifetime":{"starts":5,"earnings":301737,"show":1,"win":3,"place":1,"showP":"20","winP":"60","placeP":"20"}},"yearlySummary":[{"showsP":"20","winsP":"60","placesP":"20","starts":5,"earnings":301737,"racingYear":2026,"shows":1,"wins":3,"places":1},{"showsP":"NA","winsP":"NA","placesP":"NA","starts":0,"earnings":0,"racingYear":2025,"shows":0,"wins":0,"places":0}],"morningLineOdds":[],"bio":"\u003cp\u003eGreat Barrier Reef has been practically perfect for trainer Aidan O’Brien and the Coolmore partners, winning three of four starts with a second.\r\u003c/p\u003e\u003cp\u003eThe son of No Nay Never suffered his lone setback when he finished second by a neck Aug. 29 in the Round Tower Stakes (G3) at the Curragh. Bidding for a fourth straight win, he showed speed throughout in the 6-furlong test on good turf.\r\u003c/p\u003e\u003cp\u003eGreat Barrier Reef made his first appearance at the races April 19 when he romped by 6 lengths in a 6-furlong maiden race on soft turf at the Curragh.\r\u003c/p\u003e\u003cp\u003eMoved up to stakes company, he dwelt at the start and raced greenly but showed his class in capturing the Marble Hill Stakes (G3) at the Curragh on May 24 on good turf.\r\u003c/p\u003e\u003cp\u003eHe was prominent throughout and posted a third straight win June 16 at Royal Ascot, taking the Coventry Stakes (G2) by a half-length in a field of 21 on good to firm turf.\r\u003c/p\u003e\u003cp\u003eAll four of Great Barrier Reef’s starts were at 6 furlongs.\r\u003c/p\u003e\u003cp\u003eHe is owned by Derrick Smith, Mrs. John Magnier, Michael Tabor and Westerberg and was bred by Barronstown Stud out of the Haafhd (GB) mare Gems (GB). \r\u003c/p\u003e","gradedStakesPoints":0,"regionWinnerBadges":[],"breederName":"Barronstown Stud","uid":"blte065de6a3ee8967b","hasAutogeneratedPage":true,"url":"/redirect/horse/blte065de6a3ee8967b?ht=pre-entries","pageTitle":"Great Barrier Reef (IRE)","jockeyName":"","ownerName":"Derrick Smith, Mrs. John Magnier, Michael Tabor \u0026 Westerberg (Lucia Walder)","trainer":"Aidan P. O'Brien","country":{"uid":"blta32e5b692b12a246","title":"Ireland","abbreviation":"IRE","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt613f9a736c40223a/61aa4c2b2f8b9e70946988d3/ireland.png","alt":""}},"horseName":"Great Barrier Reef","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blte3dc2a8fb5620e03/6abe8527cd0bd98305d4df31/Contender_Photo_Great_Barrier_Reef_.jpg"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blte3dc2a8fb5620e03/6abe8527cd0bd98305d4df31/Contender_Photo_Great_Barrier_Reef_.jpg"},"cta":null,"races":[{"uid":"blt6bf61f758c07022b","ContentTypeUid":"collection_race","challengeSeriesWinner":false,"isEligible":false,"eligibleRank":null,"finishPosition":null,"classicRanking":null,"postPosition":"","scratched":false,"win":"","place":"","show":"","deadHeat":false,"silks":null}],"isChallengeSeriesWinner":false,"silks":null,"isHoC":false,"year":2026,"isHistoricalEntry":false,"relatedArticles":[],"win":"","show":"","place":""},{"sireName":"Justify","damName":"Earth Strike (IRE)","sex":"Colt","color":"Bay","foalingDate":"February, 05 2024 00:00:00","age":2,"pastPerformances":[{"trackName":"TAMPA BAY DOWNS","raceName":" ","grade":" ","raceDate":"March, 12 2023 00:00:00","purseUsa":28000,"positionAtFinish":1},{"trackName":"TAMPA BAY DOWNS","raceName":" ","grade":" ","raceDate":"February, 17 2023 00:00:00","purseUsa":28000,"positionAtFinish":1},{"trackName":"TAMPA BAY DOWNS","raceName":" ","grade":" ","raceDate":"January, 28 2023 00:00:00","purseUsa":28000,"positionAtFinish":2},{"trackName":"TAMPA BAY DOWNS","raceName":" ","grade":" ","raceDate":"December, 21 2022 00:00:00","purseUsa":28000,"positionAtFinish":2},{"trackName":"NEWMARKET","raceName":"Tattersalls Online Royal Lodge S.","grade":"2","raceDate":"September, 26 2026 00:00:00","purseUsa":165562,"positionAtFinish":1},{"trackName":"TAMPA BAY DOWNS","raceName":" ","grade":" ","raceDate":"December, 03 2022 00:00:00","purseUsa":15000,"positionAtFinish":1},{"trackName":"PIMLICO","raceName":" ","grade":" ","raceDate":"September, 24 2022 00:00:00","purseUsa":51440,"positionAtFinish":8},{"trackName":"CURRAGH","raceName":"Goffs Vincent OBrien National S.","grade":"1","raceDate":"September, 13 2026 00:00:00","purseUsa":463932,"positionAtFinish":7},{"trackName":"YORK","raceName":"Tattersalls Acomb S.","grade":"3","raceDate":"August, 19 2026 00:00:00","purseUsa":236813,"positionAtFinish":1},{"trackName":"GOODWOOD","raceName":"Coral Vintage S.","grade":"2","raceDate":"July, 28 2026 00:00:00","purseUsa":265771,"positionAtFinish":2},{"trackName":"NEWMARKET","raceName":"Rossdales British Ebf Maiden Stakes (Class 3)","grade":" ","raceDate":"July, 11 2026 00:00:00","purseUsa":28143,"positionAtFinish":1},{"trackName":"CURRAGH","raceName":"Keadeen Hotel Irish E.B.F.","grade":" ","raceDate":"June, 26 2026 00:00:00","purseUsa":28426,"positionAtFinish":2}],"record":{"previousYear":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"breedersCup":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"currentYear":{"starts":6,"earnings":305205,"show":0,"win":3,"place":2,"showP":"0","winP":"50","placeP":"33"},"lifetime":{"starts":6,"earnings":305205,"show":0,"win":3,"place":2,"showP":"0","winP":"50","placeP":"33"}},"yearlySummary":[{"showsP":"0","winsP":"50","placesP":"33","starts":6,"earnings":305205,"racingYear":2026,"shows":0,"wins":3,"places":2},{"showsP":"NA","winsP":"NA","placesP":"NA","starts":0,"earnings":0,"racingYear":2025,"shows":0,"wins":0,"places":0}],"morningLineOdds":[],"bio":"\u003cp\u003eHaffner earned a free spot in the Brown Advisory Breeders’ Cup Juvenile Turf (G1) through a 2-length win Aug. 19 in the Acomb Stakes (G3) at York, part of the Breeders’ Cup Challenge “Win and You’re In” Series. \r\u003c/p\u003e\u003cp\u003eOwned by Americans Peter Brant and Brook Smith and the Coolmore trio of Mrs. John Magnier, Michael Tabor and Derrick Smith, Haffner has won three of his first six starts for trainer Aidan O’Brien, an eight-time winner of the Juvenile Turf. \r\u003c/p\u003e\u003cp\u003eA son of American Triple Crown champion Justify, Haffner was second by 1 ¾ lengths in his June 26 debut at the Curragh. \r\u003c/p\u003e\u003cp\u003eHe then posted a maiden win July 11 at Newmarket, leading throughout and winning by 1 ½ lengths in a 7-furlong test timed in 1:26.61 on good to firm turf. \r\u003c/p\u003e\u003cp\u003eNext, in the July 28 Coral Vintage Stakes (G2) at Goodwood, he led heading into the final furlong but settled for second by a half-length in the 7-furlong stakes. \r\u003c/p\u003e\u003cp\u003eIn the Acomb, he grabbed the lead with 2 furlongs left and remained in front to prevail by 2 lengths and punch his ticket to the World Championships at Keeneland. Final time for the 7 furlongs was 1:25.96 on good turf. \r\u003c/p\u003e\u003cp\u003eIn his next start, he caught a yielding course at the Curragh on Sept. 13 for the 7-furlong Vincent O’Brien National Stakes (G1) and was a nonthreatening seventh of eight. He rebounded 13 days later at Newmarket in the 1-mile Royal Lodge Stakes (G2) by hitting the front late in posting a 1 1/4-length victory in a field of seven as the favorite. \r\u003c/p\u003e\u003cp\u003eHe was bred in Kentucky by D J Stables and the Justify Syndicate out of the Zoffany (IRE) mare Earth Strike (IRE). He was purchased for $375,000 at the Keeneland September Yearling Sale.\u0026nbsp;\u003c/p\u003e","gradedStakesPoints":0,"regionWinnerBadges":[],"breederName":"D.J. Stables \u0026 Justify Syndicate","uid":"blt13939ecdaed8f055","hasAutogeneratedPage":true,"url":"/redirect/horse/blt13939ecdaed8f055?ht=pre-entries","pageTitle":"Haffner","jockeyName":"","ownerName":"Peter M. Brant, Mrs. John Magnier, Michael Tabor, Derrick Smith, Westerberg (Lucia Walder) \u0026 Brook T. Smith","trainer":"Aidan P. O'Brien","country":{"uid":"blt1af49e3a6a89373f","title":"USA","abbreviation":"USA","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt9de45bbdff160673/60d219911e0505677a882fa1/USAFlag.png"}},"horseName":"Haffner","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blta6dbf0707b4b4dfb/6ac1404ca120e247952d9913/Contender_Photo_Haffner_.jpg"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blta6dbf0707b4b4dfb/6ac1404ca120e247952d9913/Contender_Photo_Haffner_.jpg"},"cta":null,"races":[{"uid":"blt6bf61f758c07022b","ContentTypeUid":"collection_race","challengeSeriesWinner":false,"isEligible":false,"eligibleRank":null,"finishPosition":null,"classicRanking":null,"postPosition":"","scratched":false,"win":"","place":"","show":"","deadHeat":false,"silks":null}],"isChallengeSeriesWinner":true,"silks":null,"isHoC":false,"year":2026,"isHistoricalEntry":false,"relatedArticles":[],"win":"","show":"","place":""},{"sireName":"Munnings","damName":"Into Magic","sex":"Colt","color":"Chestnut","foalingDate":"February, 10 2024 00:00:00","age":2,"pastPerformances":[{"trackName":"KENTUCKY DOWNS","raceName":"Pepsi Kentucky Downs Juvenile Mile S.","grade":" ","raceDate":"September, 09 2026 00:00:00","purseUsa":750000,"positionAtFinish":1},{"trackName":"KENTUCKY DOWNS","raceName":" ","grade":" ","raceDate":"August, 29 2026 00:00:00","purseUsa":250000,"positionAtFinish":1},{"trackName":"SARATOGA","raceName":"Saratoga Special S.","grade":"2","raceDate":"August, 01 2026 00:00:00","purseUsa":250000,"positionAtFinish":3},{"trackName":"CHURCHILL DOWNS","raceName":" ","grade":" ","raceDate":"June, 04 2026 00:00:00","purseUsa":120000,"positionAtFinish":1}],"record":{"previousYear":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"breedersCup":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"currentYear":{"starts":4,"earnings":681584,"show":1,"win":3,"place":0,"showP":"25","winP":"75","placeP":"0"},"lifetime":{"starts":4,"earnings":681584,"show":1,"win":3,"place":0,"showP":"25","winP":"75","placeP":"0"}},"yearlySummary":[{"showsP":"25","winsP":"75","placesP":"0","starts":4,"earnings":681584,"racingYear":2026,"shows":1,"wins":3,"places":0},{"showsP":"NA","winsP":"NA","placesP":"NA","starts":0,"earnings":0,"racingYear":2025,"shows":0,"wins":0,"places":0}],"morningLineOdds":[],"bio":"\u003cp\u003eFew 2-year-olds have shown the talent and versatility of How's Al Today. He has won racing short and long, on dirt and on turf. \r\u003c/p\u003e\u003cp\u003eA winner of his debut over 5 ½ furlongs on dirt June 4 at Churchill Downs, the Gold Square-owned runner then finished a distant third in the Aug. 2 Saratoga Special (G2) at Saratoga. Then he showed an entirely new dimension on turf with two victories during the short Kentucky Downs meet. \r\u003c/p\u003e\u003cp\u003eFirst, he won a 6 ½-furlong sprint Aug. 29 restricted to graduates of the Keeneland September Yearling Sale before wheeling back on short rest and romping by 4 1/2 lengths in the Sept. 7 Kentucky Downs Juvenile Mile (Listed). \r\u003c/p\u003e\u003cp\u003eSeventh early in the latter race under Brian Hernandez Jr., How's Al Today kicked into gear on the turn and began to advance. With about a quarter-mile remaining, Hernandez tipped How's Al Today into a clear path for the stretch run and his mount reeled in the leaders and opened up. How's Al Today won wrapped up in a swift time of 1:34.84. \r\u003c/p\u003e\u003cp\u003eRiley Mott trains the Willis Horton Racing-bred son of Munnings out of the Into Mischief Mare Into Magic.\u0026nbsp;\u003c/p\u003e","gradedStakesPoints":2,"regionWinnerBadges":[],"breederName":"Willis Horton Racing LLC","uid":"blt8e470be9a76d5c11","hasAutogeneratedPage":true,"url":"/redirect/horse/blt8e470be9a76d5c11?ht=pre-entries","pageTitle":"How's Al Today","jockeyName":"","ownerName":"Gold Square LLC (Al Gold)","trainer":"Riley Mott","country":{"uid":"blt1af49e3a6a89373f","title":"USA","abbreviation":"USA","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt9de45bbdff160673/60d219911e0505677a882fa1/USAFlag.png"}},"horseName":"How's Al Today","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt672ea82b4df38b57/6ac3ab5c66fa96ccd0e8ae40/Contender_Photo_How_s_Al_Today_.jpg"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt672ea82b4df38b57/6ac3ab5c66fa96ccd0e8ae40/Contender_Photo_How_s_Al_Today_.jpg"},"cta":null,"races":[{"uid":"blt6bf61f758c07022b","ContentTypeUid":"collection_race","challengeSeriesWinner":false,"isEligible":false,"eligibleRank":null,"finishPosition":null,"classicRanking":null,"postPosition":"","scratched":false,"win":"","place":"","show":"","deadHeat":false,"silks":null}],"isChallengeSeriesWinner":false,"silks":null,"isHoC":false,"year":2026,"isHistoricalEntry":false,"relatedArticles":[],"win":"","show":"","place":""},{"sireName":"Jackie's Warrior","damName":"America's Tale","sex":"Colt","color":"Bay","foalingDate":"April, 02 2024 00:00:00","age":2,"pastPerformances":[{"trackName":"BELMONT PARK","raceName":"Pilgrim S.","grade":"2","raceDate":"October, 03 2026 00:00:00","purseUsa":250000,"positionAtFinish":1},{"trackName":"WOODBINE","raceName":"bet365 Summer S.","grade":"1","raceDate":"September, 12 2026 00:00:00","purseUsa":500000,"positionAtFinish":5},{"trackName":"SARATOGA","raceName":" ","grade":" ","raceDate":"August, 16 2026 00:00:00","purseUsa":115000,"positionAtFinish":1},{"trackName":"SARATOGA","raceName":" ","grade":" ","raceDate":"July, 18 2026 00:00:00","purseUsa":115000,"positionAtFinish":6}],"record":{"previousYear":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"breedersCup":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"currentYear":{"starts":4,"earnings":211409,"show":0,"win":2,"place":0,"showP":"0","winP":"50","placeP":"0"},"lifetime":{"starts":4,"earnings":211409,"show":0,"win":2,"place":0,"showP":"0","winP":"50","placeP":"0"}},"yearlySummary":[{"showsP":"0","winsP":"50","placesP":"0","starts":4,"earnings":211409,"racingYear":2026,"shows":0,"wins":2,"places":0},{"showsP":"NA","winsP":"NA","placesP":"NA","starts":0,"earnings":0,"racingYear":2025,"shows":0,"wins":0,"places":0}],"morningLineOdds":[],"bio":"\u003cp\u003eTrainer Whit Beckman believed Let Em Know would excel on dirt. \r\u003c/p\u003e\u003cp\u003eBut after the 2-year-old son of Jackie’s Warrior finished sixth and last on dirt in his debut, Beckman opted for Plan B and was rewarded with a graded stakes winner and a starter in the Brown Advisory Breeders’ Cup Juvenile Turf (G1) at Keeneland. \r\u003c/p\u003e\u003cp\u003eIn his fourth career start, Let Em Know rallied from fourth and captured the Oct. 3 Pilgrim Stakes (G2) at Belmont Park by a half-length over Roscoe Goose. With the Pilgrim being part of the Breeders’ Cup Challenge Series, the victory earned Let Em Know a free, “Win and You’re In” spot in the Oct. 30 Juvenile Turf. \r\u003c/p\u003e\u003cp\u003eFollowing his dull debut on dirt, Let Em Know moved to turf and recorded a victory by a head over Roscoe Goose in an Aug. 16 maiden race at Saratoga. \r\u003c/p\u003e\u003cp\u003eHe then was shipped to Woodbine, where he finished fifth in the Summer Stakes (G1) on Sept. 12. \r\u003c/p\u003e\u003cp\u003eHe was originally owned by Front Page Equestrian, Anthony Tate and Joe Pickerrell. But after his maiden win, Front Page Equestrian was replaced by Robert Ogilvie and Diamond T Racing. \r\u003c/p\u003e\u003cp\u003eLet Em Know is out of the Gio Ponti mare America’s Tale, a Grade 2 winner. \r\u003c/p\u003e\u003cp\u003eHe was bought for $600,000 at the OBS March Sale of 2-Year-Olds in Training.\u0026nbsp;\u003c/p\u003e","gradedStakesPoints":6,"regionWinnerBadges":[],"breederName":"Dixiana Farms LLC","uid":"blt12567c6846a12866","hasAutogeneratedPage":true,"url":"/redirect/horse/blt12567c6846a12866?ht=pre-entries","pageTitle":"Let Em Know","jockeyName":"","ownerName":"Anthony Tate, B \u0026 E Racing (Erin Ogilvie), Joseph Pickerrell and Diamond T Racing LLC (Victoria Taylor)","trainer":"D. Whitworth Beckman","country":{"uid":"blt1af49e3a6a89373f","title":"USA","abbreviation":"USA","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt9de45bbdff160673/60d219911e0505677a882fa1/USAFlag.png"}},"horseName":"Let Em Know","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/bltd923ca001ca00da0/6ac17f5c9df04b8aa032af74/Contender_Photo_Let_Em_Know.png"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/bltd923ca001ca00da0/6ac17f5c9df04b8aa032af74/Contender_Photo_Let_Em_Know.png"},"cta":null,"races":[{"uid":"blt6bf61f758c07022b","ContentTypeUid":"collection_race","challengeSeriesWinner":false,"isEligible":false,"eligibleRank":null,"finishPosition":null,"classicRanking":null,"postPosition":"","scratched":false,"win":"","place":"","show":"","deadHeat":false,"silks":null}],"isChallengeSeriesWinner":true,"silks":null,"isHoC":false,"year":2026,"isHistoricalEntry":false,"relatedArticles":[],"win":"","show":"","place":""},{"sireName":"No Nay Never","damName":"Pandora (IRE)","sex":"Colt","color":"Bay","foalingDate":"March, 03 2024 00:00:00","age":2,"pastPerformances":[{"trackName":"LONGCHAMP","raceName":"Qatar Prix Jean-Luc Lagardere","grade":"1","raceDate":"October, 04 2026 00:00:00","purseUsa":450198,"positionAtFinish":3},{"trackName":"DEAUVILLE","raceName":"Sumbe Prix Morny","grade":"1","raceDate":"August, 23 2026 00:00:00","purseUsa":408759,"positionAtFinish":4},{"trackName":"GOODWOOD","raceName":"Markel Richmond S.","grade":"2","raceDate":"July, 30 2026 00:00:00","purseUsa":267367,"positionAtFinish":1},{"trackName":"NAAS","raceName":"Matchbook Exchange Irish E.B.F.","grade":" ","raceDate":"July, 22 2026 00:00:00","purseUsa":25076,"positionAtFinish":1},{"trackName":"CURRAGH","raceName":"Keadeen Hotel Irish E.B.F.","grade":" ","raceDate":"June, 26 2026 00:00:00","purseUsa":28426,"positionAtFinish":4}],"record":{"previousYear":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"breedersCup":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"currentYear":{"starts":5,"earnings":242301,"show":1,"win":2,"place":0,"showP":"20","winP":"40","placeP":"0"},"lifetime":{"starts":5,"earnings":242301,"show":1,"win":2,"place":0,"showP":"20","winP":"40","placeP":"0"}},"yearlySummary":[{"showsP":"20","winsP":"40","placesP":"0","starts":5,"earnings":242301,"racingYear":2026,"shows":1,"wins":2,"places":0},{"showsP":"NA","winsP":"NA","placesP":"NA","starts":0,"earnings":0,"racingYear":2025,"shows":0,"wins":0,"places":0}],"morningLineOdds":[],"bio":"\u003cp\u003eMan’s Best Friend (IRE) is one of the hopefuls that could give trainer Aidan O’Brien and the Coolmore partners of Michael Tabor, Derek Smith and Mrs. John Magnier a record-extending fifth straight win in the Brown Advisory Breeders’ Cup Juvenile Turf (G1).\r\u003c/p\u003e\u003cp\u003eSince 2011, they have dominated the stakes with eight wins apiece, seven of them together.\r\u003c/p\u003e\u003cp\u003eMan’s Best Friend won two of his first three career starts, including a Group 2 stakes.\r\u003c/p\u003e\u003cp\u003eAfter a fourth in his June 26 debut at the Curragh, the son of No Nay Never captured a July 22 maiden race at Nats, leading most of the way to win by 2 1/4 lengths at 6 furlongs.\r\u003c/p\u003e\u003cp\u003eEight days later, he returned at Goodwood in the Markel Richmond Stakes (G2) and posted a 2-length victory at 6 furlongs on good-to-firm turf. After an awkward start, he ran on well in the final 110 yards to claim the Group 2 win.\r\u003c/p\u003e\u003cp\u003eStretching out to 7 furlongs in his next start, the Prix Jean-Luc Lagardere (G1) at Parislongchamp on Oct. 4, Man’s Best Friend was in touch with the field of 10 throughout before winding up third beaten 3 lengths.\r\u003c/p\u003e\u003cp\u003eWesterberg also owns a share of the son of the Galileo (IRE) mare Pandora (IRE) bred by Newstead Breeding.\r\u003c/p\u003e","gradedStakesPoints":0,"regionWinnerBadges":[],"breederName":"Newstead Breeding","uid":"blt1be680eabae38c98","hasAutogeneratedPage":true,"url":"/redirect/horse/blt1be680eabae38c98?ht=pre-entries","pageTitle":"Man's Best Friend (IRE)","jockeyName":"","ownerName":"Michael Tabor, Derrick Smith, Mrs. John Magnier \u0026 Westerberg (Lucia Walder)","trainer":"Aidan P. O'Brien","country":{"uid":"blta32e5b692b12a246","title":"Ireland","abbreviation":"IRE","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt613f9a736c40223a/61aa4c2b2f8b9e70946988d3/ireland.png","alt":""}},"horseName":"Man's Best Friend","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt4169377fa4aeb918/6ac3b9226c775615ed646a3a/Contender_Photo_Man_s_Best_Friend.png"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt4169377fa4aeb918/6ac3b9226c775615ed646a3a/Contender_Photo_Man_s_Best_Friend.png"},"cta":null,"races":[{"uid":"blt6bf61f758c07022b","ContentTypeUid":"collection_race","challengeSeriesWinner":false,"isEligible":false,"eligibleRank":null,"finishPosition":null,"classicRanking":null,"postPosition":"","scratched":false,"win":"","place":"","show":"","deadHeat":false,"silks":null}],"isChallengeSeriesWinner":false,"silks":null,"isHoC":false,"year":2026,"isHistoricalEntry":false,"relatedArticles":[],"win":"","show":"","place":""},{"sireName":"Oscar Performance","damName":"Catbrier","sex":"Colt","color":"Bay","foalingDate":"April, 22 2024 00:00:00","age":2,"pastPerformances":[{"trackName":"WOODBINE","raceName":"bet365 Summer S.","grade":"1","raceDate":"September, 12 2026 00:00:00","purseUsa":500000,"positionAtFinish":2},{"trackName":"SARATOGA","raceName":" ","grade":" ","raceDate":"August, 08 2026 00:00:00","purseUsa":115000,"positionAtFinish":1}],"record":{"previousYear":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"breedersCup":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"currentYear":{"starts":2,"earnings":135337,"show":0,"win":1,"place":1,"showP":"0","winP":"50","placeP":"50"},"lifetime":{"starts":2,"earnings":135337,"show":0,"win":1,"place":1,"showP":"0","winP":"50","placeP":"50"}},"yearlySummary":[{"showsP":"0","winsP":"50","placesP":"50","starts":2,"earnings":135337,"racingYear":2026,"shows":0,"wins":1,"places":1},{"showsP":"NA","winsP":"NA","placesP":"NA","starts":0,"earnings":0,"racingYear":2025,"shows":0,"wins":0,"places":0}],"morningLineOdds":[],"bio":"\u003cp\u003eIn just two career starts, Oscar has earned himself a prime spot in the mix for the Brown Advisory Breeders’ Cup Juvenile Turf (G1).\r\u003c/p\u003e\u003cp\u003eTrained by Miguel Clement, Oscar debuted Aug. 8 at Saratoga in a 1 1/16-mile maiden race on turf in which he was sent off as the 2-1 favorite.\r\u003c/p\u003e\u003cp\u003eThe son of Oscar Performance was fourth, motored to the front in the stretch and held off a strong, late charge by Bold Leadership to prevail by a nose.\r\u003c/p\u003e\u003cp\u003eShipped to Woodbine in Canada for the Sept. 12 Summer Stakes (G1) to take aim at a free Breeders’ Cup Challenge Series “Win and You’re In” berth in the Breeders’ Cup Juvenile Turf, Oscar rallied from fourth but settled for second behind Al Hudaiba (GB) by 1 ¾ lengths.\r\u003c/p\u003e\u003cp\u003eOscar is owned by Elements Racing and Hoolie Racing Stable.\r\u003c/p\u003e\u003cp\u003eHe was bred by Messingw Farm in Kentucky out of the Street Sense mare Catbrier. \r\u003c/p\u003e","gradedStakesPoints":6,"regionWinnerBadges":[],"breederName":"Mesingw Farm LLC","uid":"blt919c49441295ab8b","hasAutogeneratedPage":true,"url":"/redirect/horse/blt919c49441295ab8b?ht=pre-entries","pageTitle":"Oscar","jockeyName":"","ownerName":"Elements Racing LLC (Stephen Smith) and Hoolie Racing Stable, LLC (Andrew Hudson)","trainer":"Miguel Clement","country":{"uid":"blt1af49e3a6a89373f","title":"USA","abbreviation":"USA","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt9de45bbdff160673/60d219911e0505677a882fa1/USAFlag.png"}},"horseName":"Oscar","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/bltd3244bd2b49e186c/6ace42fe9355c019487ab789/Contender_Photo_Oscar_.jpg"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/bltd3244bd2b49e186c/6ace42fe9355c019487ab789/Contender_Photo_Oscar_.jpg"},"cta":null,"races":[{"uid":"blt6bf61f758c07022b","ContentTypeUid":"collection_race","challengeSeriesWinner":false,"isEligible":false,"eligibleRank":null,"finishPosition":null,"classicRanking":null,"postPosition":"","scratched":false,"win":"","place":"","show":"","deadHeat":false,"silks":null}],"isChallengeSeriesWinner":false,"silks":null,"isHoC":false,"year":2026,"isHistoricalEntry":false,"relatedArticles":[],"win":"","show":"","place":""},{"sireName":"Frankel (GB)","damName":"Bocca Baciata (IRE)","sex":"Colt","color":"Bay","foalingDate":"March, 22 2024 00:00:00","age":2,"pastPerformances":[{"trackName":"LEOPARDSTOWN","raceName":"HKJC World Pool Golden Fleece S.","grade":"1","raceDate":"September, 12 2026 00:00:00","purseUsa":463950,"positionAtFinish":4},{"trackName":"HAMILTON PARK","raceName":"Why Settle Technology Ai Adoption Ebf Maiden Stakes (Class 3) (Hamilton 2yo Series Qualifier) (Gbb/gbbplus Race)","grade":" ","raceDate":"August, 21 2026 00:00:00","purseUsa":18401,"positionAtFinish":1},{"trackName":"GOODWOOD","raceName":"Coral Vintage S.","grade":"2","raceDate":"July, 28 2026 00:00:00","purseUsa":265771,"positionAtFinish":4},{"trackName":"NEWMARKET","raceName":"Boodles Superlative S.","grade":"2","raceDate":"July, 11 2026 00:00:00","purseUsa":167517,"positionAtFinish":3},{"trackName":"ASCOT","raceName":"Chesham S.","grade":" ","raceDate":"June, 18 2026 00:00:00","purseUsa":166181,"positionAtFinish":5},{"trackName":"THIRSK","raceName":"Enter Itv7 For Free Novice Stakes (Class 3) (Gbb Race)","grade":" ","raceDate":"May, 31 2026 00:00:00","purseUsa":25569,"positionAtFinish":2}],"record":{"previousYear":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"breedersCup":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"currentYear":{"starts":6,"earnings":70952,"show":1,"win":1,"place":1,"showP":"17","winP":"17","placeP":"17"},"lifetime":{"starts":6,"earnings":70952,"show":1,"win":1,"place":1,"showP":"17","winP":"17","placeP":"17"}},"yearlySummary":[{"showsP":"17","winsP":"17","placesP":"17","starts":6,"earnings":70952,"racingYear":2026,"shows":1,"wins":1,"places":1},{"showsP":"NA","winsP":"NA","placesP":"NA","starts":0,"earnings":0,"racingYear":2025,"shows":0,"wins":0,"places":0}],"morningLineOdds":[],"bio":"\u003cp\u003ePikachu (GB) heads to the Brown Advisory Breeders’ Cup Juvenile Turf (G1) with sufficient experience in distance races.\r\u003c/p\u003e\u003cp\u003eHe is coming off two European races, both at distances longer than the mile of the Breeders’ Cup Juvenile Turf.\r\u003c/p\u003e\u003cp\u003eTwo starts back, in his fifth career start, he broke his maiden impressively, leading throughout and scoring in an Aug. 21 race at Hamilton by 12 lengths at a distance of about 1 1/16 miles on good to soft turf.\r\u003c/p\u003e\u003cp\u003eEntered in a Group stakes off that triumph, he pressed the leaders until the final furlong and finished fourth in the Golden Fleece Stakes (G1) at Leopardstown on Sept. 12 at a 1 1/8-mile distance.\r\u003c/p\u003e\u003cp\u003eWhile a maiden, he ran twice in Group stakes.\r\u003c/p\u003e\u003cp\u003eHe showed speed in the Superlative Stakes (G2) but finished third.\r\u003c/p\u003e\u003cp\u003eIn the 7-furlong Coral Vintage Stakes (G2), he led early but settled for fourth.\r\u003c/p\u003e\u003cp\u003eOwned Amo Racing Limited and trained by Charlie Johnston, he was bred by Yulong Investments.\r\u003c/p\u003e\u003cp\u003eA son of the undefeated champion Frankel (GB), he is out of the Group 2-winning mare Bocca Baciata (IRE) and was bought for $637,169 at the Tattersalls October Yearling Sale (Book 1). \r\u003c/p\u003e","gradedStakesPoints":0,"regionWinnerBadges":[],"breederName":"Yu Long Investments","uid":"bltc9f4fdcc43d1b534","hasAutogeneratedPage":true,"url":"/redirect/horse/bltc9f4fdcc43d1b534?ht=pre-entries","pageTitle":"Pikachu (GB)","jockeyName":"","ownerName":"Amo Racing USA (Kiavash Joorabchian)","trainer":"Charlie Johnston","country":{"uid":"blt440e3ce320965a9b","title":"United Kingdom / England","abbreviation":"GBR","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt02676e7705186e63/61aa4e462e86841fa22388f0/united-kingdom.png","alt":""}},"horseName":"Pikachu","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blta0456c6065c4e44c/6ac922cd40733338ce615f3a/Contender_Photo_Pickachu.jpg"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blta0456c6065c4e44c/6ac922cd40733338ce615f3a/Contender_Photo_Pickachu.jpg"},"cta":null,"races":[{"uid":"blt6bf61f758c07022b","ContentTypeUid":"collection_race","challengeSeriesWinner":false,"isEligible":false,"eligibleRank":null,"finishPosition":null,"classicRanking":null,"postPosition":"","scratched":false,"win":"","place":"","show":"","deadHeat":false,"silks":null}],"isChallengeSeriesWinner":false,"silks":null,"isHoC":false,"year":2026,"isHistoricalEntry":false,"relatedArticles":[],"win":"","show":"","place":""},{"sireName":"Colonel Liam","damName":"Quickasakitten","sex":"Colt","color":"Bay","foalingDate":"February, 11 2024 00:00:00","age":2,"pastPerformances":[{"trackName":"SARATOGA","raceName":"With Anticipation S.","grade":"3","raceDate":"September, 05 2026 00:00:00","purseUsa":225000,"positionAtFinish":1},{"trackName":"SARATOGA","raceName":" ","grade":" ","raceDate":"July, 12 2026 00:00:00","purseUsa":115000,"positionAtFinish":1},{"trackName":"BELMONT AT THE BIG A","raceName":" ","grade":" ","raceDate":"May, 24 2026 00:00:00","purseUsa":85000,"positionAtFinish":4}],"record":{"previousYear":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"breedersCup":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"currentYear":{"starts":3,"earnings":192100,"show":0,"win":2,"place":0,"showP":"0","winP":"67","placeP":"0"},"lifetime":{"starts":3,"earnings":192100,"show":0,"win":2,"place":0,"showP":"0","winP":"67","placeP":"0"}},"yearlySummary":[{"showsP":"0","winsP":"67","placesP":"0","starts":3,"earnings":192100,"racingYear":2026,"shows":0,"wins":2,"places":0},{"showsP":"NA","winsP":"NA","placesP":"NA","starts":0,"earnings":0,"racingYear":2025,"shows":0,"wins":0,"places":0}],"morningLineOdds":[],"bio":"\u003cp\u003eLiam’s Law earned graded stakes laurels Sept. 5 at Saratoga when he narrowly prevailed in the With Anticipation Stakes (G3) on turf. \r\u003c/p\u003e\u003cp\u003eThe 2-year-old son of two-time Pegasus World Cup Turf (G1) winner Colonel Liam faced only two rivals in the With Anticipation, but he worked hard for the victory. \r\u003c/p\u003e\u003cp\u003eLiam’s Law set the pace in the 1 1/16-mile With Anticipation then had to fend off a determined late charge from stablemate Bold Leadership to prevail by a neck. \r\u003c/p\u003e\u003cp\u003eHe was timed in 1:42.59 on firm turf. \r\u003c/p\u003e\u003cp\u003eOwned by Lawana and Robert Low, Kiam’s Law is trained by Hall of Famer Todd Pletcher. \r\u003c/p\u003e\u003cp\u003e\u0026nbsp;in a race originally scheduled for turf but moved to a sloppy, sealed main track because of rain. He wound up fourth, 12 ½ lengths behind. \r\u003c/p\u003e\u003cp\u003eIn his second start, he made his delayed turf debut and registered a front-running, 1 ¼-length win in a July 12 maiden race at Saratoga. \r\u003c/p\u003e\u003cp\u003eLiam’s Law was bred in Florida by Ocala Stud out of the Kitten’s Joy mare Quickasakitten. \u0026nbsp;\r\u003c/p\u003e\u003cp\u003eHe was bought for $120,000 at the OBS March Sale of 2-Year-Olds in Training.\u0026nbsp;\u003c/p\u003e","gradedStakesPoints":4,"regionWinnerBadges":[],"breederName":"Ocala Stud","uid":"bltf268b9535eb00e88","hasAutogeneratedPage":true,"url":"/redirect/horse/bltf268b9535eb00e88?ht=pre-entries","pageTitle":"Liam's Law","jockeyName":"","ownerName":"Robert \u0026 Lawana Low","trainer":"Todd A. Pletcher","country":{"uid":"blt1af49e3a6a89373f","title":"USA","abbreviation":"USA","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt9de45bbdff160673/60d219911e0505677a882fa1/USAFlag.png"}},"horseName":"Liam's Law","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt519bfd05c3fb5eb2/6ac140a7302264f104bb3f43/Contender_Photo_Liam_s_Law_.jpg"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt519bfd05c3fb5eb2/6ac140a7302264f104bb3f43/Contender_Photo_Liam_s_Law_.jpg"},"cta":null,"races":[{"uid":"blt6bf61f758c07022b","ContentTypeUid":"collection_race","challengeSeriesWinner":false,"isEligible":true,"eligibleRank":15,"finishPosition":null,"classicRanking":null,"postPosition":"15","scratched":false,"win":"","place":"","show":"","deadHeat":false,"silks":null}],"isChallengeSeriesWinner":false,"silks":null,"isHoC":false,"year":2026,"isHistoricalEntry":false,"relatedArticles":[],"win":"","show":"","place":""},{"sireName":"Scalding","damName":"Right to Freedom","sex":"Colt","color":"Bay","foalingDate":"February, 11 2024 00:00:00","age":2,"pastPerformances":[{"trackName":"WOODBINE","raceName":"bet365 Summer S.","grade":"1","raceDate":"September, 12 2026 00:00:00","purseUsa":500000,"positionAtFinish":3},{"trackName":"COLONIAL DOWNS","raceName":" ","grade":" ","raceDate":"August, 09 2026 00:00:00","purseUsa":70000,"positionAtFinish":1}],"record":{"previousYear":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"breedersCup":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"currentYear":{"starts":2,"earnings":78044,"show":1,"win":1,"place":0,"showP":"50","winP":"50","placeP":"0"},"lifetime":{"starts":2,"earnings":78044,"show":1,"win":1,"place":0,"showP":"50","winP":"50","placeP":"0"}},"yearlySummary":[{"showsP":"50","winsP":"50","placesP":"0","starts":2,"earnings":78044,"racingYear":2026,"shows":1,"wins":1,"places":0},{"showsP":"NA","winsP":"NA","placesP":"NA","starts":0,"earnings":0,"racingYear":2025,"shows":0,"wins":0,"places":0}],"morningLineOdds":[],"bio":"\u003cp\u003eInduction enters the Brown Advisory Breeders’ Cup Juvenile Turf (G1) off a tough trip when third in the Summer Stakes (G1).\r\u003c/p\u003e\u003cp\u003eA Pin Oak Stud homebred by Scalding, Induction showed promise in his Aug. 9 career debut at Colonial Downs. Running in a mile turf race, he drew off at the end to win by 2 lengths.\r\u003c/p\u003e\u003cp\u003eThe victory encouraged trainer Graham Motion to enter him in the Sept. 12 Summer Stakes at Woodbine with a free, Breeders’ Cup Challenge Series “Win and You’re In” spot in the Breeders’ Cup Juvenile Turf (G1) on the line.\r\u003c/p\u003e\u003cp\u003eLast of eight in the early stages of the mile turf stakes, he swung out for the stretch run but then was carried out and was forced to rally six-wide.\r\u003c/p\u003e\u003cp\u003eHe finished third by 2 1/2 lengths behind European shipper Al Hudaiba (GB).\r\u003c/p\u003e\u003cp\u003eInduction is out of the stakes-placed Constitution mare Right to Freedom.\r\u003c/p\u003e\u003cp\u003eInduction’s debut win was especially satisfying for Pin Oak, which stands freshman sire Scalding and Induction served as his first winner. \r\u003c/p\u003e","gradedStakesPoints":0,"regionWinnerBadges":[],"breederName":"Pin Oak Stud, LLC","uid":"bltdfa530433eea4eff","hasAutogeneratedPage":true,"url":"/redirect/horse/bltdfa530433eea4eff?ht=pre-entries","pageTitle":"Induction","jockeyName":"","ownerName":"Pin Oak Stud, LLC (Dana Bernard)","trainer":"H. Graham Motion","country":{"uid":"blt1af49e3a6a89373f","title":"USA","abbreviation":"USA","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt9de45bbdff160673/60d219911e0505677a882fa1/USAFlag.png"}},"horseName":"Induction","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blte66e7c3f33facf3b/6334cddf4df1082a16b60e31/Fallback_Horse_Image.png"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blte66e7c3f33facf3b/6334cddf4df1082a16b60e31/Fallback_Horse_Image.png"},"cta":null,"races":[{"uid":"blt6bf61f758c07022b","ContentTypeUid":"collection_race","challengeSeriesWinner":false,"isEligible":true,"eligibleRank":16,"finishPosition":null,"classicRanking":null,"postPosition":"16","scratched":false,"win":"","place":"","show":"","deadHeat":false,"silks":null}],"isChallengeSeriesWinner":false,"silks":null,"isHoC":false,"year":2026,"isHistoricalEntry":false,"relatedArticles":[],"win":"","show":"","place":""},{"sireName":"Bayside Boy (IRE)","damName":"Bayja (IRE)","sex":"Colt","color":"Chestnut","foalingDate":"April, 08 2024 00:00:00","age":2,"pastPerformances":[{"trackName":"FAIR GROUNDS","raceName":" ","grade":" ","raceDate":"February, 15 2025 00:00:00","purseUsa":55000,"positionAtFinish":3},{"trackName":"FAIR GROUNDS","raceName":" ","grade":" ","raceDate":"January, 04 2025 00:00:00","purseUsa":59000,"positionAtFinish":4},{"trackName":"CHURCHILL DOWNS","raceName":" ","grade":" ","raceDate":"December, 01 2024 00:00:00","purseUsa":127000,"positionAtFinish":4},{"trackName