usic City S.","grade":"2","raceDate":"September, 06 2025 00:00:00","purseUsa":2000000,"positionAtFinish":4},{"trackName":"SARATOGA","raceName":"Lake George S. Presented by Surfside","grade":"3","raceDate":"July, 26 2025 00:00:00","purseUsa":175000,"positionAtFinish":2},{"trackName":"SARATOGA","raceName":"Wild Applause S.","grade":" ","raceDate":"July, 03 2025 00:00:00","purseUsa":150000,"positionAtFinish":1},{"trackName":"CHURCHILL DOWNS","raceName":"Regret S.","grade":"3","raceDate":"May, 31 2025 00:00:00","purseUsa":275000,"positionAtFinish":7},{"trackName":"CHURCHILL DOWNS","raceName":" ","grade":" ","raceDate":"April, 30 2025 00:00:00","purseUsa":127000,"positionAtFinish":1},{"trackName":"GULFSTREAM PARK","raceName":"Sanibel Island S.","grade":" ","raceDate":"March, 29 2025 00:00:00","purseUsa":165000,"positionAtFinish":4},{"trackName":"GULFSTREAM PARK","raceName":"Herecomesthebride S.","grade":"3","raceDate":"March, 01 2025 00:00:00","purseUsa":215000,"positionAtFinish":4},{"trackName":"GULFSTREAM PARK","raceName":" ","grade":" ","raceDate":"January, 26 2025 00:00:00","purseUsa":89000,"positionAtFinish":1},{"trackName":"GULFSTREAM PARK","raceName":" ","grade":" ","raceDate":"December, 22 2024 00:00:00","purseUsa":65000,"positionAtFinish":4}],"record":{"previousYear":{"starts":10,"earnings":448185,"show":1,"win":3,"place":2,"showP":"10","winP":"30","placeP":"20"},"breedersCup":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"currentYear":{"starts":6,"earnings":1512830,"show":1,"win":3,"place":1,"showP":"17","winP":"50","placeP":"17"},"lifetime":{"starts":17,"earnings":1962615,"show":2,"win":6,"place":3,"showP":"12","winP":"35","placeP":"18"}},"yearlySummary":[{"showsP":"17","winsP":"50","placesP":"17","starts":6,"earnings":1512830,"racingYear":2026,"shows":1,"wins":3,"places":1},{"showsP":"10","winsP":"30","placesP":"20","starts":10,"earnings":448185,"racingYear":2025,"shows":1,"wins":3,"places":2}],"morningLineOdds":[],"bio":"\u003cp\u003eClassic Q proved once again that she is a top-class filly when she rallied through the lane in the late stages of the First Lady (G1) at Keeneland to win by a margin of inches and claim her second top-level victory of the year and of her career. \"She amazes me,\" said trainer Mark Casse, a dual Hall of Fame member. \r\u003c/p\u003e\u003cp\u003eFollowing a protracted photo finish, the gray 4-year-old daughter of Grade 1 winner Classic Empire, who also was conditioned by Casse, was declared the winner of the 1-mile test on the turf over Lush Lips (GB). Her come-from-behind the pace was a change in tactics from her front-running tallies in the Distaff Turf Mile (G2) at Churchill Downs in May and the Just a Game (G1) at 1 mile on the Saratoga green in June. \r\u003c/p\u003e\u003cp\u003eIn the First Lady she bounced back from a third-place finish behind Bless the Broken in the Ladies Turf (G2) at Kentucky Downs in September. Casse originally thought to run the filly against the boys in the FanDuel Breeders' Cup Mile (G1) but ultimately decided to keep her with her own gender in the Maker's Mark Filly \u0026amp; Mare Turf (G1), which will be her final race before entrance in the Fasig-Tipton November Sale \r\u003c/p\u003e\u003cp\u003eClassic Q is out of the Scat Daddy mare Lovely Em and is owned by the partnership of Gary Barber, Blue Crevalle Racing and Eclipse Thoroughbred Partners. Originally purchased as a yearling for $40,000, she has earned $1.96 million.\u0026nbsp;\u003c/p\u003e","gradedStakesPoints":30,"regionWinnerBadges":[],"breederName":"Winning Bloodstock","uid":"bltcf1cb8a9b6f7184f","hasAutogeneratedPage":true,"url":"/redirect/horse/bltcf1cb8a9b6f7184f?ht=pre-entries","pageTitle":"Classic Q","jockeyName":"","ownerName":"Gary Barber, Blue Crevalle Racing (Hugh Dailey) \u0026 Eclipse Thoroughbred Partners (Aron Wellman)","trainer":"Mark E. Casse","country":{"uid":"blt1af49e3a6a89373f","title":"USA","abbreviation":"USA","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt9de45bbdff160673/60d219911e0505677a882fa1/USAFlag.png"}},"horseName":"Classic Q","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/bltf5d9b1f0f1d3b47e/6ac68b121cd7466a3717d62b/Contender_Photo_Classic_Q_.jpg"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/bltf5d9b1f0f1d3b47e/6ac68b121cd7466a3717d62b/Contender_Photo_Classic_Q_.jpg"},"cta":null,"races":[{"uid":"bltc3fc513333460ff5","ContentTypeUid":"collection_race","challengeSeriesWinner":false,"isEligible":false,"eligibleRank":null,"finishPosition":null,"classicRanking":null,"postPosition":"","scratched":false,"win":"","place":"","show":"","deadHeat":false,"silks":null}],"isChallengeSeriesWinner":false,"silks":null,"isHoC":false,"year":2026,"isHistoricalEntry":false,"relatedArticles":[],"win":"","show":"","place":""},{"sireName":"St Mark's Basilica (FR)","damName":"Prudenzia (IRE)","sex":"Filly","color":"Bay","foalingDate":"February, 09 2023 00:00:00","age":3,"pastPerformances":[{"trackName":"LONGCHAMP","raceName":"Qatar Prix de l'Arc de Triomphe","grade":"1","raceDate":"October, 04 2026 00:00:00","purseUsa":5627478,"positionAtFinish":3},{"trackName":"DEAUVILLE","raceName":"Sumbe Prix Jean Et Louis Romanet","grade":"1","raceDate":"August, 23 2026 00:00:00","purseUsa":467153,"positionAtFinish":2},{"trackName":"GOODWOOD","raceName":"Qatar Nassau S.","grade":"1","raceDate":"July, 30 2026 00:00:00","purseUsa":802100,"positionAtFinish":1},{"trackName":"CHANTILLY","raceName":"Prix de Diane Longines","grade":"1","raceDate":"June, 14 2026 00:00:00","purseUsa":1156971,"positionAtFinish":1},{"trackName":"LONGCHAMP","raceName":"Emirates Poule d'Essai des Pouliches","grade":"1","raceDate":"May, 10 2026 00:00:00","purseUsa":648271,"positionAtFinish":1},{"trackName":"LONGCHAMP","raceName":"Qatar Prix Marcel Boussac - Criterium des Pouliches","grade":"1","raceDate":"October, 05 2025 00:00:00","purseUsa":469607,"positionAtFinish":1},{"trackName":"LEOPARDSTOWN","raceName":"Ballylinch Stud Irish E.B.F. Ingabelle S.","grade":" ","raceDate":"September, 13 2025 00:00:00","purseUsa":142000,"positionAtFinish":1},{"trackName":"CURRAGH","raceName":"Grand Hotel Malahide Irish E.B.F.","grade":" ","raceDate":"August, 09 2025 00:00:00","purseUsa":37254,"positionAtFinish":1}],"record":{"previousYear":{"starts":3,"earnings":359554,"show":0,"win":3,"place":0,"showP":"0","winP":"100","placeP":"0"},"breedersCup":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"currentYear":{"starts":5,"earnings":2236398,"show":1,"win":3,"place":1,"showP":"20","winP":"60","placeP":"20"},"lifetime":{"starts":8,"earnings":2595952,"show":1,"win":6,"place":1,"showP":"13","winP":"75","placeP":"13"}},"yearlySummary":[{"showsP":"20","winsP":"60","placesP":"20","starts":5,"earnings":2236398,"racingYear":2026,"shows":1,"wins":3,"places":1},{"showsP":"0","winsP":"100","placesP":"0","starts":3,"earnings":359554,"racingYear":2025,"shows":0,"wins":3,"places":0}],"morningLineOdds":[],"bio":"\u003cp\u003eDiamond Necklace (IRE) has put together an impressive resume. The 3-year-old filly began the year with a win in the May 10 Poule d'Essai Des Pouliches (G1) at Longchamp. She took the French equivalent of England’s 1,000 Guineas (G1) by 3 lengths. \r\u003c/p\u003e\u003cp\u003eFollowing that win, Diamond Necklace won the June 14 Prix de Diane Longines (G1), or the French Oaks, at Chantilly by a neck. \r\u003c/p\u003e\u003cp\u003eFor her next start, Diamond Necklace headed to Goodwood in England for the July 30 Nassau Stakes (G1), which she won by 2 ¾ lengths. \u0026nbsp;\r\u003c/p\u003e\u003cp\u003eDiamond Necklace then finished second in the Aug. 23 Prix Jean et Louis Romanet (G1) behind Aventure (IRE). On Oct. 4, she finished third in the Prix de l’Arc de Triomphe (G1) behind Daryz (FR) and Bay City Roller (IRE). \u0026nbsp;\r\u003c/p\u003e\u003cp\u003eAs a 2-year-old, Diamond Necklace won all three of her starts, including the Prix Marcel Boussac - Criterium des Pouliches (G1). \u0026nbsp;\r\u003c/p\u003e\u003cp\u003eAidan O’Brien trains Diamond Necklace for Coolmore. M.V. Magnier bought her for $1,840,153 as a yearling. She was bred by Ecurie Des Monceaux and Skymarc Farm Inc. \r\u003c/p\u003e\u003cp\u003eDiamond Necklace is by St Mark’s Basilica (FR) and out of the Dansili (GB) mare Prudenzia (IRE).\u0026nbsp;\u003c/p\u003e","gradedStakesPoints":0,"regionWinnerBadges":[],"breederName":"Ecurie Des Monceaux \u0026 Skymarc Farm Inc","uid":"blt4d23e81704e72e29","hasAutogeneratedPage":true,"url":"/redirect/horse/blt4d23e81704e72e29?ht=pre-entries","pageTitle":"Diamond Necklace (IRE)","jockeyName":"","ownerName":"Derrick Smith, Mrs. John Magnier, Michael Tabor \u0026 Westerberg (Lucia Walder)","trainer":"Aidan P. O'Brien","country":{"uid":"blta32e5b692b12a246","title":"Ireland","abbreviation":"IRE","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt613f9a736c40223a/61aa4c2b2f8b9e70946988d3/ireland.png","alt":""}},"horseName":"Diamond Necklace","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blta49f59444c186981/6a74b6c8ded0cfedaef4a391/Contender_Photo_Diamond_Necklace_.jpg"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blta49f59444c186981/6a74b6c8ded0cfedaef4a391/Contender_Photo_Diamond_Necklace_.jpg"},"cta":null,"races":[{"uid":"bltc3fc513333460ff5","ContentTypeUid":"collection_race","challengeSeriesWinner":false,"isEligible":false,"eligibleRank":null,"finishPosition":null,"classicRanking":null,"postPosition":"","scratched":false,"win":"","place":"","show":"","deadHeat":false,"silks":null}],"isChallengeSeriesWinner":true,"silks":null,"isHoC":false,"year":2026,"isHistoricalEntry":true,"relatedArticles":[],"win":"","show":"","place":""},{"sireName":"Ivan Denisovich (IRE)","damName":"Elea (CHI)","sex":"Filly","color":"Dark Bay or Brown","foalingDate":"July, 26 2022 00:00:00","age":4,"pastPerformances":[{"trackName":"CLUB HIPICO DE SANTIAGO","raceName":"Club Hipico de Santiago-Falabella Breeder's Cup","grade":"1","raceDate":"May, 31 2026 00:00:00","purseUsa":45507,"positionAtFinish":1},{"trackName":"CLUB HIPICO DE SANTIAGO","raceName":"Carlos Campino","grade":"2","raceDate":"May, 04 2026 00:00:00","purseUsa":10499,"positionAtFinish":2},{"trackName":"CLUB HIPICO DE SANTIAGO","raceName":"Gran Clasico Coronacion Pablo Baraona U.","grade":"2","raceDate":"March, 27 2026 00:00:00","purseUsa":14569,"positionAtFinish":3},{"trackName":"VALPARAISO SPORTING CLUB","raceName":"El Derby","grade":"1","raceDate":"February, 01 2026 00:00:00","purseUsa":108154,"positionAtFinish":5},{"trackName":"CLUB HIPICO DE SANTIAGO","raceName":"Las Oaks Fasig-Tipton","grade":"1","raceDate":"December, 26 2025 00:00:00","purseUsa":29846,"positionAtFinish":2},{"trackName":"CLUB HIPICO DE SANTIAGO","raceName":"El  Ensayo- MEGA","grade":"1","raceDate":"October, 31 2025 00:00:00","purseUsa":100251,"positionAtFinish":3},{"trackName":"CLUB HIPICO DE SANTIAGO","raceName":"Nacional Ricardo Lyon","grade":"1","raceDate":"October, 05 2025 00:00:00","purseUsa":41952,"positionAtFinish":1},{"trackName":"CLUB HIPICO DE SANTIAGO","raceName":"Polla de Potrancas","grade":"1","raceDate":"August, 01 2025 00:00:00","purseUsa":27761,"positionAtFinish":1},{"trackName":"CLUB HIPICO DE SANTIAGO","raceName":"Arturo Lyon Pena","grade":"1","raceDate":"June, 20 2025 00:00:00","purseUsa":21493,"positionAtFinish":2},{"trackName":"CLUB HIPICO DE SANTIAGO","raceName":"Criadores Hembras Carlos Hirmas A.","grade":"2","raceDate":"May, 30 2025 00:00:00","purseUsa":18693,"positionAtFinish":1},{"trackName":"CLUB HIPICO DE SANTIAGO","raceName":"Julio Subercaseaux B.","grade":"3","raceDate":"May, 05 2025 00:00:00","purseUsa":10684,"positionAtFinish":1},{"trackName":"CLUB HIPICO DE SANTIAGO","raceName":"Cotejo de Potrancas","grade":"3","raceDate":"April, 13 2025 00:00:00","purseUsa":9308,"positionAtFinish":2},{"trackName":"CLUB HIPICO DE SANTIAGO","raceName":"El Debut Potrancas","grade":" ","raceDate":"January, 03 2025 00:00:00","purseUsa":9407,"positionAtFinish":1}],"record":{"previousYear":{"starts":9,"earnings":96779,"show":1,"win":5,"place":3,"showP":"11","winP":"56","placeP":"33"},"breedersCup":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"currentYear":{"starts":4,"earnings":36343,"show":1,"win":1,"place":1,"showP":"25","winP":"25","placeP":"25"},"lifetime":{"starts":13,"earnings":133122,"show":2,"win":6,"place":4,"showP":"15","winP":"46","placeP":"31"}},"yearlySummary":[{"showsP":"25","winsP":"25","placesP":"25","starts":4,"earnings":36343,"racingYear":2026,"shows":1,"wins":1,"places":1},{"showsP":"11","winsP":"56","placesP":"33","starts":9,"earnings":96779,"racingYear":2025,"shows":1,"wins":5,"places":3}],"morningLineOdds":[],"bio":"\u003cp\u003eEccentric (CHI) defeated males and claimed her spot in the starting gate of the Longines Breeders’ Cup Turf (G1) with her victory in the Gran Premio Club Hipico Falabella (G1) at Club Hípico de Santiago on May 31. The race is part of the Breeders' Cup Challenge Series: Win and You're In.\u003c/p\u003e\u003cp\u003eThe 2,000-meter (about 1 ¼ miles) contest came down to a photo finish with Eccentric getting the best of Noche Sublime (CHI) by a head.\u0026nbsp; It was Eccentric’s first victory of the year after finishing second in the Carlos Campino (G2), third in the Gran Clasico Coronacion Pablo Baraona U (G2), and fifth in El Derby (G1).\u0026nbsp;\u003c/p\u003e\u003cp\u003eLast year, Eccentric won the Premio Polla de Potrancas - Joaquin T Morande (G1), Gran Premio Nacional Ricardo Lyon (G1), Criadores Hembras Carlos Hirmas A (G2) and Julio Subercaseaux B. (G3). She also finished second in the Premio Arturo Lyon Pena (G1), Premio Las Oaks (G1) and Cotejo de Potrancas (G3) as well as third in the Premio El Ensayo Mega (G1).\u0026nbsp;\u003c/p\u003e\u003cp\u003eTrained by Patricio Baeza, Eccentric races as a homebred for Haras Don Alberto. She is by Ivan Denisovich (IRE) and out of the Seeking the Dia mare Elea (CHI).\u003c/p\u003e","gradedStakesPoints":0,"regionWinnerBadges":[],"breederName":"Haras Don Alberto","uid":"bltf6641ffd0559fb23","hasAutogeneratedPage":true,"url":"/redirect/horse/bltf6641ffd0559fb23?ht=pre-entries","pageTitle":"Eccentric (CHI)","jockeyName":"","ownerName":"Don Alberto Stable (Carlos Heller)","trainer":"Wesley A. Ward","country":{"uid":"bltbade43d7316c55b9","title":"Chile","abbreviation":"CHL","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt3eb0d27a3a780275/61aa4b95425bc6598f47b3d0/chile.png","alt":""}},"horseName":"Eccentric","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt75fcd9ba2b4854b2/6a736d70c8b7aca27051fc57/Contender_Photo_Eccentri_(CHI)_updated_.jpg"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt75fcd9ba2b4854b2/6a736d70c8b7aca27051fc57/Contender_Photo_Eccentri_(CHI)_updated_.jpg"},"cta":null,"races":[{"uid":"bltc3fc513333460ff5","ContentTypeUid":"collection_race","challengeSeriesWinner":false,"isEligible":false,"eligibleRank":null,"finishPosition":null,"classicRanking":null,"postPosition":"","scratched":false,"win":"","place":"","show":"","deadHeat":false,"silks":null}],"isChallengeSeriesWinner":true,"silks":null,"isHoC":false,"year":2026,"isHistoricalEntry":false,"relatedArticles":[],"win":"","show":"","place":""},{"sireName":"Lope de Vega (IRE)","damName":"Witches Brew (IRE)","sex":"Mare","color":"Bay","foalingDate":"April, 09 2021 00:00:00","age":5,"pastPerformances":[{"trackName":"KEENELAND","raceName":"First Lady S.","grade":"1","raceDate":"October, 03 2026 00:00:00","purseUsa":800000,"positionAtFinish":6},{"trackName":"KEENELAND","raceName":"Jenny Wiley S.","grade":"1","raceDate":"April, 11 2026 00:00:00","purseUsa":650000,"positionAtFinish":1},{"trackName":"FAIR GROUNDS","raceName":"Albert M. Stall Memorial S.","grade":" ","raceDate":"February, 14 2026 00:00:00","purseUsa":100000,"positionAtFinish":1},{"trackName":"GULFSTREAM PARK","raceName":" ","grade":" ","raceDate":"January, 18 2026 00:00:00","purseUsa":87000,"positionAtFinish":1},{"trackName":"SANTA ANITA PARK","raceName":"Gamely S.","grade":"1","raceDate":"May, 26 2025 00:00:00","purseUsa":300000,"positionAtFinish":4},{"trackName":"KEENELAND","raceName":" ","grade":" ","raceDate":"April, 18 2025 00:00:00","purseUsa":120000,"positionAtFinish":1},{"trackName":"CHELMSFORD CITY","raceName":"Best Odds On The Betfair Exchange Handicap Stakes (Class 4)","grade":" ","raceDate":"November, 07 2024 00:00:00","purseUsa":14218,"positionAtFinish":4},{"trackName":"SANDOWN PARK","raceName":"Inkerman London Fillies Handicap Stakes (Class 4)","grade":" ","raceDate":"September, 18 2024 00:00:00","purseUsa":14728,"positionAtFinish":2},{"trackName":"HAYDOCK PARK","raceName":"Betfred Bet Builder Sankey Handicap Stakes (Class 4) (Div Ii)","grade":" ","raceDate":"June, 08 2024 00:00:00","purseUsa":25439,"positionAtFinish":6},{"trackName":"YORK","raceName":"Conundrum Hr Consulting Handicap Stakes (Class 3)","grade":" ","raceDate":"May, 15 2024 00:00:00","purseUsa":31480,"positionAtFinish":10},{"trackName":"NEWMARKET","raceName":"Jenningsbet Fillies Nursery Handicap Stakes (Class 3)","grade":" ","raceDate":"August, 19 2023 00:00:00","purseUsa":25470,"positionAtFinish":2},{"trackName":"SANDOWN PARK","raceName":"European Bloodstock News E.B.F. Star S.","grade":" ","raceDate":"July, 27 2023 00:00:00","purseUsa":51769,"positionAtFinish":5},{"trackName":"HAYDOCK PARK","raceName":"British Ebf Fillies Novice Stakes (Class 4) (Gbb Race)","grade":" ","raceDate":"July, 07 2023 00:00:00","purseUsa":12738,"positionAtFinish":1}],"record":{"previousYear":{"starts":2,"earnings":63486,"show":0,"win":1,"place":0,"showP":"0","winP":"50","placeP":"0"},"breedersCup":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"currentYear":{"starts":4,"earnings":308038,"show":0,"win":3,"place":0,"showP":"0","winP":"75","placeP":"0"},"lifetime":{"starts":13,"earnings":390741,"show":0,"win":5,"place":2,"showP":"0","winP":"38","placeP":"15"}},"yearlySummary":[{"showsP":"0","winsP":"75","placesP":"0","starts":4,"earnings":308038,"racingYear":2026,"shows":0,"wins":3,"places":0},{"showsP":"0","winsP":"50","placesP":"0","starts":2,"earnings":63486,"racingYear":2025,"shows":0,"wins":1,"places":0}],"morningLineOdds":[],"bio":"\u003cp\u003eIn April 2025 Farfellow Farms in Kentucky privately purchased the Irish-bred Expensive Queen, who made her first seven starts in England and only had won her debut in a maiden race. Since traveling across the pond and into the barn of trainer Brendan Walsh she has excelled, visiting the winner's circle four times in six outings. \u0026nbsp;\r\u003c/p\u003e\u003cp\u003eAfter taking the Albert M. Stall Memorial (Listed) at Fair Grounds on Valentine's Day in her second 2026 start, Expensive Queen handled the class hike in April's Jenny Wiley (G1), when she rallied through the lane, dug down deep, and engaged pace setter Segesta in a thrilling neck-and-neck battle inside the final furlong of the 1 1/16-mile test for their dead heat victory at Keeneland April 11 with Luis Saez in the irons. \r\u003c/p\u003e\u003cp\u003eAfter a six-minth break Expensive Queen and Saez returned to Keeneland Oct. 3 for the 1-mile First Lady (G1) but she could fare no better than sixth behind first three finishers Classic Q, stablemate Lush Lips (GB) and Bless the Broken, who are all possible for the Maker's Mark Breeders’ Cup Filly \u0026amp; Mare Turf (G1). \r\u003c/p\u003e\u003cp\u003eExpensive Queen, who is Farfellow Farms' only graded stakes winner as an owner, is to be entered in the Keeneland November Sale. She is a 5-year-old daughter of Lope de Vega (IRE) and the Duke of Marmalade (IRE) mare Witches Brew (IRE). \u0026nbsp;\u003c/p\u003e","gradedStakesPoints":10,"regionWinnerBadges":[],"breederName":"Fermoir Ltd","uid":"blt2845a0a416cd6c3f","hasAutogeneratedPage":true,"url":"/redirect/horse/blt2845a0a416cd6c3f?ht=pre-entries","pageTitle":"Expensive Queen (IRE)","jockeyName":"","ownerName":"Farfellow Farms Ltd.(Kip Knelman)","trainer":"Brendan P. Walsh","country":{"uid":"blt1af49e3a6a89373f","title":"USA","abbreviation":"USA","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt9de45bbdff160673/60d219911e0505677a882fa1/USAFlag.png"}},"horseName":"Expensive Queen","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt12fb612ef4676fe1/6ac68da6d1edc6179a5735a7/Contender_Photo_Expensive_Queen_(IRE).jpg"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt12fb612ef4676fe1/6ac68da6d1edc6179a5735a7/Contender_Photo_Expensive_Queen_(IRE).jpg"},"cta":null,"races":[{"uid":"bltc3fc513333460ff5","ContentTypeUid":"collection_race","challengeSeriesWinner":false,"isEligible":false,"eligibleRank":null,"finishPosition":null,"classicRanking":null,"postPosition":"","scratched":false,"win":"","place":"","show":"","deadHeat":false,"silks":null}],"isChallengeSeriesWinner":false,"silks":null,"isHoC":false,"year":2026,"isHistoricalEntry":false,"relatedArticles":[],"win":"","show":"","place":""},{"sireName":"Gimmethegreenlight (AUS)","damName":"Nother Russia (SAF)","sex":"Mare","color":"Bay","foalingDate":"October, 20 2020 00:00:00","age":6,"pastPerformances":[{"trackName":"WOODBINE","raceName":"E. P. Taylor S.","grade":"1","raceDate":"September, 12 2026 00:00:00","purseUsa":750000,"positionAtFinish":1},{"trackName":"COLONIAL DOWNS","raceName":"Beverly D. S.","grade":"2","raceDate":"August, 01 2026 00:00:00","purseUsa":500000,"positionAtFinish":1},{"trackName":"MONMOUTH PARK","raceName":"Eatontown S.","grade":"3","raceDate":"June, 13 2026 00:00:00","purseUsa":150000,"positionAtFinish":1},{"trackName":"DEL MAR","raceName":"John C. Mabee S.","grade":"2","raceDate":"September, 06 2025 00:00:00","purseUsa":250000,"positionAtFinish":1},{"trackName":"WOODBINE","raceName":"Canadian S. Presented by the Japan Racing Association","grade":"2","raceDate":"July, 20 2025 00:00:00","purseUsa":200000,"positionAtFinish":2},{"trackName":"SARATOGA","raceName":"New York S. Presented by Rivers Casino","grade":"1","raceDate":"June, 06 2025 00:00:00","purseUsa":750000,"positionAtFinish":7},{"trackName":"CHURCHILL DOWNS","raceName":"Modesty S. presented by Veritas Prime","grade":"3","raceDate":"May, 02 2025 00:00:00","purseUsa":400000,"positionAtFinish":2},{"trackName":"TAMPA BAY DOWNS","raceName":"Hillsborough S.","grade":"2","raceDate":"March, 08 2025 00:00:00","purseUsa":225000,"positionAtFinish":2},{"trackName":"TURFFONTEIN","raceName":"Tab Empress Club S.","grade":"1","raceDate":"April, 06 2024 00:00:00","purseUsa":53478,"positionAtFinish":1},{"trackName":"TURFFONTEIN","raceName":"Wilgerbosdrift South Africa Fillies Classic","grade":"1","raceDate":"March, 02 2024 00:00:00","purseUsa":65402,"positionAtFinish":1},{"trackName":"TURFFONTEIN","raceName":"Wilgerbosdrift Gauteng Fillies Guineas","grade":"2","raceDate":"February, 03 2024 00:00:00","purseUsa":39680,"positionAtFinish":1},{"trackName":"TURFFONTEIN","raceName":"Mike De Kock Ipi Tombe Challenge","grade":"2","raceDate":"December, 17 2023 00:00:00","purseUsa":27118,"positionAtFinish":1},{"trackName":"TURFFONTEIN","raceName":"Betway Fillies Mile","grade":"3","raceDate":"November, 25 2023 00:00:00","purseUsa":18637,"positionAtFinish":1},{"trackName":"TURFFONTEIN","raceName":"Next Turffontein Racemeeting Sunday 12 November Fm 76 Handicap (f \u0026 M)","grade":" ","raceDate":"November, 09 2023 00:00:00","purseUsa":5143,"positionAtFinish":1},{"trackName":"TURFFONTEIN","raceName":"Betway Insurebet Maiden Plate (3 Year-old Fillies)","grade":" ","raceDate":"October, 07 2023 00:00:00","purseUsa":4920,"positionAtFinish":1}],"record":{"previousYear":{"starts":5,"earnings":289787,"show":0,"win":1,"place":3,"showP":"0","winP":"20","placeP":"60"},"breedersCup":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"currentYear":{"starts":3,"earnings":711992,"show":0,"win":3,"place":0,"showP":"0","winP":"100","placeP":"0"},"lifetime":{"starts":15,"earnings":1135765,"show":0,"win":11,"place":3,"showP":"0","winP":"73","placeP":"20"}},"yearlySummary":[{"showsP":"0","winsP":"100","placesP":"0","starts":3,"earnings":711992,"racingYear":2026,"shows":0,"wins":3,"places":0},{"showsP":"0","winsP":"20","placesP":"60","starts":5,"earnings":289787,"racingYear":2025,"shows":0,"wins":1,"places":3}],"morningLineOdds":[],"bio":"\u003cp\u003eGimme a Nother (SAF) is giving trainer Graham Motion, who has enjoyed success with several outstanding South African-breds to join his stable recently, another shot at Breeders’ Cup glory.\u003c/p\u003e\u003cp\u003eThe daughter of Gimmethegreenlight (AUS) and the Tiger Ridge mare Nother Russia (SAF) raced seven times for noted trainer Mike de Kock in her native land in 2023-2024 and won all seven. The dual G1 winner and South Africa’s champion 3-Year-Old Filly of 2023-24 was subsequently sent by owner Newstead Stables (Steve and Jessica Jell) stateside to Motion in December 2024.\u003c/p\u003e\u003cp\u003eShe was winless in her first four starts in 2025 but had three runner-up finishes in graded stakes before closing her campaign with a victory in the John C. Mabee (G2) at Del Mar. She opened 2026 with a win in the Eatontown (G3) at Monmouth Park on June 13 and then a narrow triumph at Colonial Downs on Aug. 1 in the Beverly D. (G2).\u003c/p\u003e\u003cp\u003eShe remained perfect in 2026 when she scored her first Grade 1 North American victory in taking the 1 1/4-mile E.P. Taylor at Woodbine on Sept. 12 by a neck.\u003c/p\u003e\u003cp\u003eFive horses have represented South Africa in the Breeders’ Cup and Gimme A Nother would be the first winner. In 2024 the Motion-trained Beach Bomb (SAF) finished eighth in the Maker’s Mark Filly \u0026amp; Mare Turf.\u0026nbsp; \u0026nbsp;\u003c/p\u003e","gradedStakesPoints":20,"regionWinnerBadges":[],"breederName":"Wilgerbosdrift \u0026 Mauritzfontein","uid":"bltdd154f7d419cda42","hasAutogeneratedPage":true,"url":"/redirect/horse/bltdd154f7d419cda42?ht=pre-entries","pageTitle":"Gimme a Nother (SAF)","jockeyName":"","ownerName":"Newstead Stables, LLC (Jessica Slack Jell)","trainer":"H. Graham Motion","country":{"uid":"blt81e1aa4cef5e5e14","title":"South Africa","abbreviation":"SAF","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt8e12ea98946f37eb/61aa4de8f4f01a1e53e2c686/south-africa.png","alt":""}},"horseName":"Gimme a Nother","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt0744dffd465c42a8/6a736d810da6739d1f579ca7/Contender_Photo_Gimme_a_Nother_.jpg"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt0744dffd465c42a8/6a736d810da6739d1f579ca7/Contender_Photo_Gimme_a_Nother_.jpg"},"cta":null,"races":[{"uid":"bltc3fc513333460ff5","ContentTypeUid":"collection_race","challengeSeriesWinner":false,"isEligible":false,"eligibleRank":null,"finishPosition":null,"classicRanking":null,"postPosition":"","scratched":false,"win":"","place":"","show":"","deadHeat":false,"silks":null}],"isChallengeSeriesWinner":true,"silks":null,"isHoC":false,"year":2026,"isHistoricalEntry":false,"relatedArticles":[],"win":"","show":"","place":""},{"sireName":"Tamayuz (GB)","damName":"Blame The Ruler (IRE)","sex":"Mare","color":"Chestnut","foalingDate":"February, 14 2021 00:00:00","age":5,"pastPerformances":[{"trackName":"WOODBINE","raceName":"E. P. Taylor S.","grade":"1","raceDate":"September, 12 2026 00:00:00","purseUsa":750000,"positionAtFinish":3},{"trackName":"NEWMARKET","raceName":"Tattersalls Sceptre Sessions Falmouth S.","grade":"1","raceDate":"July, 10 2026 00:00:00","purseUsa":502829,"positionAtFinish":5},{"trackName":"ASCOT","raceName":"Duke Of Cambridge S.","grade":"2","raceDate":"June, 17 2026 00:00:00","purseUsa":335663,"positionAtFinish":2},{"trackName":"CURRAGH","raceName":"Lanwades Stud S.","grade":"2","raceDate":"May, 24 2026 00:00:00","purseUsa":150831,"positionAtFinish":5},{"trackName":"NEWMARKET","raceName":"Betfred Dahlia S.","grade":"2","raceDate":"May, 03 2026 00:00:00","purseUsa":224111,"positionAtFinish":1},{"trackName":"DUNDALK","raceName":"Irish Stallion Farms E.B.F. Cooley Fillies S.","grade":" ","raceDate":"November, 07 2025 00:00:00","purseUsa":57738,"positionAtFinish":2},{"trackName":"LEOPARDSTOWN","raceName":"Bahrain Turf Club Desmond S.","grade":"3","raceDate":"August, 07 2025 00:00:00","purseUsa":69961,"positionAtFinish":6},{"trackName":"ASCOT","raceName":"Longines Valiant S.","grade":"3","raceDate":"July, 26 2025 00:00:00","purseUsa":114223,"positionAtFinish":4},{"trackName":"CURRAGH","raceName":"Paddy Power Pretty Polly S.","grade":"1","raceDate":"June, 28 2025 00:00:00","purseUsa":351572,"positionAtFinish":5},{"trackName":"CURRAGH","raceName":"Lanwades Stud S.","grade":"2","raceDate":"May, 25 2025 00:00:00","purseUsa":136409,"positionAtFinish":5},{"trackName":"GOWRAN PARK","raceName":"Irish Stallion Farms E.B.F. Victor McCalmont Memorial S.","grade":" ","raceDate":"May, 07 2025 00:00:00","purseUsa":56852,"positionAtFinish":2},{"trackName":"LEOPARDSTOWN","raceName":"Coolmore America Justify Matron S.","grade":"1","raceDate":"September, 14 2024 00:00:00","purseUsa":432977,"positionAtFinish":8},{"trackName":"LEOPARDSTOWN","raceName":"Irish Stallion Farms E.B.F. Brownstown S.","grade":"3","raceDate":"July, 11 2024 00:00:00","purseUsa":70359,"positionAtFinish":1},{"trackName":"LEOPARDSTOWN","raceName":"Irish Stallion Farms E.B.F. Fillies","grade":" ","raceDate":"June, 13 2024 00:00:00","purseUsa":16214,"positionAtFinish":1}],"record":{"previousYear":{"starts":6,"earnings":38353,"show":0,"win":0,"place":2,"showP":"0","winP":"0","placeP":"33"},"breedersCup":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"currentYear":{"starts":5,"earnings":268965,"show":1,"win":1,"place":1,"showP":"20","winP":"20","placeP":"20"},"lifetime":{"starts":14,"earnings":358396,"show":1,"win":3,"place":3,"showP":"7","winP":"21","placeP":"21"}},"yearlySummary":[{"showsP":"20","winsP":"20","placesP":"20","starts":5,"earnings":268965,"racingYear":2026,"shows":1,"wins":1,"places":1},{"showsP":"0","winsP":"0","placesP":"33","starts":6,"earnings":38353,"racingYear":2025,"shows":0,"wins":0,"places":2}],"morningLineOdds":[],"bio":"\u003cp\u003eJancis (IRE) is a dual group winning and multiple group-placed mare while racing against Europe’s finest of her gender and that is little wonder to her Chilean owner-breeder Arturo Cousino. “She had to be a real fighter,” he explained. \u0026nbsp;\r\u003c/p\u003e\u003cp\u003eHer dam, Blame The Ruler (IRE), died two days after she was born, leaving her as an orphan foal at Ballylinch Stud in County Kilkenny. Now a 5-year-old, trainer Willie McCreery has Jancis positioned to capture the first Grade 1 of her career in the Maker’s Mark Breeders’ Cup Filly \u0026amp; Mare Turf. “It is beyond dreams,” Cousino said. \r\u003c/p\u003e\u003cp\u003eUnraced at 2, she won the Brownstown (G3) at Leopardstown in her second start. At age 4 she was winless in six efforts but in her first start of 2026 she pulled off the upset in the Dahlia (G2) at Newmarket May 3. That gave her connections the confidence to keep her in training and she rewarded them with an impressive runner-up finish by 1 ¾ lengths to the undefeated Blue Bolt (IRE) in Royal Ascot’s Duke of Cambridge (G2) June 17. \u0026nbsp;\r\u003c/p\u003e\u003cp\u003eIn her only North American outing she ran third beaten only a neck behind possible Breeders’ Cup Filly \u0026amp; Mare Turf competitors Gimme A Nother (SAF) and See The Fire (GB) in the E.P. Taylor (G1) at Woodbine Sept. 12. \r\u003c/p\u003e\u003cp\u003eThe daughter of Tamayuz (GB) shares her name with Jancis Robinson, the world-renowned British wine writer and critic and BBC TV personality. \u0026nbsp; \r\u003c/p\u003e","gradedStakesPoints":4,"regionWinnerBadges":[],"breederName":"Mr Arturo Cousino","uid":"blt2c72e0ff8ba46ea9","hasAutogeneratedPage":true,"url":"/redirect/horse/blt2c72e0ff8ba46ea9?ht=pre-entries","pageTitle":"Jancis (IRE)","jockeyName":"","ownerName":"Arturo Cousino","trainer":"Willie McCreery","country":{"uid":"blta32e5b692b12a246","title":"Ireland","abbreviation":"IRE","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt613f9a736c40223a/61aa4c2b2f8b9e70946988d3/ireland.png","alt":""}},"horseName":"Jancis","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blte66e7c3f33facf3b/6334cddf4df1082a16b60e31/Fallback_Horse_Image.png"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blte66e7c3f33facf3b/6334cddf4df1082a16b60e31/Fallback_Horse_Image.png"},"cta":null,"races":[{"uid":"bltc3fc513333460ff5","ContentTypeUid":"collection_race","challengeSeriesWinner":false,"isEligible":false,"eligibleRank":null,"finishPosition":null,"classicRanking":null,"postPosition":"","scratched":false,"win":"","place":"","show":"","deadHeat":false,"silks":null}],"isChallengeSeriesWinner":false,"silks":null,"isHoC":false,"year":2026,"isHistoricalEntry":false,"relatedArticles":[],"win":"","show":"","place":""},{"sireName":"American Pharoah","damName":"La Dalila (CHI)","sex":"Mare","color":"Bay","foalingDate":"March, 19 2021 00:00:00","age":5,"pastPerformances":[{"trackName":"BELMONT PARK","raceName":"Flower Bowl S.","grade":"2","raceDate":"October, 01 2026 00:00:00","purseUsa":500000,"positionAtFinish":1},{"trackName":"SARATOGA","raceName":"Dunkin' Diana S.","grade":"1","raceDate":"July, 18 2026 00:00:00","purseUsa":500000,"positionAtFinish":1},{"trackName":"SARATOGA","raceName":"New York S.","grade":"1","raceDate":"June, 05 2026 00:00:00","purseUsa":750000,"positionAtFinish":3},{"trackName":"CHURCHILL DOWNS","raceName":"Modesty S. presented by Veritas Prime","grade":"3","raceDate":"May, 01 2026 00:00:00","purseUsa":500000,"positionAtFinish":1},{"trackName":"SARATOGA","raceName":" ","grade":" ","raceDate":"August, 28 2025 00:00:00","purseUsa":120000,"positionAtFinish":1},{"trackName":"SANTA ANITA PARK","raceName":"Santa Ana S.","grade":"3","raceDate":"March, 15 2025 00:00:00","purseUsa":100000,"positionAtFinish":5},{"trackName":"SANTA ANITA PARK","raceName":"American Oaks","grade":"1","raceDate":"December, 26 2024 00:00:00","purseUsa":300000,"positionAtFinish":2},{"trackName":"KENTUCKY DOWNS","raceName":"Pepsi Dueling Grounds Oaks Invitational S.","grade":" ","raceDate":"September, 11 2024 00:00:00","purseUsa":1600000,"positionAtFinish":1},{"trackName":"SARATOGA","raceName":"Fasig-Tipton Saratoga Oaks Invitational S.","grade":"2","raceDate":"August, 02 2024 00:00:00","purseUsa":400000,"positionAtFinish":2},{"trackName":"CHURCHILL DOWNS","raceName":"Tepin S.","grade":" ","raceDate":"June, 29 2024 00:00:00","purseUsa":250000,"positionAtFinish":3},{"trackName":"CHURCHILL DOWNS","raceName":" ","grade":" ","raceDate":"May, 11 2024 00:00:00","purseUsa":127000,"positionAtFinish":1},{"trackName":"SANTA ANITA PARK","raceName":" ","grade":" ","raceDate":"April, 06 2024 00:00:00","purseUsa":65000,"positionAtFinish":1},{"trackName":"SANTA ANITA PARK","raceName":" ","grade":" ","raceDate":"February, 17 2024 00:00:00","purseUsa":65000,"positionAtFinish":3},{"trackName":"AQUEDUCT","raceName":" ","grade":" ","raceDate":"January, 19 2024 00:00:00","purseUsa":80000,"positionAtFinish":4},{"trackName":"AQUEDUCT","raceName":" ","grade":" ","raceDate":"December, 01 2023 00:00:00","purseUsa":85000,"positionAtFinish":5}],"record":{"previousYear":{"starts":2,"earnings":68000,"show":0,"win":1,"place":0,"showP":"0","winP":"50","placeP":"0"},"breedersCup":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"currentYear":{"starts":4,"earnings":940560,"show":1,"win":3,"place":0,"showP":"25","winP":"75","placeP":"0"},"lifetime":{"starts":15,"earnings":2215745,"show":3,"win":7,"place":2,"showP":"20","winP":"47","placeP":"13"}},"yearlySummary":[{"showsP":"25","winsP":"75","placesP":"0","starts":4,"earnings":940560,"racingYear":2026,"shows":1,"wins":3,"places":0},{"showsP":"0","winsP":"50","placesP":"0","starts":2,"earnings":68000,"racingYear":2025,"shows":0,"wins":1,"places":0}],"morningLineOdds":[],"bio":"\u003cp\u003eKathynmarissa led a Chad Brown-trained trifecta in the Diana (G1) as the 5-year-old mare secured her first top-level victory at Saratoga on July 18 by rallying from the back of the pack on yielding turf to collar Segesta in the final strides. Aided by a patient and heady ride from Jose Ortiz, Kathynmarissa finished a half-length in front of her stablemate. \u0026nbsp;\r\u003c/p\u003e\u003cp\u003eThe win was her third in four tries since being transferred to Brown last year. \u0026nbsp;She took a 1 1/8- mile allowance race on the Saratoga turf in August 2025 but a bone bruise sent her to the bench for eight months. In her first start back this year she upset stablemate Gezora (FR), the defending Maker’s Mark Filly \u0026amp; Mare Turf (G1) titlist, in the Modesty (G3) at Churchill Downs May 1 and next time out she finished third in the 1 3/16-mile New York (G1) at Saratoga June 15. \u0026nbsp; \r\u003c/p\u003e\u003cp\u003eKathynmarissa punched her ticket to the Maker’s Mark Breeders’ Cup Filly and Mare Turf (G1) by hitting the front at the sixteenth pole en route to winning the 1 1/4-mile Flower Bowl (G2) at Belmont Park as the heavy favorite in a field of 11 by three-quarters of a length. \r\u003c/p\u003e\u003cp\u003eKathynmarissa is a daughter of 2015 Triple Crown champion and Breeders’ Cup Classic winner American Pharoah and the Milt’s Overture mare La Dalila (CHI). She is co-owned by Michael Caruso and Michael Dubb, a major homebuilder and developer in New York. Dubb said he named this filly for two Bank of America executives, Kathy Flock and Marissa Magneson, who arranged the financing for his Adelphi Hotel and Condominiums project in Saratoga Springs, New York. \u0026nbsp;\u003c/p\u003e","gradedStakesPoints":24,"regionWinnerBadges":[],"breederName":"Don Alberto Corporation","uid":"blt982b73c542059080","hasAutogeneratedPage":true,"url":"/redirect/horse/blt982b73c542059080?ht=pre-entries","pageTitle":"Kathynmarissa","jockeyName":"","ownerName":"Michael Dubb \u0026 Michael J. Caruso","trainer":"Chad C. Brown","country":{"uid":"blt1af49e3a6a89373f","title":"USA","abbreviation":"USA","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt9de45bbdff160673/60d219911e0505677a882fa1/USAFlag.png"}},"horseName":"Kathynmarissa","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt6b723eef839cef4c/6a736d9aed03cc5b35aca794/Contender_Photo_Kathynmarissa.jpg"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt6b723eef839cef4c/6a736d9aed03cc5b35aca794/Contender_Photo_Kathynmarissa.jpg"},"cta":null,"races":[{"uid":"bltc3fc513333460ff5","ContentTypeUid":"collection_race","challengeSeriesWinner":false,"isEligible":false,"eligibleRank":null,"finishPosition":null,"classicRanking":null,"postPosition":"","scratched":false,"win":"","place":"","show":"","deadHeat":false,"silks":null}],"isChallengeSeriesWinner":true,"silks":null,"isHoC":false,"year":2026,"isHistoricalEntry":false,"relatedArticles":[],"win":"","show":"","place":""},{"sireName":"Ten Sovereigns (IRE)","damName":"Lamyaa (GB)","sex":"Filly","color":"Bay","foalingDate":"January, 28 2022 00:00:00","age":4,"pastPerformances":[{"trackName":"KEENELAND","raceName":"First Lady S.","grade":"1","raceDate":"October, 03 2026 00:00:00","purseUsa":800000,"positionAtFinish":2},{"trackName":"ELLIS PARK","raceName":"Ellis Park Turf S.","grade":" ","raceDate":"August, 23 2026 00:00:00","purseUsa":175000,"positionAtFinish":2},{"trackName":"GULFSTREAM PARK","raceName":"Honey Fox S. presented by MyRacehorse","grade":"3","raceDate":"February, 28 2026 00:00:00","purseUsa":175000,"positionAtFinish":1},{"trackName":"CHURCHILL DOWNS","raceName":"Mrs. Revere S.","grade":"2","raceDate":"November, 28 2025 00:00:00","purseUsa":300000,"positionAtFinish":1},{"trackName":"KEENELAND","raceName":"Queen Elizabeth II Challenge Cup S. Presented by Dixiana","grade":"1","raceDate":"October, 11 2025 00:00:00","purseUsa":800000,"positionAtFinish":1},{"trackName":"DEL MAR","raceName":"Del Mar Oaks Presented by Keeneland Sales S.","grade":"1","raceDate":"August, 16 2025 00:00:00","purseUsa":300000,"positionAtFinish":2},{"trackName":"CHURCHILL DOWNS","raceName":"Tepin S.","grade":" ","raceDate":"June, 28 2025 00:00:00","purseUsa":250000,"positionAtFinish":1},{"trackName":"CHURCHILL DOWNS","raceName":"Edgewood S. presented by Accenture","grade":"2","raceDate":"May, 02 2025 00:00:00","purseUsa":600000,"positionAtFinish":2},{"trackName":"TAMPA BAY DOWNS","raceName":"Florida Oaks","grade":"3","raceDate":"March, 08 2025 00:00:00","purseUsa":200000,"positionAtFinish":2},{"trackName":"GULFSTREAM PARK","raceName":" ","grade":" ","raceDate":"January, 10 2025 00:00:00","purseUsa":96000,"positionAtFinish":1},{"trackName":"GULFSTREAM PARK","raceName":" ","grade":" ","raceDate":"November, 23 2024 00:00:00","purseUsa":65000,"positionAtFinish":1},{"trackName":"KENTUCKY DOWNS","raceName":" ","grade":" ","raceDate":"September, 11 2024 00:00:00","purseUsa":170000,"positionAtFinish":9},{"trackName":"TIPPERARY","raceName":"Irish Stallion Farms Ebf Fillies Maiden","grade":" ","raceDate":"August, 09 2024 00:00:00","purseUsa":19484,"positionAtFinish":2},{"trackName":"LEOPARDSTOWN","raceName":"Irish Stallion Farms E.B.F. Fillies","grade":" ","raceDate":"July, 11 2024 00:00:00","purseUsa":19484,"positionAtFinish":9}],"record":{"previousYear":{"starts":7,"earnings":887858,"show":0,"win":4,"place":3,"showP":"0","winP":"57","placeP":"43"},"breedersCup":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"currentYear":{"starts":3,"earnings":229640,"show":0,"win":1,"place":2,"showP":"0","winP":"33","placeP":"67"},"lifetime":{"starts":14,"earnings":1146400,"show":0,"win":6,"place":6,"showP":"0","winP":"43","placeP":"43"}},"yearlySummary":[{"showsP":"0","winsP":"33","placesP":"67","starts":3,"earnings":229640,"racingYear":2026,"shows":0,"wins":1,"places":2},{"showsP":"0","winsP":"57","placesP":"43","starts":7,"earnings":887858,"racingYear":2025,"shows":0,"wins":4,"places":3}],"morningLineOdds":[],"bio":"\u003cp\u003eSince transferring to the stable of Brendan Walsh, the performance of Lush Lips (GB) qualifies as a chef's kiss. In 11 starts for Walsh, she has finished second five times and won the rest, including a trio of graded stakes with the highlight coming in the Queen Elizabeth II Challenge Cup (G1) at Keeneland in October 2025. \u0026nbsp;\r\u003c/p\u003e\u003cp\u003eFollowing her first top level score, she commanded $3.7 million in the Keeneland November Breeding Stock Sale and promptly returned to the track three weeks later to reward new owners Dixiana Farms with a victory in the Mrs. Revere (G2) at Churchill Downs. \u0026nbsp;\r\u003c/p\u003e\u003cp\u003eWhen Lush Lips kicked off her 4-year-old campaign at Gulfstream Park Feb. 28, she extended her graded stakes winning streak to three in the Honey Fox (G3). She then went to the bench with what Walsh termed an \"unspecified injury\" for six months and returned Aug. 23 to be second in the Ellis Park Turf Stakes. \u0026nbsp;In the First Lady (G1) at Keeneland Oct. 3 Lush Lips appeared to be the clear winner until being run down late to lose by a short nose at the wire to Classic Q, who is also hopeful for the Maker's Mark Breeders’ Cup Filly \u0026amp; Mare Turf (G1). \r\u003c/p\u003e\u003cp\u003eLush Lips is by Ten Sovereigns (IRE) out of Lamyaa (GB) by Arcano (IRE). She began her career in Ireland and ran her first three times for trainer Donnacha O'Brien.\u0026nbsp;\u003c/p\u003e","gradedStakesPoints":10,"regionWinnerBadges":[],"breederName":"The Pocock Family","uid":"blt7da23de964cc6685","hasAutogeneratedPage":true,"url":"/redirect/horse/blt7da23de964cc6685?ht=pre-entries","pageTitle":"Lush Lips (GB)","jockeyName":"","ownerName":"Dixiana Farms, LLC (William Shively)","trainer":"Brendan P. Walsh","country":{"uid":"blt1af49e3a6a89373f","title":"USA","abbreviation":"USA","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt9de45bbdff160673/60d219911e0505677a882fa1/USAFlag.png"}},"horseName":"Lush Lips","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt44d1d9ed30c4f5c4/6ac68f02512a6d7d2ae35a78/Contender_Photo_Lush_Lips_.jpg"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt44d1d9ed30c4f5c4/6ac68f02512a6d7d2ae35a78/Contender_Photo_Lush_Lips_.jpg"},"cta":null,"races":[{"uid":"bltc3fc513333460ff5","ContentTypeUid":"collection_race","challengeSeriesWinner":false,"isEligible":false,"eligibleRank":null,"finishPosition":null,"classicRanking":null,"postPosition":"","scratched":false,"win":"","place":"","show":"","deadHeat":false,"silks":null}],"isChallengeSeriesWinner":false,"silks":null,"isHoC":false,"year":2026,"isHistoricalEntry":false,"relatedArticles":[],"win":"","show":"","place":""},{"sireName":"Starspangledbanner (AUS)","damName":"Way To My Heart (IRE)","sex":"Filly","color":"Chestnut","foalingDate":"May, 02 2023 00:00:00","age":3,"pastPerformances":[{"trackName":"LONGCHAMP","raceName":"Prix de l'Opera Longines","grade":"1","raceDate":"October, 04 2026 00:00:00","purseUsa":562748,"positionAtFinish":2},{"trackName":"LEOPARDSTOWN","raceName":"Coolmore America Justify Matron S.","grade":"1","raceDate":"September, 12 2026 00:00:00","purseUsa":463950,"positionAtFinish":5},{"trackName":"DEAUVILLE","raceName":"The Aga Khan Studs Prix Jacques Le Marois","grade":"1","raceDate":"August, 16 2026 00:00:00","purseUsa":1156887,"positionAtFinish":3},{"trackName":"DEAUVILLE","raceName":"Prix Rothschild - F.E.E. - World Pool By PMU","grade":"1","raceDate":"August, 02 2026 00:00:00","purseUsa":345999,"positionAtFinish":2},{"trackName":"NEWMARKET","raceName":"Tattersalls Sceptre Sessions Falmouth S.","grade":"1","raceDate":"July, 10 2026 00:00:00","purseUsa":502829,"positionAtFinish":2},{"trackName":"ASCOT","raceName":"Coronation S.","grade":"1","raceDate":"June, 19 2026 00:00:00","purseUsa":924338,"positionAtFinish":1},{"trackName":"CURRAGH","raceName":"Tattersalls Irish 1,000 Guineas","grade":"1","raceDate":"May, 24 2026 00:00:00","purseUsa":580120,"positionAtFinish":1},{"trackName":"NEWMARKET","raceName":"Betfred 1000 Guineas S.","grade":"1","raceDate":"May, 03 2026 00:00:00","purseUsa":713082,"positionAtFinish":7},{"trackName":"NEWMARKET","raceName":"Bet365 Fillies Mile","grade":"1","raceDate":"October, 10 2025 00:00:00","purseUsa":703453,"positionAtFinish":1},{"trackName":"CURRAGH","raceName":"Moyglare Stud S.","grade":"1","raceDate":"September, 14 2025 00:00:00","purseUsa":469395,"positionAtFinish":1},{"trackName":"GOODWOOD","raceName":"Virgin Bet Prestige Fillies S.","grade":"3","raceDate":"August, 24 2025 00:00:00","purseUsa":108126,"positionAtFinish":1},{"trackName":"CORK","raceName":"Irish Stallion Farms E.B.F.","grade":" ","raceDate":"August, 14 2025 00:00:00","purseUsa":21070,"positionAtFinish":1},{"trackName":"FAIRYHOUSE","raceName":"Irish Stallion Farms E.B.F. Fillies","grade":" ","raceDate":"July, 09 2025 00:00:00","purseUsa":21106,"positionAtFinish":2}],"record":{"previousYear":{"starts":5,"earnings":753631,"show":0,"win":4,"place":1,"showP":"0","winP":"80","placeP":"20"},"breedersCup":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"currentYear":{"starts":8,"earnings":1311755,"show":1,"win":2,"place":3,"showP":"13","winP":"25","placeP":"38"},"lifetime":{"starts":13,"earnings":2065386,"show":1,"win":6,"place":4,"showP":"8","winP":"46","placeP":"31"}},"yearlySummary":[{"showsP":"13","winsP":"25","placesP":"38","starts":8,"earnings":1311755,"racingYear":2026,"shows":1,"wins":2,"places":3},{"showsP":"0","winsP":"80","placesP":"20","starts":5,"earnings":753631,"racingYear":2025,"shows":0,"wins":4,"places":1}],"morningLineOdds":[],"bio":"\u003cp\u003eBy almost any standards, Precise (IRE) has been a spectacular success on the racecourse. Any standards, that is, other than those of the elite -- her Coolmore owners, trainer Aidan O'Brien and jockey Ryan Moore. \r\u003c/p\u003e\u003cp\u003eThe Starspangledbanner (AUS) filly romped through her juvenile season in 2025, winning four in a row after an initial loss, capping things off with victories in the Moyglare Stud Stakes (G1) at the Curragh in Ireland and the Fillies Mile (G1) at Newmarket. \r\u003c/p\u003e\u003cp\u003eShe finished seventh in her 2026 debut, the 1000 Guineas (G1) but immediately righted the ship, winning the Irish 1,000 Guineas (G1) and the Coronation Stakes (G1) at Ascot, building expectations to new heights. \r\u003c/p\u003e\u003cp\u003eBut, to paraphrase Charlie Brown, \"There is no heavier burden than great expectations.\" Thus, it was a disappointment that she finished second in the Falmouth Stakes (G1) at Newmarket, second in the Prix Rothschild (G1), third in the Prix Jacques le Marois (G1) at Deauville in France and then fifth in the Matron (G1) at Leopardstown. \r\u003c/p\u003e\u003cp\u003eIt was some comfort that Precise was competitive with the spectacular Blue Bolt (IRE), winner of the Falmouth, Rothschild and Matron, and the equally talented Rayif (IRE), who took the Jacques le Marois.\u0026nbsp;\u003c/p\u003e","gradedStakesPoints":0,"regionWinnerBadges":[],"breederName":"Whisperview Trading Ltd","uid":"blt8920ebacaed867a3","hasAutogeneratedPage":true,"url":"/redirect/horse/blt8920ebacaed867a3?ht=pre-entries","pageTitle":"Precise (IRE)","jockeyName":"","ownerName":"Derrick Smith, 