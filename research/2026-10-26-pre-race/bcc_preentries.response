r, 05 2022 00:00:00","purseUsa":120000,"positionAtFinish":2},{"trackName":"KEENELAND","raceName":"Indian Summer S. Presented by Keeneland Select","grade":" ","raceDate":"October, 09 2022 00:00:00","purseUsa":250000,"positionAtFinish":3},{"trackName":"SARATOGA","raceName":"Skidmore S.","grade":" ","raceDate":"August, 19 2022 00:00:00","purseUsa":150000,"positionAtFinish":2},{"trackName":"BELMONT PARK","raceName":"Tremont S.","grade":" ","raceDate":"June, 09 2022 00:00:00","purseUsa":150000,"positionAtFinish":4},{"trackName":"KEENELAND","raceName":" ","grade":" ","raceDate":"April, 28 2022 00:00:00","purseUsa":80000,"positionAtFinish":1}],"record":{"previousYear":{"starts":6,"earnings":200552,"show":0,"win":2,"place":1,"showP":"0","winP":"33","placeP":"17"},"breedersCup":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"currentYear":{"starts":3,"earnings":100750,"show":0,"win":0,"place":2,"showP":"0","winP":"0","placeP":"67"},"lifetime":{"starts":23,"earnings":629464,"show":2,"win":5,"place":6,"showP":"9","winP":"22","placeP":"26"}},"yearlySummary":[{"showsP":"0","winsP":"0","placesP":"67","starts":3,"earnings":100750,"racingYear":2026,"shows":0,"wins":0,"places":2},{"showsP":"0","winsP":"33","placesP":"17","starts":6,"earnings":200552,"racingYear":2025,"shows":0,"wins":2,"places":1}],"morningLineOdds":[],"bio":"\u003cp\u003eNo Nay Hudson, a No Nay Never colt, hit the track running with a victory in his career debut at Keeneland's 2022 spring meeting. While he hasn't been a frequent winner for trainer Wesley Ward, he has been in the mix in most of his races while traveling from coast to coast. \r\u003c/p\u003e\u003cp\u003eBred by RJB Bloodstock out of the Grade 2-winning Malibu Moon mare Raw Silk, No Nay Hudson won five times from his first 23 starts but failed to score back-to-back wins at any time during that stretch. \r\u003c/p\u003e\u003cp\u003eHe finished third and fourth in the Green Flash Handicap (G3) on the Del Mar turf in 2024 and 2025 but was 10th in the Woodford Stakes (G2) at Keeneland in October 2024. He appeared to turn a corner with a win in the Nearctic Stakes (G2) at Woodbine a year later but then shipped back to Del Mar in November to finish sixth in the Stormy Liberal Stakes. \r\u003c/p\u003e\u003cp\u003eHe started 2026 with another disappointment -- a seventh-place finish in the Shakertown (G2) at Keeneland. Four-plus months off seemed to provide new life as No Nay Hudson produced back-to-back seconds in the Green Flash and the Woodford.\u0026nbsp;\u003c/p\u003e","gradedStakesPoints":8,"regionWinnerBadges":[],"breederName":"RJB Bloodstock","uid":"blt83fd096b87c5a574","hasAutogeneratedPage":true,"url":"/redirect/horse/blt83fd096b87c5a574?ht=pre-entries","pageTitle":"No Nay Hudson (IRE)","jockeyName":"","ownerName":"Andrew Farm (Ben Fisher), For the People, LLC (T. Mike Morgan) \u0026 Debra L. O'Connor","trainer":"Wesley A. Ward","country":{"uid":"blt1af49e3a6a89373f","title":"USA","abbreviation":"USA","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt9de45bbdff160673/60d219911e0505677a882fa1/USAFlag.png"}},"horseName":"No Nay Hudson","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blta982d52b1b905c2c/6ac6afa8ea4fe94c6b0f3ced/Contender_Photo_No_Hay_Hudson.jpg"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blta982d52b1b905c2c/6ac6afa8ea4fe94c6b0f3ced/Contender_Photo_No_Hay_Hudson.jpg"},"cta":null,"races":[{"uid":"bltc81c6f52eeba2605","ContentTypeUid":"collection_race","challengeSeriesWinner":false,"isEligible":true,"eligibleRank":17,"finishPosition":null,"classicRanking":null,"postPosition":"17","scratched":false,"win":"","place":"","show":"","deadHeat":false,"silks":null}],"isChallengeSeriesWinner":false,"silks":null,"isHoC":false,"year":2026,"isHistoricalEntry":false,"relatedArticles":[],"win":"","show":"","place":""},{"sireName":"Mo Town","damName":"Sassy Redhead","sex"