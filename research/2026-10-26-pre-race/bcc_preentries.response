":"FAIR GROUNDS","raceName":" ","grade":" ","raceDate":"February, 13 2024 00:00:00","purseUsa":58000,"positionAtFinish":1},{"trackName":"FAIR GROUNDS","raceName":" ","grade":" ","raceDate":"December, 30 2023 00:00:00","purseUsa":52000,"positionAtFinish":1}],"record":{"previousYear":{"starts":5,"earnings":164451,"show":0,"win":2,"place":0,"showP":"0","winP":"40","placeP":"0"},"breedersCup":{"starts":0,"earnings":0,"show":0,"win":0,"place":0,"showP":"NA","winP":"NA","placeP":"NA"},"currentYear":{"starts":5,"earnings":292530,"show":1,"win":2,"place":1,"showP":"20","winP":"40","placeP":"20"},"lifetime":{"starts":15,"earnings":639081,"show":2,"win":7,"place":1,"showP":"13","winP":"47","placeP":"7"}},"yearlySummary":[{"showsP":"20","winsP":"40","placesP":"20","starts":5,"earnings":292530,"racingYear":2026,"shows":1,"wins":2,"places":1},{"showsP":"0","winsP":"40","placesP":"0","starts":5,"earnings":164451,"racingYear":2025,"shows":0,"wins":2,"places":0}],"morningLineOdds":[],"bio":"\u003cp\u003eDoncho is turning out to be a bargain buy for Jose Lopez's JAL Racing and recent results hint at an even better return on investment.\r\u003c/p\u003e\u003cp\u003eThe Mo Town gelding went through the sales ring three times before landing with Lopez for $72,000 at the Ocala 2-year-olds sale in June 2023.\r\u003c/p\u003e\u003cp\u003eEntrusted to trainer Michelle Lovell, he won his first two starts at Fair Grounds in December 2023 and February 2024. After an abbreviated campaign during the rest of 2024, Doncho worked his way back to form through the first half of 2025 but was given a bit more than he could handle in October in the Woodford Stakes (G2) at Keeneland, finishing seventh.\r\u003c/p\u003e\u003cp\u003eHe tired badly in his 2026 debut, finishing last in the King T. Leatherbury Stakes at Laurel Park, but then quickly turned things around. Victories in the Mighty Beau Stakes (Listed) at Churchill Downs and the William Garrett Handicap at Horseshoe Indianapolis prompted Lovell to try Doncho in the Troy Stakes (G2) at Saratoga. There, he finished third, just two heads back, and was awarded second on an interference, boosting his career earnings to just more than $600,000.\r\u003c/p\u003e\u003cp\u003eDoncho was favored in his next start in the 5 1/2-furlong Woodford (G2) at Keeneland on Oct. 3. He pressed the pace of eventual winner Joe Shiesty before tiring late to finish third in the field of nine beaten by a length.\r\u003c/p\u003e","gradedStakesPoints":4,"regionWinnerBadges":[],"breederName":"Susan Young","uid":"bltaf0e08806186c1d2","hasAutogeneratedPage":true,"url":"/redirect/horse/bltaf0e08806186c1d2?ht=pre-entries","pageTitle":"Doncho","jockeyName":"","ownerName":"JAL Racing (Jose A. Lopez)","trainer":"Michelle Lovell","country":{"uid":"blt1af49e3a6a89373f","title":"USA","abbreviation":"USA","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt9de45bbdff160673/60d219911e0505677a882fa1/USAFlag.png"}},"horseName":"Doncho","avatar":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt5ee143633bfb3938/6ac3bd8acd0bd9b805d4ef1f/Contender_Photo_Doncho.png"},"regularImage":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt5ee143633bfb3938/6ac3bd8acd0bd9b805d4ef1f/Contender_Photo_Doncho.png"},"cta":null,"races":[{"uid":"bltc81c6f52eeba2605","ContentTypeUid":"collection_race","challengeSeriesWinner":false,"isEligible":true,"eligibleRank":18,"finishPosition":null,"classicRanking":null,"postPosition":"18","scratched":false,"win":"","place":"","show":"","deadHeat":false,"silks":null}],"isChallengeSeriesWinner":false,"silks":null,"isHoC":false,"year":2026,"isHistoricalEntry":false,"relatedArticles":[],"win":"","show":"","place":""},{"sireName":"Cairo Prince","damName":"Hopping Not Hoping","sex":"Gelding","color":"Gray or Roan","foalingDate":"March, 14 2021 00:00:00","age":5,"pastPerformances":[{"trackName":"KEENELAND","raceName":"Woodford S. Presented by FanDuel","grade":"2","raceDate