ges.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/bltde15c95e1819160b/61aa4d361dbfc323d33b0acf/new-zealand_1.png","alt":""}},{"uid":"blt9d5daeded813ea89","title":"Peru","abbreviation":"PER","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/bltcc7330cc49845163/6291285cd0f3ca0f53e07c0c/Image_2022-05-27_at_12.35.37_PM.png"}},{"uid":"blt81e1aa4cef5e5e14","title":"South Africa","abbreviation":"SAF","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt8e12ea98946f37eb/61aa4de8f4f01a1e53e2c686/south-africa.png","alt":""}},{"uid":"blt7f7d5d2e3f0b2809","title":"United Arab Emirates","abbreviation":"ARE","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt143bcf923cbd448a/61aa4f1092da7e58659cfc10/united-arab-emirates.png","alt":""}},{"uid":"blt440e3ce320965a9b","title":"United Kingdom / England","abbreviation":"GBR","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt02676e7705186e63/61aa4e462e86841fa22388f0/united-kingdom.png","alt":""}},{"uid":"blt1af49e3a6a89373f","title":"USA","abbreviation":"USA","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt9de45bbdff160673/60d219911e0505677a882fa1/USAFlag.png"}},{"uid":"blt919360340f6a541a","title":"Uruguay","abbreviation":"URU","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blt818e1e1f270f02c4/6861abd00090ec257972af13/uruguayan-flag-small.gif"}},{"uid":"blt23f61b88ebea7f55","title":"Venezuela","abbreviation":"VEN","flag":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/bltde1a6103313dd4b0/61aa4f506b14b6709abf44fa/venezuela.png","alt":""}}]}},"sponsor":null}},{"articleMetadata":{"uid":"blt58aa5556a3f3b47b","ContentTypeUid":"block_article_metadata","article":{"uid":"blt600156f0f6149cff","title":"Record 255 Pre-Entries Highlight Global Appeal of World Championships","url":"/news/2026/record-255-pre-entries-highlight-global-appeal-of-world-championships","publishDate":"2026-10-21T16:38:31.000Z","thumbnails":{"default":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/blta67e480b748f1a65/69dd4150a37bbbbbecefd358/Keeneland_600x350_A.jpg"},"largeCard":null,"smallVerticalCard":{"src":"https://images.contentstack.io/v3/assets/blt9b0ea57b1efe7a70/bltecc0984759f7af2a/69dd41501ea2b458f158bffe/Keeneland_308x420_A.jpg"},"horizontalCard":null,"mobileHorizontalCard":null},"content":"\u003cp style=\"text-align: center;\"\u003e\u003cstrong\u003eRecord 222 Unique Horses, Including 79 International Contenders, Set Stage for Two Days of World-Class Racing at Keeneland\u003c/strong\u003e\u003c/p\u003e\u003chr/\u003e\u003cp\u003e\u003cstrong\u003eLEXINGTON, Ky. (Oct. 21, 2026)\u003c/strong\u003e – An unprecedented 255 pre-entries have set a record for the Breeders’ Cup World Championships, as the finest contenders from around the globe prepare to converge on historic Keeneland Race Course for Thoroughbred racing’s premier two-day festival of racing.\u0026nbsp;\u0026nbsp;\u003c/p\u003e\u003cp\u003eRepresenting a record 222 individual horses, including 79 international contenders – the second-highest number in history behind 80 in 2024 – the exceptional lineup underscores the global prestige of the World Championships and sets the stage for a spectacular edition Oct. 30-31 in the heart of Kentucky’s Bluegrass region. The international reach of the World Championships is once again reflected in the breadth of its pre-entries, with horses bred in 10 countries (Argentina, Australia, Canada, Chile, France, Great Britain, Ireland, Japan, South Africa, and the United States) on six continents (Africa, Asia, Australia, Europe, North America, and South America).\u0026nbsp;\u003c/p\u003e\u003cp\u003eHeadlining the action is Japan’s Forever Young (JPN), whose historic victory in last year’s $7 million Longines Breeders’ Cup Classic (G1) marked a defining moment for Japanese racing. Forever Young will return to defend his title against a world-class group of challengers when the Longines Breeders’ Cup Classic resumes its traditional position as the final race on Saturday’s card, bringing the World Championships to a dramatic conclusion at 6:16 p.m. ET. The marquee event anchors a festival worth more than $34 million in purses and awards, highlighted by 14 Grade 1 races.\u0026nbsp;\u003c/p\u003e\u003cp\u003e“This historic level of participation is a testament to the strength and prestige of the Breeders’ Cup World Championships,” said Drew Fleming, President and CEO of Breeders’ Cup Limited. “We are deeply grateful to our board of directors, members, nominators, and participants from around the globe for their unwavering support, and to our racing department for the tremendous work that goes into assembling a lineup of this caliber. We also thank our great partners at Keeneland and look forward to welcoming the world to their historic venue for another thrilling edition of the Breeders’ Cup, where the very best of our sport will compete on racing’s biggest international stage.”\u0026nbsp;\u003c/p\u003e\u003cp\u003eFans may learn more about their favorites through the contender profiles at \u003ca href=\"https://www.breederscup.com/horses/contenders/classic\"\u003eBreedersCup.com\u003c/a\u003e, featuring career statistics, race replays, news, photos, and additional information about the horses and their connections, as well as through the official \u003ca href=\"https://www.breederscup.com/app\"\u003eBreeders' Cup mobile app\u003c/a\u003e. Information about each Championship race is available at \u003ca href=\"https://www.breederscup.com/races/BCWC/2026\"\u003eBreedersCup.com/Races\u003c/a\u003e.\u0026nbsp;\u003c/p\u003e\u003cp\u003ePre-entry marks the first of a two-step process for owners intending to start a horse in one of the 14 Championship races. The final entry stage will occur Monday, Oct. 26, with post positions drawn live beginning at 5:00 p.m. ET on \u003ca href=\"https://www.fanduel.com/watch\"\u003eFanDuel TV\u003c/a\u003e, \u003ca href=\"https://www.fanduel.com/watch\"\u003eBreedersCup.com\u003c/a\u003e, the official \u003ca href=\"https://www.breederscup.com/\"\u003eBreeders' Cup mobile app\u003c/a\u003e, and the organization's \u003ca href=\"https://www.breederscup.com/\"\u003eYouTube\u003c/a\u003e, \u003ca href=\"https://www.breederscup.com/app\"\u003eFacebook\u003c/a\u003e, and \u003ca href=\"https://www.youtube.com/c/BreedersCupWorldChampionships/videos\"\u003eX\u003c/a\u003e social channels.\u0026nbsp;\u003c/p\u003e\u003cp\u003eForever Young seeks to become just the second repeat winner of the Longines Breeders’ Cup Classic, following Tiznow in 2000-01. Trained by Yoshito Yahagi for owner Susumu Fujita, the international superstar became the first Japan-based horse to win the Longines Breeders’ Cup Classic with his victory at Del Mar Thoroughbred Club in 2025. He has continued his success this season, capturing his second edition of the Saudi Cup (G1) in February and running second in the Dubai World Cup (G1) in March before turning in a 3 1/4-length victory in the Sept. 18 Jockey Club Gold Cup Stakes (G1) at Belmont Park.\u0026nbsp;\u0026nbsp;\u003c/p\u003e\u003cp\u003eStanding among his principal challengers from 11 pre-entries for one of the most anticipated races of the year is Godolphin's reigning Horse of the Year Sovereignty, winner of the 2025 Kentucky Derby (G1), Belmont Stakes (G1), and Travers Stakes (G1), who added the Whitney Stakes (G1) to his distinguished résumé this summer. The anticipated Longines Breeders’ Cup Classic field also features Godolphin's Knightsbridge, winner of the Pacific Classic Stakes (G1); Magnitude, whose victories in the Dubai World Cup and Stephen Foster Stakes (G1) established him among the division's leading performers; and millionaire Phileas Fogg, two-time winner of the Suburban Stakes (G2). Leading 3-year-olds Golden Tempo, winner of this year's Kentucky Derby and Belmont Stakes; Napoleon Solo, winner of the Preakness Stakes (G1); The Puma, winner of the Pennsylvania Derby (G1); and Blue Grass Stakes (G1) winner Further Ado look to conquer their elders. Also pre-entered in the Longines Breeders’ Cup Classic but with a first preference listed for the Breeders’ Cup Dirt Mile (G1) are Forged Steel and T O Password (JPN). The connections of Knightsbridge, Further Ado, and Napoleon Solo have listed the Dirt Mile as their second preference.\u0026nbsp;\u0026nbsp;\u003c/p\u003e\u003cp\u003eTwelve Breeders’ Cup Champions are pre-entered for the 43rd running of the World Championships: Cy Fair, Ethical Diamond (IRE), Forever Young, Full Serrano (ARG), Gstaad (GB), Immersive, Nobals, Notable Speech (GB), Shisospicy, Splendora, Starlust (GB), and Super Corredora.\u0026nbsp;\u003c/p\u003e\u003cp\u003eAdditionally, 58 individual pre-entered horses qualified through the 2026 Breeders' Cup Challenge Series: Win and You're In, an international series comprising 95 qualifying races across 14 countries on five continents. Winners of designated Challenge races receive automatic starting positions and fees paid into corresponding races at the World Championships.\u0026nbsp;\u0026nbsp;\u003c/p\u003e\u003cp\u003eKeeneland, in the heart of horse country, will host the World Championships for a fourth time after epic editions in 2015, 2020, and 2022. The historic racetrack provides a fitting setting for Thoroughbred racing's premier international event, located in a region renowned for its breeding farms, racing heritage, and generations of Thoroughbred excellence. A limited amount of general admission tickets are all that remain and are expected to sell out. Fans should visit \u003ca href=\"http://www.breederscup.com/tickets\"\u003eBreedersCup.com/Tickets\u003c/a\u003e to secure their chance to witness history.\u0026nbsp;\u003c/p\u003e\u003cp\u003eExtensive Global Coverage of World Championships Planned\u0026nbsp;\u003c/p\u003e\u003cp\u003eNBC Sports and Peacock will present 10 1/2 hours of live coverage featuring all 14 Championship races across NBC and USA Network over the two days. Coverage begins Friday, Oct. 30, from 1-6 p.m. ET on USA Network and Peacock with Future Stars Friday, showcasing five Championship races exclusively for 2-year-olds. On Saturday, Oct. 31, coverage resumes from 1-3:30 p.m. ET on USA Network and Peacock before moving to NBC and Peacock from 3:30-6:30 p.m. ET, culminating with the $7 million Longines Breeders' Cup Classic at 6:16 p.m. ET.\u0026nbsp;\u003c/p\u003e\u003cp\u003eFanDuel TV will present live, continuous coverage of every Championship and undercard race through the “Breeders' Cup Players' Show,” available on \u003ca href=\"https://www.fanduel.com/watch\"\u003eFanDuel TV\u003c/a\u003e, \u003ca href=\"https://www.breederscup.com/\"\u003eBreedersCup.com\u003c/a\u003e, the official \u003ca href=\"https://www.breederscup.com/app\"\u003eBreeders' Cup mobile app\u003c/a\u003e, Breeders' Cup \u003ca href=\"https://www.youtube.com/c/BreedersCupWorldChampionships/videos\"\u003eYouTube\u003c/a\u003e, \u003ca href=\"https://www.facebook.com/breederscup/\"\u003eFacebook\u003c/a\u003e, and \u003ca href=\"https://x.com/breederscup\"\u003eX\u003c/a\u003e social channels, major advance-deposit wagering platforms, and simulcast outlets worldwide. New this year, the Players’ Show will also be available on Peacock.\u0026nbsp;\u003c/p\u003e\u003cp\u003eThe World Championships will once again reach audiences in more than 180 territories through an extensive network of international broadcast partners. Coverage will be available across major racing and sports platforms in Europe, Asia, Australia, the Americas, and beyond. Complete domestic and international broadcast information is available at \u003ca href=\"http://www.breederscup.com/Watch\"\u003eBreedersCup.com/Watch\u003c/a\u003e.\u0026nbsp;\u0026nbsp;\u003c/p\u003e\u003cp\u003eLast year's World Championships at Del Mar generated a record $210 million in global wagering and made a record $125 million in economic impact on the San Diego area, underscoring the continued growth and significance of the Breeders’ Cup on the global sporting calendar.\u0026nbsp;\u003c/p\u003e\u003cp\u003e***\u0026nbsp;\u003c/p\u003e\u003cp\u003eA maximum of 14 starters is allowed in each of the 14 Breeders' Cup races, excluding the Breeders' Cup Dirt Mile and Breeders' Cup Juvenile Turf Sprint, which are limited to 12 starters. Breeders' Cup Limited utilizes a field selection system to select runners when fields are oversubscribed. This system ranks horses in order of preference based on (i) Breeders' Cup Challenge race winners, (ii) a points system, and (iii) the judgment of an independent international panel of racing experts.\u0026nbsp;\u003c/p\u003e\u003cp\u003eThe field selection system was implemented following the taking of pre-entries on Oct. 19 to officially rank oversubscribed fields. The Racing Directors/Secretaries Panel (the \"Panel\") ranked all horses pre-entered in oversubscribed races according to the established criteria. After pre-entry, any vacancies in the fields will be filled by horses in order of Panel preference.\u0026nbsp;\u003c/p\u003e\u003cp\u003eThere will be up to four also-eligible horses for each Championship race, except for the Breeders' Cup Dirt Mile and Breeders' Cup Juvenile Turf Sprint, which will have up to six. The also-eligible horses will be designated in accordance with the Panel's order of preference for each Championship race that was oversubscribed at the time of pre-entry. Scratch time for Friday's Championship races will be 8 a.m. ET on Friday, Oct. 30, and scratch time for Saturday's Championship races will be 8 a.m. ET on Saturday, Oct. 31.\u0026nbsp;\u003c/p\u003e\u003chr/\u003e\u003cp\u003e\u0026nbsp;\u003c/p\u003e","type":"News","author":"","adCards":[{"ContentTypeUid":"collection_advertisement","type":"DFP Ad","dfpAdCard":{"adHeight":250,"code":"\u003ca href=\"https://www.breederscup.com/watch