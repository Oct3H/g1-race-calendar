                        </div>
                      </td>
                    </tr>
                    <tr valign="TOP" bgcolor="#FFFFFF">
                      <td width="20%">Win / Place</td>
                      <td width="12%">
                        <div align="center">10%</div>
                      </td>
                      <td rowspan="2" width="12%">
                        <div align="center">6%</div>
                      </td>
                    </tr>
                    <tr valign="TOP" bgcolor="#DBE8F3">
                      <td width="20%">Quinella / Quinella Place</td>
                      <td width="12%">
                        <div align="center">12%</div>
                      </td>
                    </tr>
                  </tbody>
                </table>
              </td>
            </tr>
          </tbody>
        </table>
        <p class="gray">
          <small>^All Up as well as Cross Pool All Up bets are not available
            between local and overseas races</small><br>
          <small>*Applicable to Cash Betting, Electronic Shroff Card and
            eWallet</small>
          <br>
          <small>**Applicable to Telebet and Digital Channels including Online
            Betting Service (eWin), Classic 3-in-1 and Racing Touch App
          </small>
        </p>
        <br>
        <p class="backtotop"><a href="#top" class="backtotop">^ Top</a></p>

        <h3><a name="8"></a>2. Pari-Mutuel Outbound Commingling Pools</h3>
        <p>
          On designated simulcast races from France, Win and Place Bets will
          be outbound commingled to the respective Pools operated by Pari
          Mutuel Urbain (“PMU”) of France, in accordance with PMU’s modified
          horse race betting rules.
        </p>
        <table width="95%" border="0" cellpadding="0" cellspacing="0" bgcolor="#CCCCCC">
          <tbody>
            <tr>
              <td>
                <table width="100%" cellpadding="1" cellspacing="1">
                  <tbody>
                    <tr valign="TOP" bgcolor="#666666">
                      <td width="30%" height="10">
                        <div align="center">
                          <b>
                            <font color="#FFFFFF">Pool</font>
                          </b>
                        </div>
                      </td>
                      <td width="70%" height="10">
                        <div align="center">
                          <b>
                            <font color="#FFFFFF">% of Pool paid out as Dividend</font>
                          </b>
                        </div>
                      </td>
                    </tr>
                    <tr valign="TOP" bgcolor="#DBE8F3">
                      <td width="30%"><b>Win / Place</b></td>
                      <td width="70%">
                        84.95% (subject to the rate announced by France PMU
                        from time to time)
                      </td>
                    </tr>
                  </tbody>
                </table>
              </td>
            </tr>
          </tbody>
        </table>
        <br>

        <h4><a name="9"></a>2.1. Dividend Qualification</h4>
        <p></p>
        <table width="95%" border="0" cellpadding="0" cellspacing="0" bgcolor="#CCCCCC">
          <tbody>
            <tr>
              <td>
                <table width="100%" cellpadding="1" cellspacing="1">
                  <tbody>
                    <tr valign="TOP" bgcolor="#666666">
                      <td width="30%" height="10">
                        <div align="center">
                          <b>
                            <font color="#FFFFFF">Single-race Pools</font>
                          </b>
                        </div>
                      </td>
                      <td width="70%" height="10">
                        <div align="center">
                          <b>
                            <font color="#FFFFFF">Dividend Qualification</font>
                          </b>
                        </div>
                      </td>
                    </tr>
                    <tr valign="TOP" bgcolor="#FFFFFF">
                      <td width="30%"><b>Win</b></td>
                      <td width="70%">
                        Selection of an individual runner finishing 1<sup>st</sup>
                        in a race
                      </td>
                    </tr>
                    <tr valign="TOP" bgcolor="#DBE8F3">
                      <td width="30%" bgcolor="#DBE8F3"><b>Place</b></td>
