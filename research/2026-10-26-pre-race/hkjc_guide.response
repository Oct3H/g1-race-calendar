                      <td height="10">
                        <div align="center">
                          <b>
                            <font color="#FFFFFF">Rebate Percentage</font>
                          </b>
                        </div>
                      </td>
                      <td height="10">
                        <div align="center">
                          <b>
                            <font color="#FFFFFF">Local Races</font>
                          </b>
                        </div>
                      </td>
                      <td>
                        <div align="center">
